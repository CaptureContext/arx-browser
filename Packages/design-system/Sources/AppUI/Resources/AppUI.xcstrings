    "sendFeedback.privacyAgreement": {
      "comment": "Send Feedback card: under Include diagnostics. %@ is the privacy policy's name (sendFeedback.privacyPolicy), which is a link to the policy; it must appear exactly as that string is translated.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Senden dieses Berichts stimmst du unserer %@ zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By sending this report, you agree to our %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al enviar este informe, aceptas nuestra %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En envoyant ce rapport, vous acceptez notre %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートを送信すると、%@に同意したものとみなされます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłając to zgłoszenie, zgadzasz się na warunki opisane w dokumencie: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляя этот отчет, Вы соглашаетесь с документом: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилаючи цей звіт, ви погоджуєтеся з документом: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送此报告即表示你同意我们的%@。"
          }
        }
      }
    },
    "sendFeedback.privacyPolicy": {
