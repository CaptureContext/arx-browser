    "migration.clearConfirmationFooter": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten werden vor dem Start des Imports endgültig entfernt, und Arx behält ein neues, leeres Profil. Dieser Vorgang kann nicht widerrufen werden. Der andere Browser wird nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are removed for good before the import starts, and Arx keeps one new, empty profile. This can't be undone. The other browser isn't changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se elimina de forma definitiva antes de que empiece la importación y Arx conserva un perfil nuevo y vacío. Esta acción no se puede deshacer. El otro navegador no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments sont supprimés définitivement avant le début de l’importation, et Arx conserve un seul profil neuf et vide. Cette action est irréversible. L’autre navigateur n’est pas modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みを開始する前にこれらが完全に削除され、Arxには新しい空のプロファイルが1つ残ります。この操作は取り消せません。もう一方のブラウザは変更されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną one trwale usunięte przed rozpoczęciem importu, a Arx zachowa jeden nowy, pusty profil. Tej czynności nie można cofnąć. Druga przeglądarka nie zostanie zmieniona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это будет удалено безвозвратно до начала импорта, и в Arx останется один новый пустой профиль. Это действие нельзя отменить. Другой браузер не изменится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх буде вилучено назавжди до початку імпорту, а Arx залишить один новий порожній профіль. Цю дію не можна відмінити. Інший браузер не змінюється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些内容会在导入开始前被永久移除，Arx 会保留一个全新的空用户场景。此操作无法撤销。另一个浏览器不会有任何更改。"
          }
        }
      }
    },
