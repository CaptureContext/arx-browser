    "settings.iCloudSync.historyDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzlich besuchte Seiten im selben Profil auf deinen anderen Macs. Wenn du den Verlauf auf einem Mac löschst, wird er auch auf den anderen gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages you visited recently, in the same profile on your other Macs. Clearing history on one Mac clears it on the others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas que has visitado recientemente, en el mismo perfil de tus otros Mac. Al borrar el historial en un Mac, se borra en los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages que vous avez visitées récemment, dans le même profil sur vos autres Mac. Effacer l’historique sur un Mac l’efface sur les autres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近表示したページを、ほかのMacの同じプロファイルと共有します。1台のMacで履歴を消去すると、ほかのMacでも消去されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio odwiedzone strony w tym samym profilu na Twoich pozostałych komputerach Mac. Wymazanie historii na jednym Macu wymazuje ją na pozostałych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы, которые Вы недавно посещали, в том же профиле на Ваших других компьютерах Mac. Очистка истории на одном Mac очищает ее на остальных."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінки, які ви нещодавно відвідували, у тому самому профілі на інших ваших Mac. Очищення історії на одному Mac очищає її на інших."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近访问的页面，显示在其他 Mac 上的同一用户场景中。在一台 Mac 上清除历史记录，也会在其他 Mac 上清除。"
          }
        }
      }
    },
