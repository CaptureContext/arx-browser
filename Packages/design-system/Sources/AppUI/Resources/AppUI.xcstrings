    "appLinks.section": {
      "comment": "App Links (Settings › Links › Air Traffic Control › App Links): a handler is a rule for links that a page hands to another app, such as claude://: which links it catches (by scheme, host and path) and what happens to them, open an app or run the person's script.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
