    "settings.experimentalDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühe Ideen, die du zum Ausprobieren aktivieren kannst. Deine Auswahl gilt sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Early ideas you can turn on to try. Your choices apply right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas preliminares que puedes activar para probarlas. Tus elecciones se aplican al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des idées en avant-première que vous pouvez activer pour les essayer. Vos choix s’appliquent immédiatement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにして試せる初期段階のアイデアです。選択内容はすぐに適用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczesne pomysły, które możesz włączyć, aby je wypróbować. Twoje wybory obowiązują od razu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые идеи, которые можно включить, чтобы попробовать. Выбор применяется сразу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранні ідеї, які можна ввімкнути, щоб спробувати. Ваш вибір застосовується одразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以打开来尝试的早期构想。你的选择会立即生效。"
          }
        }
      }
    },
    "settings.experimentalFootnote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente können sich in einer späteren Version von Arx ändern oder wegfallen."
