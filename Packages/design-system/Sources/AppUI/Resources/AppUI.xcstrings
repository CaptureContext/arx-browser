    "settings.iCloudSync.merge.duplicatesDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Räume, fixierten Tabs und Favoriten werden zu einem Profil. Jeder Mac behält die Website-Daten des Profils, das er zuletzt verwendet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their spaces, pins and Favorites become one profile. Each Mac keeps the website data of the one it used last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus secciones, elementos anclados y favoritos se convierten en un solo perfil. Cada Mac conserva los datos de sitios web del que usó por última vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs sections, éléments épinglés et Favoris deviennent un seul profil. Chaque Mac conserve les données de sites web de celui qu’il a utilisé en dernier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれのスペース、固定項目、お気に入りが1つのプロファイルになります。各Macでは、最後に使用したプロファイルのウェブサイトのデータが保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich strefy, przypięte karty i ulubione stają się jednym profilem. Każdy Mac zachowuje dane witryn tego, którego użył ostatnio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их разделы, закрепленные вкладки и избранное станут одним профилем. Каждый Mac сохранит данные веб-сайтов того профиля, которым пользовался последним."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їхні розділи, закріплені вкладки й улюблені стануть одним профілем. Кожен Mac зберігає дані вебсайтів того профілю, який використовував останнім."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们的分区、固定项目和个人收藏会合并为一个用户场景。每台 Mac 会保留它最后使用的那个用户场景的网站数据。"
          }
        }
      }
    },
