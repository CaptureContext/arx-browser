    "settings.fullURLExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt des Namens der Website. Beim Bearbeiten wird immer die ganze Adresse angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of the site’s name. Editing always shows the whole address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar del nombre del sitio. Al editar, siempre se muestra la dirección completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu du nom du site. Lors de la modification, l’adresse entière s’affiche toujours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイト名の代わりに表示します。編集中は常にアドレス全体が表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast nazwy witryny. Podczas edycji zawsze widać cały adres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо названия сайта. При редактировании всегда показывается весь адрес."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замість назви сайту. Під час редагування завжди показується вся адреса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "而不是网站的名称。编辑时始终会显示完整地址。"
          }
        }
      }
    },
    "settings.hapticsExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anordnen von Tabs und wenn Force Click einen Link öffnet. Erfordert ein Force-Touch-Trackpad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you reorder tabs, and when Force Click opens a link. Needs a Force Touch trackpad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras reordenas pestañas y cuando el clic fuerte abre un enlace. Requiere un trackpad Force Touch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous réorganisez les onglets et lorsqu’un clic appuyé ouvre un lien. Nécessite un trackpad Force Touch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを並べ替えるときと、強く押してリンクを開くときに働きます。Force Touchトラックパッドが必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas zmiany kolejności kart i gdy mocne naciśnięcie otwiera łącze. Wymaga gładzika Force Touch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При изменении порядка вкладок и когда нажатие с усилием открывает ссылку. Требуется трекпад Force Touch."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час перевпорядкування вкладок і коли сильне натискання відкриває посилання. Потрібен трекпад із підтримкою Force Touch."
          }
        },
        "zh-Hans": {
