    "extensions.importReview.installAllNote": {
      "comment": "Import's extension review: one line above the buttons saying what Install All does.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Alle installieren“ fügt die übrigen hinzu, ohne sie einzeln anzuzeigen, und zwar mit den Berechtigungen, die jede anfordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install All adds the rest without showing each one, with the permissions each asks for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar todas añade el resto sin mostrar cada una, con los permisos que pide cada extensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout installer ajoute les extensions restantes sans afficher chacune, avec les autorisations que chacune demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「すべてインストール」を選択すると、残りの機能拡張が、それぞれが求める権限とともに、確認なしで追加されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja Zainstaluj wszystkie dodaje pozostałe bez pokazywania każdego z osobna, z uprawnieniami, o które każde prosi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка «Установить все» добавит остальные расширения без показа каждого, с теми разрешениями, которые они запрашивают."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Інсталювати всі» додає решту без показу кожного розширення, з дозволами, яких воно вимагає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“全部安装”会直接添加其余扩展，不再逐个显示，并授予每个扩展所请求的权限。"
          }
        }
      }
    },
