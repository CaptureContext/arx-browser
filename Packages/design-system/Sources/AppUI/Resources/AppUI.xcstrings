    "migration.extensionsReview": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Import installiert Arx die Erweiterungen aus dem Chrome Web Store nacheinander. Du prüfst zuvor die Berechtigungen jeder Erweiterung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the import, Arx installs the Chrome Web Store extensions one at a time. You review each one’s permissions first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la importación, Arx instala las extensiones de Chrome Web Store una a una. Antes revisas los permisos de cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’importation, Arx installe les extensions du Chrome Web Store une par une. Vous vérifiez d’abord les autorisations de chacune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みのあと、ArxはChrome ウェブストアの機能拡張を1つずつインストールします。最初に、それぞれの権限を確認できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po imporcie Arx instaluje rozszerzenia z Chrome Web Store po kolei. Najpierw sprawdzasz uprawnienia każdego z nich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После импорта Arx по очереди установит расширения из Интернет-магазина Chrome. Сначала Вы проверите разрешения каждого из них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після імпорту Arx інсталює розширення з вебмагазину Chrome по одному. Спершу ви переглядаєте дозволи кожного з них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入之后，Arx 会逐个安装 Chrome 应用商店的扩展。你会先检查每个扩展的权限。"
          }
        }
      }
    },
    "migration.fullDiskAccess.title": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festplattenvollzugriff erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Full Disk Access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir Acceso total al disco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès complet au disque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスを許可"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na Pełny dostęp do dysku"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить полный доступ к диску"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте повний доступ до диска"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许完全磁盘访问权限"
          }
        }
      }
    },
    "migration.fullDiskAccess.message": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bewahrt die Lesezeichen, Tabs und den Verlauf von %@ in einem geschützten Ordner auf, daher benötigt Arx den Festplattenvollzugriff, um sie zu lesen. Arx liest sie nur beim Import und ändert dort nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS keeps %@'s bookmarks, tabs and history in a protected folder, so Arx needs Full Disk Access to read them. Arx reads them only when you import, and changes nothing there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS guarda los marcadores, las pestañas y el historial de %@ en una carpeta protegida, por lo que Arx necesita Acceso total al disco para leerlos. Arx solo los lee al importar y no cambia nada en ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS conserve les signets, les onglets et l’historique de %@ dans un dossier protégé : Arx a donc besoin de l’accès complet au disque pour les lire. Arx ne les lit que lorsque vous importez, et n’y modifie rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは%@のブックマーク、タブ、履歴を保護されたフォルダに保存しているため、Arxがそれらを読み込むにはフルディスクアクセスが必要です。Arxは読み込み時にのみそれらを読み取り、そこにあるものは何も変更しません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS przechowuje zakładki, karty i historię %@ w chronionym folderze, więc Arx potrzebuje Pełnego dostępu do dysku, aby je odczytać. Arx odczytuje je tylko podczas importu i niczego tam nie zmienia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS хранит закладки, вкладки и историю %@ в защищенной папке, поэтому Arx нужен полный доступ к диску, чтобы прочитать их. Arx читает их только во время импорта и ничего там не меняет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS зберігає закладки, вкладки та історію %@ у захищеній папці, тож Arx потрібен повний доступ до диска, щоб їх прочитати. Arx читає їх лише під час імпорту й нічого там не змінює."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 将 %@ 的书签、标签页和历史记录保存在受保护的文件夹中，因此 Arx 需要“完全磁盘访问权限”才能读取它们。Arx 仅在你导入时读取它们，不会更改其中的任何内容。"
          }
        }
      }
    },
    "migration.fullDiskAccess.steps": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in den Systemeinstellungen unter „Datenschutz & Sicherheit“ › „Festplattenvollzugriff“ die Option für Arx und kehre dann zu Arx zurück. Wenn macOS vorschlägt, Arx zu beenden und erneut zu öffnen, tue das und importiere erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings, turn on Arx under Privacy & Security › Full Disk Access, then come back to Arx. If macOS asks to quit and reopen Arx, do that and import again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema, activa Arx en Privacidad y seguridad › Acceso total al disco y vuelve a Arx. Si macOS te pide salir y volver a abrir Arx, hazlo e importa de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système, activez Arx sous Confidentialité et sécurité › Accès complet au disque, puis revenez dans Arx. Si macOS demande de quitter et de rouvrir Arx, faites-le et importez de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定の「プライバシーとセキュリティ」＞「フルディスクアクセス」でArxをオンにしてから、Arxに戻ってください。macOSがArxの終了と再度の起動を求めた場合は、それに従って、もう一度読み込んでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Ustawieniach systemowych włącz Arx w sekcji Prywatność i ochrona › Pełny dostęp do dysku, a następnie wróć do Arx. Jeśli macOS poprosi o zakończenie i ponowne otwarcie Arx, zrób to i zaimportuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Системные настройки › Конфиденциальность и безопасность › Доступ к диску» включите Arx, затем вернитесь в Arx. Если macOS предложит завершить и снова открыть Arx, сделайте это и повторите импорт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Системних параметрах увімкніть Arx у розділі «Приватність і безпека» › «Повний доступ до диска», а потім поверніться до Arx. Якщо macOS запропонує завершити й знову відкрити Arx, зробіть це та імпортуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”中，于“隐私与安全”>“完全磁盘访问权限”下打开 Arx，然后回到 Arx。如果 macOS 要求退出并重新打开 Arx，请照做，然后再次导入。"
          }
        }
      }
    },
    "migration.fullDiskAccess.openSettings": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
