          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page a cessé de répondre, Arx l’a donc arrêtée. Rechargez-la pour l’ouvrir de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページが応答しなくなったため、Arxが終了しました。再読み込みすると、もう一度開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strona przestała odpowiadać, więc Arx ją zakończył. Odśwież, aby otworzyć ją ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница перестала отвечать, поэтому Arx завершил ее. Перезагрузите ее, чтобы открыть снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця сторінка перестала відповідати, тож Arx завершив її. Перезавантажте, щоб відкрити її знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面停止响应，因此 Arx 将其结束。请重新加载以再次打开。"
          }
        }
      }
    },
    "viewer.rendererLaunchFailed": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite konnte nicht gestartet werden. Lade sie neu, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page couldn't start. Reload to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página no ha podido iniciarse. Vuelve a cargarla para intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page n’a pas pu démarrer. Rechargez-la pour réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを開始できませんでした。再読み込みして、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strona nie mogła się uruchomić. Odśwież, aby spróbować ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить эту страницу. Перезагрузите ее и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю сторінку не вдалося запустити. Перезавантажте, щоб спробувати ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面无法启动。请重新加载以重试。"
          }
        }
      }
    },
    "viewer.rendererShared": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Seiten haben gleichzeitig angehalten, wahrscheinlich wegen etwas, das sie sich teilen, und nicht wegen dieser Seite. Lade sie neu, um sie erneut zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several pages stopped at once, probably because of something they share rather than this page. Reload to open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varias páginas se han detenido a la vez, probablemente por algo que comparten y no por esta página. Vuelve a cargarla para abrirla de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs pages se sont arrêtées en même temps, probablement à cause de quelque chose qu’elles partagent plutôt que de cette page. Rechargez-la pour l’ouvrir de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のページが同時に停止しました。このページではなく、共有している何かが原因である可能性があります。再読み込みすると、もう一度開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka stron zatrzymało się jednocześnie, prawdopodobnie z powodu czegoś, co współdzielą, a nie z powodu tej strony. Odśwież, aby otworzyć ją ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько страниц остановились одновременно, вероятно, из-за общего для них ресурса, а не из-за этой страницы. Перезагрузите ее, чтобы открыть снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька сторінок зупинилися одночасно, імовірно через щось спільне для них, а не через цю сторінку. Перезавантажте, щоб відкрити її знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个页面同时停止，可能是由它们共享的内容而非此页面引起。请重新加载以再次打开。"
          }
        }
      }
    },
    "viewer.rendererKeepsCrashing": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite stürzt immer wieder ab. Arx lädt sie nicht von selbst neu; lade sie neu, sobald sich etwas geändert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page keeps crashing. Arx won't reload it by itself; reload it once something has changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página sigue fallando. Arx no la volverá a cargar por sí solo; vuelve a cargarla cuando algo haya cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page plante en boucle. Arx ne la rechargera pas de lui-même ; rechargez-la une fois que quelque chose a changé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページはクラッシュを繰り返しています。Arxは自動的には再読み込みしません。状況が変わってから再読み込みしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strona wciąż ulega awarii. Arx nie odświeży jej sam; odśwież ją, gdy coś się zmieni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой странице сбои повторяются. Arx не будет перезагружать ее сам; перезагрузите ее, когда что-нибудь изменится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця сторінка постійно аварійно завершується. Arx не перезавантажуватиме її сам; перезавантажте її, коли щось зміниться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面不断崩溃。Arx 不会自动重新加载它；请在有所改变后再重新加载。"
          }
        }
      }
    },
    "viewer.rendererKeepsRunningOutOfMemory": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Seite geht immer wieder der Arbeitsspeicher aus. Arx lädt sie nicht von selbst neu; schließe andere Seiten oder lade sie später neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page keeps running out of memory. Arx won't reload it by itself; close other pages or reload it later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página sigue quedándose sin memoria. Arx no la volverá a cargar por sí solo; cierra otras páginas o vuelve a cargarla más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page manque de mémoire en boucle. Arx ne la rechargera pas de lui-même ; fermez d’autres pages ou rechargez-la plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページはメモリ不足を繰り返しています。Arxは自動的には再読み込みしません。ほかのページを閉じるか、後で再読み込みしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej stronie wciąż brakuje pamięci. Arx nie odświeży jej sam; zamknij inne strony lub odśwież ją później."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой странице снова и снова не хватает памяти. Arx не будет перезагружать ее сам; закройте другие страницы или перезагрузите ее позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цій сторінці постійно бракує памʼяті. Arx не перезавантажуватиме її сам; закрийте інші сторінки або перезавантажте її пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面的内存不断耗尽。Arx 不会自动重新加载它；请关闭其他页面，或稍后再重新加载。"
          }
        }
      }
    },
