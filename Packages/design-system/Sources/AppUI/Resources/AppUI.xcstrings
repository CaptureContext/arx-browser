    "translation.offerTitle": {
      "comment": "Title of the offer to translate a page. %@ is the language it is translated into, the person's own, as macOS names it in the interface language; it is inserted as it is and can't be declined, hence the colon.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite übersetzen nach: %@?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate this page to: %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Traducir esta página a: %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduire cette page vers : %@ ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページの翻訳先：%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetłumaczyć tę stronę na: %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевести эту страницу на язык: %@?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекласти цю сторінку мовою: %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此页面翻译为：%@？"
          }
        }
      }
    },
