    "emptyPage.hintNewTab": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke %@, um einen neuen Tab zu öffnen. Tippe einen Teil des Namens einer Website und wähle sie aus der Liste aus oder drücke den Zeilenschalter, um zu suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ to open a new tab. Type part of a site's name and pick it from the list, or press Return to search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ para abrir una pestaña nueva. Escribe parte del nombre de un sitio y elígelo en la lista, o pulsa Retorno para buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ pour ouvrir un nouvel onglet. Saisissez une partie du nom d’un site et choisissez-le dans la liste, ou appuyez sur Retour pour lancer une recherche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、新規タブが開きます。サイト名の一部を入力して一覧から選ぶか、Returnキーを押して検索します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij %@, aby otworzyć nową kartę. Wpisz część nazwy witryny i wybierz ją z listy albo naciśnij Return, aby wyszukać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@, чтобы открыть новую вкладку. Введите часть названия сайта и выберите его из списка или нажмите Return для поиска."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@, щоб відкрити нову вкладку. Введіть частину назви сайту й виберіть його зі списку або натисніть Return, щоб виконати пошук."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 %@ 可打开新标签页。输入网站名称的一部分并从列表中选取，或按下 Return 键进行搜索。"
          }
        }
      }
    },
    "emptyPage.hintAddress": {
      "comment": "Empty page tip. The address bar is the field at the top of the sidebar that shows the page's address. %@ is a keyboard shortcut such as ⌘L.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@ gelangst du von überall in die Adressleiste, auch wenn eine Seite die Tastatur hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puts you in the address bar from anywhere, even while a page has the keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te lleva al campo de dirección desde cualquier sitio, incluso cuando una página tiene el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous place dans la barre d’adresse depuis n’importe où, même lorsqu’une page a le clavier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、ページがキーボード入力を受け付けているときでも、どこからでもアドレスバーに移動できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ przenosi Cię do paska adresu z dowolnego miejsca, nawet gdy klawiaturę ma strona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ переводит Вас в строку адреса откуда угодно, даже когда клавиатура занята страницей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ переносить вас у смугу адреси звідки завгодно, навіть коли клавіатура належить сторінці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可让你在任何位置进入地址栏，即使网页正在占用键盘。"
          }
        }
      }
    },
    "emptyPage.hintCommandBar": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet die Befehlsleiste: Tabs, Ordner, Räume und Befehle in einer einzigen Suche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens the command bar: tabs, folders, spaces and commands, all in one search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre la barra de comandos: pestañas, carpetas, secciones y comandos, todo en una sola búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre la barre de commandes : onglets, dossiers, sections et commandes, dans une seule recherche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すとコマンドバーが開きます。タブ、フォルダ、スペース、コマンドを、1つの検索でまとめて探せます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera pasek poleceń: karty, foldery, strefy i polecenia, wszystko w jednym wyszukiwaniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открывает панель команд: вкладки, папки, разделы и команды в одном поиске."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відкриває панель команд: вкладки, папки, розділи й команди в одному пошуку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会打开命令栏：标签页、文件夹、分区和命令，一次搜索全部搞定。"
          }
        }
      }
    },
    "emptyPage.hintSidebar": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende die Seitenleiste mit %@ aus. Bewege den Zeiger an den linken Fensterrand, um einen Blick darauf zu werfen, ohne sie wieder festzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the sidebar with %@. Rest the pointer on the window's left edge to peek at it without pinning it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la barra lateral con %@. Deja el puntero en el borde izquierdo de la ventana para echarle un vistazo sin volver a anclarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez la barre latérale avec %@. Placez le pointeur sur le bord gauche de la fenêtre pour la consulter sans la fixer de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でサイドバーを非表示にします。ウインドウの左端にポインタを合わせると、固定し直さずにサイドバーをのぞけます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj pasek boczny za pomocą %@. Zatrzymaj wskaźnik na lewej krawędzi okna, aby go zobaczyć bez ponownego przypinania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скройте боковое меню с помощью %@. Задержите указатель у левого края окна, чтобы заглянуть в него, не закрепляя обратно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховайте бічну панель за допомогою %@. Наведіть вказівник на лівий край вікна, щоб зазирнути в неї, не закріплюючи її знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 隐藏边栏。将指针停在窗口左边缘，即可在不重新固定的情况下查看它。"
          }
        }
      }
    },
    "emptyPage.hintReopen": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Tab geschlossen, den du noch brauchst? %@ holt ihn zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed a tab you still needed? %@ brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has cerrado una pestaña que aún necesitabas? %@ la recupera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez fermé un onglet dont vous aviez encore besoin ? %@ le rouvre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ必要なタブを閉じてしまいましたか？%@で元に戻せます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta zamknięta przez pomyłkę? %@ ją przywraca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыли вкладку, которая еще была нужна? %@ возвращает ее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрили вкладку, яка ще була потрібна? %@ повертає її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭了仍然需要的标签页？%@ 可将其找回。"
          }
        }
      }
    },
    "emptyPage.hintSpaces": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume halten Projekte getrennt. Scrolle seitlich über die Seitenleiste, um zwischen ihnen zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces keep projects apart. Scroll sideways over the sidebar to move between them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las secciones mantienen separados los proyectos. Desplázate hacia los lados sobre la barra lateral para moverte entre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sections séparent vos projets. Faites défiler latéralement sur la barre latérale pour passer de l’une à l’autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを使うと、プロジェクトを分けて管理できます。サイドバー上で横にスクロールすると、スペース間を移動できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strefy oddzielają projekty. Przewiń w bok nad paskiem bocznym, aby przechodzić między nimi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделы разделяют проекты. Прокрутите боковое меню в сторону, чтобы перейти между ними."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розділи тримають проєкти окремо. Прокручуйте вбік над бічною панеллю, щоб переходити між ними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分区可将项目分开。在边栏上横向滚动即可在它们之间移动。"
          }
        }
      }
    },
    "emptyPage.hintPinned": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixierte Tabs bleiben zwischen den Starts in der Seitenleiste. Ziehe einen beliebigen Tab in die Liste der fixierten, um ihn zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned tabs stay in the sidebar between launches. Drag any tab into the pinned list to keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas ancladas permanecen en la barra lateral entre sesiones. Arrastra cualquier pestaña a la lista de ancladas para conservarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets épinglés restent dans la barre latérale d’un lancement à l’autre. Faites glisser n’importe quel onglet dans la liste des onglets épinglés pour le conserver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定タブは、起動後もサイドバーに残ります。タブを固定リストにドラッグすると保持できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypięte karty zostają na pasku bocznym między uruchomieniami. Przeciągnij dowolną kartę na listę przypiętych, aby ją zachować."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепленные вкладки остаются в боковом меню между запусками. Перетащите любую вкладку в список закрепленных, чтобы сохранить ее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріплені вкладки лишаються в бічній панелі між запусками. Перетягніть будь-яку вкладку в список закріплених, щоб зберегти її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定的标签页会在多次启动之间保留在边栏中。将任意标签页拖到固定列表中即可保留它。"
          }
        }
      }
    },
    "emptyPage.hintFolder": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erstellt einen Ordner im aktuellen Raum. Lege Tabs darauf ab, um sie zu gruppieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ makes a folder in the current space. Drop tabs onto it to group them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ crea una carpeta en la sección actual. Suelta pestañas en ella para agruparlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ crée un dossier dans la section actuelle. Déposez-y des onglets pour les regrouper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、現在のスペースにフォルダを作成します。タブをドロップするとグループ化されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tworzy folder w bieżącej strefie. Upuść na niego karty, aby je zgrupować."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ создает папку в текущем разделе. Перетащите на нее вкладки, чтобы сгруппировать их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ створює папку в поточному розділі. Перетягніть на неї вкладки, щоб згрупувати їх."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会在当前分区中创建文件夹。将标签页拖到其上即可分组。"
          }
        }
      }
    },
    "emptyPage.hintRename": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke in der Seitenleiste auf einen Tab, um ihn umzubenennen. Dein Name bleibt auch dann, wenn die Seite ihren Titel ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click a tab in the sidebar to rename it. Your name stays even when the page changes its title."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en una pestaña de la barra lateral para renombrarla. Tu nombre se mantiene aunque la página cambie su título."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur un onglet dans la barre latérale pour le renommer. Votre nom reste même quand la page change de titre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーでタブをダブルクリックすると、名前を変更できます。ページがタイトルを変更しても、付けた名前は維持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij dwukrotnie kartę na pasku bocznym, aby zmienić jej nazwę. Twoja nazwa zostaje, nawet gdy strona zmieni tytuł."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды нажмите вкладку в боковом меню, чтобы переименовать ее. Ваше название сохраняется, даже если страница меняет свой заголовок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі клацніть вкладку в бічній панелі, щоб перейменувати її. Ваша назва лишається, навіть коли сторінка змінює заголовок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击边栏中的标签页即可重新命名。即使页面更改了标题，你的名称也会保留。"
          }
        }
      }
    },
    "emptyPage.hintSpaceDrop": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen gezogenen Tab einen Moment über das Symbol eines Raums, um zu diesem Raum zu wechseln, bevor du ihn ablegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a dragged tab over a space's icon for a moment to switch to that space before you drop it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén una pestaña arrastrada sobre el icono de una sección un momento para cambiar a esa sección antes de soltarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez un onglet glissé au-dessus de l’icône d’une section un instant pour passer à cette section avant de le déposer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中のタブをスペースのアイコン上でしばらく保持すると、ドロップする前にそのスペースに切り替わります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj przeciągniętą kartę przez chwilę nad ikoną strefy, aby przełączyć się na tę strefę, zanim ją upuścisz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержите перетаскиваемую вкладку над значком раздела на мгновение, чтобы перейти в этот раздел до того, как Вы отпустите вкладку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потримайте перетягнуту вкладку над іконкою розділу, щоб перейти до цього розділу, перш ніж відпустити її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将拖移的标签页在分区图标上停留片刻，即可在放下之前切换到该分区。"
          }
        }
      }
    },
    "emptyPage.hintArrows": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Seite und drücke dann ← und →, um diese Tipps durchzugehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the page, then press ← and → to step through these tips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la página y pulsa ← y → para recorrer estos consejos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur la page, puis appuyez sur ← et → pour parcourir ces astuces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページをクリックしてから←と→を押すと、これらのヒントを順番に見られます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij stronę, a potem naciśnij ← i →, aby przeglądać te wskazówki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на страницу, затем используйте ← и →, чтобы листать эти советы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть сторінку, а потім натискайте ← і →, щоб гортати ці поради."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按页面，然后按 ← 和 → 即可逐条查看这些提示。"
          }
        }
      }
    },
    "emptyPage.hintLittleArx": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet Little Arx, ein kleines Fenster für einen kurzen Blick, das deine Räume in Ruhe lässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens Little Arx, a small window for a quick look that leaves your spaces alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre Little Arx, una ventana pequeña para echar un vistazo rápido que no toca tus secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre Little Arx, une petite fenêtre pour un coup d’œil rapide qui laisse vos sections tranquilles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、スペースに影響しない簡易表示用の小さなウインドウ、Little Arxが開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera Little Arx, małe okno do szybkiego zerknięcia, które nie rusza Twoich stref."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открывает Little Arx — небольшое окно для быстрого просмотра, не затрагивающее Ваши разделы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відкриває Little Arx — невелике вікно для швидкого перегляду, що не чіпає ваші розділи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会打开 Little Arx，这是一个小窗口，适合快速查看，不会打扰你的分区。"
          }
        }
      }
    },
    "emptyPage.hintPeek": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke bei gedrückter Umschalttaste auf einen Link, um ihn in Peek zu lesen, einer Karte über der Seite. Mit Esc schickst du ihn zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-click a link to read it in Peek, a card over the page. Esc sends it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con Mayúsculas pulsado en un enlace para leerlo en Peek, una tarjeta sobre la página. Esc lo devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un lien en maintenant Maj enfoncée pour le lire dans Peek, une carte au-dessus de la page. Échap la renvoie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftキーを押しながらリンクをクリックすると、ページの上のカード、Peekで読めます。Escキーで元に戻ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij łącze z klawiszem Shift, aby przeczytać je w Peek, karcie nad stroną. Esc odsyła ją z powrotem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ссылку, удерживая Shift, чтобы прочитать ее в Peek — карточке поверх страницы. Клавиша Esc возвращает ее обратно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть посилання із Shift, щоб прочитати його в Peek — картці поверх сторінки. Esc повертає назад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 键点按链接，即可在 Peek（页面上的一张卡片）中阅读。按 Esc 键可将其送回。"
          }
        }
      }
    },
    "emptyPage.hintSplitDrop": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege einen Tab in der Seitenleiste auf einem anderen Tab ab, um beide nebeneinander zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a tab onto another tab in the sidebar to see the two side by side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta una pestaña sobre otra pestaña de la barra lateral para ver las dos una al lado de otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un onglet sur un autre onglet dans la barre latérale pour voir les deux côte à côte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブをサイドバーのほかのタブにドロップすると、2つを並べて表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuść kartę na inną kartę na pasku bocznym, aby zobaczyć obie obok siebie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите вкладку на другую вкладку в боковом меню, чтобы увидеть их рядом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть вкладку на іншу вкладку в бічній панелі, щоб побачити їх поруч."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标签页拖到边栏中的另一个标签页上，即可并排查看两者。"
          }
        }
      }
    },
    "emptyPage.hintLibrary": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet die Bibliothek in der Seitenleiste: Medien, Downloads, Verlauf, Räume und das Tab-Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens the Library in the sidebar: Media, Downloads, History, Spaces and the Tab Archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre la biblioteca en la barra lateral: Multimedia, Descargas, Historial, Secciones y Pestañas archivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre la bibliothèque dans la barre latérale : médias, téléchargements, historique, sections et onglets archivés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、サイドバーでライブラリを開きます。メディア、ダウンロード、履歴、スペース、タブアーカイブがあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera Bibliotekę na pasku bocznym: Multimedia, Pobrane, Historię, Strefy i Archiwum kart."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открывает Библиотеку в боковом меню: «Медиа», «Загрузки», «История», «Разделы» и «Архив вкладок»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відкриває бібліотеку в бічній панелі: медіа, викачування, історію, розділи й архів вкладок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会在边栏中打开资源库：媒体、下载、历史记录、分区和标签页归档。"
          }
        }
      }
    },
    "emptyPage.hintSpaceKeys": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bis %2$@ wechseln zu deinen Räumen, in der Reihenfolge der Umschaltleiste unten in der Seitenleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to %2$@ switch to your spaces, in the order of the switcher at the bottom of the sidebar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a %2$@ cambian a tus secciones, en el orden del selector de la parte inferior de la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ à %2$@ passent à vos sections, dans l’ordre du sélecteur en bas de la barre latérale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から%2$@で、サイドバー下部の切り替えバーの順にスペースへ切り替えます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ do %2$@ przełączają na Twoje strefy, w kolejności przełącznika na dole paska bocznego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@ переключают на Ваши разделы в порядке переключателя в нижней части бокового меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@ переходять до ваших розділів у порядку перемикача внизу бічної панелі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 到 %2$@ 可切换到你的分区，顺序与边栏底部切换器中的顺序一致。"
          }
        }
      }
    },
    "emptyPage.hintCopyURL": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kopiert die Adresse der Seite. Ein kleiner Hinweis oben rechts zeigt, was in der Zwischenablage ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copies the page's address. A small note at the top right says what's on the clipboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copia la dirección de la página. Una pequeña nota arriba a la derecha indica qué hay en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copie l’adresse de la page. Une petite note en haut à droite indique ce qui se trouve dans le presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、ページのアドレスをコピーします。右上の小さな通知に、クリップボードの内容が表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kopiuje adres strony. Mała notatka u góry po prawej mówi, co jest w schowku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ копирует адрес страницы. Небольшая заметка вверху справа сообщает, что находится в буфере обмена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ копіює адресу сторінки. Невелика примітка вгорі праворуч показує, що в буфері обміну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会拷贝页面的地址。右上角的小提示会告诉你剪贴板里有什么。"
          }
        }
      }
    },
    "emptyPage.hintChat": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine Frage in die Befehlsleiste und drücke den Tabulator, um den Assistenten in einem Bereich neben der Seite zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a question in the command bar and press Tab to ask the assistant in a panel beside the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una pregunta en la barra de comandos y pulsa Tab para preguntar al asistente en un panel junto a la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une question dans la barre de commandes et appuyez sur Tab pour la poser à l’assistant dans un volet à côté de la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドバーに質問を入力してTabキーを押すと、ページの横のパネルでアシスタントに質問できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz pytanie na pasku poleceń i naciśnij Tab, aby zapytać asystenta w panelu obok strony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите вопрос в панели команд и нажмите Tab, чтобы спросить ассистента на панели рядом со страницей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть запитання в панелі команд і натисніть Tab, щоб запитати асистента в панелі поруч зі сторінкою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令栏中输入问题并按下 Tab 键，即可在页面旁的面板中向助理提问。"
          }
        }
      }
    },
    "emptyPage.hintPagePiP": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lässt die ganze Seite in einem kleinen Fenster schweben, das im Vordergrund bleibt, auch ein Video, das Bild-in-Bild verweigert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ floats the whole page in a small window that stays on top, even a video that refuses Picture in Picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lleva toda la página a una ventana pequeña que se queda encima, incluso un vídeo que no admite imagen dentro de imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ affiche toute la page dans une petite fenêtre qui reste au premier plan, même une vidéo qui refuse l’Image dans l’image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、ページ全体が前面に残る小さなウインドウで表示されます。ピクチャ・イン・ピクチャに対応していないビデオも表示できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unosi całą stronę w małym oknie, które zostaje na wierzchu, nawet wideo, które odmawia trybu Obraz w obrazie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выводит всю страницу в небольшом окне поверх остальных, даже видео, которое не поддерживает режим «Картинка в картинке»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ виводить усю сторінку в невелике вікно, що лишається поверх інших, навіть відео, яке не підтримує режим «Кадр у кадрі»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会将整个页面浮动在始终位于最前的小窗口中，即使是不支持画中画的视频也可以。"
          }
        }
      }
    },
    "emptyPage.hintHoverPreview": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege den Zeiger auf einen Tab, um seine Seite zu sehen, ohne zu ihm zu wechseln. Unter Einstellungen › Allgemein kannst du das ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest the pointer on a tab to see its page without switching to it. Turn this off in Settings › General."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el puntero sobre una pestaña para ver su página sin cambiar a ella. Puedes desactivarlo en Ajustes › General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le pointeur sur un onglet pour voir sa page sans y passer. Désactivez cette option dans Réglages › Général."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブにポインタを合わせると、切り替えずにそのページを確認できます。「設定」＞「一般」でオフにできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj wskaźnik na karcie, aby zobaczyć jej stronę bez przełączania się na nią. Wyłączysz to w Ustawieniach › Ogólne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержите указатель на вкладке, чтобы увидеть ее страницу, не переключаясь на нее. Это можно выключить в «Настройки › Основные»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть вказівник на вкладку, щоб побачити її сторінку без переходу на неї. Вимкнути це можна в «Параметри › Загальні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针停在标签页上，即可在不切换的情况下查看其页面。可在“设置”>“通用”中关闭。"
          }
        }
      }
    },
    "emptyPage.hintPrivate": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet ein privates Fenster. Es behält keinen Verlauf, und seine Cookies verschwinden, wenn du es schließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens a private window. It keeps no history, and its cookies go when you close it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre una ventana privada. No guarda historial y sus cookies desaparecen al cerrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre une fenêtre privée. Elle ne conserve aucun historique et ses cookies disparaissent à sa fermeture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、プライベートウインドウが開きます。履歴は残らず、Cookieはウインドウを閉じると消えます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera okno prywatne. Nie zachowuje historii, a jego pliki cookie znikają po zamknięciu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открывает частное окно. В нем не сохраняется история, а файлы cookie удаляются при его закрытии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відкриває приватне вікно. Воно не зберігає історію, а його файли cookie зникають після закриття."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会打开无痕浏览窗口。它不会保留历史记录，关闭后其 Cookie 也会消失。"
          }
        }
      }
    },
    "emptyPage.hintBlocking": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx blockiert Werbung und Tracker mit dem integrierten uBlock Origin. Wenn eine Website nicht funktioniert, schalte das Blockieren für sie im Website-Menü aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx blocks ads and trackers with uBlock Origin, built in. If a site breaks, turn blocking off for it in the site menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx bloquea anuncios y rastreadores con uBlock Origin, integrado. Si un sitio falla, desactiva el bloqueo para él en el menú del sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx bloque les publicités et les traqueurs avec uBlock Origin, intégré. Si un site ne fonctionne plus, désactivez le blocage pour lui dans le menu du site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxには、uBlock Originによる広告とトラッカーのブロック機能が内蔵されています。サイトが正しく表示されない場合は、サイトメニューでそのサイトのブロックをオフにします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx blokuje reklamy i skrypty śledzące za pomocą wbudowanego uBlock Origin. Jeśli witryna przestaje działać, wyłącz dla niej blokowanie w menu witryny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx блокирует рекламу и трекеры с помощью встроенного uBlock Origin. Если сайт работает неправильно, выключите блокировку для него в меню сайта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx блокує рекламу й трекери за допомогою вбудованого uBlock Origin. Якщо сайт ламається, вимкніть блокування для нього в меню сайту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 内置 uBlock Origin，可拦截广告和追踪器。如果某个网站出现问题，可在网站菜单中为它关闭拦截。"
          }
        }
      }
    },
    "emptyPage.hintNextTab": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und %2$@ wechseln zum nächsten und zum vorherigen Tab in der Seitenleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and %2$@ move to the next and previous tab in the sidebar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ y %2$@ pasan a la pestaña siguiente y a la anterior de la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ et %2$@ passent à l’onglet suivant et à l’onglet précédent dans la barre latérale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@と%2$@で、サイドバーの次のタブと前のタブに移動します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ i %2$@ przechodzą do następnej i poprzedniej karty na pasku bocznym."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и %2$@ переходят к следующей и предыдущей вкладке в боковом меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ і %2$@ переходять до наступної й попередньої вкладки в бічній панелі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 和 %2$@ 可移到边栏中的下一个和上一个标签页。"
          }
        }
      }
    },
    "emptyPage.hintCalculator": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine Rechnung wie 12*7.5 in die Befehlsleiste. Die Antwort steht zuerst, und der Zeilenschalter kopiert sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a sum such as 12*7.5 in the command bar. The answer comes first, and Return copies it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una operación como 12*7.5 en la barra de comandos. La respuesta aparece primero y Retorno la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un calcul tel que 12*7.5 dans la barre de commandes. La réponse s’affiche en premier, et Retour la copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドバーに12*7.5のような計算式を入力すると、答えが最初に表示され、Returnキーで答えをコピーできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz działanie, takie jak 12*7.5, na pasku poleceń. Odpowiedź jest pierwsza, a Return ją kopiuje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите выражение вроде 12*7.5 в панели команд. Ответ показывается первым, а Return копирует его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть вираз на кшталт 12*7.5 у панелі команд. Відповідь стоїть першою, а Return копіює її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令栏中输入算式，例如 12*7.5。答案会显示在最前面，按下 Return 键即可拷贝。"
          }
        }
      }
    },
    "emptyPage.hintCaptureArea": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Bereich aufnehmen …“ im Menü „Ablage“ klickst du auf einen Block der Seite oder ziehst darüber, um nur diesen Teil aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Area…, in the File menu, lets you click a block of the page or drag across it to capture just that part."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar área…, en el menú Archivo, te permite hacer clic en un bloque de la página o arrastrar sobre ella para capturar solo esa parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer une zone…, dans le menu Fichier, vous permet de cliquer sur un bloc de la page ou de le faire glisser pour capturer uniquement cette partie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」メニューの「領域をキャプチャ…」では、ページのブロックをクリックするか、ドラッグして囲み、その部分だけをキャプチャできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób zrzut obszaru…, w menu Plik, pozwala kliknąć blok strony lub przeciągnąć przez niego, aby zrobić zrzut tylko tej części."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Снимок области…» в меню «Файл» позволяет нажать на блок страницы или протянуть по ней, чтобы сделать снимок только этой части."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Зняти область…» у меню «Файл» дає змогу клацнути блок сторінки або перетягнути вказівник по ній, щоб зняти лише цю частину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“文件”菜单中的“截取区域…”可让你点按页面的某个区块，或在其上拖移，只截取那一部分。"
          }
        }
      }
    },
    "emptyPage.hintProfiles": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Profil hat seine eigenen Cookies, seinen eigenen Verlauf, eigene Passwörter und Erweiterungen, und jeder Raum gehört zu einem Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each profile keeps its own cookies, history, passwords and extensions, and every space belongs to one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil guarda sus propias cookies, historial, contraseñas y extensiones, y cada sección pertenece a uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil conserve ses propres cookies, son historique, ses mots de passe et ses extensions, et chaque section appartient à un profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルごとに、Cookie、履歴、パスワード、機能拡張が別々に保持され、すべてのスペースはいずれかのプロファイルに属します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy profil ma własne pliki cookie, historię, hasła i rozszerzenia, a każda strefa należy do jednego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого профиля свои файлы cookie, история, пароли и расширения, и каждый раздел принадлежит одному из них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен профіль зберігає власні файли cookie, історію, паролі й розширення, і кожен розділ належить одному з них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个用户场景都有各自的 Cookie、历史记录、密码和扩展，每个分区都属于某一个用户场景。"
          }
        }
      }
    },
    "emptyPage.hintReadingMode": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zeigt den Artikel der Seite allein an, in einem Design, einer Textgröße und einer Breite deiner Wahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ shows the page's article on its own, in a theme, text size and width you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muestra solo el artículo de la página, con el tema, el tamaño de texto y el ancho que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ affiche seul l’article de la page, dans le thème, la taille de texte et la largeur que vous choisissez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、ページの記事だけを、選んだテーマ、文字サイズ、幅で表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pokazuje samodzielnie artykuł ze strony, w motywie, rozmiarze tekstu i szerokości, które wybierzesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ показывает статью со страницы отдельно, с выбранными Вами темой, размером текста и шириной."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ показує лише статтю сторінки в обраній вами темі, розмірі тексту й ширині."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会单独显示页面中的文章，主题、文字大小和宽度均可自行选择。"
          }
        }
      }
    },
    "emptyPage.hintFavorites": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe einen Tab nach oben in das Raster oben in der Seitenleiste, um ihn zu einem Favoriten zu machen. Favoriten erscheinen in jedem Raum des Profils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a tab up into the grid at the top of the sidebar to make it a Favorite. Favorites show in every space of the profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una pestaña hacia la cuadrícula de la parte superior de la barra lateral para convertirla en favorito. Los favoritos aparecen en todas las secciones del perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un onglet vers la grille en haut de la barre latérale pour en faire un favori. Les favoris apparaissent dans toutes les sections du profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブをサイドバー上部のグリッドにドラッグすると、お気に入りになります。お気に入りは、プロファイルのすべてのスペースに表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij kartę w górę do siatki u góry paska bocznego, aby zrobić z niej ulubioną. Ulubione są widoczne w każdej strefie profilu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите вкладку вверх в сетку в верхней части бокового меню, чтобы сделать ее избранной. Избранные вкладки показываются во всех разделах профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть вкладку вгору в сітку на початку бічної панелі, щоб зробити її улюбленою. Улюблені показуються в кожному розділі профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标签页向上拖到边栏顶部的网格中，即可将其设为个人收藏。个人收藏会显示在该用户场景的每个分区中。"
          }
        }
      }
    },
    "emptyPage.hintSplitAdd": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fügt dem Fenster einen Bereich hinzu und fragt, welche Seite hineinkommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adds a pane to the window and asks which page goes in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ añade un panel a la ventana y pregunta qué página va en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajoute un volet à la fenêtre et demande quelle page y placer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、ウインドウにペインを追加し、表示するページを確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dodaje panel do okna i pyta, jaka strona ma w nim być."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ добавляет в окно панель и спрашивает, какая страница в ней откроется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ додає область до вікна й питає, яка сторінка буде в ній."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会为窗口添加一个窗格，并询问要放入哪个页面。"
          }
        }
      }
    },
    "emptyPage.hintRouting": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Control unter Einstellungen › Links legt den Raum und das Fenster fest, in dem ein Link aus einer anderen App geöffnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Control, in Settings › Links, chooses the space and window a link from another app opens in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Control, en Ajustes › Enlaces, elige la sección y la ventana en las que se abre un enlace de otra app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Control, dans Réglages › Liens, choisit la section et la fenêtre dans lesquelles s’ouvre un lien provenant d’une autre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」＞「リンク」のAir Traffic Controlでは、ほかのAppからのリンクを開くスペースとウインドウを選べます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Control, w Ustawieniach › Łącza, wybiera strefę i okno, w których otwiera się łącze z innej aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Control в «Настройки › Ссылки» выбирает раздел и окно, в которых открывается ссылка из другого приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Control у «Параметри › Посилання» вибирає розділ і вікно, де відкривається посилання з іншої програми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”>“链接”中的 Air Traffic Control 可选择来自其他 App 的链接在哪个分区和窗口中打开。"
          }
        }
      }
    },
    "emptyPage.hintAssistants": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenten wie Claude Code können Arx über seinen lokalen MCP-Server verwenden. Aktiviere ihn unter Einstellungen › Erweitert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistants such as Claude Code can use Arx through its local MCP server. Turn it on in Settings › Advanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistentes como Claude Code pueden usar Arx a través de su servidor MCP local. Actívalo en Ajustes › Avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des assistants tels que Claude Code peuvent utiliser Arx via son serveur MCP local. Activez-le dans Réglages › Avancés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Codeなどのアシスタントは、ローカルのMCPサーバ経由でArxを使用できます。「設定」＞「詳細」でオンにします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystenci tacy jak Claude Code mogą używać Arx przez jego lokalny serwer MCP. Włącz go w Ustawieniach › Zaawansowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистенты вроде Claude Code могут использовать Arx через его локальный сервер MCP. Включите его в «Настройки › Дополнения»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистенти на кшталт Claude Code можуть користуватися Arx через його локальний сервер MCP. Увімкніть його в «Параметри › Експертні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 等助理可以通过本地 MCP 服务器使用 Arx。请在“设置”>“高级”中打开。"
          }
        }
      }
    },
    "emptyPage.hintSettings": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet die Einstellungen. Tippe in die Suche dort, um jede Einstellung nach Namen zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens Settings. Type in its search to find any setting by name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre Ajustes. Escribe en su búsqueda para encontrar cualquier ajuste por nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre les Réglages. Saisissez dans leur recherche pour trouver n’importe quel réglage par son nom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、「設定」が開きます。検索欄に入力すると、名前から設定を探せます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera Ustawienia. Wpisz tekst w ich wyszukiwaniu, aby znaleźć dowolne ustawienie po nazwie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открывает настройки. Введите запрос в их поиск, чтобы найти любую настройку по названию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відкриває параметри. Введіть текст у їхньому пошуку, щоб знайти будь-який параметр за назвою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会打开“设置”。在其搜索栏中输入，即可按名称找到任何设置。"
          }
        }
      }
    },
    "emptyPage.hintFind": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sucht Text auf der Seite, und %2$@ springt zum nächsten Treffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ finds text on the page, and %2$@ goes to the next match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ busca texto en la página y %2$@ va a la siguiente coincidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recherche du texte dans la page, et %2$@ passe à l’occurrence suivante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でページ内のテキストを検索し、%2$@で次の一致箇所に移動します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ znajduje tekst na stronie, a %2$@ przechodzi do następnego dopasowania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ищет текст на странице, а %2$@ переходит к следующему совпадению."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ шукає текст на сторінці, а %2$@ переходить до наступного збігу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可在页面上查找文本，%2$@ 可前往下一个匹配项。"
          }
        }
      }
    },
    "emptyPage.hintNewSpace": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche in der Seitenleiste über deinen letzten Raum hinaus, um einen neuen zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe past your last space in the sidebar to make a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza más allá de tu última sección en la barra lateral para crear una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez au-delà de votre dernière section dans la barre latérale pour en créer une nouvelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーで最後のスペースを越えてスワイプすると、新しいスペースを作成できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń palcem poza ostatnią strefę na pasku bocznym, aby utworzyć nową."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по боковому меню за последний раздел, чтобы создать новый."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть за межі останнього розділу в бічній панелі, щоб створити новий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在边栏中滑过最后一个分区，即可创建新分区。"
          }
        }
      }
    },
    "emptyPage.hintFocusedLink": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet den Link, zu dem du mit dem Tabulator gewechselt bist, in Peek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens the link you moved to with Tab in Peek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre en Peek el enlace al que te has movido con Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre dans Peek le lien auquel vous vous êtes déplacé avec Tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、Tabキーで移動したリンクをPeekで開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera w Peek łącze wybrane klawiszem Tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открывает в Peek ссылку, на которую Вы перешли клавишей Tab."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відкриває в Peek посилання, до якого ви перейшли клавішею Tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会在 Peek 中打开你用 Tab 键移到的链接。"
          }
        }
      }
    },
    "emptyPage.hintCleanLink": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bereinigten Link kopieren“ kopiert die Adresse ohne Tracking-Tags wie utm_source."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Clean Link copies the address without tracking tags such as utm_source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar enlace limpio copia la dirección sin etiquetas de seguimiento como utm_source."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Copier le lien propre » copie l’adresse sans balises de suivi telles que utm_source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「クリーンリンクをコピー」は、utm_sourceなどのトラッキングタグを除いたアドレスをコピーします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuj czyste łącze kopiuje adres bez znaczników śledzących, takich jak utm_source."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скопировать чистую ссылку» копирует адрес без меток отслеживания вроде utm_source."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скопіювати чисте посилання» копіює адресу без міток відстеження на кшталт utm_source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“拷贝纯净链接”会拷贝不含 utm_source 等追踪标记的地址。"
          }
        }
      }
    },
    "emptyPage.hintAutoPictureInPicture": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zu einer anderen App, während ein Video läuft, und es schwebt in Bild-in-Bild. Unter Einstellungen › Allgemein lässt sich das ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to another app while a video plays and it floats into Picture in Picture. Settings › General can turn this off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a otra app mientras se reproduce un vídeo y pasará a imagen dentro de imagen. Puedes desactivarlo en Ajustes › General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à une autre app pendant la lecture d’une vidéo et elle passe en Image dans l’image. Réglages › Général permet de le désactiver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオの再生中にほかのAppに切り替えると、ビデオがピクチャ・イン・ピクチャで表示されます。「設定」＞「一般」でオフにできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącz się na inną aplikację, gdy odtwarzane jest wideo, a unosi się ono w trybie Obraz w obrazie. Ustawienia › Ogólne mogą to wyłączyć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в другое приложение во время воспроизведения видео, и оно переключится в режим «Картинка в картинке». Это можно выключить в «Настройки › Основные»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдіть в іншу програму, поки грає відео, і воно перейде в режим «Кадр у кадрі». Вимкнути це можна в «Параметри › Загальні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频播放时切换到其他 App，视频会浮动为画中画。可在“设置”>“通用”中关闭。"
          }
        }
      }
    },
    "emptyPage.hintBangs": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne eine Suche mit ! und einem Stichwort, um eine Website zu durchsuchen, zum Beispiel !w swift für Wikipedia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a search with ! and a keyword to search one site, such as !w swift for Wikipedia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza una búsqueda con ! y una palabra clave para buscar en un sitio, como !w swift para Wikipedia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez une recherche par ! et un mot-clé pour interroger un seul site, par exemple !w swift pour Wikipédia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索を!とキーワードで始めると、1つのサイトを検索できます。たとえば、Wikipediaなら!w swiftと入力します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij wyszukiwanie od ! i słowa kluczowego, aby przeszukać jedną witrynę, na przykład !w swift dla Wikipedii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните поиск с ! и ключевого слова, чтобы искать на одном сайте, например !w swift для Википедии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть пошук зі знака ! і ключового слова, щоб шукати на одному сайті, наприклад !w swift для Вікіпедії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 ! 和关键词开头进行搜索，即可搜索某个网站，例如用 !w swift 搜索维基百科。"
          }
        }
      }
    },
    "emptyPage.hintCloseResets": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen fixierten Tab oder einen Favoriten mit %@ schließt, wird er auf seine gesicherte Seite zurückgesetzt, statt entfernt zu werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing a pinned tab or a Favorite with %@ resets it to its saved page instead of removing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar una pestaña anclada o un favorito con %@ lo restablece a su página guardada en lugar de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer un onglet épinglé ou un favori avec %@ le réinitialise à sa page enregistrée au lieu de le supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定タブやお気に入りを%@で閉じると、削除されずに、保存したページにリセットされます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie przypiętej karty lub ulubionej za pomocą %@ resetuje ją do zachowanej strony zamiast ją usuwać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие закрепленной или избранной вкладки с помощью %@ возвращает ее на сохраненную страницу вместо удаления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриття закріпленої вкладки або улюбленої за допомогою %@ повертає її до збереженої сторінки, а не вилучає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 关闭已固定的标签页或个人收藏时，会将其重置为已存储的页面，而不是将其移除。"
          }
        }
      }
    },
    "emptyPage.hintHideElement": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blendet ein Banner oder ein Feld auf einer Website dauerhaft aus: Klicke darauf und wähle dann „Erstellen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hides a banner or a box on a site for good: click it, then choose Create."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oculta para siempre un banner o un recuadro de un sitio: haz clic en él y elige Crear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ masque définitivement une bannière ou un encadré sur un site : cliquez dessus, puis choisissez Créer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、サイト上のバナーやボックスを常に非表示にできます。クリックしてから「作成」を選びます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ukrywa baner lub ramkę w witrynie na stałe: kliknij go, a potem wybierz Utwórz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ навсегда скрывает баннер или блок на сайте: нажмите на него, затем выберите «Создать»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ назавжди ховає банер чи блок на сайті: клацніть його, а потім виберіть «Створити»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可永久隐藏网站上的横幅或方框：点按它，然后选择“创建”。"
          }
        }
      }
    },
    "emptyPage.hintSpaceIcon": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf einen Raum und wähle „Raumsymbol ändern …“, um ihm ein beliebiges Symbol oder Emoji zu geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a space and choose Change Space Icon… to give it any symbol or emoji."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con el botón derecho en una sección y elige Cambiar icono de la sección… para darle cualquier símbolo o emoji."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur une section et choisissez « Changer l’icône de la section… » pour lui donner n’importe quel symbole ou emoji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを右クリックして「スペースのアイコンを変更…」を選ぶと、好きなシンボルや絵文字を設定できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij strefę prawym przyciskiem i wybierz Zmień ikonę strefy…, aby nadać jej dowolny symbol lub emoji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите раздел правой кнопкой и выберите «Изменить значок раздела…», чтобы задать ему любой символ или эмодзи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть розділ правою кнопкою й виберіть «Змінити іконку розділу…», щоб задати йому будь-який символ чи емодзі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按分区并选取“更改分区图标…”，即可为其设置任意符号或表情符号。"
          }
        }
      }
    },
    "emptyPage.hintFocusPane": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verschiebt den Fokus auf den anderen Bereich eines Splits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ moves the focus to the other pane of a split."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lleva el foco al otro panel de una división."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ déplace le focus vers l’autre volet d’une vue partagée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、分割したもう一方のペインにフォーカスが移ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ przenosi fokus do drugiego panelu podziału."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ переводит фокус на другую панель в Split View."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ переносить фокус на іншу область поділу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可将焦点移到分屏的另一个窗格。"
          }
        }
      }
    },
    "emptyPage.hintWebKit": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ und anderes geschütztes Video werden wie in Safari in WebKit-Seiten wiedergegeben. Die Liste steht unter Einstellungen › Erweitert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ and other protected video play in WebKit pages, as in Safari. The list is in Settings › Advanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ y otros vídeos protegidos se reproducen en páginas de WebKit, como en Safari. La lista está en Ajustes › Avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ et d’autres vidéos protégées se lisent dans des pages WebKit, comme dans Safari. La liste se trouve dans Réglages › Avancés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix、Disney+などの保護されたビデオは、Safariと同じようにWebKitのページで再生されます。一覧は「設定」＞「詳細」にあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ i inne chronione wideo odtwarzają się na stronach WebKit, jak w Safari. Lista jest w Ustawieniach › Zaawansowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ и другое защищенное видео воспроизводятся на страницах WebKit, как в Safari. Список находится в «Настройки › Дополнения»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ та інше захищене відео відтворюються на сторінках WebKit, як у Safari. Список є в «Параметри › Експертні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix、Disney+ 和其他受保护的视频会像在 Safari 中一样，在 WebKit 页面中播放。列表位于“设置”>“高级”。"
          }
        }
      }
    },
    "emptyPage.hintChatPin": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Chat an diesen Tab fixieren“ behält einen Chat bei einem Tab. Andere Tabs zeigen den eigenen Chat des Fensters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin Chat to This Tab keeps a chat with one tab. Other tabs show the window's own chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anclar chat a esta pestaña mantiene un chat con una sola pestaña. Las demás pestañas muestran el chat propio de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Épingler la discussion à cet onglet » associe une discussion à un seul onglet. Les autres onglets affichent la discussion de la fenêtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「チャットをこのタブに固定」を選ぶと、チャットが1つのタブに保持されます。ほかのタブには、ウインドウ自体のチャットが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypnij czat do tej karty zachowuje czat z jedną kartą. Inne karty pokazują własny czat okna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Закрепить чат за этой вкладкой» оставляет чат с одной вкладкой. Другие вкладки показывают чат самого окна."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Закріпити чат за цією вкладкою» зберігає чат для однієї вкладки. Інші вкладки показують власний чат вікна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“将聊天固定到此标签页”会让聊天只与一个标签页相关联。其他标签页显示该窗口自己的聊天。"
          }
        }
      }
    },
    "emptyPage.hintFirstLastTab": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ springt zum ersten Tab in der Seitenleiste und %2$@ zum letzten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jumps to the first tab in the sidebar, and %2$@ to the last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ salta a la primera pestaña de la barra lateral y %2$@ a la última."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passe au premier onglet de la barre latérale, et %2$@ au dernier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でサイドバーの最初のタブに、%2$@で最後のタブに移動します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ przechodzi do pierwszej karty na pasku bocznym, a %2$@ do ostatniej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ переходит к первой вкладке в боковом меню, а %2$@ — к последней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ переходить до першої вкладки в бічній панелі, а %2$@ — до останньої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可跳到边栏中的第一个标签页，%2$@ 可跳到最后一个。"
          }
        }
      }
    },
    "emptyPage.hintMatchSite": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„An Website anpassen“ unter Einstellungen › Erscheinungsbild & Ton tönt die Seitenleiste in der Farbe der Seite, auf der du bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match site, in Settings › Appearance & Sound, tints the sidebar with the color of the page you're on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Igualar al sitio, en Ajustes › Aspecto y sonido, tiñe la barra lateral con el color de la página en la que estás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Adapter au site », dans Réglages › Apparence et son, teinte la barre latérale avec la couleur de la page affichée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」＞「外観とサウンド」の「サイトに合わせる」は、表示中のページの色でサイドバーに色を付けます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasuj do witryny, w Ustawieniach › Wygląd i dźwięk, barwi pasek boczny kolorem strony, na której jesteś."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Как у сайта» в «Настройки › Оформление и звук» подкрашивает боковое меню цветом текущей страницы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Як на сайті» в «Параметри › Вигляд і звук» підфарбовує бічну панель кольором сторінки, на якій ви перебуваєте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”>“外观与声音”中的“匹配网站”会用你所在页面的颜色为边栏着色。"
          }
        }
      }
    },
    "emptyPage.hintGlobalLittleArx": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Einstellungen › Links kannst du Little Arx einen Tastaturkurzbefehl geben, der in jeder App funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Links can give Little Arx a shortcut that works from any app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes › Enlaces puede dar a Little Arx un atajo que funciona desde cualquier app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages › Liens permet d’attribuer à Little Arx un raccourci qui fonctionne depuis n’importe quelle app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」＞「リンク」で、どのAppからでも使えるLittle Arxのショートカットを設定できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia › Łącza mogą nadać Little Arx skrót działający w każdej aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Настройки › Ссылки» для Little Arx можно задать сочетание клавиш, которое работает в любом приложении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «Параметри › Посилання» можна задати для Little Arx скорочення, що працює з будь-якої програми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”>“链接”可为 Little Arx 设置在任何 App 中都可使用的快捷键。"
          }
        }
      }
    },
    "emptyPage.hintArchive": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschlossene Tabs warten im Tab-Archiv, ebenso Tabs, die 6 Stunden nicht angesehen wurden, sofern unter Einstellungen › Profile nichts anderes steht. Öffne es in der Bibliothek, um beliebige davon zurückzuholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs you close wait in the Tab Archive, and so do tabs left unviewed for 6 hours unless Settings › Profiles says otherwise. Open it from the Library to bring any of them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas cerradas esperan en Pestañas archivadas, igual que las que llevan 6 horas sin mirarse, salvo que Ajustes › Perfiles indique otra cosa. Ábrelas desde la biblioteca para recuperar cualquiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets fermés attendent dans les onglets archivés, de même que ceux restés sans consultation pendant 6 heures, sauf indication contraire dans Réglages › Profils. Ouvrez-les depuis la bibliothèque pour en récupérer un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたタブはタブアーカイブに保管されます。「設定 › プロファイル」で変更しない限り、6時間見ていないタブも保管されます。ライブラリから開くと、どのタブも元に戻せます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięte karty czekają w Archiwum kart, podobnie jak karty nieoglądane przez 6 godzin, chyba że w Ustawienia › Profile ustawiono inaczej. Otwórz je z Biblioteki, aby przywrócić dowolną z nich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытые вкладки ждут в архиве вкладок, как и вкладки, которые не открывали 6 часов, если в разделе Настройки › Профили не указано иное. Откройте его из Библиотеки, чтобы вернуть любую из них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриті вкладки чекають в архіві вкладок, як і вкладки, які не переглядали 6 годин, якщо в розділі Параметри › Профілі не вказано інше. Відкрийте його з бібліотеки, щоб повернути будь-яку з них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭的标签页会保留在标签页归档中，6 小时没有查看的标签页也会保留，除非“设置 › 用户场景”另有设定。从资源库打开即可找回其中任意一个。"
          }
        }
      }
    },
    "emptyPage.hintZoom": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und %2$@ zoomen die Seite, und der Zoom bleibt für die ganze Website erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and %2$@ zoom the page, and the zoom stays with the whole site."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ y %2$@ amplían y reducen la página, y el zoom se mantiene en todo el sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ et %2$@ zooment la page, et le zoom s’applique à tout le site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@と%2$@でページを拡大/縮小します。拡大率はサイト全体に適用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ i %2$@ powiększają stronę, a powiększenie zostaje dla całej witryny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и %2$@ изменяют масштаб страницы, и масштаб сохраняется для всего сайта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ і %2$@ змінюють масштаб сторінки, і масштаб зберігається для всього сайту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 和 %2$@ 可缩放页面，缩放比例会应用于整个网站。"
          }
        }
      }
    },
    "emptyPage.hintSearchShortcut": {
      "comment": "Empty page tip. “gh” is a keyword the person types; keep it. The path names the Settings tab and section as titled (settings.category.general, settings.section.search).",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib !gh in die Befehlsleiste ein und drücke den Zeilenschalter, um GitHub zu durchsuchen. Füge unter Einstellungen › Allgemein › Suchen eigene Stichwörter hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type !gh and press Return in the command bar to search GitHub. Add your own keywords in Settings › General › Search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe !gh en la barra de comandos y pulsa Retorno para buscar en GitHub. Añade tus propias palabras clave en Ajustes › General › Búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez !gh dans la barre de commandes et appuyez sur Retour pour rechercher sur GitHub. Ajoutez vos propres mots-clés dans Réglages › Général › Recherche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドバーに!ghと入力してReturnキーを押すと、GitHubを検索できます。独自のキーワードは「設定」＞「一般」＞「検索」で追加できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz !gh na pasku poleceń i naciśnij Return, aby przeszukać GitHub. Dodaj własne słowa kluczowe w Ustawieniach › Ogólne › Wyszukiwanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите !gh в панели команд и нажмите Return, чтобы искать на GitHub. Добавьте свои ключевые слова в «Настройки › Основные › Поиск»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть !gh у панелі команд і натисніть Return, щоб шукати на GitHub. Додайте власні ключові слова в «Параметри › Загальні › Пошук»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令栏中输入 !gh 并按下 Return 键，即可搜索 GitHub。可在“设置”>“通用”>“搜索”中添加你自己的关键词。"
          }
        }
      }
    },
    "emptyPage.hintMedia": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Medien“ in der Bibliothek listet die Tabs auf, die Ton oder Video wiedergeben, mit Wiedergabe, Pause und Stummschalten für jeden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media, in the Library, lists the tabs playing sound or video, with play, pause and mute for each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multimedia, en la biblioteca, muestra las pestañas que reproducen sonido o vídeo, con reproducir, pausar y silenciar para cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Médias, dans la bibliothèque, liste les onglets qui diffusent du son ou de la vidéo, avec lecture, pause et coupure du son pour chacun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリの「メディア」には、音声やビデオを再生中のタブが一覧表示され、それぞれ再生、一時停止、消音ができます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Multimedia, w Bibliotece, wyświetlają karty odtwarzające dźwięk lub wideo, z odtwarzaniem, wstrzymaniem i wyciszeniem dla każdej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Медиа» в Библиотеке показывает вкладки, в которых воспроизводится звук или видео, с кнопками воспроизведения, паузы и выключения звука для каждой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Медіа» в бібліотеці перелічує вкладки зі звуком чи відео та має для кожної відтворення, паузу й вимкнення звуку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源库中的“媒体”会列出正在播放声音或视频的标签页，并为每个标签页提供播放、暂停和静音。"
          }
        }
      }
    },
    "emptyPage.hintGroupTabs": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke bei gedrückter Befehlstaste auf einige Tabs und klicke dann mit der rechten Maustaste auf einen, um sie zu gruppieren. Eine Gruppe hält sie zusammen, ohne sie zu fixieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command-click a few tabs, then right-click one to group them. A group keeps them together without pinning them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con ⌘ pulsado en varias pestañas y luego haz clic con el botón derecho en una para agruparlas. Un grupo las mantiene juntas sin anclarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur quelques onglets en maintenant ⌘ enfoncée, puis faites un clic droit sur l’un d’eux pour les grouper. Un groupe les garde ensemble sans les épingler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandキーを押しながら複数のタブをクリックし、1つを右クリックするとグループ化できます。グループ化すると、固定せずにタブをまとめておけます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij z klawiszem Command kilka kart, a potem kliknij jedną prawym przyciskiem, aby je zgrupować. Grupa trzyma je razem bez przypinania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите несколько вкладок, удерживая Command, затем нажмите одну из них правой кнопкой, чтобы сгруппировать их. Группа держит их вместе без закрепления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть кілька вкладок із клавішею Command, а потім клацніть одну з них правою кнопкою, щоб згрупувати їх. Група тримає їх разом, не закріплюючи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 键点按几个标签页，然后右键点按其中一个即可将它们分组。分组会让它们保持在一起，而无需固定。"
          }
        }
      }
    },
    "emptyPage.hintProxyLinks": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy-Links machen beim Kopieren aus Links von x.com solche von fxtwitter.com, damit sie in Chats gut als Vorschau erscheinen. Siehe Einstellungen › Links."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy Links turn x.com links into fxtwitter.com ones when you copy, so they preview well in chats. See Settings › Links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces proxy convierten al copiar los enlaces de x.com en enlaces de fxtwitter.com, para que se vean bien en los chats. Consulta Ajustes › Enlaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens proxy transforment les liens x.com en liens fxtwitter.com à la copie, pour qu’ils s’affichent bien dans les discussions. Consultez Réglages › Liens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシリンクは、コピーするときにx.comのリンクをfxtwitter.comのリンクに変換するため、チャットで見栄えのよいプレビューが表示されます。「設定」＞「リンク」を参照してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącza proxy zmieniają łącza x.com na fxtwitter.com podczas kopiowania, aby dobrze się podglądały w czatach. Zobacz Ustawienia › Łącza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси-ссылки превращают ссылки x.com в ссылки fxtwitter.com при копировании, чтобы они хорошо отображались в чатах. См. «Настройки › Ссылки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проксі-посилання перетворюють посилання x.com на fxtwitter.com під час копіювання, щоб вони добре показувалися в чатах. Дивіться «Параметри › Посилання»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理链接会在你拷贝时将 x.com 链接转换为 fxtwitter.com 链接，使其在聊天中能很好地预览。请参阅“设置”>“链接”。"
          }
        }
      }
    },
    "emptyPage.hintTaskManager": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zeigt, wie viel Arbeitsspeicher und CPU jeder Tab und jede Erweiterung verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ shows how much memory and CPU each tab and extension uses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muestra cuánta memoria y CPU usa cada pestaña y extensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ affiche la mémoire et le processeur utilisés par chaque onglet et chaque extension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、各タブと機能拡張が使用しているメモリとCPUの量を表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pokazuje, ile pamięci i procesora zużywa każda karta i rozszerzenie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ показывает, сколько памяти и ресурсов процессора использует каждая вкладка и расширение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ показує, скільки памʼяті й ресурсів ЦП використовує кожна вкладка та розширення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会显示每个标签页和扩展占用了多少内存和 CPU。"
          }
        }
      }
    },
    "emptyPage.hintNewWindow": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet ein weiteres Fenster. Jedes Fenster zeigt alle deine Räume, daher gehen beim Schließen eines Fensters keine Tabs verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens another window. Every window shows all your spaces, so closing one loses no tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre otra ventana. Cada ventana muestra todas tus secciones, así que cerrar una no hace perder pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre une autre fenêtre. Chaque fenêtre affiche toutes vos sections, donc en fermer une ne fait perdre aucun onglet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、別のウインドウが開きます。どのウインドウにもすべてのスペースが表示されるため、1つ閉じてもタブは失われません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera kolejne okno. Każde okno pokazuje wszystkie Twoje strefy, więc zamknięcie jednego nie gubi kart."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открывает еще одно окно. В каждом окне показаны все Ваши разделы, поэтому закрытие окна не приводит к потере вкладок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відкриває ще одне вікно. Кожне вікно показує всі ваші розділи, тому закриття одного не втрачає вкладок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会打开另一个窗口。每个窗口都会显示你所有的分区，因此关闭一个窗口不会丢失任何标签页。"
          }
        }
      }
    },
    "emptyPage.hintFavoriteLinks": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link zu einer anderen Website in einem Favoriten wird in Peek geöffnet, sodass der Favorit seine eigene Seite behält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link to another site in a Favorite opens in Peek, so the Favorite keeps its own page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace a otro sitio en un favorito se abre en Peek, así el favorito conserva su propia página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien vers un autre site dans un favori s’ouvre dans Peek, afin que le favori conserve sa propre page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り内のほかのサイトへのリンクはPeekで開くため、お気に入りは自分のページを保てます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącze do innej witryny w ulubionej otwiera się w Peek, więc ulubiona zachowuje własną stronę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка на другой сайт в избранной вкладке открывается в Peek, так что избранная вкладка сохраняет свою страницу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання на інший сайт в улюбленому відкривається в Peek, тож улюблена вкладка зберігає власну сторінку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人收藏中指向其他网站的链接会在 Peek 中打开，因此个人收藏会保持其自己的页面。"
          }
        }
      }
    },
    "emptyPage.hintArrangePanes": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %1$@ tauschst du die Bereiche eines Splits, und mit %2$@ stapelst du sie oder legst sie nebeneinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ swaps the panes of a split, and %2$@ stacks them or puts them side by side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ intercambia los paneles de una división y %2$@ los apila o los pone en paralelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ échange les volets d’une vue partagée, et %2$@ les empile ou les place côte à côte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@で分割のペインを入れ替え、%2$@で縦または横に並べ替えます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zamienia miejscami panele podziału, a %2$@ układa je jeden nad drugim albo obok siebie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ меняет местами панели в Split View, а %2$@ располагает их друг над другом или рядом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ міняє місцями області поділу, а %2$@ розташовує їх одну над одною або поруч."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可交换分屏的窗格，%2$@ 可将它们上下堆叠或左右并排。"
          }
        }
      }
    },
    "emptyPage.hintTranslate": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Seite übersetzen“ übersetzt die Seite auf deinem Mac und übersetzt weiter, während du scrollst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate Page translates the page on your Mac and keeps translating as you scroll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducir página traduce la página en tu Mac y sigue traduciendo a medida que te desplazas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Traduire la page » traduit la page sur votre Mac et continue de traduire pendant que vous faites défiler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ページを翻訳」は、Mac上でページを翻訳し、スクロールしても翻訳を続けます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetłumacz stronę tłumaczy stronę na Twoim Macu i tłumaczy dalej podczas przewijania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Перевести веб-страницу» переводит страницу на Вашем Mac и продолжает переводить по мере прокрутки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Перекласти вебсторінку» перекладає сторінку на вашому Mac і продовжує перекладати під час прокручування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“翻译页面”会在你的 Mac 上翻译页面，并在你滚动时继续翻译。"
          }
        }
      }
    },
    "emptyPage.hintActions": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke %@ erneut, während die Befehlsleiste geöffnet ist, um zu sehen, was du sonst noch mit dem markierten Ergebnis tun kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ again while the command bar is open to see what else you can do with the highlighted result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a pulsar %@ con la barra de comandos abierta para ver qué más puedes hacer con el resultado resaltado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez de nouveau sur %@ lorsque la barre de commandes est ouverte pour voir ce que vous pouvez faire d’autre avec le résultat en surbrillance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドバーを開いているときに%@をもう一度押すと、ハイライトされた結果に対するほかの操作が表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ponownie %@, gdy pasek poleceń jest otwarty, aby zobaczyć, co jeszcze możesz zrobić z wyróżnionym wynikiem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@ еще раз при открытой панели команд, чтобы увидеть, что еще можно сделать с выделенным результатом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@ ще раз, коли панель команд відкрита, щоб побачити, що ще можна зробити з виділеним результатом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令栏打开时再次按下 %@，可查看对高亮结果还能执行哪些操作。"
          }
        }
      }
    },
    "emptyPage.hintKeepLoaded": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf einen Tab und wähle „Diese Website immer geladen halten“ für einen Musikplayer oder ein Dashboard, die nie entladen werden sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a tab and choose Always Keep This Site Loaded for a music player or a dashboard that should never unload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con el botón derecho en una pestaña y elige Mantener siempre cargado este sitio para un reproductor de música o un panel que nunca debería descargarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un onglet et choisissez « Toujours garder ce site chargé » pour un lecteur de musique ou un tableau de bord qui ne doit jamais être déchargé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックプレーヤーやダッシュボードなど、ずっと読み込んでおきたいサイトは、タブを右クリックして「このサイトを常に読み込んでおく」を選びます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij kartę prawym przyciskiem i wybierz Zawsze trzymaj tę witrynę wczytaną dla odtwarzacza muzyki lub panelu, który nigdy nie powinien być zwalniany."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите вкладку правой кнопкой и выберите «Всегда держать этот сайт загруженным» для музыкального плеера или панели, которые не должны выгружаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть вкладку правою кнопкою й виберіть «Завжди тримати цей сайт завантаженим» для музичного програвача чи панелі, що ніколи не має вивантажуватися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按标签页并选择“始终保持此网站已加载”，适用于不应被卸载的音乐播放器或仪表板。"
          }
        }
      }
    },
    "emptyPage.hintAssistantGrants": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Assistent sieht nur die Profile, Räume oder Tabs, die du ihm freigibst, und nie ein privates Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An assistant sees only the profiles, spaces or tabs you grant it, and never a private window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asistente solo ve los perfiles, las secciones o las pestañas que le concedas, y nunca una ventana privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un assistant ne voit que les profils, les sections ou les onglets que vous lui accordez, et jamais une fenêtre privée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントが参照できるのは、許可したプロファイル、スペース、タブのみで、プライベートウインドウは参照できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent widzi tylko profile, strefy lub karty, które mu przyznasz, i nigdy okna prywatnego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент видит только те профили, разделы и вкладки, которые Вы ему разрешили, и никогда не видит частное окно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент бачить лише профілі, розділи чи вкладки, до яких ви надали доступ, і ніколи не бачить приватне вікно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理只能看到你授权给它的用户场景、分区或标签页，绝不会看到无痕浏览窗口。"
          }
        }
      }
    },
    "emptyPage.hintSidebarSide": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Einstellungen › Erscheinungsbild & Ton kann die Seitenleiste auf der rechten Seite des Fensters stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Appearance & Sound can put the sidebar on the right side of the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes › Aspecto y sonido puede poner la barra lateral en el lado derecho de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages › Apparence et son permet de placer la barre latérale à droite de la fenêtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」＞「外観とサウンド」で、サイドバーをウインドウの右側に配置できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia › Wygląd i dźwięk mogą umieścić pasek boczny po prawej stronie okna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Настройки › Оформление и звук» боковое меню можно разместить справа в окне."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «Параметри › Вигляд і звук» бічну панель можна розмістити праворуч у вікні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”>“外观与声音”可将边栏放在窗口的右侧。"
          }
        }
      }
    },
    "emptyPage.hintTabVolume": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den Lautsprecher eines Tabs, der etwas wiedergibt, um nur diesen Tab leiser zu stellen, auch einen Anruf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the speaker on a playing tab to turn just that tab down, even a call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el altavoz de una pestaña que se reproduce para bajar el volumen solo de esa pestaña, incluso una llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le haut-parleur d’un onglet en lecture pour baisser le volume de cet onglet seulement, même pour un appel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中のタブのスピーカーをクリックすると、通話を含め、そのタブだけ音量を下げられます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij głośnik na odtwarzającej karcie, aby ściszyć tylko tę kartę, nawet rozmowę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите динамик на вкладке с воспроизведением, чтобы убавить звук только этой вкладки, даже во время звонка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть динамік на вкладці зі звуком, щоб приглушити лише цю вкладку, навіть виклик."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按正在播放的标签页上的扬声器，即可只调低该标签页的音量，通话也不例外。"
          }
        }
      }
    },
    "emptyPage.hintImport": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommst von Arc, Chrome oder Safari? Unter Einstellungen › Erweitert › Importieren … übernimmst du deine Konfiguration, deinen Verlauf und deine Passwörter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming from Arc, Chrome or Safari? Settings › Advanced › Import… brings your setup, history and passwords over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Vienes de Arc, Chrome o Safari? Ajustes › Avanzado › Importar… trae tu configuración, historial y contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez d’Arc, de Chrome ou de Safari ? Réglages › Avancés › Importer… reprend votre configuration, votre historique et vos mots de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc、Chrome、Safariからお乗り換えですか？「設定」＞「詳細」＞「読み込む…」で、設定、履歴、パスワードを読み込めます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechodzisz z Arc, Chrome lub Safari? Ustawienia › Zaawansowane › Importuj… przenosi Twoją konfigurację, historię i hasła."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходите из Arc, Chrome или Safari? «Настройки › Дополнения › Импортировать…» переносит Ваши настройки, историю и пароли."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходите з Arc, Chrome або Safari? «Параметри › Експертні › Імпортувати…» переносить ваші налаштування, історію та паролі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Arc、Chrome 或 Safari 迁移而来？“设置”>“高级”>“导入…”可带来你的设置、历史记录和密码。"
          }
        }
      }
    },
    "emptyPage.hintTearOff": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe einen Tab aus dem Fenster auf den Schreibtisch, und er wird dort, wo du ihn loslässt, in ein Little-Arx-Fenster bewegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a tab out of the window onto the desktop, and it moves into a Little Arx window where you let go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una pestaña fuera de la ventana al escritorio y pasa a una ventana de Little Arx donde la sueltes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un onglet hors de la fenêtre vers le bureau, et il passe dans une fenêtre Little Arx là où vous le relâchez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブをウインドウの外のデスクトップにドラッグすると、指を離した場所のLittle Arxウインドウに移動します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij kartę z okna na biurko, a przeniesie się do okna Little Arx w miejscu, w którym ją puścisz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите вкладку из окна на рабочий стол, и она переместится в окно Little Arx там, где Вы ее отпустите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть вкладку з вікна на робочий стіл, і вона перейде у вікно Little Arx там, де ви її відпустите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标签页拖出窗口并放到桌面上，它会移入你松开手的位置的 Little Arx 窗口中。"
          }
        }
      }
    },
    "emptyPage.hintCast": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Streamen …“ zeigt den Tab oder das eigene Video der Website auf einem Chromecast oder einem Fernseher in deinem Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cast… shows the tab, or the site's own video, on a Chromecast or a TV on your network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar… muestra la pestaña, o el propio vídeo del sitio, en un Chromecast o un televisor de tu red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caster… affiche l’onglet, ou la vidéo du site, sur un Chromecast ou un téléviseur de votre réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キャスト…」を選ぶと、タブまたはサイト自身のビデオを、ネットワーク上のChromecastやテレビに表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesyłaj… pokazuje kartę lub własne wideo witryny na urządzeniu Chromecast albo w telewizorze w Twojej sieci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Трансляция…» показывает вкладку или собственное видео сайта на Chromecast или телевизоре в Вашей сети."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Транслювати…» показує вкладку або власне відео сайту на Chromecast чи телевізорі у вашій мережі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“投放…”可在你网络上的 Chromecast 或电视上显示该标签页，或网站自带的视频。"
          }
        }
      }
    },
    "emptyPage.hintPinTab": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen ist nicht nötig: %@ fixiert den Tab, auf dem du bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No need to drag: %@ pins the tab you're on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta arrastrar: %@ ancla la pestaña en la que estás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inutile de faire glisser : %@ épingle l’onglet affiché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグは不要です。%@を押すと、表示中のタブを固定します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie musisz przeciągać: %@ przypina kartę, na której jesteś."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивать не нужно: %@ закрепляет текущую вкладку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягувати не потрібно: %@ закріплює вкладку, на якій ви перебуваєте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需拖移：%@ 会固定你当前所在的标签页。"
          }
        }
      }
    },
    "emptyPage.hintCreate": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe new doc oder new issue in die Befehlsleiste, um die Seite zu öffnen, auf der du eines startest, in Google Docs, Linear und mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type new doc or new issue in the command bar to open the page that starts one, in Google Docs, Linear and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe new doc o new issue en la barra de comandos para abrir la página que inicia uno, en Google Docs, Linear y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez new doc ou new issue dans la barre de commandes pour ouvrir la page qui en crée un, dans Google Docs, Linear et d’autres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドバーにnew docやnew issueと入力すると、GoogleドキュメントやLinearなどで新規作成するページが開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz new doc lub new issue na pasku poleceń, aby otworzyć stronę, która zaczyna taki dokument, w Dokumentach Google, Linear i innych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите new doc или new issue в панели команд, чтобы открыть страницу, которая создает такой объект, в Google Docs, Linear и других сервисах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть new doc або new issue у панелі команд, щоб відкрити сторінку, що створює такий запис, у Google Docs, Linear та інших."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令栏中输入“new doc”或“new issue”，即可打开用于新建的页面，支持 Google 文档、Linear 等。"
          }
        }
      }
    },
    "emptyPage.hintSpaceAppearance": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf einen Raum und wähle „Erscheinungsbild …“, um ihm ein eigenes Design, eine eigene Tönung und einen eigenen Verlauf zu geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a space and choose Appearance… to give it its own theme, tint and gradient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con el botón derecho en una sección y elige Aspecto… para darle su propio tema, tono y degradado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur une section et choisissez Apparence… pour lui donner son propre thème, sa propre teinte et son propre dégradé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを右クリックして「外観…」を選ぶと、そのスペース独自のテーマ、色合い、グラデーションを設定できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij strefę prawym przyciskiem i wybierz Wygląd…, aby nadać jej własny motyw, odcień i gradient."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите раздел правой кнопкой и выберите «Оформление…», чтобы задать ему собственные тему, оттенок и градиент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть розділ правою кнопкою й виберіть «Вигляд…», щоб задати йому власну тему, відтінок і градієнт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按分区并选取“外观…”，即可为其设置各自的主题、色调和渐变。"
          }
        }
      }
    },
    "emptyPage.hintLinkStatus": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege den Zeiger auf einen Link, um zu sehen, wohin er führt. Halte eine Zusatztaste gedrückt, und die Beschriftung zeigt, was ein Klick bewirkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest the pointer on a link to see where it goes. Hold a modifier key and the label says what a click will do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el puntero sobre un enlace para ver adónde lleva. Mantén pulsada una tecla modificadora y la etiqueta indica qué hará un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le pointeur sur un lien pour voir où il mène. Maintenez une touche de modification enfoncée et l’étiquette indique ce que fera un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクにポインタを合わせると、リンク先が表示されます。修飾キーを押すと、クリックしたときの動作がラベルに表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj wskaźnik na łączu, aby zobaczyć, dokąd prowadzi. Przytrzymaj klawisz modyfikujący, a etykieta powie, co zrobi kliknięcie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержите указатель на ссылке, чтобы увидеть, куда она ведет. Удерживайте клавишу-модификатор, и подпись покажет, что произойдет при нажатии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть вказівник на посилання, щоб побачити, куди воно веде. Утримуйте клавішу-модифікатор, і напис покаже, що зробить клацання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针停在链接上，即可查看它会跳转到哪里。按住修饰键，标签会显示点按后将执行的操作。"
          }
        }
      }
    },
    "emptyPage.hintBatterySaver": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Energiesparmodus verlangsamt Tabs im Hintergrund, wenn der Akku sich leert. Lege unter Einstellungen › Allgemein fest, wann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery Saver slows background tabs when the battery runs low. Choose when in Settings › General."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro de energía ralentiza las pestañas en segundo plano cuando la batería está baja. Elige cuándo en Ajustes › General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’énergie ralentit les onglets en arrière-plan quand la batterie est faible. Choisissez quand dans Réglages › Général."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "省エネモードは、バッテリー残量が少なくなるとバックグラウンドのタブの動作を遅くします。条件は「設定」＞「一般」で選べます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszczędzanie energii spowalnia karty w tle, gdy bateria się wyczerpuje. Wybierz kiedy w Ustawieniach › Ogólne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим энергосбережения замедляет фоновые вкладки при низком заряде батареи. Выберите условия в «Настройки › Основные»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим енергозбереження сповільнює фонові вкладки, коли заряд батареї низький. Виберіть, коли саме, в «Параметри › Загальні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节能模式会在电量不足时减慢后台标签页的速度。可在“设置”>“通用”中选择触发时机。"
          }
        }
      }
    },
    "emptyPage.hintClosePane": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schließt den fokussierten Bereich und behält seinen Tab in der Seitenleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ closes the focused pane and keeps its tab in the sidebar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cierra el panel activo y mantiene su pestaña en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ferme le volet actif et conserve son onglet dans la barre latérale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、フォーカス中のペインを閉じ、そのタブはサイドバーに残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zamyka aktywny panel i zachowuje jego kartę na pasku bocznym."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ закрывает активную панель и оставляет ее вкладку в боковом меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ закриває активну область і залишає її вкладку в бічній панелі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会关闭聚焦的窗格，并将其标签页保留在边栏中。"
          }
        }
      }
    },
    "emptyPage.hintChatTab": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Chat in Tab öffnen“ macht aus einem Chat einen Tab, den du in einem Split neben die Seite legen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Chat in Tab turns a chat into a tab you can put in a split next to the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir chat en una pestaña convierte un chat en una pestaña que puedes poner en una división junto a la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ouvrir la discussion dans un onglet » transforme une discussion en onglet que vous pouvez placer dans une vue partagée à côté de la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「チャットをタブで開く」を選ぶと、チャットがタブになり、ページの隣に分割して置けます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz czat w karcie zmienia czat w kartę, którą możesz umieścić w podziale obok strony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Открыть чат во вкладке» превращает чат во вкладку, которую можно поместить в Split View рядом со страницей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Відкрити чат у вкладці» перетворює чат на вкладку, яку можна розмістити в поділі поруч зі сторінкою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“在标签页中打开聊天”会将聊天变成标签页，你可以将它放入分屏，与页面并排显示。"
          }
        }
      }
    },
    "emptyPage.hintUndo": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Änderung der Anordnung widerrufen“ im Menü „Bearbeiten“ macht das Letzte rückgängig, was du in diesem Fenster mit deinen Tabs getan hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo Organization Change, in the Edit menu, takes back the last thing you did to your tabs in this window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer cambio de organización, en el menú Edición, deshace lo último que hiciste con tus pestañas en esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Annuler la modification de l’organisation », dans le menu Édition, annule la dernière action que vous avez effectuée sur vos onglets dans cette fenêtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「編集」メニューの「構成の変更を取り消す」は、このウインドウでタブに対して最後に行った操作を取り消します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnij zmianę układu, w menu Edycja, cofa ostatnią zmianę wprowadzoną w kartach w tym oknie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить изменение упорядочивания» в меню «Правка» отменяет последнее действие с вкладками в этом окне."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Відмінити зміну упорядкування» в меню «Редагування» скасовує останню дію з вашими вкладками в цьому вікні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“编辑”菜单中的“撤销布局更改”会撤回你在此窗口中对标签页所做的上一个操作。"
          }
        }
      }
    },
    "emptyPage.hintAppLinks": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Einstellungen › Links legen die App-Links fest, welche App einen Link wie claude:// öffnet, den eine Seite weitergibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Links, in Settings › Links, choose which app opens a link such as claude:// that a page hands off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaces de apps, en Ajustes › Enlaces, elige qué app abre un enlace como claude:// que cede una página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens d’apps, dans Réglages › Liens, déterminent quelle app ouvre un lien tel que claude:// qu’une page transmet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」＞「リンク」のAppリンクでは、ページが渡すclaude://などのリンクを開くAppを選べます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącza aplikacji, w Ustawieniach › Łącza, wybierają aplikację otwierającą łącze takie jak claude://, które przekazuje strona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ссылки приложений» в «Настройки › Ссылки» определяют, какое приложение открывает ссылку вроде claude://, которую передает страница."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Посилання на програми» в «Параметри › Посилання» визначають, яка програма відкриває посилання на кшталт claude://, яке передає сторінка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”>“链接”中的“App 链接”可选择由哪个 App 打开网页交出的链接，例如 claude://。"
          }
        }
      }
    },
    "emptyPage.hintHistory": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zeigt deinen Verlauf nach Tagen mit den neuesten zuerst und mit einer Suche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ shows your history by day, newest first, with a search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muestra tu historial por día, del más reciente al más antiguo, con una búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ affiche votre historique par jour, du plus récent au plus ancien, avec une recherche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、履歴を新しい順に日ごとに表示します。検索もできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pokazuje historię według dni, od najnowszych, z wyszukiwaniem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ показывает Вашу историю по дням, сначала новые, с поиском."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ показує вашу історію за днями, спершу найновіші, з пошуком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会按天显示你的历史记录，最新的在前，并可搜索。"
          }
        }
      }
    },
    "emptyPage.hintPasswords": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx sichert Passwörter für jedes Profil und verlangt Touch ID, bevor es eines ausfüllt. Unter Einstellungen › Allgemein kannst du das überspringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx saves passwords for each profile and asks for Touch ID before it fills one. Settings › General can skip that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx guarda las contraseñas de cada perfil y pide Touch ID antes de rellenar una. Ajustes › General puede omitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx enregistre les mots de passe de chaque profil et demande Touch ID avant d’en remplir un. Réglages › Général permet de s’en passer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxはプロファイルごとにパスワードを保存し、入力する前にTouch IDを求めます。「設定」＞「一般」で省略できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx zachowuje hasła dla każdego profilu i prosi o Touch ID, zanim je wypełni. Ustawienia › Ogólne mogą to pominąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx сохраняет пароли для каждого профиля и запрашивает Touch ID перед их вводом. В «Настройки › Основные» это можно отключить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx зберігає паролі для кожного профілю й просить Touch ID перед тим, як заповнити пароль. У «Параметри › Загальні» це можна пропустити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会为每个用户场景存储密码，并在填写之前要求使用 Touch ID。可在“设置”>“通用”中跳过此步骤。"
          }
        }
      }
    },
    "emptyPage.hintFullScreenSidebar": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst ein Video im Vollbildmodus? %@ zeigt die Seitenleiste daneben an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watching a video full screen? %@ shows the sidebar beside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ves un vídeo a pantalla completa? %@ muestra la barra lateral junto a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous regardez une vidéo en plein écran ? %@ affiche la barre latérale à côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオをフルスクリーンで見ていますか？%@を押すと、横にサイドバーを表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglądasz wideo na pełnym ekranie? %@ pokazuje pasek boczny obok niego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите видео на весь экран? %@ показывает боковое меню рядом с ним."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дивитеся відео на весь екран? %@ показує бічну панель поруч із ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在全屏幕观看视频？%@ 会在其旁边显示边栏。"
          }
        }
      }
    },
    "emptyPage.hintAliases": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einem Befehl unter Einstellungen › Tastaturkurzbefehle einen Alias, zum Beispiel fixieren, und tippe ihn dann in die Befehlsleiste, um den Befehl auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a command an alias in Settings › Shortcuts, such as pin, then type it in the command bar to run it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna un alias a un comando en Ajustes › Atajos, como pin, y escríbelo en la barra de comandos para ejecutarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez un alias à une commande dans Réglages › Raccourcis, par exemple pin, puis saisissez-le dans la barre de commandes pour l’exécuter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」＞「ショートカット」でコマンドにpinなどのエイリアスを付け、コマンドバーに入力して実行できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj poleceniu alias w Ustawieniach › Skróty, na przykład pin, a potem wpisz go na pasku poleceń, aby je uruchomić."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте команде псевдоним в «Настройки › Сочетания клавиш», например pin, а затем введите его в панели команд, чтобы выполнить ее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте команді псевдонім у «Параметри › Клавіатурні скорочення», наприклад pin, а потім введіть його в панелі команд, щоб виконати її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”>“快捷键”中为命令设置别名（例如 pin），然后在命令栏中输入该别名即可运行命令。"
          }
        }
      }
    },
    "emptyPage.hintSidebarKeys": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke den Tabulator, um in die Seitenleiste zu wechseln. Die Pfeiltasten bewegen sich zwischen den Zeilen, und die Leertaste öffnet die Zeile, auf der du bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Tab to move into the sidebar. The arrow keys move between rows, and Space opens the one you're on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Tab para pasar a la barra lateral. Las teclas de flecha se mueven entre filas y Espacio abre la fila en la que estás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Tab pour passer dans la barre latérale. Les touches fléchées se déplacent entre les lignes, et la barre d’espace ouvre celle où vous êtes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabキーを押すと、サイドバーに移動します。矢印キーで行を移動し、スペースキーで選択中の行を開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Tab, aby przejść na pasek boczny. Klawisze strzałek przechodzą między wierszami, a spacja otwiera wiersz, na którym jesteś."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите Tab, чтобы перейти в боковое меню. Клавиши со стрелками перемещают между строками, а пробел открывает текущую."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть Tab, щоб перейти до бічної панелі. Клавіші зі стрілками переходять між рядками, а пробіл відкриває поточний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 Tab 键可移入边栏。方向键可在各行之间移动，空格键可打开当前所在的行。"
          }
        }
      }
    },
    "emptyPage.hintWebStore": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chrome Web Store öffnet den Store im aktuellen Profil, und „Zu Arx hinzufügen“ installiert dort eine Erweiterung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome Web Store opens the store in the current profile, and Add to Arx installs an extension there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome Web Store abre la tienda en el perfil actual y Añadir a Arx instala allí una extensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome Web Store ouvre la boutique dans le profil actuel, et « Ajouter à Arx » y installe une extension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Chrome ウェブストア」は現在のプロファイルでストアを開き、「Arxに追加」でそこから機能拡張をインストールします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome Web Store otwiera sklep w bieżącym profilu, a Dodaj do Arx instaluje tam rozszerzenie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Интернет-магазин Chrome» открывает магазин в текущем профиле, а «Добавить в Arx» устанавливает там расширение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Вебмагазин Chrome» відкриває магазин у поточному профілі, а «Додати до Arx» інсталює там розширення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“Chrome 应用商店”会在当前用户场景中打开商店，“添加至 Arx”会在其中安装扩展。"
          }
        }
      }
    },
    "emptyPage.hintUnload": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx entlädt Tabs, die du stundenlang nicht angesehen hast, um Arbeitsspeicher zu sparen. Lege unter Einstellungen › Allgemein fest, wann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx unloads tabs you haven't looked at for hours to save memory. Choose when in Settings › General."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx descarga las pestañas que no has mirado durante horas para ahorrar memoria. Elige cuándo en Ajustes › General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx décharge les onglets que vous n’avez pas consultés depuis des heures pour économiser la mémoire. Choisissez quand dans Réglages › Général."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは、数時間見ていないタブをメモリ節約のために読み込み解除します。条件は「設定」＞「一般」で選べます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx zwalnia karty, na które nie patrzysz od godzin, aby oszczędzać pamięć. Wybierz kiedy w Ustawieniach › Ogólne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx выгружает вкладки, на которые Вы не смотрели несколько часов, чтобы экономить память. Выберите условия в «Настройки › Основные»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx вивантажує вкладки, на які ви не дивилися годинами, щоб заощадити памʼять. Виберіть, коли саме, в «Параметри › Загальні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会卸载你数小时未查看的标签页以节省内存。可在“设置”>“通用”中选择时机。"
          }
        }
      }
    },
    "emptyPage.hintAssistantStop": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während ein Assistent auf einer Seite arbeitet, nennt ihn ein Hinweis oben. „Stopp“ pausiert den Assistenten sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While an assistant works in a page, a note at the top names it. Stop pauses the assistant at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras un asistente trabaja en una página, una nota en la parte superior lo nombra. Detener pausa al asistente al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant qu’un assistant travaille dans une page, une note en haut le nomme. Arrêter suspend aussitôt l’assistant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントがページで作業している間、上部にその名前が表示されます。「停止」を押すと、アシスタントがすぐに一時停止します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy asystent pracuje na stronie, notatka u góry podaje jego nazwę. Zatrzymaj natychmiast wstrzymuje asystenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ассистент работает на странице, вверху показывается заметка с его названием. Кнопка «Остановить» сразу приостанавливает ассистента."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли асистент працює на сторінці, угорі є примітка з його назвою. Кнопка «Зупинити» одразу призупиняє асистента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理在网页中工作时，顶部会有一条注明它的提示。“停止”会立即暂停该助理。"
          }
        }
      }
    },
    "emptyPage.hintLinkTabs": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke bei gedrückter Befehlstaste auf einen Link, und er wird hinter der Seite geöffnet, die du liest. Unter Einstellungen › Allgemein können diese Tabs in den Vordergrund kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command-click a link and it opens behind the page you're reading. Settings › General can bring those tabs to the front."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con ⌘ pulsado en un enlace y se abre detrás de la página que lees. Ajustes › General puede traer esas pestañas al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un lien en maintenant ⌘ enfoncée et il s’ouvre derrière la page que vous lisez. Réglages › Général permet de mettre ces onglets au premier plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandキーを押しながらリンクをクリックすると、読んでいるページの背面で開きます。「設定」＞「一般」で、これらのタブを前面に表示するよう設定できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij łącze z klawiszem Command, a otworzy się za czytaną stroną. Ustawienia › Ogólne mogą wysuwać te karty na wierzch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ссылку, удерживая Command, и она откроется позади читаемой страницы. В «Настройки › Основные» такие вкладки можно выводить на передний план."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть посилання із Command, і воно відкриється позаду сторінки, яку ви читаєте. У «Параметри › Загальні» ці вкладки можна виводити на передній план."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 键点按链接，它会在你正在阅读的页面后面打开。可在“设置”>“通用”中让这些标签页置于前台。"
          }
        }
      }
    },
    "emptyPage.hintCaptureChat": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem du einen Teil einer Seite aufgenommen hast, hängt „An Chat senden“ das Bild an den Chat des Fensters an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you capture part of a page, Send to Chat attaches the picture to the window's chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de capturar parte de una página, Enviar al chat adjunta la imagen al chat de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir capturé une partie d’une page, « Envoyer dans la discussion » joint l’image à la discussion de la fenêtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの一部をキャプチャしたあと、「チャットに送信」を選ぶと、ウインドウのチャットにそのイメージが添付されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zrobieniu zrzutu części strony Wyślij do czatu załącza obraz do czatu okna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После снимка части страницы «Отправить в чат» прикрепляет изображение к чату окна."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після того як ви зняли частину сторінки, «Надіслати в чат» додає зображення до чату вікна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截取页面的一部分后，“发送到聊天”会将图片添加到该窗口的聊天中。"
          }
        }
      }
    },
    "emptyPage.hintPlayer": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn etwas wiedergegeben wird, hat ein kleiner Player unten in der Seitenleiste Wiedergabe, Pause und den nächsten Titel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When something plays, a small player at the bottom of the sidebar has play, pause and the next track."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando algo se reproduce, un pequeño reproductor en la parte inferior de la barra lateral tiene reproducir, pausar y la pista siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’un contenu est en lecture, un petit lecteur en bas de la barre latérale propose lecture, pause et piste suivante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かを再生中は、サイドバーの下部に、再生、一時停止、次のトラックのボタンがある小さなプレーヤーが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy coś gra, mały odtwarzacz na dole paska bocznego ma odtwarzanie, wstrzymanie i następny utwór."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда что-то воспроизводится, в нижней части бокового меню появляется небольшой плеер с кнопками воспроизведения, паузы и следующей дорожки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли щось відтворюється, невеликий програвач унизу бічної панелі має відтворення, паузу й наступну доріжку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有内容播放时，边栏底部的小型播放器提供播放、暂停和下一曲。"
          }
        }
      }
    },
    "emptyPage.hintSiteMenu": {
      "comment": "Empty page tip. The address bar is the field at the top of the sidebar that shows the page's address; the site menu opens from the button at its end.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Button am Ende der Adressleiste öffnet das Website-Menü: was die Website verwenden darf, deine Erweiterungen und ihre Cookies."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The button at the end of the address bar opens the site menu: what the site may use, your extensions and its cookies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón al final del campo de dirección abre el menú del sitio: lo que el sitio puede usar, tus extensiones y sus cookies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton à l’extrémité de la barre d’adresse ouvre le menu du site : ce que le site peut utiliser, vos extensions et ses cookies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスバーの右端のボタンでサイトメニューが開きます。サイトが使用できるもの、機能拡張、サイトのCookieを確認できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycisk na końcu paska adresu otwiera menu witryny: z czego witryna może korzystać, Twoje rozszerzenia i jej pliki cookie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка в конце строки адреса открывает меню сайта: что может использовать сайт, Ваши расширения и его файлы cookie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка в кінці смуги адреси відкриває меню сайту: що сайт може використовувати, ваші розширення та його файли cookie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址栏末尾的按钮会打开网站菜单：网站可使用的内容、你的扩展及其 Cookie。"
          }
        }
      }
    },
    "emptyPage.hintDevTools": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei aktiviertem Entwicklermodus öffnet %@ die Entwicklertools angedockt in der Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With developer mode on, %@ opens DevTools docked in the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el modo de desarrollador activado, %@ abre las herramientas para desarrolladores acopladas en la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le mode développeur activé, %@ ouvre les outils de développement ancrés dans la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デベロッパモードがオンのとき、%@を押すと、ページ内にドッキングしたDevToolsが開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy tryb dewelopera jest włączony, %@ otwiera DevTools zadokowane na stronie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включенном режиме разработчика %@ открывает инструменты разработчика, закрепленные на странице."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли режим розробника ввімкнено, %@ відкриває інструменти розробника, закріплені на сторінці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启开发者模式后，%@ 会在页面中打开停靠的开发者工具。"
          }
        }
      }
    },
    "emptyPage.hintAskForProfile": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zuordnung in Air Traffic Control kann jedes Mal fragen, welches Profil verwendet werden soll, was sich für Anmeldelinks eignet. Siehe Einstellungen › Links."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An Air Traffic Control route can ask which profile to use each time, which suits sign-in links. See Settings › Links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla de Air Traffic Control puede preguntar qué perfil usar cada vez, lo que va bien con los enlaces de inicio de sesión. Consulta Ajustes › Enlaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle d’ouverture d’Air Traffic Control peut demander quel profil utiliser à chaque fois, ce qui convient aux liens de connexion. Consultez Réglages › Liens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Controlの振り分けルールでは、使用するプロファイルを毎回確認できます。サインイン用のリンクに便利です。「設定」＞「リンク」を参照してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasa Air Traffic Control może za każdym razem pytać, którego profilu użyć, co pasuje do łączy logowania. Zobacz Ustawienia › Łącza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрут Air Traffic Control может каждый раз спрашивать, какой профиль использовать, что удобно для ссылок входа. См. «Настройки › Ссылки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрут Air Traffic Control може щоразу питати, який профіль використати, що зручно для посилань входу. Дивіться «Параметри › Посилання»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Traffic Control 的路由可以每次询问使用哪个用户场景，适合登录链接。请参阅“设置”>“链接”。"
          }
        }
      }
    },
    "emptyPage.hintNewTabPlacement": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Tabs beginnen oben in der Liste, wie in Arc. Unter Einstellungen › Allgemein können sie unten oder unter dem aktuellen Tab stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New tabs start at the top of the list, as in Arc. Settings › General can put them at the bottom or below the current tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas nuevas empiezan al principio de la lista, como en Arc. Ajustes › General puede ponerlas al final o debajo de la pestaña actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux onglets commencent en haut de la liste, comme dans Arc. Réglages › Général permet de les placer en bas ou sous l’onglet actuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規タブは、Arcと同じようにリストの先頭に配置されます。「設定」＞「一般」で、末尾や現在のタブの下に配置するよう変更できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe karty zaczynają się na górze listy, jak w Arc. Ustawienia › Ogólne mogą umieszczać je na dole lub pod bieżącą kartą."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые вкладки появляются вверху списка, как в Arc. В «Настройки › Основные» их можно разместить внизу или под текущей вкладкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові вкладки зʼявляються на початку списку, як в Arc. У «Параметри › Загальні» їх можна розміщувати внизу або під поточною вкладкою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新标签页会像在 Arc 中那样从列表顶部开始。可在“设置”>“通用”中将它们放在底部或当前标签页下方。"
          }
        }
      }
    },
    "emptyPage.hintUnreadBadges": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab zeigt eine Zahl, wenn seine Seite etwas Ungelesenes hat. Klicke mit der rechten Maustaste darauf, um die Kennzeichen dieser Website auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab shows a count when its page has something unread. Right-click it to hide that site's badges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña muestra un número cuando su página tiene algo sin leer. Haz clic con el botón derecho en ella para ocultar los globos de ese sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet affiche un nombre lorsque sa page contient quelque chose de non lu. Faites un clic droit dessus pour masquer les pastilles de ce site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページに未読がある場合、タブに件数が表示されます。右クリックすると、そのサイトのバッジを非表示にできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta pokazuje liczbę, gdy jej strona ma coś nieprzeczytanego. Kliknij ją prawym przyciskiem, aby ukryć plakietki tej witryny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка показывает число, если на ее странице есть непрочитанное. Нажмите ее правой кнопкой, чтобы скрыть наклейки этого сайта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка показує число, коли на її сторінці є щось непрочитане. Клацніть її правою кнопкою, щоб сховати значки цього сайту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当标签页的页面有未读内容时，标签页会显示计数。右键点按它可隐藏该网站的标记。"
          }
        }
      }
    },
    "emptyPage.hintPageWords": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Befehlsleiste findet eine besuchte Seite anhand der Wörter, die du darauf gelesen hast, nicht nur anhand ihres Titels."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command bar finds a page you visited by the words you read on it, not only by its title."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de comandos encuentra una página que has visitado por las palabras que leíste en ella, no solo por su título."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de commandes retrouve une page que vous avez visitée grâce aux mots que vous y avez lus, et pas seulement grâce à son titre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドバーでは、タイトルだけでなく、ページで読んだ言葉からも、表示したページを探せます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek poleceń znajduje odwiedzoną stronę po słowach z jej treści, nie tylko po jej tytule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель команд находит посещенную страницу по словам, которые Вы на ней читали, а не только по заголовку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель команд знаходить відвідану сторінку за словами, які ви на ній читали, а не лише за заголовком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令栏可以通过你在页面上读到的词语找到你访问过的页面，而不仅仅是通过标题。"
          }
        }
      }
    },
    "emptyPage.hintFolderPreview": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege den Zeiger auf einen Ordner, um seine Tabs mit einer Suche aufzulisten, ohne ihn zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest the pointer on a folder to list its tabs, with a search, without opening it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el puntero sobre una carpeta para ver sus pestañas, con una búsqueda, sin abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le pointeur sur un dossier pour lister ses onglets, avec une recherche, sans l’ouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダにポインタを合わせると、フォルダを開かずに、検索付きでタブの一覧を表示できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj wskaźnik na folderze, aby zobaczyć listę jego kart, z wyszukiwaniem, bez otwierania go."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержите указатель на папке, чтобы увидеть список ее вкладок с поиском, не открывая ее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть вказівник на папку, щоб побачити її вкладки з пошуком, не відкриваючи її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针停在文件夹上，即可在不打开它的情况下列出其标签页，并可搜索。"
          }
        }
      }
    },
    "emptyPage.hintGmail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange Gmail in einem Favoriten geöffnet ist, zeigt dir der Zeiger auf dem Favoriten deine neuesten ungelesenen E-Mails."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Gmail is open in a Favorite, rest the pointer on the Favorite to see your latest unread mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras Gmail está abierto en un favorito, deja el puntero sobre el favorito para ver tu último correo sin leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque Gmail est ouvert dans un favori, placez le pointeur sur le favori pour voir vos derniers e-mails non lus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmailをお気に入りで開いている間、そのお気に入りにポインタを合わせると、最新の未読メールが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy Gmail jest otwarty w ulubionej, zatrzymaj na niej wskaźnik, aby zobaczyć najnowszą nieprzeczytaną pocztę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если Gmail открыт в избранной вкладке, задержите указатель на ней, чтобы увидеть последние непрочитанные письма."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли Gmail відкрито в улюбленому, наведіть вказівник на нього, щоб побачити останні непрочитані листи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在个人收藏中打开 Gmail 时，将指针停在该个人收藏上，即可查看最新的未读邮件。"
          }
        }
      }
    },
    "emptyPage.hintRecentPages": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Favorit von Linear, Notion oder Figma listet die Seiten auf, die du dort zuletzt geöffnet hast, wenn du den Zeiger darauf bewegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Linear, Notion or Figma Favorite lists the pages you opened there last when you rest the pointer on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un favorito de Linear, Notion o Figma muestra las últimas páginas que abriste allí cuando dejas el puntero sobre él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un favori Linear, Notion ou Figma liste les dernières pages que vous y avez ouvertes lorsque vous placez le pointeur dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linear、Notion、Figmaのお気に入りにポインタを合わせると、そこで最後に開いたページが一覧表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubiona Linear, Notion lub Figma wyświetla strony, ostatnio otwarte w niej, gdy zatrzymasz na niej wskaźnik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранная вкладка Linear, Notion или Figma показывает последние открытые в ней страницы, если задержать на ней указатель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Улюблена вкладка Linear, Notion чи Figma перелічує сторінки, які ви відкривали там останніми, коли навести на неї вказівник."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针停在 Linear、Notion 或 Figma 的个人收藏上，会列出你最近在其中打开的页面。"
          }
        }
      }
    },
    "emptyPage.hintQuit": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fragt, bevor Arx beendet wird. Unter Einstellungen › Allgemein kannst du diese Frage ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks before it quits. Settings › General can turn that question off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pregunta antes de salir. Ajustes › General puede desactivar esa pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande confirmation avant de quitter. Réglages › Général permet de désactiver cette question."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、終了前に確認します。「設定」＞「一般」でこの確認をオフにできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pyta przed zakończeniem. Ustawienia › Ogólne mogą wyłączyć to pytanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ спрашивает перед завершением. В «Настройки › Основные» этот вопрос можно отключить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ питає перед завершенням роботи. У «Параметри › Загальні» це запитання можна вимкнути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在退出前会先询问。可在“设置”>“通用”中关闭该询问。"
          }
        }
      }
    },
    "emptyPage.hintAssistantSignIn": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenten sehen nie deine Passwörter. Wenn sich eine Website eine Anmeldung von dir wünscht, übergeben sie dir die Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistants never see your passwords. When a site needs you to sign in, they hand the page to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los asistentes nunca ven tus contraseñas. Cuando un sitio necesita que inicies sesión, te ceden la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les assistants ne voient jamais vos mots de passe. Quand un site vous demande de vous connecter, ils vous passent la main sur la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントがパスワードを見ることはありません。サイトでサインインが必要なときは、ページをあなたに引き渡します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystenci nigdy nie widzą Twoich haseł. Gdy witryna wymaga zalogowania, oddają Ci stronę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистенты никогда не видят Ваши пароли. Когда сайт требует входа, они передают страницу Вам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистенти ніколи не бачать ваші паролі. Коли сайт вимагає входу, вони передають сторінку вам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理绝不会看到你的密码。当网站需要你登录时，它们会把页面交给你。"
          }
        }
      }
    },
    "emptyPage.hintSwipeBack": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche mit zwei Fingern seitlich über eine Seite, um zurück oder vorwärts zu gehen. Streiche weiter und halte, um eine beliebige Seite aus ihrem Verlauf auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe sideways with two fingers on a page to go back or forward. Push further and hold to pick any page from its history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia los lados con dos dedos en una página para ir atrás o adelante. Empuja más y mantén para elegir cualquier página de su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez latéralement avec deux doigts sur une page pour revenir en arrière ou avancer. Allez plus loin et maintenez pour choisir n’importe quelle page de son historique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ上で2本指で横にスワイプすると、戻る/進むができます。さらに押し込んで保持すると、履歴から好きなページを選べます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń dwoma palcami w bok po stronie, aby wrócić lub przejść do przodu. Przesuń dalej i przytrzymaj, aby wybrać dowolną stronę z historii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите двумя пальцами в сторону на странице, чтобы вернуться назад или перейти вперед. Проведите дальше и удерживайте, чтобы выбрать любую страницу из истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть двома пальцями вбік на сторінці, щоб перейти назад або вперед. Проведіть далі й утримуйте, щоб вибрати будь-яку сторінку з її історії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在页面上用两指横向轻扫即可后退或前进。继续推动并按住，可从历史记录中选取任意页面。"
          }
        }
      }
    },
    "emptyPage.hintDownloads": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiere einen Download in „Downloads“ und setze ihn später fort, auch nach dem Beenden von Arx."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause a download in Downloads and resume it later, even after you quit Arx."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa una descarga en Descargas y reanúdala más tarde, incluso después de salir de Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez un téléchargement en pause dans Téléchargements et reprenez-le plus tard, même après avoir quitté Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロード」でダウンロードを一時停止し、あとで再開できます。Arxを終了したあとでも再開できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj pobieranie na liście Pobrane i wznów je później, nawet po zakończeniu Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановите загрузку в списке загрузок и возобновите ее позже, даже после завершения Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупиніть викачування у списку викачувань і відновіть його пізніше, навіть після завершення роботи Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在“下载”中暂停下载，稍后再继续，即使退出 Arx 也可以。"
          }
        }
      }
    },
    "emptyPage.hintDefaultBrowser": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Einstellungen › Arx siehst du, ob Arx deine Links aus anderen Apps öffnet, und kannst Arx zu deinem Standardbrowser machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Arx shows whether Arx opens your links from other apps, and can make it your default browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes › Arx muestra si Arx abre tus enlaces de otras apps y puede convertirlo en tu navegador por omisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages › Arx indique si Arx ouvre vos liens provenant d’autres apps, et peut en faire votre navigateur par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」＞「Arx」では、ArxがほかのAppからのリンクを開くかどうかを確認でき、ArxをデフォルトのWebブラウザにすることもできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia › Arx pokazują, czy Arx otwiera Twoje łącza z innych aplikacji, i mogą ustawić go jako domyślną przeglądarkę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Настройки › Arx» показывает, открывает ли Arx Ваши ссылки из других приложений, и может сделать его браузером по умолчанию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Параметри › Arx» показують, чи відкриває Arx ваші посилання з інших програм, і можуть зробити його вашим основним браузером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”>“Arx”会显示 Arx 是否会打开来自其他 App 的链接，并且可以将其设为你的默认网页浏览器。"
          }
        }
      }
    },
