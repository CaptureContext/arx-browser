    "persistence.failure.unsupportedVersion": {
      "comment": "%lld is the version number of the saved file's format, newer than this Arx reads.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Räume und Tabs wurden im Format %lld gesichert. Öffne sie mit einer neueren Version von Arx."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your spaces and tabs were saved in format %lld. Open them with a newer Arx version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus secciones y pestañas se guardaron en el formato %lld. Ábrelas con una versión más reciente de Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos sections et onglets ont été enregistrés au format %lld. Ouvrez-les avec une version plus récente d’Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースとタブは形式%lldで保存されています。新しいバージョンのArxで開いてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje strefy i karty zostały zachowane w formacie %lld. Otwórz je w nowszej wersji Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши разделы и вкладки сохранены в формате %lld. Откройте их в более новой версии Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші розділи та вкладки збережено у форматі %lld. Відкрийте їх новішою версією Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的分区和标签页以格式 %lld 存储。请使用更新版本的 Arx 打开。"
          }
        }
      }
    },
    "persistence.failure.unsupportedOrganization": {
      "comment": "Shown when the saved profiles, spaces and tabs have no profile or no space.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx benötigt mindestens ein Profil und einen Raum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx needs at least one profile and space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx necesita al menos un perfil y una sección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx requiert au moins un profil et une section."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxには、少なくとも1つのプロファイルとスペースが必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx wymaga co najmniej jednego profilu i jednej strefy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Arx нужны хотя бы один профиль и один раздел."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx потрібен щонайменше один профіль і один розділ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 至少需要一个用户场景和一个分区。"
          }
        }
      }
    },
    "persistence.failure.invalidOrganization": {
      "comment": "Shown when the profiles, spaces, folders and tabs contradict each other, so the save was refused.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx konnte deine Tabs, Ordner und Räume nicht sichern, weil sie nicht zusammenpassen. Deine Fenster zeigen weiterhin alles. Exportiere sie, um eine Kopie zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx couldn't save your tabs, folders and spaces because they don't fit together. Your windows still show everything. Export them to keep a copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx no ha podido guardar tus pestañas, carpetas y secciones porque no encajan entre sí. Tus ventanas siguen mostrándolo todo. Expórtalas para conservar una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx n’a pas pu enregistrer vos onglets, dossiers et sections, car ils ne sont pas cohérents entre eux. Vos fenêtres affichent toujours tout. Exportez-les pour en conserver une copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブ、フォルダ、スペースが整合しないため、Arxは保存できませんでした。ウインドウにはすべてが表示されたままです。コピーを残すには、書き出してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie mógł zachować kart, folderów i stref, ponieważ do siebie nie pasują. Twoje okna nadal pokazują wszystko. Wyeksportuj je, aby zachować kopię."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не удалось сохранить Ваши вкладки, папки и разделы, так как они не согласуются друг с другом. В Ваших окнах по-прежнему отображается все. Экспортируйте их, чтобы сохранить копию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не вдалося зберегти ваші вкладки, папки та розділи, бо вони не узгоджуються. Ваші вікна досі показують усе. Експортуйте їх, щоб зберегти копію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 无法存储你的标签页、文件夹和分区，因为它们互不匹配。你的窗口仍会显示所有内容。请导出它们以保留一份副本。"
          }
        }
      }
    },
    "persistence.failure.changedOnDisk": {
      "comment": "Shown when another program changed the file holding profiles, spaces, folders and tabs while Arx was running.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei mit deinen Räumen und Tabs wurde auf dem Datenträger geändert. Exportiere deine nicht gesicherten Änderungen, bevor du Arx erneut öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file with your spaces and tabs changed on disk. Export your unsaved changes before reopening Arx."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo con tus secciones y pestañas ha cambiado en el disco. Exporta los cambios sin guardar antes de volver a abrir Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier contenant vos sections et onglets a changé sur le disque. Exportez vos modifications non enregistrées avant de rouvrir Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースとタブのファイルがディスク上で変更されました。Arxを開き直す前に、保存されていない変更を書き出してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik z Twoimi strefami i kartami zmienił się na dysku. Wyeksportuj niezachowane zmiany, zanim ponownie otworzysz Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл с Вашими разделами и вкладками изменился на диске. Экспортируйте несохраненные изменения, прежде чем снова открывать Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл із вашими розділами та вкладками змінено на диску. Експортуйте незбережені зміни, перш ніж знову відкривати Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存有你的分区和标签页的文件在磁盘上已更改。重新打开 Arx 之前，请导出你未存储的更改。"
          }
        }
      }
    },
    "persistence.failure.synchronizationFailed": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheitsänderung konnte nicht mit dem Speicher synchronisiert werden. Die Automatisierung bleibt pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security change could not be synchronized to storage. Automation remains paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido sincronizar con el almacenamiento el cambio de seguridad. La automatización sigue en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification de sécurité n’a pas pu être synchronisée avec le stockage. L’automatisation reste suspendue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティの変更をストレージに同期できませんでした。自動操作は停止したままです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zsynchronizować zmiany zabezpieczeń z pamięcią. Automatyzacja pozostaje wstrzymana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось синхронизировать изменение безопасности с хранилищем. Автоматизация остается приостановленной."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося синхронізувати зміну безпеки зі сховищем. Автоматизація лишається призупиненою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将安全性更改同步到储存空间。自动化仍处于暂停状态。"
          }
        }
      }
    },
    "retirement.failure.ownershipChanged": {
      "comment": "Removing a profile with “Permanently erase this profile’s website data”: Arx closes the profile and erases its cookies, accounts, history and cached website data, which finishes only after Arx reopens and then the Mac restarts. “Retirement” and “cleanup” are that removal and erasure.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Identität des Browserspeichers hat sich geändert. Die Profilbereinigung ist blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser storage identity changed. Profile cleanup is blocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad del almacenamiento del navegador ha cambiado. La limpieza de perfiles está bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité du stockage du navigateur a changé. Le nettoyage du profil est bloqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのストレージのIDが変更されました。プロファイルの消去はブロックされています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tożsamość pamięci przeglądarki uległa zmianie. Czyszczenie profilu jest zablokowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор хранилища браузера изменился. Очистка профиля заблокирована."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідентифікатор сховища браузера змінився. Очищення профілю заблоковано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器储存标识已更改。用户场景清除已被阻止。"
          }
        }
      }
    },
    "retirement.failure.corrupt": {
      "comment": "Removing a profile with “Permanently erase this profile’s website data”: Arx closes the profile and erases its cookies, accounts, history and cached website data, which finishes only after Arx reopens and then the Mac restarts. “Retirement” and “cleanup” are that removal and erasure.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Datensatz der Profilbereinigung muss wiederhergestellt werden. Vorhandene Daten wurden beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private profile cleanup record needs recovery. Existing data has been preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro privado de limpieza de perfiles necesita recuperación. Se han conservado los datos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement privé du nettoyage de profil doit être récupéré. Les données existantes ont été conservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開のプロファイル消去の記録を復旧する必要があります。既存のデータは保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatny zapis czyszczenia profilu wymaga odzyskania. Istniejące dane zachowano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытую запись об очистке профиля нужно восстановить. Существующие данные сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватний запис очищення профілю потребує відновлення. Наявні дані збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密的用户场景清除记录需要恢复。现有数据已保留。"
          }
        }
      }
    },
    "retirement.failure.busy": {
      "comment": "Removing a profile with “Permanently erase this profile’s website data”: Arx closes the profile and erases its cookies, accounts, history and cached website data, which finishes only after Arx reopens and then the Mac restarts. “Retirement” and “cleanup” are that removal and erasure.",
