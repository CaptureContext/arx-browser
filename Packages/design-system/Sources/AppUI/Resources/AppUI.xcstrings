    "siteSettings.defaultsDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was eine Website erhält, die keine eigene Einstellung hat. Websites, die nachfragen, zeigen zuerst eine Abfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a site gets when it hasn't got its own setting. Sites that ask show a prompt first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que recibe un sitio que no tiene un ajuste propio. Los sitios que preguntan muestran antes un aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’un site obtient quand il n’a pas de réglage propre. Les sites qui demandent affichent d’abord une invite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイト独自の設定がない場合に適用される内容です。確認を求めるサイトでは、最初にメッセージが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co dostaje witryna, która nie ma własnego ustawienia. Witryny, które pytają, najpierw pokazują monit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что получает сайт, если у него нет собственной настройки. Сайты, которые запрашивают разрешение, сначала показывают запрос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що отримує сайт, коли не має власного параметра. Сайти, які запитують дозвіл, спершу показують запит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站在没有自己的设置时所获得的权限。会询问的网站会先显示提示。"
          }
        }
      }
    },
