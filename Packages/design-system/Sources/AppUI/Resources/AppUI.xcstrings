    "reportProblem.notOpenYet": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn GitHub meldet, dass die Seite nicht gefunden wurde, ist das Arx-Repository für deinen Account noch nicht geöffnet. Sende die Datei auf anderem Weg an das Arx-Team."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If GitHub says the page can't be found, the Arx repository isn't open to your account yet. Send the file to the Arx team another way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si GitHub dice que no se encuentra la página, el repositorio de Arx aún no está abierto para tu cuenta. Envía el archivo al equipo de Arx de otra forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si GitHub indique que la page est introuvable, le dépôt d’Arx n’est pas encore ouvert à votre compte. Envoyez le fichier à l’équipe d’Arx d’une autre manière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubでページが見つからないと表示された場合、Arxのリポジトリはまだあなたのアカウントに公開されていません。別の方法で、ファイルをArxチームに送信してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli GitHub informuje, że nie można znaleźć strony, repozytorium Arx nie jest jeszcze otwarte dla Twojego konta. Wyślij plik zespołowi Arx w inny sposób."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если GitHub сообщает, что страница не найдена, репозиторий Arx пока недоступен для Вашей учетной записи. Отправьте файл команде Arx другим способом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо GitHub каже, що сторінку не знайдено, репозиторій Arx ще не відкрито для вашого облікового запису. Надішліть файл команді Arx іншим способом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 GitHub 提示找不到该页面，说明 Arx 仓库尚未向你的账户开放。请通过其他方式将该文件发送给 Arx 团队。"
          }
        }
      }
    },
    "reportProblem.notOpenYetSave": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn GitHub meldet, dass die Seite nicht gefunden wurde, ist das Arx-Repository für deinen Account noch nicht geöffnet. Sichere den Bericht und sende ihn auf anderem Weg an das Arx-Team."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If GitHub says the page can't be found, the Arx repository isn't open to your account yet. Save the report and send it to the Arx team another way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si GitHub dice que no se encuentra la página, el repositorio de Arx aún no está abierto para tu cuenta. Guarda el informe y envíalo al equipo de Arx de otra forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si GitHub indique que la page est introuvable, le dépôt d’Arx n’est pas encore ouvert à votre compte. Enregistrez le signalement et envoyez-le à l’équipe d’Arx d’une autre manière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubでページが見つからないと表示された場合、Arxのリポジトリはまだあなたのアカウントに公開されていません。レポートを保存して、別の方法でArxチームに送信してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli GitHub informuje, że nie można znaleźć strony, repozytorium Arx nie jest jeszcze otwarte dla Twojego konta. Zachowaj raport i wyślij go zespołowi Arx w inny sposób."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если GitHub сообщает, что страница не найдена, репозиторий Arx пока недоступен для Вашей учетной записи. Сохраните отчет и отправьте его команде Arx другим способом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо GitHub каже, що сторінку не знайдено, репозиторій Arx ще не відкрито для вашого облікового запису. Збережіть звіт і надішліть його команді Arx іншим способом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 GitHub 提示找不到该页面，说明 Arx 仓库尚未向你的账户开放。请存储报告，并通过其他方式发送给 Arx 团队。"
          }
        }
      }
    },
