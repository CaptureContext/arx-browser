    "settings.profileSandbox": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Profil behält seine eigenen Anmeldungen, Passwörter, Erweiterungen, seinen Verlauf und seine Website-Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each profile keeps its own sign-ins, passwords, extensions, history and website data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil conserva sus propios inicios de sesión, contraseñas, extensiones, historial y datos de sitios web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil conserve ses propres connexions, mots de passe, extensions, historique et données de sites web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プロファイルは、サインイン情報、パスワード、機能拡張、履歴、ウェブサイトのデータをそれぞれ別に保持します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy profil ma własne logowania, hasła, rozszerzenia, historię i dane witryn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого профиля свои входы, пароли, расширения, история и данные веб-сайтов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен профіль зберігає власні входи, паролі, розширення, історію та дані вебсайтів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个用户场景都有各自的登录信息、密码、扩展、历史记录和网站数据。"
          }
        }
      }
    },
    "settings.profilesDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile halten Website-Sitzungen und Browserdaten getrennt. Jeder Raum gehört zu einem Profil; ein Profil kann von mehreren Räumen verwendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles keep website sessions and browsing data separate. Each space belongs to one profile; a profile can be shared by several spaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles mantienen separadas las sesiones de sitios web y los datos de navegación. Cada sección pertenece a un perfil; un perfil puede compartirse entre varias secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils séparent les sessions de sites web et les données de navigation. Chaque section appartient à un profil ; un profil peut être partagé par plusieurs sections."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルは、ウェブサイトのセッションと閲覧履歴データを分けて保持します。各スペースは1つのプロファイルに属し、1つのプロファイルを複数のスペースで共有できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile oddzielają sesje witryn i dane przeglądania. Każda strefa należy do jednego profilu; profil może być wspólny dla kilku stref."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили хранят сеансы веб-сайтов и данные о работе в браузере отдельно. Каждый раздел принадлежит одному профилю; один профиль могут использовать несколько разделов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі розділяють сеанси вебсайтів і дані вебперегляду. Кожен розділ належить одному профілю; один профіль можуть спільно використовувати кілька розділів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户场景会将网站会话和浏览数据分隔开。每个分区属于一个用户场景；一个用户场景可由多个分区共用。"
          }
        }
      }
    },
    "settings.quotes": {
