    "onboarding.makeItYours.keepSpacesOff": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet: Alles kommt in eine Liste in deinem aktuellen Raum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off, it all comes into one list in your current space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, todo entra en una sola lista de tu sección actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, tout arrive dans une seule liste de votre section actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、すべてが現在のスペースの1つのリストに読み込まれます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone: wszystko trafia na jedną listę w bieżącej strefie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: все попадет в один список в Вашем текущем разделе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнено: усе потрапить в один список у вашому поточному розділі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭，所有内容会汇入你当前分区中的一个列表。"
          }
        }
      }
    },
    "onboarding.makeItYours.keepSpacesOn": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder seiner Räume kommt als eigener Raum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each of its spaces comes in as a space of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada una de sus secciones entra como una sección propia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacune de ses sections arrive comme une section à part entière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各スペースが、それぞれ独立したスペースとして読み込まれます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda z jej stref trafia jako osobna strefa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый из его разделов переносится как отдельный раздел."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен його розділ стане окремим розділом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的每个分区都会作为一个独立的分区导入。"
          }
        }
      }
    },
    "onboarding.makeItYours.noBrowsers": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx hat keinen Browser gefunden, aus dem es etwas übernehmen kann. Du kannst trotzdem ein Arx-Archiv oder eine Lesezeichendatei übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx didn’t find a browser it can bring things from. You can still bring an Arx archive or a bookmarks file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx no ha encontrado ningún navegador del que traer cosas. Aún puedes traer un archivo de Arx o un archivo de marcadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx n’a pas trouvé de navigateur depuis lequel importer. Vous pouvez tout de même importer une archive Arx ou un fichier de signets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxが読み込めるブラウザは見つかりませんでした。Arxのアーカイブまたはブックマークファイルは読み込めます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie znalazł przeglądarki, z której może coś przenieść. Nadal możesz przenieść archiwum Arx lub plik zakładek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не нашел браузер, из которого можно что-то перенести. Можно по-прежнему перенести архив Arx или файл закладок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не знайшов браузера, з якого можна щось перенести. Ви все ще можете перенести архів Arx або файл закладок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 没有找到可以导入内容的浏览器。你仍然可以导入 Arx 归档或书签文件。"
          }
        }
      }
    },
