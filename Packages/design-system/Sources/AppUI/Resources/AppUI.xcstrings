    "onboarding.tour.commandBar.message": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um Tabs, Verlauf und Aktionen zu finden, und drücke dann den Zeilenschalter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type to find tabs, history and actions, then press Return."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe para encontrar pestañas, historial y acciones, y pulsa Retorno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez pour trouver des onglets, de l’historique et des actions, puis appuyez sur Retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力してタブ、履歴、アクションを探し、Returnキーを押します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz, aby znaleźć karty, historię i czynności, a następnie naciśnij Return."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводите, чтобы найти вкладки, историю и действия, затем нажмите Return."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть, щоб знайти вкладки, історію й дії, а потім натисніть Return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入内容以查找标签页、历史记录和操作，然后按下 Return 键。"
          }
        }
      }
    },
    "onboarding.tour.commandBar.description": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Die Eingabe von „peek“ in der Befehlsleiste findet einen Tab, eine Seite aus dem Verlauf und eine Aktion, und der Zeilenschalter wechselt zum Tab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: typing “peek” in the command bar finds a tab, a page from history and an action, and Return switches to the tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostración: al escribir “peek” en la barra de comandos aparecen una pestaña, una página del historial y una acción, y Retorno cambia a la pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démo : la saisie de « peek » dans la barre de commandes trouve un onglet, une page de l’historique et une action, et Retour bascule vers l’onglet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ：コマンドバーに「peek」と入力すると、タブ、履歴のページ、アクションが見つかり、Returnキーでそのタブに切り替わります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: wpisanie „peek” na pasku poleceń znajduje kartę, stronę z historii i czynność, a Return przełącza na kartę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрация: ввод «peek» в панели команд находит вкладку, страницу из истории и действие, а клавиша Return переключает на вкладку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрація: введення «peek» у панелі команд знаходить вкладку, сторінку з історії та дію, а Return перемикає на вкладку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示：在命令栏中输入“peek”，会找到一个标签页、一个历史记录中的页面和一个操作，按下 Return 键即可切换到该标签页。"
          }
        }
      }
    },
    "onboarding.tour.chats.headline": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag zur Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez des questions sur la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページについて質問しましょう。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj o stronę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите о странице."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте про сторінку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问有关页面的问题。"
          }
        }
      }
    },
    "onboarding.tour.chats.message": {
      "comment": "Onboarding tour, Chats page: the line under the title. ⇧Esc is the shortcut that hides the chat.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne einen Chat neben der Seite und stelle Fragen dazu. ⇧Esc blendet ihn aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a chat beside the page and ask about it. ⇧Esc hides it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un chat junto a la página y pregunta sobre ella. ⇧Esc lo oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une discussion à côté de la page et posez-lui des questions. ⇧Échap la masque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの横にチャットを開いて、ページについて質問できます。⇧Escで非表示にします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz czat obok strony i zadaj pytanie o nią. ⇧Esc go ukrywa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте чат рядом со страницей и задайте вопрос о ней. Сочетание ⇧Esc скрывает чат."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте чат поруч зі сторінкою й запитайте про неї. ⇧Esc ховає його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在页面旁边打开聊天，并询问有关该页面的问题。按 ⇧Esc 可将其隐藏。"
          }
        }
      }
    },
    "onboarding.tour.chats.description": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Der Befehl „Chats“ in der Befehlsleiste öffnet den Chat neben einer Seite, „Seite zusammenfassen“ wird ausgewählt, eine kurze Zusammenfassung erscheint nach und nach, und Umschalt-Esc blendet den Chat aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: the Chats command in the command bar opens the chat beside a page, “Summarize the page” is chosen, a short summary streams in, and Shift-Escape hides the chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostración: el comando Chats de la barra de comandos abre el chat junto a una página, se selecciona “Resumir la página”, aparece poco a poco un resumen breve y Mayúsculas-Esc oculta el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démo : la commande Discussions de la barre de commandes ouvre la discussion à côté d’une page, « Résumer la page » est choisi, un court résumé s’affiche progressivement, et Maj-Échap masque la discussion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ：コマンドバーの「チャット」コマンドでページの横にチャットが開き、「ページを要約」が選択されて短い要約が表示され、Shift＋Escでチャットが非表示になります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: polecenie Czaty na pasku poleceń otwiera czat obok strony, wybrano „Podsumuj stronę”, pojawia się krótkie podsumowanie, a Shift-Esc ukrywa czat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрация: команда «Чаты» в панели команд открывает чат рядом со страницей, выбирается «Кратко изложить страницу», появляется краткое содержание, а Shift-Esc скрывает чат."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрація: команда «Чати» в панелі команд відкриває чат поруч зі сторінкою, вибирається «Підсумувати сторінку», зʼявляється короткий підсумок, а Shift-Esc ховає чат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示：在命令栏中使用“聊天”命令，会在页面旁边打开聊天；选取“总结此页面”，随即出现简短的摘要，按 Shift-Esc 可隐藏聊天。"
          }
        }
      }
    },
