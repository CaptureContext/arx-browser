    "extensions.allowInPrivateDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt dieser Erweiterung, Seiten in privaten Fenstern zu sehen und zu ändern. Standardmäßig ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets this extension see and change pages in private windows. Off by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que esta extensión vea y cambie páginas en ventanas privadas. Desactivado por omisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à cette extension de voir et de modifier les pages dans les fenêtres privées. Désactivé par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能拡張が、プライベートウインドウのページを表示したり変更したりできるようにします。デフォルトではオフです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala temu rozszerzeniu widzieć i zmieniać strony w oknach prywatnych. Domyślnie wyłączone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет этому расширению видеть и изменять страницы в частных окнах. По умолчанию выключено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дає цьому розширенню змогу бачити й змінювати сторінки в приватних вікнах. Типово вимкнено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此扩展查看和更改无痕浏览窗口中的页面。默认关闭。"
          }
        }
      }
    },
