    "settings.globalShortcutFailed": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte diesen Tastaturkurzbefehl nicht registrieren (Fehler %lld). Er ist möglicherweise reserviert oder bereits in Verwendung. Wähle eine andere Tastenkombination oder schalte diese Option aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not register this shortcut (error %lld). It may be reserved or already in use. Choose another binding or toggle this setting to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no ha podido registrar este atajo (error %lld). Puede estar reservado o ya en uso. Elige otra combinación o desactiva y vuelve a activar este ajuste para reintentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas pu enregistrer ce raccourci (erreur %lld). Il est peut-être réservé ou déjà utilisé. Choisissez une autre combinaison ou désactivez puis réactivez ce réglage pour réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSでこのショートカットを登録できませんでした（エラー%lld）。予約済みか、すでに使用されている可能性があります。ほかのキーの組み合わせを選択するか、この設定をオフにしてからオンにして再試行してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nie mógł zarejestrować tego skrótu (błąd %lld). Może być zarezerwowany lub już używany. Wybierz inny skrót albo przełącz to ustawienie, aby spróbować ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не удалось зарегистрировать это сочетание клавиш (ошибка %lld). Возможно, оно зарезервировано или уже используется. Выберите другое сочетание или выключите и снова включите этот параметр."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не вдалося зареєструвати це скорочення (помилка %lld). Можливо, воно зарезервоване або вже використовується. Виберіть інше скорочення або вимкніть і ввімкніть цей параметр, щоб спробувати ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法注册此快捷键（错误 %lld）。它可能已被保留或正在使用。请选取其他按键组合，或将此设置关闭再打开以重试。"
          }
        }
      }
    },
