    "settings.iCloudSync.review.message": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Profile, Räume und Einstellungen dieses Macs wurden mit einem anderen iCloud-Account synchronisiert. An diesen wurde noch nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac’s profiles, spaces and preferences were syncing with a different iCloud account. Nothing has been sent to this one yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles, secciones y preferencias de este Mac se sincronizaban con otra cuenta de iCloud. Todavía no se ha enviado nada a esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils, sections et préférences de ce Mac étaient synchronisés avec un autre compte iCloud. Rien n’a encore été envoyé à celui-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのプロファイル、スペース、環境設定は、別のiCloudアカウントと同期されていました。このアカウントには、まだ何も送信されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile, strefy i preferencje tego Maca były synchronizowane z innym kontem iCloud. Nic nie zostało jeszcze wysłane na to konto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили, разделы и настройки этого Mac синхронизировались с другой учетной записью iCloud. В эту учетную запись пока ничего не отправлено."
          }
        },
