    "relocation.promptTitle": {
      "comment": "Asked at launch when Arx runs from its disk image or the Downloads folder: Arx offers to move itself into the Applications folder and reopen from there. The alert's title.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx in den Ordner „Programme“ bewegen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Arx to Applications?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Trasladar Arx a Aplicaciones?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer Arx dans le dossier Applications ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxを「アプリケーション」フォルダに移動しますか？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieść Arx do folderu Aplikacje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить Arx в папку «Программы»?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістити Arx у папку «Програми»?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将 Arx 移到“应用程序”文件夹吗？"
          }
        }
      }
    },
    "relocation.promptMessage": {
      "comment": "Asked at launch when Arx runs from its disk image or the Downloads folder: Arx offers to move itself into the Applications folder and reopen from there. The alert's text.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx funktioniert am besten im Ordner „Programme“. Es wird dorthin bewegt und öffnet sich erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx works best from your Applications folder. It will move there and open again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx funciona mejor desde la carpeta Aplicaciones. Se trasladará allí y se abrirá de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx fonctionne mieux depuis votre dossier Applications. Il va s’y placer et se rouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは「アプリケーション」フォルダから使用するのが最適です。そこに移動して、もう一度開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx działa najlepiej z folderu Aplikacje. Przeniesie się tam i otworzy ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx лучше всего работает из папки «Программы». Он переместится туда и откроется снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx працює найкраще з папки «Програми». Він переміститься туди й відкриється знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 在“应用程序”文件夹中运行效果最佳。它将移到那里并重新打开。"
          }
        }
      }
    },
    "relocation.move": {
