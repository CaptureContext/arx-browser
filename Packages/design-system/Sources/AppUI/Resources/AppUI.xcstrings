    "automation.scriptNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt JavaScript in freigegebenen Tabs aus, in einer getrennten Umgebung, die weder Cookies, Passwörter, Kartennummern noch gesicherte Zugangsdaten lesen kann. Ein Skript kann dennoch alles tun, was du auf dieser Website tun kannst. Jedes Skript fragt dich, sofern die Freigaberegel Änderungen nicht überspringt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs JavaScript in granted tabs, in a separate world that can't read cookies, passwords, card numbers or saved credentials. A script can still do anything you can do on that site. Each script asks you unless the approval policy skips changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta JavaScript en pestañas con permiso, en un entorno aparte que no puede leer cookies, contraseñas, números de tarjeta ni credenciales guardadas. Un script aún puede hacer todo lo que tú puedes hacer en ese sitio. Cada script te pregunta, salvo que la política de aprobación omita los cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute du JavaScript dans les onglets autorisés, dans un monde distinct qui ne peut pas lire les cookies, les mots de passe, les numéros de carte ni les identifiants enregistrés. Un script peut tout de même faire tout ce que vous pouvez faire sur ce site. Chaque script vous demande confirmation, sauf si la politique d’approbation ignore les modifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されたタブで、Cookie、パスワード、カード番号、保存済みの認証情報を読み取れない別の環境でJavaScriptを実行します。それでもスクリプトは、そのサイトでご自身ができることをすべて実行できます。承認ポリシーで変更の確認を省略しない限り、スクリプトごとに確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia JavaScript w kartach objętych zgodą, w osobnym świecie, który nie może odczytać plików cookie, haseł, numerów kart ani zachowanych poświadczeń. Skrypt nadal może zrobić w tej witrynie wszystko, co Ty. Każdy skrypt pyta Cię o zgodę, chyba że zasady zatwierdzania pomijają zmiany."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает JavaScript в разрешенных вкладках в отдельной среде, которая не может читать файлы cookie, пароли, номера карт и сохраненные учетные данные. Скрипт все равно может сделать на сайте все, что можете Вы. Каждый скрипт запрашивает подтверждение, если политика подтверждения не пропускает изменения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконує JavaScript у вкладках з наданим доступом в окремому середовищі, яке не може читати файли cookie, паролі, номери карток чи збережені облікові дані. Скрипт усе одно може робити все, що можете ви на цьому сайті. Кожен скрипт питає вас, якщо політика підтвердження не пропускає зміни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已授权的标签页中运行 JavaScript，运行于无法读取 Cookie、密码、卡号或已存储凭据的独立环境。脚本仍可执行你在该网站上能做的任何事。除非批准策略跳过更改，否则每个脚本都会询问你。"
          }
        }
      }
    },
