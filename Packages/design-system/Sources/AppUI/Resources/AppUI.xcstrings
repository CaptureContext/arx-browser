          }
        }
      }
    },
    "autofill.invalid": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe die Felder: Eine Karte benötigt eine gültige Nummer, eine Adresse mindestens eine Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the fields: a card needs a valid number, an address at least one line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los campos: una tarjeta necesita un número válido y una dirección, al menos una línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les champs : une carte nécessite un numéro valide, une adresse au moins une ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容を確認してください。カードには有効な番号が、住所には1行以上が必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź pola: karta wymaga prawidłowego numeru, a adres co najmniej jednego wiersza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте поля: для карты нужен действительный номер, для адреса — хотя бы одна строка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте поля: картці потрібен дійсний номер, адресі — принаймні один рядок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查各栏：银行卡需要有效的卡号，地址至少需要一行。"
          }
        }
      }
    },
