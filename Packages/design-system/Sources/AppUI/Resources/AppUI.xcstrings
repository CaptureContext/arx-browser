    "automation.presenceStopHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet, was %@ tut, und pausiert den Zugriff, bis du ihn fortsetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends what %@ is doing and pauses its access until you resume it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina lo que está haciendo %@ y pausa su acceso hasta que lo reanudes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met fin à ce que fait %@ et suspend son accès jusqu’à ce que vous le repreniez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の操作を終了し、再開するまでそのアクセスを一時停止します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy to, co robi %@, i wstrzymuje jego dostęp, dopóki go nie wznowisz"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекращает действия %@ и приостанавливает его доступ, пока Вы не возобновите работу"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Припиняє дії %@ і призупиняє його доступ, доки ви не відновите"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束 %@ 正在进行的操作，并暂停其访问权限，直到你继续"
          }
        }
      }
    },
