    "onboarding.tour.sample.page.body": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kleinste Breite bleibt bei 240 Punkt, und ein Doppelklick auf den Rand stellt sie wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the narrowest width at 240 points, and let a double-click on the edge put it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el ancho mínimo en 240 puntos y deja que un doble clic en el borde lo restablezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la largeur minimale à 240 points, et laissez un double-clic sur le bord la rétablir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小幅は240ポイントに保ち、端をダブルクリックすると元に戻るようにします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymaj najmniejszą szerokość 240 punktów i pozwól, by dwukrotne kliknięcie krawędzi ją przywracało."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте наименьшую ширину 240 пунктов, а двойной клик по краю пусть возвращает ее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште найменшу ширину 240 пунктів і нехай подвійне клацання на краю повертає її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将最小宽度保持为 240 点，双击边缘即可恢复。"
          }
        }
      }
    },
