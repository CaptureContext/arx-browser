    "settings.crashReportsFooter": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx bewahrt einen kurzen Bericht zu jedem Absturz 30 Tage lang auf diesem Mac auf und sendet ihn nie irgendwohin. „Problem melden“ kann aktuelle Berichte in eine Datei legen, die du an ein Issue anhängen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx keeps a short report of each crash on this Mac for 30 days and never sends it anywhere. Report a Problem can put recent ones in a file for you to attach to an issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx guarda en este Mac un breve informe de cada fallo durante 30 días y nunca lo envía a ningún sitio. Informar de un problema puede incluir los más recientes en un archivo para que lo adjuntes a una incidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx conserve sur ce Mac un bref rapport de chaque plantage pendant 30 jours et ne l’envoie jamais nulle part. Signaler un problème peut placer les plus récents dans un fichier à joindre à un ticket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは、クラッシュごとの簡単なレポートをこのMacに30日間保存し、どこにも送信しません。「問題を報告…」を使うと、最近のレポートをファイルにまとめて、Issueに添付できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx przechowuje na tym Macu krótki raport z każdej awarii przez 30 dni i nigdzie go nie wysyła. Zgłoś problem może umieścić ostatnie raporty w pliku, który dołączysz do zgłoszenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx хранит на этом Mac краткий отчет о каждом сбое в течение 30 дней и никуда его не отправляет. Команда «Сообщить о проблеме…» может сохранить последние отчеты в файл, который можно приложить к обращению."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx зберігає короткий звіт про кожен збій на цьому Mac упродовж 30 днів і нікуди його не надсилає. Команда «Повідомити про проблему…» може зібрати останні звіти у файл, який можна додати до звернення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会在这台 Mac 上保留每次崩溃的简短报告 30 天，且绝不会将其发送到任何地方。“报告问题”可以将最近的报告放入一个文件，供你附加到问题中。"
          }
        }
      }
    },
