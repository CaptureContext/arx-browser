    "onboarding.tour.splitView.message": {
      "comment": "Onboarding tour, Split View page: the line under the title.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache aus einem Peek ein zweites Teilfenster und wechsle den Fokus zwischen beiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn a Peek into a second pane, and move focus between them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un Peek en un segundo panel y mueve el foco entre ambos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez un Peek en second volet et passez de l’un à l’autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peekを2つ目のペインにして、ペイン間でフォーカスを移動できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień Peek w drugi panel i przełączaj fokus między nimi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превратите Peek во вторую панель и переключайте фокус между ними."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворіть Peek на другу область і переходьте між ними фокусом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Peek 变为第二个窗格，并在两者之间移动焦点。"
          }
        }
      }
    },
    "onboarding.tour.splitView.description": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Ein Peek wird zu einem zweiten Bereich neben der Seite, und der Fokus wechselt von einem Bereich zum anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: a Peek becomes a second pane beside the page, and focus moves from one pane to the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostración: un Peek se convierte en un segundo panel junto a la página y el foco pasa de un panel al otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démo : un Peek devient un second volet à côté de la page, et le focus passe d’un volet à l’autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ：Peekがページの横の2つ目のペインになり、フォーカスが一方のペインからもう一方へ移ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Peek staje się drugim panelem obok strony, a fokus przechodzi z jednego panelu do drugiego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрация: Peek становится второй панелью рядом со страницей, и фокус переходит с одной панели на другую."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрація: Peek стає другою областю поруч зі сторінкою, а фокус переходить з однієї області на іншу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示：Peek 变成页面旁边的第二个窗格，焦点从一个窗格移到另一个窗格。"
          }
        }
      }
    },
