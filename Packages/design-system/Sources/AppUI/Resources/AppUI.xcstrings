    "settings.bangsDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib !Stichwort oder ein Stichwort und den Tabulator ein, um eine Website zu durchsuchen. Suchkürzel gelten für alle Profile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type !keyword, or a keyword and Tab, to search a site. Shortcuts apply to every profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe !palabra clave, o una palabra clave y Tab, para buscar en un sitio. Los atajos se aplican a todos los perfiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez !mot-clé, ou un mot-clé puis Tab, pour effectuer une recherche sur un site. Les raccourcis s’appliquent à tous les profils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「!キーワード」、またはキーワードとTabキーを入力すると、サイト内を検索できます。ショートカットはすべてのプロファイルに適用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz !słowo lub słowo i Tab, aby przeszukać witrynę. Skróty obowiązują we wszystkich profilach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите !ключевое_слово или ключевое слово и Tab, чтобы искать на сайте. Сокращения действуют во всех профилях."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть !ключове_слово або ключове слово й Tab, щоб шукати на сайті. Скорочення діють в усіх профілях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 !关键词，或输入关键词后按 Tab 键，即可搜索某个网站。快捷词适用于所有用户场景。"
          }
        }
      }
    },
