    "onboarding.crashReports.sent": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo im Code von Arx der Absturz passiert ist, welcher Teil von Arx abgestürzt ist und die Versionen von Arx, seiner Engine und macOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the crash happened in Arx's code, which part of Arx crashed, and the versions of Arx, its engine and macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde se produjo el fallo en el código de Arx, qué parte de Arx falló y las versiones de Arx, de su motor y de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’endroit du plantage dans le code d’Arx, la partie d’Arx qui a planté, et les versions d’Arx, de son moteur et de macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxのコード内でクラッシュが発生した場所、クラッシュしたArxの部分、Arx、そのエンジン、macOSのバージョン。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce awarii w kodzie Arx, która część Arx uległa awarii oraz wersje Arx, jego silnika i macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где в коде Arx произошел сбой, какая часть Arx дала сбой, а также версии Arx, его движка и macOS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Де саме в коді Arx стався збій, яка частина Arx зазнала збою, а також версії Arx, його рушія та macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "崩溃发生在 Arx 代码中的位置、Arx 的哪一部分崩溃了，以及 Arx、其引擎和 macOS 的版本。"
          }
        }
      }
    },
