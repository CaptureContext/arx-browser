    "management.markedForDeletionBy": {
      "comment": "Hint on a profile or space another Mac removed from iCloud, where \"sync deletions after\" removes it here. %1$@ is that Mac's name, %2$@ the date it goes here.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %1$@ entfernt. Arx entfernt es hier am %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed on %1$@. Arx removes it here on %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado en %1$@. Arx lo eliminará aquí el %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé sur %1$@. Arx le supprimera ici le %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@で削除されました。Arxは%2$@にこのMacからも削除します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto na %1$@. Arx usunie to tutaj %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено на %1$@. Arx удалит это здесь %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалено на %1$@. Arx видалить це тут %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 %1$@ 上移除。Arx 将于 %2$@ 在此处移除它。"
          }
        }
      }
    },
    "management.markedForDeletion": {
      "comment": "Hint on a profile or space another Mac removed from iCloud, when that Mac has no name, where \"sync deletions after\" removes it here. %@ is the date it goes here.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem anderen Mac entfernt. Arx entfernt es hier am %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed on another Mac. Arx removes it here on %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado en otro Mac. Arx lo eliminará aquí el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé sur un autre Mac. Arx le supprimera ici le %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のMacで削除されました。Arxは%@にこのMacからも削除します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto na innym Macu. Arx usunie to tutaj %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено на другом Mac. Arx удалит это здесь %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалено на іншому Mac. Arx видалить це тут %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在另一台 Mac 上移除。Arx 将于 %@ 在此处移除它。"
          }
        }
      }
    },
    "management.markedStaysBy": {
      "comment": "Hint on a profile or space another Mac removed from iCloud, which stays on this Mac until the person removes it. %@ is that Mac's name.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ entfernt. Es bleibt hier, bis du es entfernst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed on %@. It stays here until you remove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado en %@. Se mantiene aquí hasta que lo elimines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé sur %@. Il reste ici jusqu’à ce que vous le supprimiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で削除されました。削除するまでこのMacに残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto na %@. Zostaje tutaj, dopóki tego nie usuniesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено на %@. Здесь оно останется, пока Вы его не удалите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалено на %@. Тут воно залишиться, доки ви його не видалите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 %@ 上移除。在你移除之前，它会保留在此处。"
          }
        }
      }
    },
