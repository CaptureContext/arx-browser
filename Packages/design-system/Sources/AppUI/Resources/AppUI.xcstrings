    "automation.consequenceSubmit": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann auf %@ einen Schritt auslösen, der nicht widerrufen werden kann, etwa eine Überweisung, das Beenden eines Abonnements oder ein Skript, das etwas drückt oder sendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may take a step on %@ that can't be undone, such as a transfer, ending a subscription, or a script pressing or sending something."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto puede dar un paso en %@ que no se puede deshacer, como una transferencia, dar de baja una suscripción o un script que pulsa o envía algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut déclencher sur %@ une action irréversible, comme un virement, la résiliation d’un abonnement ou un script qui appuie sur un bouton ou envoie quelque chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で、送金、サブスクリプションの終了、スクリプトによる押下や送信など、取り消せない操作が行われる可能性があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To może wykonać w witrynie %@ krok, którego nie można cofnąć, na przykład przelew, zakończenie subskrypcji lub naciśnięcie albo wysłanie czegoś przez skrypt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это может выполнить на сайте %@ необратимое действие, например перевод, отмену подписки или нажатие или отправку скриптом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це може виконати на %@ дію, яку не можна відмінити, наприклад переказ, скасування підписки або натискання чи надсилання скриптом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可能会在 %@ 上执行无法撤销的步骤，例如转账、终止订阅，或由脚本按下或发送某些内容。"
          }
        }
      }
    },
    "automation.consequenceAlwaysAsks": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx fragt vor jedem solchen Tastendruck nach, unabhängig von der Freigabeeinstellung dieses Agenten. Arx kann nicht widerrufen, was es auf der Website tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx asks before every press like this, whatever this agent's approval setting. Arx can't undo what it does on the website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx pregunta antes de cada pulsación como esta, sea cual sea el ajuste de aprobación de este agente. Arx no puede deshacer lo que hace en el sitio web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx demande avant chaque appui de ce type, quel que soit le réglage d’approbation de cet agent. Arx ne peut pas annuler ce qu’il fait sur le site web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントの承認設定にかかわらず、Arxはこのような操作のたびに確認します。Arxはウェブサイトでの操作を取り消せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx pyta przed każdym takim naciśnięciem, niezależnie od ustawienia zatwierdzania tego agenta. Arx nie może cofnąć tego, co zrobi w witrynie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx спрашивает перед каждым таким нажатием, независимо от настройки подтверждения для этого агента. Arx не может отменить действия на сайте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx питає перед кожним таким натисканням, незалежно від параметра підтвердження цього агента. Arx не може відмінити те, що відбувається на вебсайті."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论此智能体的批准设置如何，Arx 在每次这样的按下操作前都会询问。Arx 无法撤销它在网站上所做的操作。"
          }
        }
      }
    },
    "viewer.unresponsiveTitle": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
