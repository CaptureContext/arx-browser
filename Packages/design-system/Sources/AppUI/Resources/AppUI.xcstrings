    "management.removeWhereDetail": {
      "comment": "Under Delete Space or Delete Profile, when another Mac syncs it with iCloud: what Remove from iCloud does.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus iCloud entfernen“ fragt zuerst deine anderen Macs: Sie behalten es, bis sie zustimmen oder ihr Entfernungsdatum erreicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from iCloud asks your other Macs first: they keep it until they agree or their removal date passes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Eliminar de iCloud” pregunta primero a tus otros Mac: lo conservan hasta que estén de acuerdo o llegue su fecha de eliminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Supprimer d’iCloud » demande d’abord à vos autres Mac : ils le conservent jusqu’à ce qu’ils acceptent ou que leur date de suppression soit passée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「iCloudから削除」は、まずほかのMacに確認します。同意するか削除日が過ぎるまで、ほかのMacには残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Usuń z iCloud” najpierw pyta inne Maki: zachowują to, dopóki się nie zgodzą lub nie minie ich data usunięcia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Удалить из iCloud» сначала спрашивает другие Ваши Mac: они сохраняют это, пока не согласятся или не наступит их дата удаления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Видалити з iCloud» спершу запитує інші ваші Mac: вони зберігають це, доки не погодяться або не настане їхня дата видалення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“从 iCloud 中移除”会先询问你的其他 Mac：在它们同意或到达各自的移除日期之前，它们会保留此项。"
          }
        }
      }
    },
