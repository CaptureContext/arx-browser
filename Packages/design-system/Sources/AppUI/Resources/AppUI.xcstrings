    "settings.browserDataNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive übertragen Profile, Räume, Tabs und Einstellungen auf einen anderen Mac und führen installierte Erweiterungen auf. Verlauf und Tab-Archiv sind nur enthalten, wenn du sie einschließt. Passwörter, Cookies und Sitzungen sind nicht enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives move profiles, spaces, tabs and preferences to another Mac, and list installed extensions. History and the Tab Archive go in only when you include them. Passwords, cookies and sessions aren’t included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos trasladan perfiles, secciones, pestañas y preferencias a otro Mac, y enumeran las extensiones instaladas. El historial y las pestañas archivadas solo se incluyen si lo indicas. Las contraseñas, las cookies y las sesiones no se incluyen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les archives transfèrent les profils, sections, onglets et préférences vers un autre Mac, et listent les extensions installées. L’historique et les onglets archivés ne sont inclus que si vous le demandez. Les mots de passe, cookies et sessions ne sont pas inclus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブには、プロファイル、スペース、タブ、環境設定を別のMacに移すための情報と、インストール済みの機能拡張のリストが含まれます。履歴とタブアーカイブは、含める場合にのみ書き出されます。パスワード、Cookie、セッションは含まれません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiwa przenoszą profile, strefy, karty i preferencje na inny Mac oraz zawierają listę zainstalowanych rozszerzeń. Historia i Archiwum kart są dołączane tylko wtedy, gdy je uwzględnisz. Hasła, pliki cookie i sesje nie są uwzględniane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивы переносят профили, разделы, вкладки и настройки на другой Mac и содержат список установленных расширений. История и архив вкладок включаются, только если Вы их выберете. Пароли, файлы cookie и сеансы не включаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Архіви переносять профілі, розділи, вкладки й параметри на інший Mac та містять список інстальованих розширень. Історія й архів вкладок додаються, лише якщо ви їх уключите. Паролі, файли cookie й сеанси не входять до архіву."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档会将用户场景、分区、标签页和偏好设置移到另一台 Mac，并列出已安装的扩展。只有在你选择包含时，才会带上历史记录和标签页归档。密码、Cookie 和会话不会包含在内。"
          }
        }
      }
    },
