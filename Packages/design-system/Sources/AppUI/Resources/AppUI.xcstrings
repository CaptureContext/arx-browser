    "management.removeProfileDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil und seine Favoriten aus Arx entfernen? Website-Daten bleiben auf diesem Mac erhalten; Cookies, Passwörter und Browserdaten werden dadurch nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this profile and its favorites from Arx? Website data is retained on this Mac; this does not erase cookies, passwords, or browsing data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este perfil y sus favoritos de Arx? Los datos de sitios web se conservan en este Mac; no se borran las cookies, las contraseñas ni los datos de navegación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce profil et ses favoris d’Arx ? Les données de sites web sont conservées sur ce Mac ; les cookies, les mots de passe et les données de navigation ne sont pas effacés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルとそのお気に入りをArxから削除しますか？ウェブサイトデータはこのMacに残ります。Cookie、パスワード、閲覧履歴データは消去されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć ten profil i jego ulubione z Arx? Dane witryn pozostają na tym Macu; nie zostaną wymazane pliki cookie, hasła ani dane przeglądania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот профиль и его избранное из Arx? Данные веб-сайтов остаются на этом Mac; файлы cookie, пароли и данные о работе в браузере не стираются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити цей профіль і його улюблені з Arx? Дані вебсайтів залишаються на цьому Mac; файли cookie, паролі та дані вебперегляду не стираються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从 Arx 中移除此用户场景及其个人收藏吗？网站数据会保留在这台 Mac 上；这不会抹掉 Cookie、密码或浏览数据。"
          }
        }
      }
    },
