    "migration.credentials.intro": {
      "comment": "Import, Passwords and sign-ins step: the introduction. %@ is the other browser's name, such as Chrome.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm die gesicherten Passwörter und Anmeldungen aus %@ in die Arx-Profile unten. Du wählst zuerst aus, was übertragen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring %@'s saved passwords and sign-ins into the Arx profiles below. You choose what moves first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae las contraseñas guardadas y los inicios de sesión de %@ a los perfiles de Arx indicados abajo. Tú eliges antes qué se traslada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférez les mots de passe et les connexions enregistrés dans %@ vers les profils Arx ci-dessous. Vous choisissez d’abord ce qui est transféré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に保存されているパスワードとサインインを、以下のArxのプロファイルに読み込みます。最初に、移行する内容を選択します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś zachowane hasła i logowania z %@ do poniższych profili Arx. Najpierw wybierasz, co zostanie przeniesione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите пароли и данные для входа из %@ в указанные ниже профили Arx. Что переносить, выбираете Вы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесіть паролі та вхід на сайти з браузера %@ у профілі Arx нижче. Спершу ви вибираєте, що переносити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 中存储的密码和登录状态导入到下方的 Arx 用户场景中。你可以先选取要移动的内容。"
          }
        }
      }
    },
    "migration.credentials.promptExplanation": {
      "comment": "Import, Passwords and sign-ins step: before macOS's keychain prompt. %@ is the keychain item's name, such as “Chrome Safe Storage”.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes fragt macOS, ob „%@“ verwendet werden darf. Wähle „Einmal erlauben“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks to use “%@” next. Choose Allow Once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación, macOS pedirá permiso para usar “%@”. Selecciona Permitir una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, macOS demande à utiliser « %@ ». Choisissez Autoriser une fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、macOSが「%@」の使用を確認します。「1回のみ許可」を選択してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie macOS zapyta o użycie „%@”. Wybierz Pozwól raz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее macOS запросит доступ к «%@». Выберите «Разрешить один раз»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Далі macOS запитає дозвіл на використання «%@». Виберіть «Дозволити раз»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来，macOS 会询问是否使用“%@”。请选取“允许一次”。"
          }
        }
      }
    },
    "migration.credentials.unverifiedItem": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx hat das Schlüsselbundobjekt dieses Browsers noch nicht bestätigt. Wenn macOS nicht nachfragt, bietet Arx stattdessen eine CSV-Datei an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx hasn't confirmed this browser's keychain item yet. If macOS doesn't ask, Arx offers a CSV file instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx aún no ha confirmado el ítem del llavero de este navegador. Si macOS no pregunta, Arx ofrece un archivo CSV en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx n’a pas encore confirmé l’élément de trousseau de ce navigateur. Si macOS ne demande rien, Arx propose un fichier CSV à la place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxはこのブラウザのキーチェーン項目をまだ確認していません。macOSが確認しない場合、ArxはCSVファイルを提案します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie potwierdził jeszcze elementu pęku kluczy tej przeglądarki. Jeśli macOS nie zapyta, Arx zaproponuje plik CSV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx еще не подтвердил объект связки ключей этого браузера. Если macOS не запросит разрешение, Arx предложит файл CSV."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx ще не підтвердив елемент вʼязки цього браузера. Якщо macOS не запитає, Arx запропонує файл CSV."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 尚未确认此浏览器的钥匙串项目。如果 macOS 没有询问，Arx 会改为提供 CSV 文件。"
          }
        }
      }
    },
    "migration.credentials.profileFilesExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx liest die Anmeldedaten und Cookies, die %@ in seinem Profilordner ablegt. macOS fragt nicht nach, und in %@ wird nichts geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx reads the logins and cookies %@ keeps in its profile folder. macOS doesn't ask, and nothing in %@ changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx lee los datos de acceso y las cookies que %@ guarda en la carpeta de su perfil. macOS no pregunta y no cambia nada en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx lit les identifiants et les cookies que %@ conserve dans son dossier de profil. macOS ne demande rien, et rien ne change dans %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは、%@がプロファイルフォルダに保存しているサインイン情報とCookieを読み込みます。macOSは確認せず、%@の内容は変更されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx odczytuje dane logowania i pliki cookie, które %@ przechowuje w folderze swojego profilu. macOS nie pyta, a nic w %@ się nie zmienia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx читает логины и файлы cookie, которые %@ хранит в папке своего профиля. macOS ничего не спрашивает, и в %@ ничего не меняется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx читає логіни та файли cookie, які %@ зберігає у своїй папці профілю. macOS не запитує, і нічого в %@ не змінюється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会读取 %@ 在其用户场景文件夹中保存的登录信息和 Cookie。macOS 不会询问，%@ 中的内容也不会有任何更改。"
          }
        }
      }
    },
    "migration.credentials.safariExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx liest die Anmeldungen von Safari mit dem Festplattenvollzugriff, den du ihm gegeben hast. Die Passwörter von Safari befinden sich in der App „Passwörter“: Exportiere sie dort und importiere die Datei anschließend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx reads Safari's sign-ins with the Full Disk Access you gave it. Safari's passwords are in the Passwords app: export them there and import the file afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx lee los inicios de sesión de Safari con el Acceso total al disco que le has dado. Las contraseñas de Safari están en la app Contraseñas: expórtalas allí e importa el archivo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx lit les connexions de Safari grâce à l’accès complet au disque que vous lui avez accordé. Les mots de passe de Safari se trouvent dans l’app Mots de passe : exportez-les à partir de là, puis importez le fichier ensuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは、付与されたフルディスクアクセスでSafariのサインインを読み込みます。Safariのパスワードは「パスワード」アプリにあります。そこで書き出して、あとでファイルを読み込んでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx odczytuje logowania Safari dzięki nadanemu mu Pełnemu dostępowi do dysku. Hasła Safari są w aplikacji Hasła: wyeksportuj je tam, a potem zaimportuj plik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx читает данные для входа Safari с помощью полного доступа к диску, который Вы ему дали. Пароли Safari находятся в приложении «Пароли»: экспортируйте их там и затем импортируйте файл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx читає входи Safari завдяки наданому йому повному доступу до диска. Паролі Safari є в програмі «Паролі»: експортуйте їх там, а потім імпортуйте файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 使用你授予它的“完全磁盘访问权限”读取 Safari 的登录状态。Safari 的密码在“密码” App 中：请在那里导出，之后再导入该文件。"
          }
        }
      }
    },
    "migration.credentials.csvPrimaryPassword": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schützt seine Passwörter mit einem Hauptpasswort, nach dem Arx nicht fragt. Exportiere sie stattdessen aus %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ protects its passwords with a primary password, which Arx doesn't ask for. Export them from %@ instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ protege sus contraseñas con una contraseña principal, que Arx no solicita. Expórtalas desde %@ en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ protège ses mots de passe par un mot de passe principal, que Arx ne demande pas. Exportez-les plutôt depuis %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はマスターパスワードでパスワードを保護しているため、Arxはそれを要求しません。代わりに%@から書き出してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chroni swoje hasła hasłem głównym, o które Arx nie pyta. Wyeksportuj je zamiast tego z %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ защищает свои пароли основным паролем, который Arx не запрашивает. Экспортируйте их из %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ захищає свої паролі головним паролем, який Arx не запитує. Натомість експортуйте їх із %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用主密码保护其密码，而 Arx 不会请求主密码。请改为从 %@ 中导出它们。"
          }
        }
      }
    },
