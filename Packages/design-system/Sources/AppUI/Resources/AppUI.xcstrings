    "chat.ephemeralNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat verschwindet 20 Minuten nach seiner letzten Nachricht oder wenn Arx beendet wird. Fixiere ihn, um ihn zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat disappears 20 minutes after its last message, or when Arx quits. Pin it to keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat desaparece 20 minutos después de su último mensaje o cuando Arx se cierra. Ánclalo para conservarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion disparaît 20 minutes après son dernier message, ou quand Arx se ferme. Épinglez-la pour la conserver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットは、最後のメッセージから20分後、またはArxを終了すると消えます。保持するには固定してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten czat znika 20 minut po ostatniej wiadomości lub po zakończeniu Arx. Przypnij go, aby go zachować."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чат исчезнет через 20 минут после последнего сообщения или при завершении Arx. Закрепите его, чтобы сохранить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чат зникне через 20 хвилин після останнього повідомлення або коли Arx завершить роботу. Закріпіть його, щоб зберегти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天会在最后一条消息 20 分钟后或 Arx 退出时消失。将其固定即可保留。"
          }
        }
      }
    },
