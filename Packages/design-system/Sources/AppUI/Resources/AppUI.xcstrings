    "relocation.failureMessage": {
      "comment": "Shown when moving Arx into the Applications folder failed, after the error's own description. The Arx menu is the app menu.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx läuft weiter vom aktuellen Ort. Du kannst es im Menü „Arx“ erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx will keep running from where it is. You can try again from the Arx menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx seguirá funcionando desde donde está. Puedes volver a intentarlo desde el menú Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx continuera de s’exécuter depuis son emplacement actuel. Vous pouvez réessayer depuis le menu Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは現在の場所で実行を続けます。Arxメニューからもう一度お試しいただけます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx będzie działać tam, gdzie jest. Możesz spróbować ponownie z menu Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx продолжит работать из текущего места. Можно повторить попытку из меню Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx продовжить працювати з поточного місця. Ви можете спробувати ще раз у меню Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 将继续从当前位置运行。你可以稍后从“Arx”菜单重试。"
          }
        }
      }
    },
    "hideElement.toast.title": {
      "comment": "Hide Element's toast, at the bottom right of the page while Hide Element (⇧⌘H) is on: what a click on the page does.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ein Element klicken, um es auszublenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click an element to hide it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un elemento para ocultarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un élément pour le masquer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックして要素を非表示にします"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij element, aby go ukryć"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на элемент, чтобы скрыть его"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть елемент, щоб сховати його"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按元素即可将其隐藏"
          }
        }
      }
    },
    "hideElement.toast.listHint": {
      "comment": "Hide Element's toast, at the bottom right of the page while Hide Element (⇧⌘H) is on: the second line while its list is closed. Return opens the list of elements hidden on this site.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilenschalter drücken, um ausgeblendete Elemente zu sehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Return to see hidden elements"
          }
        },
