    "archive.emptyExplanation": {
      "comment": "Below No Archived Tabs. %@ is the profile's archive interval as a duration, such as “6 hours” or “7 days”.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschlossene Tabs erscheinen hier, ebenso Tabs, die du seit %@ nicht angesehen hast. Unter Einstellungen › Profile legst du fest, wie lange."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs you close appear here, and so do tabs you haven’t looked at for %@. Settings › Profiles sets how long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas que cierras aparecen aquí, igual que las que no has mirado durante %@. En Ajustes › Perfiles eliges cuánto tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets que vous fermez apparaissent ici, de même que ceux que vous n’avez pas consultés depuis %@. Réglages › Profils permet de choisir la durée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたタブはここに表示されます。%@見ていないタブも同様です。時間は「設定 › プロファイル」で変更できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięte karty pojawiają się tutaj, podobnie jak karty, których nie oglądano przez %@. Jak długo, ustawisz w Ustawienia › Profile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытые вкладки появляются здесь, как и вкладки, которые Вы не открывали %@. Как долго, задается в разделе Настройки › Профили."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриті вкладки зʼявляються тут, як і вкладки, які ви не переглядали протягом %@. Як довго, задається в розділі Параметри › Профілі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你关闭的标签页会显示在这里，超过 %@ 没有查看的标签页也会显示在这里。“设置 › 用户场景”可设定时长。"
          }
        }
      }
    },
    "archive.emptyExplanationNever": {
      "comment": "Below No Archived Tabs, for a profile whose Automatically archive tabs is Never.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschlossene Tabs erscheinen hier. Um Tabs zu archivieren, die du eine Weile nicht angesehen hast, wähle unter Einstellungen › Profile die Dauer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs you close appear here. To archive tabs you haven’t looked at for a while, choose how long in Settings › Profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas que cierras aparecen aquí. Para archivar las que llevas un tiempo sin mirar, elige cuánto en Ajustes › Perfiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets que vous fermez apparaissent ici. Pour archiver les onglets que vous n’avez pas consultés depuis un moment, choisissez la durée dans Réglages › Profils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたタブはここに表示されます。しばらく見ていないタブをアーカイブするには、「設定 › プロファイル」で時間を選択してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięte karty pojawiają się tutaj. Aby archiwizować karty, których od jakiegoś czasu nie oglądano, wybierz czas w Ustawienia › Profile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытые вкладки появляются здесь. Чтобы архивировать вкладки, которые Вы давно не открывали, выберите срок в разделе Настройки › Профили."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриті вкладки зʼявляються тут. Щоб архівувати вкладки, які ви давно не переглядали, виберіть термін у розділі Параметри › Профілі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你关闭的标签页会显示在这里。若要归档一段时间没有查看的标签页，请在“设置 › 用户场景”中选择时长。"
          }
        }
      }
    },
