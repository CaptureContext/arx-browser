    "onboarding.message.defaultBrowser": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Arx als deinen Standardbrowser fest, dann werden Links aus Mail und Nachrichten hier geöffnet."
          }
        },
        "en": {
