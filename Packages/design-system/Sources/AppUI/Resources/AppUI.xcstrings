    "management.spaceProfileDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Raum verwendet die Sitzungen und Favoriten des zugewiesenen Profils. Alle Räume bleiben in der Seitenleiste sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This space uses its assigned profile’s sessions and favorites. All spaces remain visible in the sidebar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sección usa las sesiones y los favoritos del perfil que tiene asignado. Todas las secciones siguen visibles en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette section utilise les sessions et les favoris du profil qui lui est attribué. Toutes les sections restent visibles dans la barre latérale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスペースは、割り当てられたプロファイルのセッションとお気に入りを使用します。すべてのスペースがサイドバーに表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strefa używa sesji i ulubionych przypisanego profilu. Wszystkie strefy pozostają widoczne na pasku bocznym."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот раздел использует сеансы и избранное назначенного ему профиля. Все разделы остаются видны в боковом меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей розділ використовує сеанси й улюблені призначеного профілю. Усі розділи лишаються видимими в бічній панелі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分区使用其所属用户场景的会话和个人收藏。所有分区都会显示在边栏中。"
          }
        }
      }
    },
    "management.spacesDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Räume erscheinen in der Reihenfolge der Seitenleiste, unabhängig vom Profil. Bewege sie, um sie umzuordnen, oder verwende die Pfeile. Bearbeite einen Raum, um Name, Symbol oder Profil zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All spaces appear in sidebar order, regardless of profile. Drag to reorder, or use the arrows. Edit a space to change its name, icon, or profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las secciones aparecen en el orden de la barra lateral, sea cual sea su perfil. Arrastra para reordenar o usa las flechas. Edita una sección para cambiar su nombre, su icono o su perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les sections apparaissent dans l’ordre de la barre latérale, quel que soit le profil. Faites glisser pour réorganiser, ou utilisez les flèches. Modifiez une section pour changer son nom, son icône ou son profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのスペースが、プロファイルに関係なくサイドバーの順序で表示されます。ドラッグするか矢印を使って、順序を変更できます。スペースを編集すると、名前、アイコン、プロファイルを変更できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie strefy są pokazane w kolejności z paska bocznego, niezależnie od profilu. Przeciągnij, aby zmienić kolejność, lub użyj strzałek. Edytuj strefę, aby zmienić jej nazwę, ikonę lub profil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все разделы расположены в порядке бокового меню независимо от профиля. Чтобы изменить порядок, перетащите раздел или используйте стрелки. Чтобы изменить название, значок или профиль раздела, откройте его для редактирования."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі розділи показано в порядку бічної панелі, незалежно від профілю. Перетягніть, щоб змінити порядок, або скористайтеся стрілками. Відредагуйте розділ, щоб змінити його назву, іконку чи профіль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有分区按边栏顺序显示，不论其用户场景。拖移可重新排序，也可使用箭头。编辑分区可更改其名称、图标或用户场景。"
          }
        }
      }
    },
    "management.transferInProgress": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis die ausstehenden Tab-Bewegungen abgeschlossen sind, und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for pending tab moves to finish, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que terminen los traslados de pestañas pendientes e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin des déplacements d’onglets en cours, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のタブの移動が完了するまで待ってから、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie przenoszenia kart, a następnie spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь завершения перемещения вкладок и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дочекайтеся завершення переміщення вкладок і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待标签页移动完成，然后重试。"
          }
        }
      }
    },
    "management.workspaceChanged": {
      "comment": "Shown when closing or moving tabs was refused because the sidebar changed meanwhile.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tabs, Ordner oder Räume haben sich geändert, während Seiten geschlossen wurden. Es wurde nichts geändert; versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tabs, folders or spaces changed while pages were closing. Nothing was changed; please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus pestañas, carpetas o secciones han cambiado mientras se cerraban las páginas. No se ha cambiado nada; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos onglets, dossiers ou sections ont changé pendant la fermeture des pages. Rien n’a été modifié ; veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを閉じている間に、タブ、フォルダ、スペースが変更されました。何も変更されていません。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje karty, foldery lub strefy zmieniły się podczas zamykania stron. Nic nie zmieniono; spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки, папки или разделы изменились, пока страницы закрывались. Ничего не изменено; повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші вкладки, папки або розділи змінилися під час закриття сторінок. Нічого не змінено; спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的标签页、文件夹或分区在页面关闭期间发生了变化。未作任何更改；请重试。"
          }
        }
      }
    },
    "media.automaticPicture": {
