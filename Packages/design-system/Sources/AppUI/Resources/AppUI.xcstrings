    "automation.findInPageWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Treffer auf der Seite hervorgehoben, und beim Beenden bleibt die Auswahl auf dem aktiven Treffer. Die Seite kann die Auswahl sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This highlights matches in the page, and stopping leaves the selection on the active match. The page can see the selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto resalta las coincidencias en la página y, al detenerlo, deja la selección en la coincidencia activa. La página puede ver la selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela met en surbrillance les occurrences dans la page, et l’arrêt laisse la sélection sur l’occurrence active. La page peut voir la sélection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ内の一致する部分をハイライトし、停止すると現在の一致部分が選択されたままになります。ページは選択範囲を参照できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wyróżnia dopasowania na stronie, a zatrzymanie pozostawia zaznaczenie na aktywnym dopasowaniu. Strona widzi zaznaczenie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это выделяет совпадения на странице, а при остановке выделение остается на активном совпадении. Страница видит выделение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це виділяє збіги на сторінці, а після зупинки виділення лишається на активному збігу. Сторінка може бачити виділення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会高亮显示页面中的匹配项，停止后所选内容会停留在当前匹配项上。网页可以看到所选内容。"
          }
        }
      }
    },
    "automation.scrollWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird ein begrenztes Scrollen im nächsten scrollbaren Container angefordert. Handler von Websites können den Zustand ändern. Arx kann Auswirkungen auf Websites nicht widerrufen; Seitenbezeichnungen sind nicht vertrauenswürdig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This requests a bounded scroll in the nearest scrollable container. Website handlers may change state. Arx cannot undo website effects; page labels are untrusted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solicita un desplazamiento limitado en el contenedor desplazable más cercano. Los controladores de los sitios web pueden cambiar el estado. Arx no puede deshacer los efectos en los sitios web; las etiquetas de las páginas no son de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela demande un défilement limité dans le conteneur défilant le plus proche. Les gestionnaires du site web peuvent modifier l’état. Arx ne peut pas annuler les effets sur le site web ; les libellés de la page ne sont pas fiables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も近いスクロール可能なコンテナで、範囲を限定したスクロールを要求します。ウェブサイトのハンドラにより状態が変わる場合があります。Arxはウェブサイトへの影響を取り消せません。ページのラベルは信頼できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To żąda ograniczonego przewinięcia w najbliższym przewijalnym kontenerze. Procedury witryny mogą zmienić stan. Arx nie może cofnąć skutków po stronie witryn; etykiety stron są niezaufane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это запрашивает ограниченную прокрутку в ближайшем прокручиваемом контейнере. Обработчики сайта могут менять состояние. Arx не может отменить действия на сайте; подписи на странице ненадежны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це запитує обмежене прокручування в найближчому контейнері з прокручуванням. Обробники вебсайту можуть змінити стан. Arx не може відмінити наслідки на вебсайті; мітки сторінок не є надійними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会在最近的可滚动容器中请求有限度的滚动。网站处理程序可能会更改状态。Arx 无法撤销网站上的影响；网页标签不可信。"
          }
        }
      }
    },
    "automation.formWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird ein Feldwert ersetzt, was Handler der Website, das Senden oder eine Navigation auslösen kann. Arx kann Auswirkungen auf Websites nicht widerrufen. Gesendete Werte werden weder angezeigt noch protokolliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces a field value and may trigger website handlers, submission or navigation. Arx cannot undo website effects. Submitted values are not displayed or logged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye el valor de un campo y puede activar controladores del sitio web, un envío o una navegación. Arx no puede deshacer los efectos en los sitios web. Los valores enviados no se muestran ni se registran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace la valeur d’un champ et peut déclencher des gestionnaires du site web, un envoi ou une navigation. Arx ne peut pas annuler les effets sur le site web. Les valeurs envoyées ne sont ni affichées ni consignées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィールドの値が置き換えられ、ウェブサイトのハンドラ、送信、またはナビゲーションが実行される場合があります。Arxはウェブサイトへの影響を取り消せません。送信された値は表示も記録もされません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zastępuje wartość pola i może uruchomić procedury witryny, wysłanie lub nawigację. Arx nie może cofnąć skutków po stronie witryn. Wysłane wartości nie są wyświetlane ani zapisywane w dzienniku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это заменяет значение поля и может вызвать обработчики сайта, отправку или переход. Arx не может отменить действия на сайте. Отправленные значения не показываются и не записываются в журнал."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінює значення поля й може запустити обробники вебсайту, надсилання або перехід. Arx не може відмінити наслідки на вебсайті. Надіслані значення не показуються й не записуються в журнал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换栏位的值，并可能触发网站处理程序、提交或导航。Arx 无法撤销网站上的影响。提交的值不会显示或记录。"
          }
        }
      }
    },
