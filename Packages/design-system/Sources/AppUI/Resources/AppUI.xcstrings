    "developer.localTabsSettingExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs in der Seitenleiste auf localhost, 127.0.0.1, [::1], *.localhost, *.local, *.test oder einer Adresse in einem privaten Netzwerk erhalten einen gelb-schwarzen Rand und zeigen ihren Host und Port an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar tabs on localhost, 127.0.0.1, [::1], *.localhost, *.local, *.test or a private-network address get a yellow and black border and show their host and port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas de la barra lateral en localhost, 127.0.0.1, [::1], *.localhost, *.local, *.test o una dirección de red privada tienen un borde amarillo y negro y muestran su host y puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets de la barre latérale sur localhost, 127.0.0.1, [::1], *.localhost, *.local, *.test ou une adresse de réseau privé reçoivent une bordure jaune et noire et affichent leur hôte et leur port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "localhost、127.0.0.1、[::1]、*.localhost、*.local、*.test、またはプライベートネットワークのアドレスにあるサイドバーのタブは、黄色と黒の枠線で表示され、ホストとポートが示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty na pasku bocznym z adresem localhost, 127.0.0.1, [::1], *.localhost, *.local, *.test lub adresem sieci prywatnej dostają żółto-czarną ramkę i pokazują swój host i port."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки в боковом меню с адресами localhost, 127.0.0.1, [::1], *.localhost, *.local, *.test или адресом частной сети получают желто-черную рамку и показывают свой хост и порт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки в бічній панелі на localhost, 127.0.0.1, [::1], *.localhost, *.local, *.test або адресі приватної мережі отримують жовто-чорну рамку та показують свій хост і порт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 localhost、127.0.0.1、[::1]、*.localhost、*.local、*.test 或私有网络地址上的边栏标签页，会带有黄黑相间的边框，并显示其主机和端口。"
          }
        }
      }
    },
