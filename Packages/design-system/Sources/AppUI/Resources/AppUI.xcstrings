    "appearance.matchSiteDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster übernimmt die Farbe der angezeigten Seite. Seiten ohne Farbe verwenden die Farbe unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chrome takes the color of the page it shows. Pages without one use the color below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interfaz toma el color de la página que muestra. Las páginas sin color usan el color de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interface prend la couleur de la page affichée. Les pages sans couleur utilisent la couleur ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示しているページの色がクロームに反映されます。色のないページでは、下のカラーを使用します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy interfejsu przejmują kolor wyświetlanej strony. Strony bez koloru używają koloru poniżej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы интерфейса принимают цвет показываемой страницы. Для страниц без цвета используется цвет ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елементи інтерфейсу беруть колір сторінки, яку показують. Для сторінок без кольору використовується колір нижче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面会采用所显示网页的颜色。没有颜色的网页使用下方的颜色。"
          }
        }
      }
    },
