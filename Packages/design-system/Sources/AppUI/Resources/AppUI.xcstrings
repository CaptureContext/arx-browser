        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha finalizado esta página, normalmente para liberar memoria. Vuelve a cargarla para abrirla de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a arrêté cette page, généralement pour libérer de la mémoire. Rechargez-la pour l’ouvrir de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがこのページを終了しました。多くの場合、メモリを解放するためです。再読み込みすると、もう一度開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zakończył tę stronę, zwykle aby zwolnić pamięć. Odśwież, aby otworzyć ją ponownie."
          }
