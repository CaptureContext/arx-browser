    "reportProblem.diagnosticsDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert eine Datei mit dem Modell und dem Arbeitsspeicher deines Macs und %@ Absturzberichten der letzten 7 Tage und wählt sie im Finder aus, damit du sie dem Problem anhängen kannst. Nie Webadressen, Seitentitel oder Seiteninhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a file with your Mac's model and memory and %@ crash reports from the last 7 days, and selects it in Finder so you can attach it to the issue. Never web addresses, page titles or page content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un archivo con el modelo y la memoria de tu Mac y %@ informes de fallos de los últimos 7 días, y lo selecciona en el Finder para que puedas adjuntarlo a la incidencia. Nunca direcciones web, títulos de páginas ni contenido de páginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un fichier contenant le modèle et la mémoire de votre Mac ainsi que %@ rapports de plantage des 7 derniers jours, et le sélectionne dans le Finder pour que vous puissiez le joindre au ticket. Jamais d’adresses web, de titres de pages ni de contenu de pages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのモデルとメモリ、過去7日間の%@件のクラッシュレポートを含むファイルを保存し、Finderで選択状態にします。Issueに添付できます。ウェブアドレス、ページのタイトル、ページの内容は含まれません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje plik z modelem i pamięcią Twojego Maca oraz raportami o awariach (%@) z ostatnich 7 dni i zaznacza go w Finderze, aby można go było dołączyć do zgłoszenia. Nigdy adresów internetowych, tytułów stron ani zawartości stron."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет файл с моделью и объемом памяти Вашего Mac и отчетами о сбоях %@ за последние 7 дней и выбирает его в Finder, чтобы Вы могли приложить его к обращению. Веб-адреса, названия страниц и содержимое страниц не включаются никогда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає файл із моделлю й памʼяттю вашого Mac та звітами про збої (%@) за останні 7 днів і вибирає його у Finder, щоб ви могли додати його до повідомлення. Ніколи не містить вебадрес, заголовків чи вмісту сторінок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储一个文件，其中包含你的 Mac 型号和内存，以及最近 7 天的 %@ 崩溃报告，并在访达中将其选中，以便你将它附加到问题中。绝不包含网址、页面标题或页面内容。"
          }
        }
      }
    },
