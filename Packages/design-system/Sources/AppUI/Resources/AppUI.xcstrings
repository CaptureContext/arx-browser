    "routing.sourceChanged": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Quell-Tab oder Browserkontext hat sich geändert. Brich ab und rufe „Aktuelle URL zuordnen“ erneut von der gewünschten Seite aus auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source tab or browsing context changed. Cancel and invoke Route URL again from the intended page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña de origen o el contexto de navegación han cambiado. Cancela y vuelve a aplicar las reglas de apertura desde la página deseada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’onglet source ou le contexte de navigation a changé. Annulez et relancez « Ouvrir l’URL actuelle selon les règles » depuis la page voulue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のタブまたはブラウズコンテキストが変更されました。キャンセルして、目的のページからもう一度「URLを振り分け」を実行してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta źródłowa lub kontekst przeglądania uległy zmianie. Anuluj i ponownie wywołaj Kieruj URL z właściwej strony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная вкладка или контекст просмотра изменились. Отмените и снова вызовите «Направить URL» на нужной странице."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихідна вкладка або контекст перегляду змінилися. Скасуйте та знову викличте «Маршрутизувати URL» з потрібної сторінки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源标签页或浏览上下文已更改。请取消，并从目标页面再次调用“路由 URL”。"
          }
        }
      }
    },
    "routing.subdomains": {
      "localizations": {
        "de": {
