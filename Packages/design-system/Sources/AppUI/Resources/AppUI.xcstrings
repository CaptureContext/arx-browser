    "settings.unloadedPreviewsDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab, dessen Seite nicht geladen ist, zeigt das letzte Bild, das Arx von ihr aufgenommen hat, als sie geöffnet war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab whose page isn’t loaded shows the last picture Arx took of it while it was open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña cuya página no está cargada muestra la última imagen que Arx tomó de ella mientras estaba abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet dont la page n’est pas chargée affiche la dernière image qu’Arx en a prise pendant qu’il était ouvert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページが読み込まれていないタブには、開いていたときにArxが最後に取得したイメージが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta, której strona nie jest załadowana, pokazuje ostatni obraz, który Arx zrobił, gdy była otwarta."
          }
