    "darkPages.explanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt Websites ab, die kein eigenes dunkles Erscheinungsbild haben. Eine Website mit eigenem dunklem Design behält es, und du kannst eine Website in ihrem Website-Menü ausschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darkens sites that have no dark look of their own. A site with its own dark theme keeps it, and you can turn a site off in its site menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece los sitios que no tienen un aspecto oscuro propio. Un sitio con su propio tema oscuro lo conserva, y puedes desactivarlo para un sitio en su menú del sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit les sites qui n’ont pas d’apparence sombre. Un site doté de son propre thème sombre le conserve, et vous pouvez désactiver un site dans son menu du site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のダークな外観を持たないサイトを暗くします。独自のダークテーマを持つサイトはそのまま表示され、サイトメニューからサイトごとにオフにできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciemnia witryny, które nie mają własnego ciemnego wyglądu. Witryna z własnym ciemnym motywem go zachowuje, a witrynę możesz wyłączyć w jej menu witryny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет сайты, у которых нет собственного темного вида. Сайт со своей темной темой сохраняет ее, а отключить затемнение для сайта можно в меню сайта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемнює сайти, які не мають власного темного вигляду. Сайт із власною темною темою зберігає її, а для окремого сайту можна вимкнути це в меню сайту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将没有自带深色外观的网站调暗。拥有自带深色主题的网站会保留其主题，你也可以在网站菜单中为某个网站关闭此功能。"
          }
        }
      }
    },
