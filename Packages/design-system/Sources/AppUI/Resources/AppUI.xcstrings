    "webKitPrompt.message": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite hat geschütztes Video oder geschützte Musik angefordert, was die Chromium-Seiten von Arx nicht wiedergeben können. WebKit gibt sie wie Safari wieder. Deine Anmeldung wird mitgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page asked for protected video or music, which Arx's Chromium pages can't play. WebKit plays it as Safari does. Your sign-in comes along."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página ha solicitado vídeo o música protegidos, que las páginas de Chromium de Arx no pueden reproducir. WebKit los reproduce como Safari. Tu inicio de sesión se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page a demandé une vidéo ou une musique protégée, que les pages Chromium d’Arx ne peuvent pas lire. WebKit la lit comme Safari. Votre connexion est conservée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページは、ArxのChromiumページでは再生できない、保護されたビデオまたは音楽を要求しました。WebKitでは、Safariと同様に再生できます。サインイン情報も引き継がれます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strona zażądała chronionego wideo lub muzyki, których nie mogą odtwarzać strony Chromium w Arx. WebKit odtwarza je tak jak Safari. Twoje logowanie jest przenoszone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница запросила защищенное видео или музыку, которые страницы Arx на основе Chromium воспроизвести не могут. WebKit воспроизводит их, как Safari. Ваш вход сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця сторінка запросила захищене відео або музику, які сторінки Arx на Chromium не можуть відтворити. WebKit відтворює їх так, як Safari. Ваш вхід переноситься."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面请求播放受保护的视频或音乐，而 Arx 的 Chromium 页面无法播放。WebKit 可以像 Safari 一样播放。你的登录信息会一并带过去。"
          }
        }
      }
    },
