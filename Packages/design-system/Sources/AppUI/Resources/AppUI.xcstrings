    "automation.dialogWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptieren bestätigt, was die Seite verlangt hat, oder erteilt die angeforderte Berechtigung, als hättest du darauf geklickt. Arx fragt jedes Mal nach, unabhängig von der Freigabeeinstellung dieses Clients."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting confirms what the page asked, or grants the permission it requested, as if you had clicked it. Arx asks every time, whatever this client's approval setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar confirma lo que ha pedido la página o concede el permiso que ha solicitado, como si hubieras hecho clic. Arx pregunta siempre, sea cual sea el ajuste de aprobación de este cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter confirme ce que la page a demandé, ou accorde l’autorisation demandée, comme si vous aviez cliqué vous-même. Arx demande à chaque fois, quel que soit le réglage d’approbation de ce client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、ページが求めた内容が確定されるか、要求された権限が付与されます。ご自身でクリックした場合と同じです。このクライアントの承認設定にかかわらず、Arxは毎回確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaakceptowanie potwierdza to, o co poprosiła strona, lub przyznaje żądane uprawnienie, tak jakby było to Twoje kliknięcie. Arx pyta za każdym razem, niezależnie od ustawienia zatwierdzania tego klienta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принятие подтверждает то, что запросила страница, или предоставляет запрошенное ею разрешение, как если бы Вы нажали сами. Arx спрашивает каждый раз, независимо от настройки подтверждения для этого клиента."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прийняття підтверджує те, що запитала сторінка, або надає дозвіл, який вона запитала, так само, наче ви клацнули самі. Arx питає щоразу, незалежно від параметра підтвердження цього клієнта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受即确认网页所询问的内容，或授予其请求的权限，就像你亲自点按了一样。无论此客户端的批准设置如何，Arx 每次都会询问。"
          }
        }
      }
    },
