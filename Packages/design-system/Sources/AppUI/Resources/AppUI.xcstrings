    "settings.translationQualityExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Qualität von Apple Intelligence liest sich besser und dauert länger, sofern der Mac sie unterstützt; „Schneller“ verwendet kleinere Modelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence quality reads better and takes longer, where the Mac has it; Faster uses smaller models."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La calidad de Apple Intelligence se lee mejor y tarda más, en los Mac que la tienen; Más rápida usa modelos más pequeños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La qualité Apple Intelligence se lit mieux et prend plus de temps, lorsque le Mac la prend en charge ; Plus rapide utilise des modèles plus petits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceの品質は、Macで利用できる場合に、より自然に読めますが時間がかかります。「高速」はより小さいモデルを使用します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakość Apple Intelligence daje lepszy tekst i trwa dłużej, jeśli Mac ją ma; Szybciej używa mniejszych modeli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Качество Apple Intelligence лучше читается и занимает больше времени, если оно есть на Mac; «Быстрее» использует более компактные модели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якість Apple Intelligence дає кращий текст і потребує більше часу, якщо на Mac є ця функція; «Швидше» використовує менші моделі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持的 Mac 上，Apple 智能质量读起来更自然，但耗时更长；“更快”使用较小的模型。"
          }
        }
      }
    },
