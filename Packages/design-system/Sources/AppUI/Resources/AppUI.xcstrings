    "developer.modeExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Entwicklertools und „Element untersuchen“ für Seiten in jedem Profil an. Jeder Inspektor wird in einem eigenen Fenster geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Developer Tools and Inspect Element for pages in every profile. Each inspector opens in its own window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Herramientas para desarrolladores e Inspeccionar elemento para las páginas de todos los perfiles. Cada inspector se abre en su propia ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les outils de développement et Inspecter l’élément pour les pages de tous les profils. Chaque inspecteur s’ouvre dans sa propre fenêtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのプロファイルのページで、デベロッパーツールと「要素の詳細を表示」を表示します。各インスペクタは専用のウインドウで開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje Narzędzia dla deweloperów i Zbadaj element dla stron w każdym profilu. Każdy inspektor otwiera się we własnym oknie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает «Инструменты разработчика» и «Проверить элемент» для страниц во всех профилях. Каждый инспектор открывается в отдельном окне."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує інструменти розробника та «Перевірити елемент» для сторінок у кожному профілі. Кожен інспектор відкривається у власному вікні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有用户场景中的网页显示“开发者工具”和“检查元素”。每个检查器都在各自的窗口中打开。"
          }
        }
      }
    },
    "developer.safety": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwicklermodus schaltet nie Zertifikatsprüfungen, Same-Origin-Schutz oder die Sandbox von Chromium aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer mode never turns off certificate checks, same-origin protections or Chromium's sandbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de desarrollador nunca desactiva las comprobaciones de certificados, las protecciones de mismo origen ni el sandbox de Chromium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode développeur ne désactive jamais les vérifications de certificats, les protections de même origine ni le bac à sable de Chromium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デベロッパモードでも、証明書のチェック、同一オリジンの保護、Chromiumのサンドボックスがオフになることはありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb dewelopera nigdy nie wyłącza sprawdzania certyfikatów, zabezpieczeń tego samego źródła ani piaskownicy Chromium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим разработчика никогда не отключает проверку сертификатов, защиту одного источника и песочницу Chromium."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим розробника ніколи не вимикає перевірку сертифікатів, захист за походженням чи пісочницю Chromium."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者模式绝不会关闭证书检查、同源保护或 Chromium 的沙盒。"
          }
        }
      }
    },
    "developer.reloadTitle": {
      "comment": "Shown in Settings Developer Pane.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu laden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloading"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a cargar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechargement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込み"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeżanie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезагрузка"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезавантаження"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        }
      }
    },
    "developer.reloadExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ohne Cache neu laden“ prüft die Seite und ihre Ressourcen erneut; „Cache leeren und neu laden“ leert zusätzlich den HTTP-Cache des Profils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload Ignoring Cache revalidates the page and its resources; Clear Cache and Reload also clears the profile’s HTTP cache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a cargar sin caché revalida la página y sus recursos; Vaciar caché y volver a cargar también vacía la caché HTTP del perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Recharger sans utiliser le cache » revalide la page et ses ressources ; « Vider le cache et recharger » vide aussi le cache HTTP du profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キャッシュを無視して再読み込み」はページとそのリソースを再検証します。「キャッシュを消去して再読み込み」はプロファイルのHTTPキャッシュも消去します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odśwież z pominięciem pamięci podręcznej ponownie sprawdza stronę i jej zasoby; Wyczyść pamięć podręczną i odśwież czyści także pamięć podręczną HTTP profilu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Перезагрузить без кэша» повторно проверяет страницу и ее ресурсы; «Очистить кэш и перезагрузить» также очищает HTTP-кэш профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Перезавантажити без кешу» повторно перевіряє сторінку та її ресурси; «Очистити кеш і перезавантажити» також очищає HTTP-кеш профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“忽略缓存并重新加载”会重新验证页面及其资源；“清除缓存并重新加载”还会清除用户场景的 HTTP 缓存。"
          }
        }
      }
    },
