    "siteMenu.clearCacheTitle": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache für %@ leeren?"
          }
        },
