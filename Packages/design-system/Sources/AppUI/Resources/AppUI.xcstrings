    "links.restoreDefaultsHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt die Regeln für Instagram, X und TikTok so wieder her, wie Arx sie mitliefert, auch gelöschte oder geänderte, hinter deinen eigenen Regeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings back the Instagram, X and TikTok rules as Arx ships them, deleted or changed, after your own rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera las reglas de Instagram, X y TikTok tal como las incluye Arx, si se han eliminado o modificado, después de tus propias reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les règles Instagram, X et TikTok telles que les fournit Arx, supprimées ou modifiées, après vos propres règles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram、X、TikTokのルールを、削除または変更されていてもArxの提供時の状態に戻し、自分のルールの後ろに追加します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca reguły Instagram, X i TikTok w postaci, w jakiej dostarcza je Arx, także usunięte lub zmienione, po Twoich własnych regułach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает правила для Instagram, X и TikTok в том виде, в каком их поставляет Arx, если они удалены или изменены, после Ваших собственных правил."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертає правила Instagram, X і TikTok у вигляді, в якому їх постачає Arx, видалені чи змінені, після ваших власних правил."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Instagram、X 和 TikTok 的规则按 Arx 提供的原样恢复（包括已删除或已更改的），排在你自己的规则之后。"
          }
        }
      }
    },
