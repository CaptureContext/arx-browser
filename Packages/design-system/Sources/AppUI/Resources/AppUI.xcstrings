    "settings.categoryDetail.sync": {
      "comment": "The description under the Sync tab's title.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Profile, Räume und Einstellungen auf jedem Mac, über deinen iCloud-Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profiles, spaces and settings on every Mac, through your iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus perfiles, secciones y ajustes en todos tus Mac, a través de tu cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos profils, sections et réglages sur tous vos Mac, via votre compte iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル、スペース、設定を、iCloudアカウントを通じてすべてのMacで。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje profile, strefy i ustawienia na każdym Macu, przez konto iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши профили, разделы и настройки на каждом Mac через учетную запись iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші профілі, розділи й параметри на кожному Mac через обліковий запис iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的 iCloud 账户，在每台 Mac 上使用你的用户场景、分区和设置。"
          }
        }
      }
    },
    "settingsSearch.keywords.iCloudSync": {
