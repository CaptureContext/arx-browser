    "automation.pageContentNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Getrennt von Browser-Metadaten. Erlaubt begrenzten Text von zulässigen gewöhnlichen Seiten, der private Informationen enthalten kann. Formularwerte und Passwortbereiche werden ausgelassen; dies erkennt nicht jedes Geheimnis. Seiteninteraktion erfordert eine separate Freigabe und Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate from browser metadata. Allows bounded text from permitted ordinary pages, which may contain private information. Form values and password subtrees are omitted; this does not detect every secret. Page interaction requires a separate grant and approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Independiente de los metadatos del navegador. Permite texto limitado de páginas ordinarias permitidas, que puede contener información privada. Se omiten los valores de formularios y los subárboles de contraseñas; esto no detecta todos los secretos. La interacción con la página requiere un permiso y una aprobación aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distinct des métadonnées du navigateur. Autorise un texte limité provenant de pages ordinaires autorisées, qui peut contenir des informations privées. Les valeurs de formulaires et les sous-arborescences de mots de passe sont omises ; cela ne détecte pas tous les secrets. L’interaction avec les pages nécessite une autorisation et une approbation distinctes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのメタデータとは別です。許可された通常のページから、範囲を限定してテキストを読み取ります。非公開の情報が含まれている場合があります。フォームの値とパスワードのサブツリーは除かれますが、すべての機密情報を検出できるわけではありません。ページの操作には、別の許可と承認が必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddzielne od metadanych przeglądarki. Pozwala na ograniczony tekst z dozwolonych zwykłych stron, który może zawierać prywatne informacje. Wartości formularzy i poddrzewa haseł są pomijane; nie wykrywa to każdego sekretu. Interakcja ze stroną wymaga osobnej zgody i zatwierdzenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельно от метаданных браузера. Разрешает ограниченный объем текста с разрешенных обычных страниц, где может быть личная информация. Значения форм и деревья паролей пропускаются; это не выявляет все секреты. Для взаимодействия со страницей нужны отдельное разрешение и подтверждение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окремо від метаданих браузера. Дозволяє обмежений обсяг тексту з дозволених звичайних сторінок, який може містити приватну інформацію. Значення форм і піддерева паролів пропускаються; це не виявляє всі секрети. Взаємодія зі сторінкою потребує окремого дозволу та підтвердження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与浏览器元数据分开。允许读取获准的普通网页中的有限文本，其中可能包含私人信息。表单值和密码子树会被省略；这无法检测所有机密信息。与网页交互需要单独的授权和批准。"
          }
        }
      }
    },
