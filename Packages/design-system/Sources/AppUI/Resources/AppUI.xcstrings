          }
        }
      }
    },
    "automation.passwordSignInWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx füllt das Passwort selbst aus und sendet es. Der Agent erfährt nur, ob die Anmeldung funktioniert hat, nie das Passwort oder den Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx fills and submits the password itself. The agent learns only whether signing in worked, never the password or the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx rellena y envía la contraseña por sí mismo. El agente solo sabe si el inicio de sesión ha funcionado, nunca la contraseña ni la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx remplit et envoie lui-même le mot de passe. L’agent apprend seulement si la connexion a réussi, jamais le mot de passe ni le compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx自身がパスワードを入力して送信します。エージェントに伝わるのはサインインできたかどうかだけで、パスワードやアカウントは伝わりません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx sam wypełnia i wysyła hasło. Agent dowiaduje się tylko, czy logowanie się powiodło, nigdy nie poznaje hasła ani konta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx сам вводит и отправляет пароль. Агент узнает только, удался ли вход, но не пароль и не учетную запись."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx сам вводить і надсилає пароль. Агент дізнається лише, чи вдався вхід, але ніколи не бачить пароль чи обліковий запис."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会自行填写并提交密码。智能体只会得知登录是否成功，绝不会得知密码或账户。"
          }
        }
      }
    },
