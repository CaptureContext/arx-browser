    "settings.suggestionsExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet, was du in der Befehlsleiste eingibst, für Vorschläge an die Suchmaschine dieses Profils, sofern unterstützt. Private Fenster tun das nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends what you type in the command bar to this profile’s search engine for suggestions, if supported. Private windows never do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía lo que escribes en la barra de comandos al buscador de este perfil para obtener sugerencias, si lo admite. Las ventanas privadas nunca lo hacen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie ce que vous saisissez dans la barre de commandes au moteur de recherche de ce profil pour obtenir des suggestions, s’il les prend en charge. Les fenêtres privées ne le font jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応している場合、コマンドバーに入力した内容を、候補を得るためにこのプロファイルの検索エンジンへ送信します。プライベートウインドウでは送信しません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła to, co wpisujesz na pasku poleceń, do wyszukiwarki tego profilu po podpowiedzi, jeśli to obsługuje. Okna prywatne nigdy tego nie robią."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет то, что Вы вводите в панели команд, в поисковую систему этого профиля для получения подсказок, если она их поддерживает. В частных окнах этого никогда не происходит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає введене на панелі команд до пошукової системи цього профілю, щоб отримати пропозиції, якщо вона це підтримує. Приватні вікна ніколи цього не роблять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果支持，会将你在命令栏中输入的内容发送到此用户场景的搜索引擎以获取建议。无痕浏览窗口绝不会这样做。"
          }
        }
      }
    },
