    "siteSettings.empty": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Website hat eigene Berechtigungen. Websites, die du über eine Abfrage erlaubst oder blockierst, erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No site has its own permissions yet. Sites you allow or block from a prompt appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún sitio tiene todavía permisos propios. Los sitios que permitas o bloquees desde un aviso aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun site n’a encore d’autorisations propres. Les sites que vous autorisez ou bloquez depuis une invite apparaissent ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の権限を持つサイトはまだありません。メッセージから許可またはブロックしたサイトがここに表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna witryna nie ma jeszcze własnych uprawnień. Witryny, którym pozwolisz lub które zablokujesz w monicie, pojawią się tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни у одного сайта пока нет собственных разрешений. Сайты, которым Вы разрешили или запретили доступ в запросе, появятся здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден сайт ще не має власних дозволів. Сайти, які ви дозволяєте або блокуєте із запиту, зʼявляться тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有网站拥有自己的权限。你在提示中允许或阻止的网站会显示在这里。"
          }
        }
      }
    },
