    "siteMenu.clearCookiesMessage": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich von %1$@ und seinen Subdomains in %2$@ ab und entfernt die Daten, die sie speichern. Andere Websites und Profile behalten ihre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs you out of %1$@ and its subdomains in %2$@, and removes the data they store. Other sites and profiles keep theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra tu sesión en %1$@ y sus subdominios en %2$@, y elimina los datos que almacenan. Los demás sitios y perfiles conservan los suyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous déconnecte de %1$@ et de ses sous-domaines dans %2$@, et supprime les données qu’ils stockent. Les autres sites et profils conservent les leurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@にある%1$@とそのサブドメインからサインアウトし、それらが保存したデータを削除します。ほかのサイトやプロファイルのデータは保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowuje Cię z witryny %1$@ i jej subdomen w profilu %2$@ oraz usuwa dane, które przechowują. Inne witryny i profile zachowują swoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет выход из сайта %1$@ и его поддоменов в профиле «%2$@» и удаляет данные, которые они хранят. Другие сайты и профили сохраняют свои."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконує вихід із %1$@ та його піддоменів у «%2$@» і вилучає дані, які вони зберігають. Інші сайти й профілі зберігають свої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在%2$@中退出%1$@及其子域名的登录，并移除它们存储的数据。其他网站和用户场景会保留各自的数据。"
          }
        }
      }
    },
