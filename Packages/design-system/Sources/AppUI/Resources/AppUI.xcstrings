    "outsideAgents.review.kept": {
      "comment": "Outside agents, the review before Arx is added to an agent app's configuration file.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles andere in der Datei bleibt unverändert, und der Eintrag enthält kein Geheimnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else in the file changes, and the entry holds no secret."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada más del archivo y la entrada no contiene ningún secreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’autre dans le fichier ne change, et l’entrée ne contient aucun secret."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル内のほかの内容は変更されません。この項目に機密情報は含まれません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic innego w pliku się nie zmienia, a wpis nie zawiera żadnego sekretu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальное в файле не изменится, а в записи нет секретов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Решта файлу не змінюється, а запис не містить секретів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件中的其他内容保持不变，且该条目不含任何机密信息。"
          }
        }
      }
    },
