            "value": "Chronione multimedia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищенные медиа"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захищені медіа"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护的媒体"
          }
        }
      }
    },
    "settings.protectedMediaExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„FairPlay im Tab“ gibt Spotify in seinem eigenen Tab wieder und öffnet die anderen aufgeführten Websites in WebKit-Seiten. „In einer WebKit-Seite öffnen“ öffnet jede aufgeführte Website in WebKit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay in the tab plays Spotify in its own tab and opens the other listed sites in WebKit pages. Open in a WebKit page opens every listed site in WebKit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay en la pestaña reproduce Spotify en su propia pestaña y abre los demás sitios de la lista en páginas de WebKit. Abrir en una página de WebKit abre en WebKit todos los sitios de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay dans l’onglet lit Spotify dans son propre onglet et ouvre les autres sites listés dans des pages WebKit. Ouvrir dans une page WebKit ouvre tous les sites listés dans WebKit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「タブ内のFairPlay」では、Spotifyは専用のタブで再生され、一覧のほかのサイトはWebKitページで開きます。「WebKitページで開く」では、一覧のすべてのサイトをWebKitで開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay w karcie odtwarza Spotify we własnej karcie i otwiera pozostałe wymienione witryny na stronach WebKit. Otwórz na stronie WebKit otwiera każdą wymienioną witrynę w WebKit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«FairPlay во вкладке» воспроизводит Spotify в его собственной вкладке и открывает остальные перечисленные сайты на страницах WebKit. «Открывать на странице WebKit» открывает на странице WebKit все перечисленные сайты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«FairPlay у вкладці» відтворює Spotify в окремій вкладці й відкриває решту сайтів зі списку на сторінках WebKit. «Відкривати на сторінці WebKit» відкриває на сторінці WebKit усі сайти зі списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“在标签页中使用 FairPlay”会在其自己的标签页中播放 Spotify，并在 WebKit 页面中打开列出的其他网站。“在 WebKit 页面中打开”会在 WebKit 中打开所有列出的网站。"
          }
        }
      }
    },
