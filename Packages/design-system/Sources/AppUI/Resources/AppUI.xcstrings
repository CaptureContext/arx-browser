    "routing.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wo Links aus anderen Apps und mit „Aktuelle URL zuordnen“ gesendete Seiten geöffnet werden: in einem Raum und einem Hauptfenster oder Little Arx, das das Profil dieses Raums verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where links from other apps, and pages sent with Route Current URL, open: a space and a main window or Little Arx, which uses that space's profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona dónde se abren los enlaces de otras apps y las páginas enviadas con “Aplicar reglas de apertura a la URL actual”: una sección y una ventana principal o Little Arx, que usa el perfil de esa sección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où s’ouvrent les liens d’autres apps et les pages envoyées avec « Ouvrir l’URL actuelle selon les règles » : une section et une fenêtre principale ou Little Arx, qui utilise le profil de cette section."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのAppからのリンクと、「現在のURLを振り分け」で送られたページを、どこで開くかを選択します。スペースと、メインウインドウまたはLittle Arxを選択でき、そのスペースのプロファイルが使用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, gdzie otwierają się łącza z innych aplikacji oraz strony wysłane przez Kieruj bieżący URL: strefa oraz okno główne lub Little Arx, który używa profilu tej strefy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, где открываются ссылки из других приложений и страницы, отправленные командой «Направить текущий URL»: раздел и главное окно либо Little Arx, который использует профиль этого раздела."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, де відкриваються посилання з інших програм і сторінки, надіслані командою «Маршрутизувати поточну URL-адресу»: розділ і головне вікно або Little Arx, який використовує профіль цього розділу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取来自其他 App 的链接，以及通过“路由当前 URL”发送的页面，在何处打开：一个分区，以及主窗口或 Little Arx（它使用该分区的用户场景）。"
          }
        }
      },
      "extractionState": "manual",
      "generatesSymbol": false
    },
    "routing.destinationChanged": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel hat sich geändert. Prüfe das Ziel erneut, bevor du es öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination changed. Review the destination again before opening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destino ha cambiado. Revísalo de nuevo antes de abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination a changé. Vérifiez-la de nouveau avant d’ouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動先が変更されました。開く前に、もう一度移動先を確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce docelowe zmieniło się. Sprawdź je ponownie przed otwarciem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место назначения изменилось. Проверьте его снова, прежде чем открывать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначення змінилося. Перегляньте його ще раз, перш ніж відкривати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标位置已更改。打开之前，请再次检查目标位置。"
          }
        }
      }
    },
