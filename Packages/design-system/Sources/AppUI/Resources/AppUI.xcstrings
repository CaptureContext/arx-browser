    "viewer.rendererKilled": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat diese Seite beendet, meist um Arbeitsspeicher freizugeben. Lade sie neu, um sie erneut zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ended this page, usually to free memory. Reload to open it again."
