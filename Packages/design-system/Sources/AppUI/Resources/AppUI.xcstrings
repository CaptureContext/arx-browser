    "siteMenu.extensionChangeFailed": {
      "comment": "Site menu: turning an extension on or off failed. Extensions are listed per profile, on the profile's page in Settings › Profiles.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx konnte diese Erweiterung nicht ändern. Versuche es erneut unter Einstellungen › Profile, auf der Seite dieses Profils unter „Erweiterungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx couldn't change that extension. Try again in Settings › Profiles, on this profile's page under Extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx no ha podido cambiar esa extensión. Inténtalo de nuevo en Ajustes › Perfiles, en la página de este perfil, en Extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx n’a pas pu modifier cette extension. Réessayez dans Réglages › Profils, sur la page de ce profil, sous Extensions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxはその機能拡張を変更できませんでした。「設定」＞「プロファイル」で、このプロファイルのページの「機能拡張」からもう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie mógł zmienić tego rozszerzenia. Spróbuj ponownie w Ustawieniach › Profile, na stronie tego profilu w sekcji Rozszerzenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не удалось изменить это расширение. Повторите попытку в «Настройки › Профили», на странице этого профиля в разделе «Расширения»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не вдалося змінити це розширення. Спробуйте ще раз у «Параметри › Профілі», на сторінці цього профілю в розділі «Розширення»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 无法更改该扩展。请在“设置”>“用户场景”中此用户场景的页面上，于“扩展”下重试。"
          }
        }
      }
    },
