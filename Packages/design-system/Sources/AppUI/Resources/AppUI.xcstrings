        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルからこの機能拡張を削除します。機能拡張のデータも削除される場合があります。この操作は取り消せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń to rozszerzenie z tego profilu. Jego dane mogą zostać usunięte. Tej czynności nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить это расширение из этого профиля. Данные расширения могут быть удалены. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити це розширення з цього профілю. Дані розширення можуть бути видалені. Цю дію не можна відмінити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
