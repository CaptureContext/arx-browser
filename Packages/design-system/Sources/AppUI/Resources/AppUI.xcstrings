    "appLinks.landTitle": {
      "comment": "Title of the prompt before the script runs. App Links (Settings › Links › Air Traffic Control › App Links): a handler for this kind of link runs the person's script, which hands the link to an app, often one window or account of it, such as the Claude app signed in to the Work profile's account. %@ is the handler's name, followed by the page's profile name when the handling is per profile (\"Claude Work\"); it is a name, so keep it as it is.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Link an %@ senden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send This Link to %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar este enlace a %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer ce lien vers %@ ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを%@に送信しますか？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłać to łącze do: %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить эту ссылку в %@?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати це посилання в %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将此链接发送到 %@ 吗？"
          }
        }
      }
    },
