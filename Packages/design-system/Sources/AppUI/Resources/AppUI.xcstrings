    "retirement.uncertain": {
      "comment": "Removing a profile with “Permanently erase this profile’s website data”: Arx closes the profile and erases its cookies, accounts, history and cached website data, which finishes only after Arx reopens and then the Mac restarts. “Retirement” and “cleanup” are that removal and erasure.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Außerbetriebnahme ist noch nicht bestätigt. Neue Sitzungen sind blockiert. Prüfe und versuche es erneut, wenn die Seiten und Downloads dieses Profils abgeschlossen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirement is not yet acknowledged. New sessions are blocked. Check and retry when this profile’s pages and downloads have finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La baja aún no está confirmada. Las sesiones nuevas están bloqueadas. Comprueba y reintenta cuando las páginas y las descargas de este perfil hayan terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retrait n’est pas encore confirmé. Les nouvelles sessions sont bloquées. Vérifiez et réessayez lorsque les pages et les téléchargements de ce profil seront terminés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除はまだ確認されていません。新しいセッションはブロックされます。このプロファイルのページとダウンロードが完了したら、確認して再試行してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycofanie nie zostało jeszcze potwierdzone. Nowe sesje są zablokowane. Sprawdź i spróbuj ponownie, gdy strony i pobieranie tego profilu się zakończą."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление профиля еще не подтверждено. Новые сеансы заблокированы. Нажмите «Проверить и повторить», когда страницы и загрузки этого профиля завершатся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучення ще не підтверджено. Нові сеанси заблоковано. Перевірте й повторіть, коли сторінки та викачування цього профілю завершаться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用尚未得到确认。新会话已被阻止。待此用户场景的页面和下载完成后，请检查并重试。"
          }
        }
      },
      "generatesSymbol": false
    },
