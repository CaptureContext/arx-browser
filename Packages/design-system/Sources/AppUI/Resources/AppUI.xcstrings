    "siteMenu.removeExtensionMessage": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wird aus diesem Profil entfernt und ihre Daten werden möglicherweise gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed from this profile and its data may be deleted. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de este perfil y sus datos pueden borrarse. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est supprimée de ce profil et ses données peuvent être effacées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルから削除され、そのデータも削除される場合があります。この操作は取り消せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięte z tego profilu, a jego dane mogą zostać skasowane. Tej czynności nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно будет удалено из этого профиля, а его данные могут быть стерты. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його буде вилучено з цього профілю, а його дані можуть бути видалені. Цю дію не можна скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从此用户场景中移除，其数据可能会被删除。此操作无法撤销。"
          }
        }
      }
    },
