    "siteMenu.webKitNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Website wird in WebKit geöffnet, das geschützte Videos und Musik wiedergibt. WebKit-Seiten unterstützen keine Erweiterungen, kein automatisches Ausfüllen von Passwörtern, keine Chrome-Website-Einstellungen, keine Übersetzung, keine Mitteilungen und keine Passkeys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This site opens in WebKit, which plays protected video and music. WebKit pages don't have extensions, password autofill, Chrome site settings, translation, notifications or passkeys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sitio se abre en WebKit, que reproduce vídeo y música protegidos. Las páginas de WebKit no tienen extensiones, autorrelleno de contraseñas, ajustes del sitio de Chrome, traducción, notificaciones ni llaves de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce site s’ouvre dans WebKit, qui lit les vidéos et la musique protégées. Les pages WebKit n’ont ni extensions, ni remplissage automatique des mots de passe, ni réglages de sites de Chrome, ni traduction, ni notifications, ni clés d’accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトは、保護されたビデオや音楽を再生できるWebKitで開きます。WebKitページでは、機能拡張、パスワードの自動入力、Chromeのサイトの設定、翻訳、通知、パスキーは使用できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta witryna otwiera się w WebKit, który odtwarza chronione wideo i muzykę. Strony WebKit nie mają rozszerzeń, wypełniania haseł, ustawień witryn Chrome, tłumaczenia, powiadomień ani kluczy dostępu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сайт открывается в WebKit, который воспроизводит защищенные видео и музыку. На страницах WebKit нет расширений, автозаполнения паролей, настроек сайта Chrome, перевода, уведомлений и ключей входа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сайт відкривається в WebKit, який відтворює захищене відео й музику. Сторінки WebKit не мають розширень, автозаповнення паролів, параметрів вебсайтів Chrome, перекладу, сповіщень чи ключів допуску."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网站会在 WebKit 中打开，它可以播放受保护的视频和音乐。WebKit 页面没有扩展、密码自动填充、Chrome 网站设置、翻译、通知或通行密钥。"
          }
        }
      }
    },
    "siteMenu.webKitVideoOnly": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video dieser Website wird nur in WebKit wiedergegeben. Arx bietet daher an, die Seite dort zu öffnen, wenn ein Video startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This site's video plays only in WebKit, so Arx offers to open the page there when a video starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo de este sitio solo se reproduce en WebKit, así que Arx ofrece abrir allí la página cuando empieza un vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo de ce site ne se lit que dans WebKit : Arx propose donc d’y ouvrir la page quand une vidéo démarre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトのビデオはWebKitでのみ再生できるため、ビデオが始まるとArxはそのページをWebKitで開くことを提案します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wideo z tej witryny odtwarza się tylko w WebKit, więc Arx proponuje otwarcie tam strony, gdy rozpocznie się wideo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео этого сайта воспроизводится только в WebKit, поэтому Arx предлагает открыть там страницу, когда начинается видео."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео цього сайту відтворюється лише в WebKit, тому Arx пропонує відкрити там сторінку, коли починається відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网站的视频只能在 WebKit 中播放，因此视频开始播放时，Arx 会提议在 WebKit 中打开该页面。"
          }
        }
      }
    },
