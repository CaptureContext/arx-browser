    "automation.downloadsNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet Downloads von Freigaben für das gesamte Profil auf, bricht sie ab und zeigt fertige Dateien im Finder an. Private Downloads erscheinen nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists downloads of whole-profile grants, cancels them and shows finished files in Finder. Private downloads never appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las descargas de los permisos de perfil completo, las cancela y muestra los archivos terminados en el Finder. Las descargas privadas nunca aparecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les téléchargements des autorisations sur le profil entier, les annule et affiche les fichiers terminés dans le Finder. Les téléchargements privés n’apparaissent jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル全体の許可があるダウンロードを一覧表示し、キャンセルしたり、完了したファイルをFinderで表示したりします。プライベートなダウンロードは表示されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla pobrane pliki ze zgód na cały profil, anuluje je i pokazuje zakończone pliki w Finderze. Pobrane pliki w trybie prywatnym nigdy się nie pojawiają."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает загрузки при разрешении на весь профиль, отменяет их и показывает готовые файлы в Finder. Частные загрузки не появляются никогда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перелічує викачування профілів із повним доступом, скасовує їх і показує завершені файли у Finder. Приватні викачування ніколи не показуються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出整个用户场景授权下的下载项，可取消它们，并在访达中显示已完成的文件。无痕浏览下载不会出现。"
          }
        }
      }
    },
