    "settings.aliasHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Alias in der Befehlsleiste ein, um seinen Befehl zu finden. Der Zeilenschalter bei einem exakten Alias führt ihn aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type an alias in the command bar to find its command. Return on an exact alias runs it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un alias en la barra de comandos para encontrar su comando. Retorno sobre un alias exacto lo ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un alias dans la barre de commandes pour trouver sa commande. Retour sur un alias exact l’exécute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドバーにエイリアスを入力すると、そのコマンドが見つかります。完全に一致するエイリアスでReturnキーを押すと、実行されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz alias na pasku poleceń, aby znaleźć jego polecenie. Return przy dokładnym aliasie uruchamia je."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите псевдоним в панели команд, чтобы найти его команду. Return на точном псевдониме выполняет ее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть псевдонім у панелі команд, щоб знайти його команду. Return на точному псевдонімі виконує її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令栏中输入别名即可找到其命令。对完全匹配的别名按下 Return 键即可运行它。"
          }
        }
      }
    },
