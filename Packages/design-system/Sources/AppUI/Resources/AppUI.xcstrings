        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages situées à une adresse locale avec un port affichent leur adresse complète et des boutons de développement au-dessus de la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート付きのローカルアドレスのページでは、ページの上にアドレス全体とデベロッパボタンを表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strony pod adresem lokalnym z portem pokazują nad stroną pełny adres i przyciski dewelopera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Над страницами с локальным адресом и портом показываются их полный адрес и кнопки разработчика."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінки на локальній адресі з портом показують повну адресу та кнопки розробника над сторінкою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于带端口的本地地址上的网页，会在页面上方显示完整地址和开发者按钮。"
          }
        }
      }
    },
    "developer.localTabsSetting": {
