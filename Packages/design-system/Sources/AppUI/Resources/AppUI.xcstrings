    "chat.settingsPersistent": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis ich sie lösche"
          }
        },
        "en": {
