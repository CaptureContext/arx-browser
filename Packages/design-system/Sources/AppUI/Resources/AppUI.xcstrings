            "value": "App Links"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaces de apps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liens d’apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appリンク"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącza aplikacji"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки приложений"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання на програми"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 链接"
          }
        }
      }
    },
    "appLinks.description": {
      "comment": "App Links (Settings › Links › Air Traffic Control › App Links): a handler is a rule for links that a page hands to another app, such as claude://: which links it catches (by scheme, host and path) and what happens to them, open an app or run the person's script.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Seite einen Link für eine andere App öffnet, etwa eine Anmeldung, die in Claude endet, entscheidet ein Handler, was passiert: die App öffnen oder dein Skript ausführen. Das Profil der Seite bestimmt die Verarbeitung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a page opens a link for another app, such as a sign-in that ends in Claude, a handler decides what happens: open the app, or run your script. The page's profile picks the handling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una página abre un enlace para otra app, como un inicio de sesión que termina en Claude, un gestor decide qué ocurre: abrir la app o ejecutar tu script. El perfil de la página elige la gestión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’une page ouvre un lien destiné à une autre app, par exemple une connexion qui se termine dans Claude, un gestionnaire décide de la suite : ouvrir l’app ou exécuter votre script. Le profil de la page détermine le traitement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページが別のApp用のリンク（Claudeで終わるサインインなど）を開こうとすると、ハンドラが動作を決めます。Appを開くか、スクリプトを実行します。扱いはページのプロファイルで決まります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy strona otwiera łącze dla innej aplikacji, na przykład logowanie kończące się w Claude, obsługa decyduje, co się stanie: otwarcie aplikacji albo uruchomienie Twojego skryptu. Obsługę wybiera profil strony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда страница открывает ссылку для другого приложения, например вход, который завершается в Claude, обработчик решает, что делать: открыть приложение или запустить Ваш скрипт. Способ обработки выбирается по профилю страницы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли сторінка відкриває посилання для іншої програми, наприклад вхід, що завершується в Claude, обробник вирішує, що робити: відкрити програму чи виконати ваш скрипт. Спосіб обробки визначає профіль сторінки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当网页打开用于其他 App 的链接时（例如以 Claude 结尾的登录流程），由处理程序决定如何处理：打开该 App，或运行你的脚本。处理方式由网页所在的用户场景决定。"
          }
        }
      }
    },
