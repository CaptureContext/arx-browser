    "settings.showsUnreadBadgesDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahl oder ein Punkt auf Tabs und Favoriten mit Ungelesenem. Ein Profil, eine Website oder ein Tab kann es anders festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A count or a dot on tabs and Favorites with something unread. A profile, a site or a tab can choose otherwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número o un punto en las pestañas y favoritos con algo sin leer. Un perfil, un sitio o una pestaña pueden elegir otra cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre ou un point sur les onglets et les Favoris contenant des éléments non lus. Un profil, un site ou un onglet peut en décider autrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読のあるタブとお気に入りに、件数またはドットを表示します。プロファイル、サイト、タブで別の設定にすることもできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba lub kropka na kartach i w ulubionych z czymś nieprzeczytanym. Profil, witryna lub karta może wybrać inaczej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число или точка на вкладках и в избранном, где есть непрочитанное. Профиль, сайт или вкладка могут выбрать иначе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильник або крапка на вкладках і улюблених, де є щось непрочитане. Профіль, сайт або вкладка можуть вирішити інакше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在有未读内容的标签页和个人收藏上显示数字或圆点。用户场景、网站或标签页可以另行选择。"
          }
        }
      }
    },
    "settings.unreadBadgeSites": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites, die selbst entscheiden"
