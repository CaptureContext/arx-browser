            "state": "translated",
            "value": "Appuyez sur Retour pour afficher les éléments masqués"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Returnキーで非表示にした要素を表示します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Return, aby zobaczyć ukryte elementy"
          }
        },
        "ru": {
