    "extensions.removeMessage": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne diese Erweiterung aus diesem Profil. Ihre Daten werden möglicherweise gelöscht. Dieser Vorgang kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this extension from this profile. Its extension data may be deleted. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina esta extensión de este perfil. Es posible que se borren los datos de la extensión. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez cette extension de ce profil. Ses données peuvent être effacées. Cette action est irréversible."
