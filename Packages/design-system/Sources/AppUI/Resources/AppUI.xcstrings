    "onboarding.crashReports.notSent": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von Arx kann Absturzberichte nirgendwohin senden, daher bleiben sie auf diesem Mac. Du kannst sie über das Menü „Hilfe“ zu einem Problembericht hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Arx has nowhere to send crash reports, so they stay on this Mac. You can add them to a problem report from the Help menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Arx no tiene adónde enviar los informes de fallos, así que se quedan en este Mac. Puedes añadirlos a un informe de problema desde el menú Ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d’Arx n’a nulle part où envoyer les rapports de plantage ; ils restent donc sur ce Mac. Vous pouvez les joindre à un signalement de problème depuis le menu Aide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのArxにはクラッシュレポートの送信先がないため、レポートはこのMacに残ります。「ヘルプ」メニューから、問題のレポートに追加できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja Arx nie ma dokąd wysyłać raportów o awariach, więc zostają na tym Macu. Możesz dodać je do zgłoszenia problemu z menu Pomoc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии Arx некуда отправлять отчеты о сбоях, поэтому они остаются на этом Mac. Их можно добавить к отчету о проблеме из меню «Справка»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця версія Arx не має, куди надсилати звіти про збої, тому вони лишаються на цьому Mac. Ви можете додати їх до звіту про проблему з меню «Довідка»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Arx 没有可发送崩溃报告的目的地，因此它们会保留在这台 Mac 上。你可以从“帮助”菜单将它们添加到问题报告中。"
          }
        }
      }
    },
    "onboarding.crashReports.settings": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absturzberichte bleiben in jedem Fall auf diesem Mac. Du kannst das jederzeit unter Einstellungen › Datenschutz ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crash reports stay on this Mac either way. Change this any time in Settings › Privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes de fallos se quedan en este Mac en cualquier caso. Cámbialo cuando quieras en Ajustes › Privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports de plantage restent de toute façon sur ce Mac. Modifiez cela à tout moment dans Réglages › Confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの場合も、クラッシュレポートはこのMacに残ります。これは「設定」＞「プライバシー」でいつでも変更できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporty o awariach i tak zostają na tym Macu. Możesz to zmienić w dowolnej chwili w Ustawieniach › Prywatność."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчеты о сбоях в любом случае остаются на этом Mac. Это можно изменить в любое время в «Настройки › Конфиденциальность»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звіти про збої в будь-якому разі лишаються на цьому Mac. Змініть це будь-коли в «Параметри › Приватність»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论如何，崩溃报告都会保留在这台 Mac 上。你可以随时在“设置”>“隐私”中更改此项。"
          }
        }
      }
    },
    "onboarding.crashReports.never": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Webadressen, Seitentitel, Seiteninhalte, deine Dateien oder irgendetwas, das dich oder deinen Mac identifiziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web addresses, page titles, page content, your files, or anything that identifies you or your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcciones web, títulos de páginas, contenido de páginas, tus archivos ni nada que te identifique a ti o a tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresses web, titres de pages, contenu des pages, vos fichiers, ni rien qui vous identifie ou identifie votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブアドレス、ページのタイトル、ページの内容、ファイル、またはあなたやMacを特定できるものは含まれません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresów internetowych, tytułów stron, zawartości stron, Twoich plików ani niczego, co identyfikuje Ciebie lub Twojego Maca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-адреса, названия страниц, содержимое страниц, Ваши файлы и любые данные, которые идентифицируют Вас или Ваш Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вебадреси, заголовки сторінок, вміст сторінок, ваші файли чи будь-що, що ідентифікує вас або ваш Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网址、页面标题、页面内容、你的文件，或任何可识别你或你的 Mac 的信息。"
          }
        }
      }
    },
