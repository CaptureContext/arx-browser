    "automation.policyNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine dauerhafte Auswahl, die Neustarts übersteht. Arx entscheidet, wie riskant jede Aktion ist, nie der Assistent. Lesen fragt nie nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A standing choice that survives restarts. Arx decides how risky each action is, never the assistant. Reading never asks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una elección permanente que se mantiene al reiniciar. Arx decide el riesgo de cada acción, nunca el asistente. Leer nunca pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un choix permanent qui persiste après un redémarrage. Arx évalue le risque de chaque action, jamais l’assistant. La lecture ne demande jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後も維持される固定の選択です。各操作のリスクはArxが判断し、アシスタントは判断しません。読み取りは確認しません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stały wybór, który przetrwa ponowne uruchomienie. Arx decyduje, jak ryzykowna jest każda czynność, nigdy asystent. Odczyt nigdy nie pyta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянный выбор, который сохраняется после перезапуска. Степень риска каждого действия определяет Arx, а не ассистент. Чтение никогда не запрашивает подтверждение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постійний вибір, що зберігається після перезапуску. Ризикованість кожної дії визначає Arx, а не асистент. Читання ніколи не питає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动后依然有效的固定选择。每个操作的风险高低由 Arx 判定，而非助理。读取操作从不询问。"
          }
        }
      }
    },
    "automation.readNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet die freigegebenen Räume, Ordner und Tabs mit bereinigten URLs auf und wartet, bis Seiten fertig geladen sind. Jede andere Klasse erfordert auch diese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists the granted spaces, folders and tabs, with sanitized URLs, and waits for pages to finish loading. Every other class also needs this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las secciones, carpetas y pestañas con permiso, con URL depuradas, y espera a que las páginas terminen de cargarse. Todas las demás clases también necesitan esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les sections, dossiers et onglets autorisés, avec des URL nettoyées, et attend la fin du chargement des pages. Toutes les autres catégories nécessitent aussi celle-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されたスペース、フォルダ、タブを、サニタイズしたURLとともに一覧表示し、ページの読み込み完了を待ちます。ほかのすべての項目にもこの許可が必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla strefy, foldery i karty objęte zgodą, z oczyszczonymi adresami URL, i czeka na zakończenie ładowania stron. Każda inna klasa wymaga także tej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает разрешенные разделы, папки и вкладки с очищенными URL и ждет окончания загрузки страниц. Для всех остальных классов нужен и этот."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перелічує розділи, папки та вкладки з наданим доступом із очищеними URL-адресами й чекає, доки сторінки завершать завантаження. Усі інші класи також потребують цього."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出已授权的分区、文件夹和标签页（URL 已清理），并等待网页加载完成。其他所有类别也需要此项。"
          }
        }
      }
    },
