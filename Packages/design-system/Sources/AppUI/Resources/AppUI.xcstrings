    "settings.iCloudSync.review.replaceDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert eine Kopie der synchronisierten Daten dieses Macs und ersetzt sie dann durch die Daten in diesem iCloud-Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a copy of this Mac’s synced data, then replaces it with what’s in this iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia de los datos sincronizados de este Mac y los sustituye por los de esta cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une copie des données synchronisées de ce Mac, puis les remplace par celles de ce compte iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの同期済みデータのコピーを保存してから、このiCloudアカウントにあるデータで置き換えます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje kopię zsynchronizowanych danych tego Maca, a następnie zastępuje je danymi z tego konta iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет копию синхронизированных данных этого Mac, а затем заменяет их данными из этой учетной записи iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає копію синхронізованих даних цього Mac, а потім замінює їх даними з цього облікового запису iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储这台 Mac 上已同步数据的副本，然后用此 iCloud 账户中的内容替换。"
          }
        }
      }
    },
