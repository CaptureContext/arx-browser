    "settings.opensEmptyPageAtLaunchExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Tab ausgewählt und jeder Ordner ist eingeklappt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tab is selected and every folder is collapsed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se selecciona ninguna pestaña y todas las carpetas aparecen plegadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun onglet n’est sélectionné et tous les dossiers sont repliés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは選択されず、すべてのフォルダは閉じた状態になります。"
          }
        },
