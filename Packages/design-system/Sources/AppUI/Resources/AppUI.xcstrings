    "links.invalidTemplate": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine gültige HTTP(S)-Vorlage, in der {host}, {path}, {query} und {fragment} nur in den entsprechenden URL-Bestandteilen stehen und {subdomain} nur am Anfang des Hosts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a valid HTTP(S) template with {host}, {path}, {query} and {fragment} only in their URL components, and {subdomain} only at the start of the host."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una plantilla HTTP(S) válida con {host}, {path}, {query} y {fragment} solo en sus componentes de la URL, y {subdomain} solo al principio del host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un modèle HTTP(S) valide avec {host}, {path}, {query} et {fragment} uniquement dans leurs composants d’URL, et {subdomain} uniquement au début de l’hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なHTTP(S)テンプレートを使用してください。{host}、{path}、{query}、{fragment}はURLのそれぞれの部分にのみ、{subdomain}はホストの先頭にのみ使用できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj prawidłowego szablonu HTTP(S), w którym {host}, {path}, {query} i {fragment} występują tylko w swoich częściach URL, a {subdomain} tylko na początku hosta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте допустимый шаблон HTTP(S), где {host}, {path}, {query} и {fragment} стоят только в своих частях URL, а {subdomain} только в начале хоста."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використайте дійсний шаблон HTTP(S), у якому {host}, {path}, {query} і {fragment} стоять лише у своїх компонентах URL-адреси, а {subdomain} лише на початку хоста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用有效的 HTTP(S) 模板，其中 {host}、{path}、{query} 和 {fragment} 只能出现在各自对应的 URL 部分，{subdomain} 只能出现在主机开头。"
          }
        }
      }
    },
