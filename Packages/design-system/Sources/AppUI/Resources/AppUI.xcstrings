    "migration.credentials.signInsFooter": {
      "comment": "Import, Passwords and sign-ins step: the footer under the sign-ins to move.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert die Cookies jeder Website. Eine Website kann dich in einem Browser abmelden; Arx listet alle auf, bei denen du dich erneut anmelden musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies each site’s cookies. A site may sign you out of one browser; Arx lists any that need you to sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia las cookies de cada sitio. Un sitio puede cerrar tu sesión en uno de los navegadores; Arx enumera los que requieran que vuelvas a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie les cookies de chaque site. Un site peut vous déconnecter d’un navigateur ; Arx liste ceux pour lesquels vous devez vous reconnecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サイトのCookieをコピーします。サイトによっては、一方のブラウザでサインアウトされる場合があります。もう一度サインインが必要なサイトは、Arxが一覧表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuje pliki cookie każdej witryny. Witryna może wylogować Cię z jednej przeglądarki; Arx wymieni te, w których trzeba się zalogować ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирует файлы cookie каждого сайта. Сайт может завершить сеанс в одном из браузеров; Arx покажет те сайты, на которые нужно войти снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіює файли cookie кожного сайту. Сайт може вийти з одного з браузерів; Arx покаже ті, де потрібно увійти знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝每个网站的 Cookie。网站可能会让你在一个浏览器中退出登录；Arx 会列出需要你重新登录的网站。"
          }
        }
      }
    },
