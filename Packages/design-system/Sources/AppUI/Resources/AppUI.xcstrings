    "settings.asksBeforeFillingPasswordsExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt nach Touch ID oder deinem Anmeldepasswort, bevor ein gesicherter Account ausgefüllt wird. Zahlungskarten fragen immer nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks for Touch ID or your login password before filling a saved account. Payment cards always ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide Touch ID o la contraseña de inicio de sesión antes de rellenar una cuenta guardada. Las tarjetas de pago siempre lo piden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande Touch ID ou votre mot de passe de session avant de remplir un compte enregistré. Les cartes de paiement demandent toujours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたアカウントを入力する前に、Touch IDまたはログインパスワードを求めます。支払いカードは常に確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosi o Touch ID lub hasło logowania przed wypełnieniem zachowanego konta. Karty płatnicze zawsze o to pytają."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает Touch ID или пароль входа перед заполнением сохраненной учетной записи. Для платежных карт запрос всегда выводится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує Touch ID або пароль вашого облікового запису перед заповненням збереженого облікового запису. Платіжні картки завжди потребують підтвердження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填充已存储的账户前，先要求使用 Touch ID 或输入你的登录密码。付款卡始终会询问。"
          }
        }
      }
    },
