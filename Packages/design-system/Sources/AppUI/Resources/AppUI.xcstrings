    "settings.previewsDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Vorschauen von Ordnern und Favoriten, wenn du den Zeiger darüber bewegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview folders and favorite sites when you hover over them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza carpetas y sitios favoritos al pasar el puntero sobre ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez un aperçu des dossiers et des sites favoris lorsque vous les survolez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダやお気に入りのサイトにポインタを重ねたときに、プレビューを表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj podgląd folderów i ulubionych witryn po najechaniu na nie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте папки и избранные сайты при наведении на них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередньо переглядайте папки й улюблені сайти, наводячи на них курсор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针悬停在文件夹和个人收藏网站上时进行预览。"
          }
        }
      }
    },
    "settings.previewsPrivacy": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Favorit wird in seinem eigenen Profil auf diesem Mac gelesen. Ungelesene E-Mails stammen von einem Gmail-Favoriten, solange er geöffnet ist, und zuletzt besuchte Seiten aus dem Verlauf des Profils. Es wird nichts an Arx oder anderswohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each favorite is read in its own profile, on this Mac. Unread mail comes from a Gmail favorite while it’s open, and recent pages from the profile’s history. Nothing is sent to Arx or anywhere else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada favorito se lee en su propio perfil, en este Mac. El correo no leído procede de un favorito de Gmail mientras está abierto, y las páginas recientes, del historial del perfil. No se envía nada a Arx ni a ningún otro sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque favori est lu dans son propre profil, sur ce Mac. Le courrier non lu provient d’un favori Gmail tant qu’il est ouvert, et les pages récentes de l’historique du profil. Rien n’est envoyé à Arx ni ailleurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各お気に入りは、このMac上のそれぞれのプロファイルで読み取られます。未読メールは、開いている間のGmailのお気に入りから、最近のページはプロファイルの履歴から取得されます。Arxやほかの場所には何も送信されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda ulubiona witryna jest odczytywana w swoim własnym profilu, na tym Macu. Nieprzeczytane wiadomości pochodzą z ulubionej witryny Gmail, gdy jest otwarta, a ostatnie strony z historii profilu. Nic nie jest wysyłane do Arx ani nigdzie indziej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый избранный сайт читается в своем профиле на этом Mac. Непрочитанная почта берется из избранного Gmail, пока он открыт, а недавние страницы — из истории профиля. Ничего не отправляется в Arx или куда-либо еще."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен улюблений сайт читається у власному профілі на цьому Mac. Непрочитана пошта береться з улюбленого сайту Gmail, поки він відкритий, а нещодавні сторінки — з історії профілю. Нічого не надсилається до Arx чи кудись іще."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个个人收藏都会在这台 Mac 上、于其自己的用户场景中读取。未读邮件来自已打开的 Gmail 个人收藏，最近的页面来自该用户场景的历史记录。不会向 Arx 或其他任何地方发送任何内容。"
          }
        }
      }
    },
