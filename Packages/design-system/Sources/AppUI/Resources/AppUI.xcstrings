    "reportProblem.message": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was passiert ist und was du erwartet hast. „Problem auf GitHub öffnen“ öffnet ein neues Problem für das Arx-Team, in dem dies und die Versionen ausgefüllt sind; du reichst es mit deinem GitHub-Account ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what happened and what you expected. Open Issue on GitHub opens a new issue for the Arx team with this and the versions filled in; you file it with your GitHub account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe lo que ha pasado y lo que esperabas. “Abrir incidencia en GitHub” abre una incidencia nueva para el equipo de Arx con esto y las versiones ya rellenadas; la envías con tu cuenta de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez ce qui s’est passé et ce que vous attendiez. « Ouvrir un ticket sur GitHub » ouvre un nouveau ticket pour l’équipe d’Arx avec ce texte et les versions déjà renseignés ; vous le créez avec votre compte GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が起きたか、何を期待していたかを記入してください。「GitHubでIssueを開く」を選択すると、この内容とバージョンが入力された、Arxチーム宛ての新しいIssueが開きます。送信にはご自身のGitHubアカウントを使用します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz, co się stało i czego oczekiwano. Opcja Otwórz zgłoszenie na GitHubie otwiera nowe zgłoszenie dla zespołu Arx z tym opisem i wypełnionymi wersjami; zgłaszasz je ze swojego konta GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите, что произошло и что Вы ожидали. Кнопка «Открыть обращение на GitHub» открывает для команды Arx новое обращение с этим описанием и заполненными версиями; отправляете его Вы со своей учетной записью GitHub."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть, що сталося і чого ви очікували. «Відкрити повідомлення на GitHub» відкриває нове повідомлення для команди Arx із цим описом і заповненими версіями; ви створюєте його зі своїм обліковим записом GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请描述发生了什么，以及你期望的结果。“在 GitHub 上打开问题”会为 Arx 团队新建一个问题，并填入这些内容和版本信息；你需要使用自己的 GitHub 账户提交。"
          }
        }
      }
    },
    "reportProblem.title": {
      "extractionState": "manual",
