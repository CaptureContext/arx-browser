    "settings.switchesToLinkTabs": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Link in einem neuen Tab geöffnet wird, zu diesem wechseln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a link opens in a new tab, switch to it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un enlace se abre en una pestaña nueva, ir a ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un lien s’ouvre dans un nouvel onglet, y passer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを新規タブで開いたときにそのタブに切り替える"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy łącze otwiera się w nowej karcie, przełączaj na nią"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключаться на вкладку, когда ссылка открывается в новой вкладке"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли посилання відкривається в новій вкладці, переходити до неї"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接在新标签页中打开时，切换到该标签页"
          }
        }
      }
    },
    "settings.switchesToLinkTabsExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für „In neuem Tab öffnen“, Befehlstaste-Klick und Klick mit der mittleren Maustaste. ⇧⌘-Klick bewirkt das Gegenteil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Open in New Tab, ⌘-click and middle-click. ⇧⌘-click does the opposite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Abrir en una pestaña nueva, ⌘ + clic y clic con el botón central. ⇧⌘ + clic hace lo contrario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour Ouvrir dans un nouvel onglet, ⌘-clic et clic central. ⇧⌘-clic fait l’inverse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「新規タブで開く」、⌘クリック、中央ボタンのクリックが対象です。⇧⌘クリックでは逆の動作になります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla Otwórz w nowej karcie, kliknięcia z ⌘ i kliknięcia środkowym przyciskiem. Kliknięcie z ⇧⌘ robi odwrotnie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для команды «Открыть в новой вкладке», нажатия с ⌘ и нажатия средней кнопкой. Нажатие с ⇧⌘ делает наоборот."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для «Відкрити в новій вкладці», клацання із ⌘ і клацання середньою кнопкою. Клацання із ⇧⌘ робить навпаки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于“在新标签页中打开”、按住 ⌘ 点按和中键点按。按住 ⇧⌘ 点按则相反。"
          }
        }
      }
    },
