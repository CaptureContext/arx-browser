    "onboarding.tour.peek.headline": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirf mit Peek einen Blick auf einen Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peek at a link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peek: un vistazo a un enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Peek sur un lien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクをPeekで見る。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Peek na łącze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peek: загляните в ссылку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте посилання в Peek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Peek 快速查看链接。"
          }
        }
      }
    },
    "onboarding.tour.peek.message": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird über der aktuellen Seite geöffnet, und Esc legt ihn wieder weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It opens over the page you're on, and Esc puts it away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre sobre la página en la que estás y Esc lo guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’ouvre au-dessus de la page où vous êtes, et Échap le range."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今見ているページの上で開き、Escキーでしまえます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera się nad stroną, na której jesteś, a Esc go chowa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она открывается поверх текущей страницы, а Esc убирает ее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Воно відкривається поверх сторінки, на якій ви перебуваєте, а Esc прибирає його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会在你当前的页面上方打开，按 Esc 键即可收起。"
          }
        }
      }
    },
    "onboarding.tour.peek.description": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Ein Link auf einer Seite wird in Peek über der Seite geöffnet, und Esc legt ihn wieder weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: a link on a page opens in Peek over the page, and Escape puts it away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostración: un enlace de una página se abre en Peek sobre la página y Esc lo guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démo : un lien d’une page s’ouvre dans Peek au-dessus de la page, et Échap le range."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ：ページのリンクがページの上のPeekで開き、Escキーでしまわれます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: łącze na stronie otwiera się w Peek nad stroną, a Esc go chowa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрация: ссылка на странице открывается в Peek поверх страницы, а Escape убирает его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрація: посилання на сторінці відкривається в Peek поверх сторінки, а Esc прибирає його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示：页面上的链接在页面上方的 Peek 中打开，按 Esc 键即可收起。"
          }
        }
      }
    },
    "onboarding.tour.splitView.headline": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte es neben der Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it beside the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
