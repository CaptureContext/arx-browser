    "automation.signIn.originNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist der genaue Ursprung des Dienstes, einschließlich seines Ports. Arx ruft keine Passwörter, Codes oder Zugangsdaten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the exact service origin, including its port. Arx does not retrieve passwords, codes or credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el origen exacto del servicio, con su puerto. Arx no obtiene contraseñas, códigos ni credenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit de l’origine exacte du service, port compris. Arx ne récupère ni mots de passe, ni codes, ni identifiants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートを含む、サービスのオリジンそのものです。Arxはパスワード、コード、認証情報を取得しません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dokładne źródło usługi, razem z jej portem. Arx nie pobiera haseł, kodów ani poświadczeń."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это точный источник службы, включая порт. Arx не получает пароли, коды и учетные данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це точне джерело сервісу разом із портом. Arx не отримує паролі, коди чи облікові дані."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是确切的服务来源，包括其端口。Arx 不会获取密码、验证码或凭据。"
          }
        }
      }
    },
    "automation.signIn.pauseNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Fortfahren werden alle Lesezugriffe und Aktionen der Assistenten im Browser pausiert, auch in anderen Tabs und Profilen. Gib keine Passwörter oder Codes ein, bevor die Assistenten pausiert sind. Frühere Aktionen auf Websites können nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuing pauses every assistant’s browser reads and actions, including other tabs and profiles. Do not enter passwords or codes until assistants are paused. Earlier website actions cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar pausa todas las lecturas y acciones de los asistentes en el navegador, incluidas las de otras pestañas y perfiles. No introduzcas contraseñas ni códigos hasta que los asistentes estén en pausa. Las acciones anteriores en sitios web no se pueden deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer suspend les lectures et les actions de tous les assistants dans le navigateur, y compris dans les autres onglets et profils. Ne saisissez ni mots de passe ni codes tant que les assistants ne sont pas suspendus. Les actions précédentes sur les sites web ne peuvent pas être annulées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けると、ほかのタブやプロファイルを含め、すべてのアシスタントのブラウザの読み取りと操作が一時停止されます。アシスタントが一時停止されるまで、パスワードやコードを入力しないでください。以前のウェブサイトでの操作は取り消せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuowanie wstrzymuje odczyty i czynności przeglądarki każdego asystenta, także w innych kartach i profilach. Nie wpisuj haseł ani kodów, dopóki asystenci nie zostaną wstrzymani. Wcześniejszych czynności w witrynach nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжение приостанавливает чтение и действия всех ассистентов в браузере, включая другие вкладки и профили. Не вводите пароли и коды, пока ассистенты не приостановлены. Предыдущие действия на сайтах нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовження призупиняє читання й дії всіх асистентів у браузері, зокрема в інших вкладках і профілях. Не вводьте паролі чи коди, доки асистентів не призупинено. Попередні дії на вебсайті не можна відмінити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续会暂停所有助理对浏览器的读取和操作，包括其他标签页和用户场景。在助理暂停之前，请勿输入密码或验证码。之前在网站上的操作无法撤销。"
          }
        }
      }
    },
    "automation.signIn.approve": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenten pausieren und fortfahren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause assistants and continue"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar asistentes y continuar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendre les assistants et continuer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントを一時停止して続ける"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj asystentów i kontynuuj"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановить ассистентов и продолжить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупинити асистентів і продовжити"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停助理并继续"
          }
        }
      }
    },
    "automation.signIn.securing": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenschutzsperre wird gesichert. Gib noch keine Authentifizierungsdaten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving the privacy lock. Do not enter authentication details yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando el bloqueo de privacidad. No introduzcas todavía datos de autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement du verrouillage de confidentialité. Ne saisissez pas encore d’informations d’authentification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーロックを保存しています。まだ認証情報を入力しないでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowywanie blokady prywatności. Nie wpisuj jeszcze danych uwierzytelniających."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение блокировки конфиденциальности. Пока не вводите данные для аутентификации."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збереження блокування приватності. Поки не вводьте дані автентифікації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在存储隐私锁定。请暂时不要输入验证信息。"
          }
        }
      }
    },
    "automation.signIn.userAction": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Assistenten sind pausiert. Verwende die bestehende Browsersitzung oder schließe die Anmeldung selbst ab. Beim Verlassen der Seite wird diese Übergabe abgebrochen und die Datenschutzsperre bleibt aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistants are paused. Use the existing browser session or complete sign-in yourself. Navigating away cancels this handoff and keeps privacy locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los asistentes están en pausa. Usa la sesión existente del navegador o completa tú el inicio de sesión. Si navegas a otra página, se cancela este traspaso y la privacidad sigue bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les assistants sont suspendus. Utilisez la session existante du navigateur ou terminez la connexion vous-même. Quitter la page annule ce transfert et laisse la confidentialité verrouillée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントは一時停止中です。既存のブラウザセッションを使うか、ご自身でサインインを完了してください。別のページに移動すると、この引き継ぎはキャンセルされ、プライバシーロックは維持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystenci są wstrzymani. Użyj istniejącej sesji przeglądarki albo zaloguj się samodzielnie. Przejście na inną stronę anuluje to przekazanie i pozostawia blokadę prywatności."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистенты приостановлены. Используйте существующий сеанс браузера или выполните вход самостоятельно. Переход на другую страницу отменяет эту передачу и сохраняет блокировку конфиденциальности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистентів призупинено. Скористайтеся наявним сеансом браузера або завершіть вхід самостійно. Перехід на іншу сторінку скасовує це передавання й залишає приватність заблокованою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理已暂停。请使用现有的浏览器会话，或自行完成登录。离开此页面会取消此次交接，并保持隐私锁定。"
          }
        }
      }
    },
    "automation.signIn.confirm": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bestätige, dass diese Sitzung angemeldet ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I confirm this session is signed in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmo que esta sesión tiene la sesión iniciada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je confirme que cette session est connectée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションでサインイン済みであることを確認しました"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzam, że ta sesja jest zalogowana"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждаю, что вход в этом сеансе выполнен"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтверджую, що цей сеанс авторизовано"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我确认此会话已登录"
          }
        }
      }
    },
    "automation.signIn.blocked": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine frühere Aktion auf dieser Seite gibt es keinen bestätigten Abschluss. Die sensible Übergabe ist gesperrt, bis die Seite wechselt oder geschlossen wird. Die Datenschutzsperre bleibt aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier action on this page has no confirmed completion. Sensitive handoff is blocked until the page navigates or closes. Privacy remains locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una acción anterior en esta página no tiene una finalización confirmada. El traspaso sensible está bloqueado hasta que la página navegue o se cierre. La privacidad sigue bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une action précédente sur cette page n’a pas de fin confirmée. Le transfert sensible est bloqué jusqu’à ce que la page change ou se ferme. La confidentialité reste verrouillée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページでの以前の操作の完了が確認できていません。ページが移動するか閉じるまで、機密情報の引き継ぎはブロックされます。プライバシーロックは維持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcześniejsza czynność na tej stronie nie ma potwierdzonego zakończenia. Przekazanie wrażliwych danych jest zablokowane, dopóki strona nie zmieni adresu lub nie zostanie zamknięta. Blokada prywatności pozostaje włączona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для предыдущего действия на этой странице нет подтвержденного завершения. Передача конфиденциальных данных заблокирована, пока страница не перейдет по ссылке или не закроется. Блокировка конфиденциальности сохраняется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для попередньої дії на цій сторінці немає підтвердженого завершення. Передавання чутливих даних заблоковано, доки сторінка не перейде в інше місце або не закриється. Блокування приватності лишається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网页上之前的某个操作尚未确认完成。在网页跳转或关闭之前，敏感信息交接会被阻止。隐私保护仍保持锁定。"
          }
        }
      }
    },
    "automation.signIn.confirmed": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bestätigung wurde aufgezeichnet. Arx hat die Anmeldung nicht unabhängig überprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your confirmation was recorded. Arx has not independently verified sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha registrado tu confirmación. Arx no ha verificado el inicio de sesión por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre confirmation a été enregistrée. Arx n’a pas vérifié la connexion de façon indépendante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が記録されました。Arxはサインインを独自に検証していません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje potwierdzenie zostało zapisane. Arx nie zweryfikował logowania niezależnie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше подтверждение записано. Arx не проверял вход самостоятельно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше підтвердження записано. Arx самостійно не перевіряв вхід."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录你的确认。Arx 并未独立验证登录。"
          }
        }
      }
    },
    "automation.signIn.ended": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übergabe wurde beendet. Die Datenschutzsperre bleibt aktiv, falls sie aktiviert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The handoff ended. Privacy remains locked if it was activated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El traspaso ha terminado. La privacidad sigue bloqueada si se activó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert est terminé. La confidentialité reste verrouillée s’il a été activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き継ぎが終了しました。有効になっていた場合、プライバシーロックは維持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazanie zakończyło się. Blokada prywatności pozostaje włączona, jeśli została aktywowana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача завершена. Блокировка конфиденциальности сохраняется, если она была включена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передавання завершено. Блокування приватності лишається, якщо його було активовано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交接已结束。如果已启用隐私锁定，则仍保持锁定。"
          }
        }
      }
