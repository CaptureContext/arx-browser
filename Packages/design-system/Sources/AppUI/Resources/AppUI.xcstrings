    "migration.preferencesNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das Erscheinungsbild und die Tastaturbelegungen der Datei und fügt ihre Suchkürzel und Linkregeln hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the file’s appearance and key bindings, and adds its search shortcuts and link rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el aspecto y los atajos de teclado del archivo, y añade sus atajos de búsqueda y sus reglas de enlaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l’apparence et les raccourcis clavier du fichier, et ajoute ses raccourcis de recherche et ses règles de lien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの外観とキーバインドを使用し、検索ショートカットとリンクのルールを追加します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa wyglądu i skrótów klawiszowych z pliku oraz dodaje jego skróty wyszukiwania i reguły łączy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется оформление и сочетания клавиш из файла, а также добавляются его поисковые сокращения и правила для ссылок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує вигляд і клавіатурні скорочення з файлу та додає його пошукові скорочення й правила посилань."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用该文件的外观和按键绑定，并添加其搜索快捷词和链接规则。"
          }
        }
      }
    },
