    "translation.needsDownload": {
      "comment": "Translation failed until the language is downloaded. The path names macOS's System Settings as Apple titles them in this language. %@ is a language's name as macOS gives it in the interface language (“French”, „Französisch“); it is inserted as it is and can't be declined, hence the label and colon.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sprache muss zuerst geladen werden: %@. Lade sie unter Systemeinstellungen › Allgemein › Sprache & Region › Übersetzungssprachen und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This language needs to be downloaded first: %@. Download it in System Settings › General › Language & Region › Translation Languages, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes hay que descargar este idioma: %@. Descárgalo en Ajustes del Sistema › General › Idioma y región › Idiomas de traducción y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette langue doit d’abord être téléchargée : %@. Téléchargez-la dans Réglages Système › Général › Langue et région › Langues de traduction, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語を先にダウンロードする必要があります：%@。「システム設定」＞「一般」＞「言語と地域」＞「翻訳言語」でダウンロードしてから、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw trzeba pobrać ten język: %@. Pobierz go w Ustawieniach systemowych › Ogólne › Język i region › Języki tłumaczeń, a następnie spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала нужно загрузить язык: %@. Загрузите его в «Системные настройки › Основные › Язык и регион › Языки для перевода» и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу потрібно викачати мову: %@. Викачайте її в «Системні параметри › Загальні › Мова і регіон › Мови перекладу», потім спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先下载此语言：%@。请在“系统设置”>“通用”>“语言与地区”>“翻译语言”中下载，然后重试。"
          }
        }
      }
    },
    "translation.unavailable": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite kann nicht übersetzt werden: Private Fenster, WebKit-Seiten und Seiten, die nicht im Web sind, werden nicht übersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page can't be translated: private windows, WebKit pages and pages that aren't on the web aren't translated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página no se puede traducir: no se traducen las ventanas privadas, las páginas de WebKit ni las páginas que no son de la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page ne peut pas être traduite : les fenêtres privées, les pages WebKit et les pages hors du web ne sont pas traduites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページは翻訳できません。プライベートウインドウ、WebKitページ、ウェブ上にないページは翻訳されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej strony nie można przetłumaczyć: okna prywatne, strony WebKit i strony spoza internetu nie są tłumaczone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту страницу нельзя перевести: частные окна, страницы WebKit и страницы не из интернета не переводятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю сторінку не можна перекласти: приватні вікна, сторінки WebKit і сторінки не з вебу не перекладаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法翻译此页面：无痕浏览窗口、WebKit 页面和不在网络上的页面不会被翻译。"
          }
        }
      }
    },
