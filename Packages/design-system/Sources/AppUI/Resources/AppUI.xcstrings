    "automation.pausedNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Seite aus gestoppt. Seine Anfragen schlagen fehl, bis du es fortsetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped from the page. Its requests fail until you resume it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido desde la página. Sus peticiones fallan hasta que lo reanudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté depuis la page. Ses requêtes échouent jusqu’à ce que vous le reprenniez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページから停止されました。再開するまで、リクエストは失敗します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano ze strony. Jego żądania kończą się niepowodzeniem, dopóki go nie wznowisz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено со страницы. Его запросы завершаются ошибкой, пока Вы не возобновите работу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупинено зі сторінки. Його запити не виконуються, доки ви не відновите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在网页上停止。在你恢复之前，它的请求都会失败。"
          }
        }
      }
    },
