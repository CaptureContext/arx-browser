    "chat.settingsDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in die Befehlsleiste und drücke den Tabulator, um den Assistenten zu fragen. Er läuft mit deiner eigenen Anmeldung bei Claude oder ChatGPT, daher werden Chats auf diesen Tarif angerechnet. Jedes Profil behält seine eigenen Chats und Auswahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type in the command bar and press Tab to ask the assistant. It runs on your own Claude or ChatGPT sign-in, so chats count against that plan. Each profile keeps its own chats and choices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en la barra de comandos y pulsa Tab para preguntar al asistente. Funciona con tu propio inicio de sesión de Claude o ChatGPT, así que los chats cuentan para ese plan. Cada perfil guarda sus propios chats y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez dans la barre de commandes et appuyez sur Tab pour interroger l’assistant. Il utilise votre propre connexion Claude ou ChatGPT ; les discussions sont donc décomptées de ce forfait. Chaque profil conserve ses propres discussions et ses propres choix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドバーに入力してTabキーを押すと、アシスタントに質問できます。お使いのClaudeまたはChatGPTのサインインで実行されるため、チャットはそのプランの使用量にカウントされます。チャットと選択内容はプロファイルごとに保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz tekst na pasku poleceń i naciśnij Tab, aby zapytać asystenta. Działa na Twoim własnym logowaniu do Claude lub ChatGPT, więc czaty wliczają się do tego planu. Każdy profil ma własne czaty i wybory."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите текст в панели команд и нажмите Tab, чтобы спросить ассистента. Он работает с Вашим собственным входом в Claude или ChatGPT, поэтому чаты учитываются в этом плане. У каждого профиля свои чаты и настройки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть текст у панелі команд і натисніть Tab, щоб запитати асистента. Він працює через ваш власний вхід у Claude або ChatGPT, тому чати враховуються у вашому плані. Кожен профіль зберігає власні чати та вибір."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令栏中输入并按下 Tab 键即可向助理提问。它使用你自己的 Claude 或 ChatGPT 登录，因此聊天会计入该套餐的用量。每个用户场景都有各自的聊天和选择。"
          }
        }
      }
    },
