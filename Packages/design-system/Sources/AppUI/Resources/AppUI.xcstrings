    "management.profileHasSpaces": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege oder entferne die Räume eines Profils, bevor du das Profil entfernst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move or remove a profile’s spaces before removing the profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traslada o elimina las secciones de un perfil antes de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez ou supprimez les sections d’un profil avant de le supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルを削除する前に、そのスペースを移動または削除してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś lub usuń strefy profilu, zanim go usuniesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем удалять профиль, переместите или удалите его разделы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістіть або вилучіть розділи профілю, перш ніж вилучати профіль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除用户场景之前，请先移动或移除它的分区。"
          }
        }
      }
    },
    "management.profileInUse": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Peek-Vorschauen und Little-Arx-Fenster dieses Profils, bevor du es entfernst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this profile’s Peek previews and Little Arx windows before removing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra las previsualizaciones de Peek y las ventanas de Little Arx de este perfil antes de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez les aperçus Peek et les fenêtres Little Arx de ce profil avant de le supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルを削除する前に、そのプロファイルのPeekプレビューとLittle Arxウインドウを閉じてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij podglądy Peek i okna Little Arx tego profilu, zanim go usuniesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем удалять профиль, закройте его окна Peek и Little Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрийте попередні перегляди Peek і вікна Little Arx цього профілю, перш ніж вилучати його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此用户场景之前，请先关闭它的 Peek 预览和 Little Arx 窗口。"
          }
        }
      }
    },
    "management.profilePreparationFailed": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zielprofil konnte nicht geöffnet werden. Es wurde nichts geändert; versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the destination profile. Nothing was changed; please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir el perfil de destino. No se ha cambiado nada; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le profil de destination. Rien n’a été modifié ; veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動先のプロファイルを開けませんでした。何も変更されていません。もう一度お試しください。"
