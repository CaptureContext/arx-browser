    },
    "onboarding.message.migration": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm Tabs, Lesezeichen und Verlauf aus dem Browser, den du jetzt verwendest. Alles bleibt auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring tabs, bookmarks and history from the browser you use now. It all stays on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae pestañas, marcadores e historial del navegador que usas ahora. Todo se queda en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez les onglets, les signets et l’historique du navigateur que vous utilisez actuellement. Tout reste sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在使用しているブラウザから、タブ、ブックマーク、履歴を読み込みます。すべてこのMacに残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś karty, zakładki i historię z przeglądarki, której teraz używasz. Wszystko zostaje na tym Macu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите вкладки, закладки и историю из браузера, которым Вы пользуетесь сейчас. Все остается на этом Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесіть вкладки, закладки та історію з браузера, яким ви користуєтеся зараз. Усе лишається на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你当前使用的浏览器导入标签页、书签和历史记录。所有内容都会保留在这台 Mac 上。"
          }
        }
      }
    },
    "onboarding.message.outsideAgents": {
