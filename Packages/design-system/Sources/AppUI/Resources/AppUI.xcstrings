    "history.unavailable": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf konnte nicht geladen werden. Versuche es erneut, damit die zuletzt besuchten Seiten dieses Profils verfügbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History could not be loaded. Retry to make this profile’s recent pages available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar el historial. Reinténtalo para que estén disponibles las páginas recientes de este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique n’a pas pu être chargé. Réessayez pour rendre disponibles les pages récentes de ce profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を読み込めませんでした。再試行して、このプロファイルの最近のページを利用できるようにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać historii. Spróbuj ponownie, aby udostępnić ostatnie strony tego profilu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить историю. Повторите попытку, чтобы сделать доступными недавние страницы этого профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити історію. Повторіть спробу, щоб зробити доступними недавні сторінки цього профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入历史记录。请重试，以使此用户场景的最近页面可用。"
          }
        }
      }
    },
    "history.unreadable": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf dieses Profils konnte nicht gelesen werden. Die vorhandene Datei wurde beibehalten. Lösche den Verlauf, um einen neuen Index zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile’s history could not be read. The existing file has been preserved. Clear History to start a new index."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el historial de este perfil. Se ha conservado el archivo existente. Borra el historial para empezar un índice nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique de ce profil n’a pas pu être lu. Le fichier existant a été conservé. Effacez l’historique pour créer un nouvel index."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルの履歴を読み込めませんでした。既存のファイルは保持されています。履歴を消去して、新しいインデックスを作成してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać historii tego profilu. Istniejący plik został zachowany. Wymaż historię, aby rozpocząć nowy indeks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать историю этого профиля. Существующий файл сохранен. Очистите историю, чтобы начать новый индекс."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати історію цього профілю. Наявний файл збережено. Очистьте історію, щоб почати новий індекс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此用户场景的历史记录。现有文件已保留。请清除历史记录以开始新的索引。"
          }
        }
      }
    },
