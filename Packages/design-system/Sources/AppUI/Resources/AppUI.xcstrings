    },
    "settings.iCloudSync.groupSync.title": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wieder synchronisieren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync %@ again?"
          }
        },
        "es": {
          "stringUnit": {
