    "media.staleSource": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Medienquelle hat sich geändert. Wähle ihre aktuellen Steuerelemente aus, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This media source changed. Choose its current controls to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este origen multimedia ha cambiado. Selecciona sus controles actuales para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source multimédia a changé. Choisissez ses commandes actuelles pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメディアソースが変更されました。続けるには、現在のコントロールを選択してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To źródło multimediów uległo zmianie. Wybierz jego aktualne elementy sterujące, aby kontynuować."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источник медиа изменился. Выберите его текущие элементы управления, чтобы продолжить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це джерело медіа змінилося. Виберіть його поточні елементи керування, щоб продовжити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此媒体来源已更改。请选取其当前的控制项以继续。"
          }
        }
      }
    },
    "media.timedOut": {
      "comment": "Media controls: the page didn't answer a play, pause or PiP request in time. PiP is Arx's mini player; keep “PiP”.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite hat die Aktion nicht bestätigt. Öffne den Tab erneut, falls PiP weiterhin nicht verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page did not confirm the action. Reopen the tab if PiP remains unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página no ha confirmado la acción. Vuelve a abrir la pestaña si el PiP sigue sin estar disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page n’a pas confirmé l’action. Rouvrez l’onglet si PiP reste indisponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページが操作を確認しませんでした。PiPが引き続き利用できない場合は、タブを開き直してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona nie potwierdziła czynności. Otwórz kartę ponownie, jeśli PiP nadal jest niedostępny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница не подтвердила действие. Откройте вкладку заново, если PiP по-прежнему недоступен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
