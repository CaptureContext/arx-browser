    "onboarding.tour.sample.chats.answer": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Design-Aufgabe, um die kleinste Breite der Seitenleiste festzulegen.\n• Sie bleibt mindestens 240 Punkt breit.\n• Ein Doppelklick auf den Rand setzt sie zurück.\n• In Arbeit, mit verlinkter Peek-Spezifikation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A design task to set the sidebar's narrowest width.\n• Keep it at least 240 points wide.\n• A double-click on the edge resets it.\n• In progress, with the Peek spec linked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea de diseño para fijar el ancho mínimo de la barra lateral.\n• Mantenerla al menos a 240 puntos de ancho.\n• Un doble clic en el borde la restablece.\n• En curso, con la especificación de Peek enlazada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche de conception pour définir la largeur minimale de la barre latérale.\n• La garder à au moins 240 points de large.\n• Un double-clic sur le bord la réinitialise.\n• En cours, avec la spécification de Peek en lien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーの最小幅を設定するデザインタスクです。\n• 幅は240ポイント以上に保ちます。\n• 端をダブルクリックすると、リセットされます。\n• 進行中で、Peekの仕様がリンクされています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadanie projektowe: ustawić najmniejszą szerokość paska bocznego.\n• Utrzymaj co najmniej 240 punktów szerokości.\n• Dwukrotne kliknięcie krawędzi przywraca ustawienie.\n• W toku, z linkiem do specyfikacji Peek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача по дизайну: задать наименьшую ширину бокового меню.\n• Ширина не меньше 240 пунктов.\n• Двойной клик по краю сбрасывает ее.\n• В работе, со ссылкой на спецификацию Peek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання дизайну: задати найменшу ширину бічної панелі.\n• Тримати її шириною щонайменше 240 пунктів.\n• Подвійне клацання на краю скидає її.\n• У роботі, зі специфікацією Peek за посиланням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一项设计任务，用于设定边栏的最小宽度。\n• 至少保持 240 点宽。\n• 双击边缘即可重置。\n• 进行中，并附有 Peek 规格的链接。"
          }
        }
      }
    },
