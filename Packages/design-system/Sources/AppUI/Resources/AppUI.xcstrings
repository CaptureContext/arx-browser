          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は添付できません。イメージ、ビデオ、テキスト、PDFファイルを添付してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można załączyć „%@”. Załączaj obrazy, filmy, tekst lub pliki PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл «%@» нельзя прикрепить. Прикрепляйте изображения, видео, текстовые файлы или файлы PDF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не можна додати. Додавайте зображення, відео, текстові файли або PDF."
