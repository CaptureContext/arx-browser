    "onboarding.iCloud.unreachable": {
      "comment": "Onboarding, Sync with iCloud page: iCloud can't be reached; the footer offers Continue without waiting and Try again.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist nicht erreichbar. Fahre fort, dann synchronisiert Arx, sobald es möglich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach iCloud. Continue, and Arx syncs once it can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a iCloud. Continúa y Arx sincronizará en cuanto pueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre iCloud. Continuez, et Arx se synchronisera dès que possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudに接続できません。続けると、接続できるようになった時点でArxが同期します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z iCloud. Kontynuuj, a Arx zsynchronizuje się, gdy będzie to możliwe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удается подключиться к iCloud. Продолжайте, а Arx синхронизируется, как только это станет возможно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається звʼязатися з iCloud. Продовжте, і Arx синхронізується, щойно зможе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 iCloud。请继续，Arx 会在能够连接时进行同步。"
          }
        }
      }
    },
