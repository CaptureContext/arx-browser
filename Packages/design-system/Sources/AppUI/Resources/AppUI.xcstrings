          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの横に置いておく。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miej to obok strony."
          }
        },
        "ru": {
          "stringUnit": {
