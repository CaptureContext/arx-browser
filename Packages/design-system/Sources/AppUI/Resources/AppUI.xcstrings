      "comment": "Shown in Settings › Arx when getting the member number failed because there was no connection.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server von Arx konnte nicht erreicht werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach Arx's server. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar con el servidor de Arx. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur d’Arx. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxのサーバに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z serwerem Arx. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к серверу Arx. Проверьте подключение и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося звʼязатися із сервером Arx. Перевірте зʼєднання й спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Arx 的服务器。请检查网络连接，然后重试。"
          }
        }
      }
    },
    "settings.identity.member.failed.cancelled": {
      "comment": "Shown in Settings › Arx when the person closed Apple's sign-in before it finished.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde abgebrochen. Es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was cancelled. Nothing was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha cancelado el inicio de sesión. No se ha enviado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été annulée. Rien n’a été envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインが取り消されました。何も送信されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie zostało anulowane. Nic nie wysłano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход отменен. Ничего не отправлено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід скасовано. Нічого не надіслано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消登录。未发送任何内容。"
          }
        }
      }
    },
    "settings.identity.member.failed.refused": {
      "comment": "Shown in Settings › Arx when Arx's server answered without giving a member number.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server von Arx hat die Anmeldung nicht akzeptiert. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx's server didn't accept the sign-in. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de Arx no ha aceptado el inicio de sesión. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur d’Arx n’a pas accepté la connexion. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxのサーバがサインインを受け付けませんでした。後でもう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer Arx nie przyjął logowania. Spróbuj ponownie później."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Arx не принял вход. Повторите попытку позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Arx не прийняв вхід. Спробуйте пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 的服务器未接受此次登录。请稍后再试。"
          }
        }
      }
    },
    "settings.identity.member.failed.signIn": {
