    "settings.routingReview": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-Abgleich, Regelreihenfolge, Ziele und Ausweichverhalten werden noch geprüft. Externe Links werden von diesen Platzhaltern nicht zugeordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL matching, rule order, destinations and fallback behavior are being reviewed. External links are not routed by these placeholders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La coincidencia de URL, el orden de las reglas, los destinos y el comportamiento alternativo se están revisando. Estos marcadores de posición no gestionan la apertura de los enlaces externos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correspondance des URL, l’ordre des règles, les destinations et le comportement de repli sont en cours d’examen. Les liens externes ne sont pas acheminés par ces éléments provisoires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URLの一致、ルールの順序、移動先、フォールバックの動作は検討中です。外部のリンクは、これらのプレースホルダでは振り分けられません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasowywanie URL, kolejność reguł, miejsca docelowe i zachowanie awaryjne są w trakcie przeglądu. Te zastępcze reguły nie kierują łączy zewnętrznych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопоставление URL-адресов, порядок правил, места назначения и резервное поведение проходят проверку. Внешние ссылки не направляются этими заполнителями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіставлення URL-адрес, порядок правил, пункти призначення й запасна поведінка переглядаються. Зовнішні посилання не маршрутизуються цими заповнювачами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 匹配、规则顺序、目的地和后备行为正在审核中。来自其他 App 的链接不会按这些占位项进行路由。"
          }
        }
      }
    },
