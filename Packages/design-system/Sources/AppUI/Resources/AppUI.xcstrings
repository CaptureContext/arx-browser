          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обращение открылось в новой вкладке с Вашим описанием и заполненными версиями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення відкрилося в новій вкладці з вашим описом і заповненими версіями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
