    "settings.memoryNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Inaktive Tabs entladen“ ist dieselbe Einstellung wie in Allgemein › Tabs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unload inactive tabs is the same setting as in General › Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar pestañas inactivas es el mismo ajuste que en General › Pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décharger les onglets inactifs est le même réglage que dans Général › Onglets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「非アクティブなタブを解放」は、「一般」＞「タブ」と同じ設定です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwalnianie nieaktywnych kart to to samo ustawienie co w Ustawieniach › Ogólne › Karty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр «Выгружать неактивные вкладки» — тот же, что в «Настройки › Основные › Вкладки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивантаження неактивних вкладок — той самий параметр, що й у розділі «Загальні › Вкладки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“卸载不活跃的标签页”与“通用”>“标签页”中的设置相同。"
          }
        }
      }
    },
    "settings.keptLoadedSites": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites, die geladen bleiben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites kept loaded"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitios que se mantienen cargados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites gardés chargés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだままにするサイト"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witryny utrzymywane załadowane"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайты, которые не выгружаются"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайти, що залишаються завантаженими"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持已加载的网站"
          }
        }
      }
    },
    "settings.keptLoadedSitesExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs dieser Websites werden nie entladen, weder nach längerer Zeit im Hintergrund noch bei knappem Arbeitsspeicher. Eine Website umfasst ihre Subdomains. Jedes Profil hat seine eigenen Websites."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs on these sites never unload, after any time hidden or when memory runs low. A site covers its subdomains. Each profile has its own sites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas de estos sitios nunca se descargan, ni tras un tiempo oculto ni cuando queda poca memoria. Un sitio incluye sus subdominios. Cada perfil tiene sus propios sitios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets de ces sites ne sont jamais déchargés, quelle que soit la durée pendant laquelle ils sont masqués ou même quand la mémoire est faible. Un site couvre ses sous-domaines. Chaque profil a ses propres sites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのサイトのタブは、非表示のまま時間が経過しても、メモリが少なくなっても、解放されません。サイトにはそのサブドメインも含まれます。サイトはプロファイルごとに設定します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty tych witryn nigdy nie są zwalniane, ani po jakimkolwiek czasie w ukryciu, ani gdy brakuje pamięci. Witryna obejmuje swoje subdomeny. Każdy profil ma własne witryny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки этих сайтов никогда не выгружаются: ни после долгого пребывания в фоне, ни при нехватке памяти. Сайт охватывает и свои поддомены. У каждого профиля свои сайты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки цих сайтів ніколи не вивантажуються, незалежно від того, як довго вони приховані, і коли памʼяті мало. Сайт охоплює свої піддомени. Кожен профіль має власні сайти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些网站上的标签页永远不会卸载，无论隐藏多久或内存不足时。一个网站涵盖其子域名。每个用户场景有各自的网站。"
          }
        }
      }
    },
