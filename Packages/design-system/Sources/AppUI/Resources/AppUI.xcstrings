    "settings.defaultDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, die du in anderen Apps wie Mail und Nachrichten öffnest, werden in deinem Standardbrowser geöffnet. Du kannst ihn auch in den Systemeinstellungen › Schreibtisch & Dock ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links you open in other apps, such as Mail and Messages, open in your default browser. You can also change it in System Settings › Desktop & Dock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que abres en otras apps, como Mail y Mensajes, se abren en tu navegador por omisión. También puedes cambiarlo en Ajustes del Sistema › Escritorio y Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens que vous ouvrez dans d’autres apps, comme Mail et Messages, s’ouvrent dans votre navigateur par défaut. Vous pouvez aussi le modifier dans Réglages Système › Bureau et Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールやメッセージなどほかのAppで開いたリンクは、デフォルトのWebブラウザで開きます。「システム設定」＞「デスクトップとDock」でも変更できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącza otwierane w innych aplikacjach, takich jak Mail i Wiadomości, otwierają się w Twojej domyślnej przeglądarce. Możesz ją też zmienić w Ustawieniach systemowych › Biurko i Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки, которые Вы открываете в других приложениях, например в Почте и Сообщениях, открываются в браузере по умолчанию. Его также можно изменить в «Системные настройки › Рабочий стол и Dock»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання, які ви відкриваєте в інших програмах, наприклад у Пошті й Повідомленнях, відкриваються в основному браузері. Його також можна змінити в розділі «Системні параметри › Робочий стіл і Dock»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在其他 App（如“邮件”和“信息”）中打开的链接，会在默认网页浏览器中打开。你也可以在“系统设置”>“桌面与程序坞”中更改。"
          }
        }
      }
    },
