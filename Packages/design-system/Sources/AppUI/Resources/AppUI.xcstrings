    "automation.configurationNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere diese Konfiguration in deinen vertrauenswürdigen Client. Sie enthält eine Zugangsberechtigung, die nur jetzt angezeigt wird. Bewahre sie privat auf. Starte den Client nach Änderungen an Berechtigungen neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy this configuration into your trusted client. It contains a credential shown only now. Store it privately. Restart the client after permission changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia esta configuración en tu cliente de confianza. Contiene una credencial que solo se muestra ahora. Guárdala en privado. Reinicia el cliente después de cambiar los permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez cette configuration dans votre client de confiance. Elle contient un identifiant affiché uniquement maintenant. Conservez-la de façon privée. Relancez le client après toute modification des autorisations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この構成を信頼できるクライアントにコピーしてください。ここでのみ表示される認証情報が含まれています。非公開で保管してください。権限を変更したあとは、クライアントを再起動してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj tę konfigurację do zaufanego klienta. Zawiera poświadczenie wyświetlone tylko teraz. Przechowuj ją prywatnie. Po zmianie uprawnień uruchom klienta ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте эту конфигурацию в доверенный клиент. В ней есть учетные данные, которые показываются только сейчас. Храните их в тайне. Перезапустите клиент после изменения разрешений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіюйте цю конфігурацію у свій надійний клієнт. Вона містить облікові дані, які показано лише зараз. Зберігайте їх у безпечному місці. Після зміни дозволів перезапустіть клієнт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将此配置拷贝到你信任的客户端中。其中包含仅此刻显示的凭据。请妥善私密保存。更改权限后请重新启动客户端。"
          }
        }
      }
    },
