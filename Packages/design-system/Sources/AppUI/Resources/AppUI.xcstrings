    "automation.historyNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht besuchte Seiten von Freigaben für das gesamte Profil. URLs lassen Query und Fragment weg; Titel können dennoch privat sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches visited pages of whole-profile grants. URLs drop query and fragment; titles can still be private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en las páginas visitadas de los permisos de perfil completo. Las URL omiten la consulta y el fragmento; los títulos aún pueden ser privados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche les pages visitées des autorisations sur le profil entier. Les URL perdent leur requête et leur fragment ; les titres peuvent rester privés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル全体の許可があるものについて、表示したページを検索します。URLからはクエリとフラグメントが除かれますが、タイトルは非公開の情報を含む場合があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukuje odwiedzone strony ze zgód na cały profil. Adresy URL są pozbawiane zapytania i fragmentu; tytuły nadal mogą być prywatne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет по посещенным страницам при разрешении на весь профиль. В URL убираются запрос и фрагмент; заголовки все же могут быть личными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукає серед відвіданих сторінок профілів із повним доступом. У URL-адресах немає запиту та фрагмента; заголовки все ж можуть бути приватними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索整个用户场景授权下访问过的网页。URL 会去掉查询和片段；标题仍可能涉及隐私。"
          }
        }
      }
    },
    "automation.downloads": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
