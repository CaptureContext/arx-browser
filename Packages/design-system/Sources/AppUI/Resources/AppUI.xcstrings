    "links.noRules": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Regeln. Füge einen Anbieter hinzu, dem du vertraust. Die Unterstützung von Vorschauen hängt von diesem Anbieter und der empfangenden App ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules yet. Add a provider you trust. Preview support depends on that provider and the receiving app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay reglas. Añade un proveedor de confianza. La vista previa depende de ese proveedor y de la app que la recibe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune règle pour l’instant. Ajoutez un fournisseur de confiance. La prise en charge de l’aperçu dépend de ce fournisseur et de l’app qui reçoit le lien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールはまだありません。信頼できるプロバイダを追加してください。プレビューのサポートは、そのプロバイダと受信側のAppによって異なります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak reguł. Dodaj dostawcę, któremu ufasz. Obsługa podglądu zależy od tego dostawcy i aplikacji odbierającej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил пока нет. Добавьте поставщика, которому Вы доверяете. Поддержка предпросмотра зависит от этого поставщика и принимающего приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил ще немає. Додайте надійного провайдера. Підтримка попереднього перегляду залежить від цього провайдера та програми-одержувача."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有规则。请添加你信任的提供方。预览支持情况取决于该提供方和接收的 App。"
          }
        }
      }
    },
