    "automation.clickWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Klick kann ein Formular senden oder Website-Daten ändern. Arx kann Auswirkungen auf Websites nicht widerrufen. Die Bezeichnung der Seite ist nicht vertrauenswürdig und belegt keine Sicherheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This click may submit a form or change website data. Arx cannot undo website effects. The page label is untrusted and does not establish safety."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este clic puede enviar un formulario o cambiar datos del sitio web. Arx no puede deshacer los efectos en los sitios web. La etiqueta de la página no es de confianza y no garantiza su seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce clic peut envoyer un formulaire ou modifier des données du site web. Arx ne peut pas annuler les effets sur le site web. Le libellé de la page n’est pas fiable et ne garantit pas la sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このクリックにより、フォームが送信されたり、ウェブサイトのデータが変更されたりする場合があります。Arxはウェブサイトへの影響を取り消せません。ページのラベルは信頼できず、安全性を保証するものではありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To kliknięcie może wysłać formularz lub zmienić dane witryny. Arx nie może cofnąć skutków po stronie witryn. Etykieta strony jest niezaufana i nie świadczy o bezpieczeństwie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нажатие может отправить форму или изменить данные сайта. Arx не может отменить действия на сайте. Подпись на странице ненадежна и не гарантирует безопасность."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це клацання може надіслати форму або змінити дані вебсайту. Arx не може відмінити наслідки на вебсайті. Мітка сторінки не є надійною і не гарантує безпеки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此点按可能会提交表单或更改网站数据。Arx 无法撤销网站上的影响。网页标签不可信，不能据此判断是否安全。"
          }
        }
      }
    },
