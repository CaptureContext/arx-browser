    "batterySaver.on": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Energiesparmodus ist aktiv. Tabs im Hintergrund werden verlangsamt, um Strom zu sparen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery Saver is on. Background tabs slow down to save power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro de energía está activado. Las pestañas en segundo plano se ralentizan para ahorrar energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’énergie est activé. Les onglets en arrière-plan ralentissent pour économiser l’énergie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "省エネモードがオンです。バックグラウンドのタブは、電力を節約するため動作が遅くなります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszczędzanie energii jest włączone. Karty w tle działają wolniej, aby oszczędzać energię."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим энергосбережения включен. Фоновые вкладки замедляются для экономии заряда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим енергозбереження увімкнено. Фонові вкладки сповільнюються, щоб заощадити заряд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节能模式已打开。后台标签页会减速以节省电量。"
          }
        }
      }
    },
