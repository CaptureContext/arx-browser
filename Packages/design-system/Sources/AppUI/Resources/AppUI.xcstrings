    "migration.credentials.directSummary": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt aus %@, nach dem Import. macOS fragt zuerst nach, und du wählst für jedes Profil aus, was übertragen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight from %@, after the import. macOS asks first, and you choose what moves for each profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directamente desde %@, después de la importación. macOS pregunta antes y tú seleccionas qué se traslada de cada perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Directement depuis %@, après l’importation. macOS demande d’abord votre accord, et vous choisissez ce qui est transféré pour chaque profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みのあと、%@から直接移行します。最初にmacOSが確認し、プロファイルごとに移行する内容を選択します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośrednio z %@, po imporcie. Najpierw pyta macOS, a Ty wybierasz, co zostanie przeniesione dla każdego profilu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напрямую из %@ после импорта. Сначала macOS запросит разрешение, а Вы выберете, что переносить для каждого профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напряму з %@, після імпорту. Спершу macOS запитає, а ви виберете, що переносити для кожного профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入之后，直接从 %@ 导入。macOS 会先询问你，你可以为每个用户场景选择要移动的内容。"
          }
        }
      }
    },
