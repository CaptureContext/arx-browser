    "settings.contentBlockingExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das in Arx integrierte uBlock Origin in jedem Profil und in privaten Fenstern. Die Filterlisten werden direkt von denen aktualisiert, die sie veröffentlichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses uBlock Origin, built into Arx, in every profile and in private windows. Its filter lists update straight from the people who publish them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa uBlock Origin, integrado en Arx, en todos los perfiles y en las ventanas privadas. Sus listas de filtros se actualizan directamente desde quienes las publican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise uBlock Origin, intégré à Arx, dans tous les profils et dans les fenêtres privées. Ses listes de filtres sont mises à jour directement auprès de leurs éditeurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxに内蔵されたuBlock Originを、すべてのプロファイルとプライベートウインドウで使用します。フィルタリストは、公開している作成者から直接アップデートされます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa uBlock Origin, wbudowanego w Arx, w każdym profilu i w oknach prywatnych. Jego listy filtrów są aktualizowane bezpośrednio przez osoby, które je publikują."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует uBlock Origin, встроенный в Arx, во всех профилях и в частных окнах. Его списки фильтров обновляются напрямую от тех, кто их публикует."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує вбудований в Arx uBlock Origin в усіх профілях і в приватних вікнах. Його списки фільтрів оновлюються безпосередньо від тих, хто їх публікує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用内置于 Arx 的 uBlock Origin，适用于每个用户场景和无痕浏览窗口。其过滤列表直接从发布者处更新。"
          }
        }
      }
    },
    "settings.blockCookieBanners": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie-Banner blockieren"
          }
        },
        "en": {
