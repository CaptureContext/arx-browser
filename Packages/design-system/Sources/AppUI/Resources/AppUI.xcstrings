        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的機能は、Arxの今後のバージョンで変更または廃止される可能性があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperymenty mogą się zmienić lub zniknąć w późniejszej wersji Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эксперименты могут измениться или исчезнуть в одной из следующих версий Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
