    "developer.localExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx vertraut selbstsignierten Zertifikaten nicht: Verwende http auf localhost oder füge dein Entwicklungszertifikat in der Schlüsselbundverwaltung hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx doesn’t trust self-signed certificates: use http on localhost, or add your development certificate to Keychain Access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx no confía en los certificados autofirmados: usa http en localhost o añade tu certificado de desarrollo a Acceso a Llaveros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx ne fait pas confiance aux certificats autosignés : utilisez http sur localhost, ou ajoutez votre certificat de développement à Trousseaux d’accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは自己署名証明書を信頼しません。localhostではhttpを使うか、開発用の証明書をキーチェーンアクセスに追加してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie ufa certyfikatom z podpisem własnym: używaj http na localhost albo dodaj swój certyfikat deweloperski do Dostępu do pęku kluczy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не доверяет самоподписанным сертификатам: используйте http на localhost или добавьте свой сертификат разработки в приложение «Связка ключей»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не довіряє самопідписаним сертифікатам: використовуйте http на localhost або додайте свій сертифікат розробки до Ключаря."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 不信任自签名证书：请在 localhost 上使用 http，或将你的开发证书添加到“钥匙串访问”。"
          }
        }
      }
    },
