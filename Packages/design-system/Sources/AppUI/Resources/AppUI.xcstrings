    "siteMenu.clearCacheMessage": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt zwischengespeicherte Bilder und Dateien von %1$@ und seinen Subdomains in %2$@. Seiten dort laden beim nächsten Mal möglicherweise langsamer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes cached images and files from %1$@ and its subdomains in %2$@. Pages there may load more slowly the next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las imágenes y los archivos en caché de %1$@ y sus subdominios en %2$@. Las páginas pueden cargarse más despacio la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les images et fichiers en cache de %1$@ et de ses sous-domaines dans %2$@. Les pages concernées peuvent se charger plus lentement la prochaine fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@にある%1$@とそのサブドメインの、キャッシュされたイメージとファイルを削除します。次回、それらのページの読み込みが遅くなる場合があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa obrazy i pliki z pamięci podręcznej witryny %1$@ i jej subdomen w profilu %2$@. Strony tam mogą następnym razem ładować się wolniej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет кэшированные изображения и файлы сайта %1$@ и его поддоменов в профиле «%2$@». В следующий раз страницы там могут загружаться медленнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучає кешовані зображення й файли з %1$@ та його піддоменів у «%2$@». Наступного разу сторінки там можуть завантажуватися повільніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将移除%2$@中%1$@及其子域名的缓存图像和文件。这些页面下次可能加载得更慢。"
          }
        }
      }
    },
