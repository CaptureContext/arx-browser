    "links.proxyDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, welche URLs über einen anderen Host geteilt werden. Wenn zwei Regeln auf einen Link zutreffen, gilt die höhere; bewege eine Regel, um ihre Position zu ändern. Beim Kopieren wird nie ein Anbieter geöffnet und die Seite nie geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which URLs to share through another host. When two rules match a link, the higher one wins; drag a rule to change its place. Copying never opens a provider or changes the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona qué URL se comparten a través de otro host. Si dos reglas coinciden con un enlace, gana la de arriba; arrastra una regla para cambiar su posición. Copiar nunca abre un proveedor ni cambia la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les URL à partager via un autre hôte. Lorsque deux règles correspondent à un lien, la plus haute l’emporte ; faites glisser une règle pour changer sa position. La copie n’ouvre jamais de fournisseur et ne modifie pas la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のホスト経由で共有するURLを選択します。2つのルールがリンクに一致する場合は、上にあるルールが優先されます。ルールをドラッグして順序を変更できます。コピーしても、プロバイダが開いたり、ページが変更されたりすることはありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, które adresy URL udostępniać przez inny host. Gdy do łącza pasują dwie reguły, wygrywa wyższa; przeciągnij regułę, aby zmienić jej miejsce. Kopiowanie nigdy nie otwiera dostawcy ani nie zmienia strony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие URL передавать через другой хост. Если ссылке подходят два правила, действует то, что выше; чтобы изменить место правила, перетащите его. Копирование никогда не открывает поставщика и не меняет страницу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, які URL-адреси поширювати через інший хост. Якщо посиланню відповідають два правила, переважає вище; перетягніть правило, щоб змінити його місце. Копіювання ніколи не відкриває провайдера й не змінює сторінку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取哪些 URL 通过其他主机共享。当两条规则都匹配某个链接时，排在上方的规则优先；拖移规则可更改其位置。拷贝时不会打开提供方，也不会更改页面。"
          }
        }
      }
    },
    "links.proxySummary": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere Links über einen anderen Host deiner Wahl. Beim Kopieren wird er nie geöffnet und die Seite nie geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy links through another host you choose. Copying never opens it or changes the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia enlaces a través de otro host que elijas. Copiar nunca lo abre ni cambia la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez des liens via un autre hôte de votre choix. La copie ne l’ouvre jamais et ne modifie pas la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した別のホスト経由でリンクをコピーします。コピーしても、そのホストが開いたり、ページが変更されたりすることはありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
