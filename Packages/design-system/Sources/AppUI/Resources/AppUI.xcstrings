            "value": "Les fenêtres privées ne remplissent jamais les adresses ni les cartes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートウインドウでは、住所やカードは入力されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okna prywatne nigdy nie wypełniają adresów ani kart."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В частных окнах адреса и карты никогда не заполняются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватні вікна ніколи не заповнюють адреси чи картки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无痕浏览窗口绝不会填充地址或付款卡。"
          }
        }
      }
    },
