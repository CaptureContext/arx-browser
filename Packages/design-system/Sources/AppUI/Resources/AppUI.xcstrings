    "media.volumeHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke, um die Lautstärke einzustellen. Klicke bei gedrückter Wahltaste, um die Stummschaltung ein- oder auszuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to set the volume. Option-click to mute or unmute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para ajustar el volumen. Haz clic con la tecla Opción pulsada para silenciar o activar el sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour régler le volume. Cliquez en maintenant Option pour couper ou réactiver le son."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックして音量を設定します。Optionキーを押しながらクリックすると、消音または消音解除します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, aby ustawić głośność. Kliknij z naciśniętym klawiszem Option, aby wyciszyć lub wyłączyć wyciszenie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы задать громкость. Нажмите с зажатой клавишей Option, чтобы выключить или включить звук."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть, щоб встановити гучність. Клацніть із Option, щоб вимкнути або увімкнути звук."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以设定音量。按住 Option 键点按可静音或取消静音。"
          }
        }
      }
    },
