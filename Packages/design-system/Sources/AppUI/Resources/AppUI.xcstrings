    "archive.workspaceChanged": {
      "comment": "Tab Archive: a restore was refused because the sidebar changed meanwhile.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tabs, Ordner oder Räume haben sich beim Wiederherstellen geändert. Dein Archiv ist unverändert; versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tabs, folders or spaces changed while restoring. Your archive is unchanged; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus pestañas, carpetas o secciones han cambiado durante la restauración. Tu archivo no ha cambiado; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos onglets, dossiers ou sections ont changé pendant la restauration. Votre archive n’a pas été modifiée ; réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元中にタブ、フォルダ、スペースが変更されました。アーカイブは変更されていません。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje karty, foldery lub strefy zmieniły się podczas przywracania. Archiwum pozostało bez zmian; spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки, папки или разделы изменились при восстановлении. Архив не изменен; повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші вкладки, папки або розділи змінилися під час відновлення. Ваш архів не змінився; спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的标签页、文件夹或分区在恢复时发生了变化。你的归档没有改变；请重试。"
          }
        }
      }
    },
