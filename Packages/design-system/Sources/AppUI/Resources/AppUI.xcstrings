    "settings.tabUnloadPressureGraceExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Arbeitsspeicher deines Macs kritisch knapp wird, werden Tabs im Hintergrund nach dieser Zeit entladen. Ein Tab, den du verlässt und sofort wieder öffnest, bleibt geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your Mac runs critically low on memory, hidden tabs unload after this long. A tab you leave and come straight back to stays loaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando a tu Mac le queda muy poca memoria, las pestañas ocultas se descargan pasado este tiempo. Una pestaña que dejas y a la que vuelves enseguida se mantiene cargada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la mémoire de votre Mac devient très faible, les onglets masqués sont déchargés après ce délai. Un onglet que vous quittez et auquel vous revenez aussitôt reste chargé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのメモリが極端に少なくなると、非表示のタブはこれだけの時間が経過した後に解放されます。離れてすぐに戻ったタブは、読み込まれたままになります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy w Macu krytycznie brakuje pamięci, ukryte karty są zwalniane po tym czasie. Karta, którą opuścisz i od razu do niej wrócisz, pozostaje załadowana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда на Вашем Mac критически не хватает памяти, скрытые вкладки выгружаются через это время. Вкладка, которую Вы покидаете и сразу возвращаетесь, остается загруженной."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли на вашому Mac критично бракує памʼяті, приховані вкладки вивантажуються через цей час. Вкладка, яку ви залишили й одразу повернулися, залишається завантаженою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Mac 的内存严重不足时，隐藏的标签页会在这段时间后卸载。你离开后又立即返回的标签页会保持已加载。"
          }
        }
      }
    },
