    "automation.screenshotsNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos enthalten sichtbaren Seiteninhalt und eingebettete Frames. Sie können private Informationen enthalten. Privates Surfen ist ausgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots include visible page content and embedded frames. They may contain private information. Private browsing is excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas incluyen el contenido visible de la página y los marcos incrustados. Pueden contener información privada. Se excluye la navegación privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran incluent le contenu visible de la page et les cadres intégrés. Elles peuvent contenir des informations privées. La navigation privée est exclue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットには、表示中のページの内容と埋め込みフレームが含まれます。非公開の情報が含まれている場合があります。プライベートブラウズは対象外です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzuty ekranu obejmują widoczną zawartość strony i osadzone ramki. Mogą zawierać prywatne informacje. Przeglądanie prywatne jest wyłączone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимки включают видимое содержимое страницы и встроенные фреймы. В них может быть личная информация. Частный доступ исключен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімки містять видимий вміст сторінки й вбудовані фрейми. Вони можуть містити приватну інформацію. Приватний перегляд виключено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截屏包含网页的可见内容和嵌入的框架，可能包含私人信息。无痕浏览除外。"
          }
        }
      }
    },
