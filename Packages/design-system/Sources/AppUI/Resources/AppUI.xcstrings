    "migration.spaces.footer": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Raum behält seine Farben aus %@, so nah, wie die Farben von Arx herankommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each space keeps its colors from %@, as near as Arx's colors come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sección conserva sus colores de %@, en la medida en que lo permiten los colores de Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque section conserve ses couleurs de %@, au plus près des couleurs d’Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各スペースは、Arxのカラーで可能な限り近い形で、%@のカラーを維持します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda strefa zachowuje kolory z %@, na tyle wiernie, na ile pozwalają kolory Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раздел сохраняет свои цвета из %@ с точностью до ближайших цветов Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен розділ зберігає свої кольори з %@ — наскільки близько це дозволяють кольори Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个分区会保留其来自 %@ 的颜色，与 Arx 的颜色尽量接近。"
          }
        }
      }
    },
    "migration.mapping.footer": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Profil von %@ wird zu einem neuen Arx-Profil mit dem Namen, den du vergibst, oder wird einem vorhandenen Profil hinzugefügt. Seine Räume kommen als neue Räume mit, und seine Passwörter und Anmeldungen folgen ihm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each %@ profile becomes a new Arx profile with the name you give it, or joins one you already have. Its spaces come along as new spaces, and its passwords and sign-ins follow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil de %@ se convierte en un perfil de Arx nuevo con el nombre que le des, o se une a uno que ya tengas. Sus secciones se incorporan como secciones nuevas y sus contraseñas e inicios de sesión lo acompañan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil %@ devient un nouveau profil Arx portant le nom que vous lui donnez, ou rejoint un profil existant. Ses sections arrivent comme de nouvelles sections, et ses mots de passe et ses connexions le suivent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の各プロファイルは、指定した名前の新しいArxのプロファイルになるか、すでにあるプロファイルに統合されます。そのスペースは新しいスペースとして取り込まれ、パスワードとサインインもそれに従います。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy profil %@ staje się nowym profilem Arx o nadanej przez Ciebie nazwie lub dołącza do już istniejącego. Jego strefy są dodawane jako nowe strefy, a jego hasła i logowania podążają za nim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый профиль %@ становится новым профилем Arx с заданным Вами названием или присоединяется к уже существующему. Его разделы переносятся как новые разделы, а пароли и данные для входа следуют за ним."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен профіль %@ стає новим профілем Arx із назвою, яку ви задасте, або приєднується до наявного. Його розділи переносяться як нові розділи, а паролі та входи йдуть за ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的每个用户场景都会成为一个新的 Arx 用户场景（使用你为其指定的名称），或并入你已有的用户场景。它的分区会作为新分区一并导入，它的密码和登录状态也会随之导入。"
          }
        }
      }
    },
