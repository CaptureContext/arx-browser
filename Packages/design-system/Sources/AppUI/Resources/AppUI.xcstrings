    "automation.filesNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwortet Dateiauswahldialoge, die eine Seite öffnet, mit Dateien von deinem Mac. Jeder Upload fragt dich weiterhin und zeigt jede Datei an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer file choosers a page opens with files from your Mac. Every upload still asks you, showing each file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a los selectores de archivos que abre una página con archivos de tu Mac. Cada subida sigue preguntándote y muestra cada archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répond aux sélecteurs de fichiers ouverts par une page avec des fichiers de votre Mac. Chaque import vous demande toujours confirmation, en affichant chaque fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページが開くファイル選択に、Macのファイルで応答します。アップロードのたびに、各ファイルを表示して確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiada na okna wyboru plików otwierane przez stronę plikami z Twojego Maca. Każde wysłanie nadal wymaga Twojej zgody, z pokazaniem każdego pliku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечает на окна выбора файлов, которые открывает страница, файлами с Вашего Mac. Каждая загрузка по-прежнему запрашивает у Вас подтверждение и показывает каждый файл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідати на вибір файлів, який відкриває сторінка, файлами з вашого Mac. Кожне передавання все одно питає вас, показуючи кожен файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你 Mac 上的文件回应网页打开的文件选择器。每次上传仍会询问你，并显示每个文件。"
          }
        }
      }
    },
