    "capture.overlayHint": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege den Zeiger oder verwende die Pfeiltasten, um einen Block auszuwählen, und klicke dann oder drücke den Zeilenschalter. Ziehe, um einen Bereich aufzuziehen. Drücke Esc, um abzubrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the pointer or use the arrow keys to pick a block, then click or press Return. Drag to draw an area. Press Escape to cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el puntero o usa las teclas de flecha para elegir un bloque y haz clic o pulsa Retorno. Arrastra para dibujar un área. Pulsa Esc para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez le pointeur ou utilisez les touches fléchées pour choisir un bloc, puis cliquez ou appuyez sur Retour. Faites glisser pour dessiner une zone. Appuyez sur Échap pour annuler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを動かすか矢印キーでブロックを選び、クリックするかReturnキーを押します。ドラッグして領域を描きます。キャンセルするにはEscキーを押します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń wskaźnik lub użyj klawiszy strzałek, aby wybrać blok, a następnie kliknij lub naciśnij Return. Przeciągnij, aby narysować obszar. Naciśnij Esc, aby anulować."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель или используйте клавиши со стрелками, чтобы выбрать блок, затем щелкните мышью или нажмите Return. Протяните, чтобы выделить область. Нажмите Escape для отмены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересувайте вказівник або скористайтеся клавішами зі стрілками, щоб вибрати блок, потім клацніть або натисніть Return. Перетягніть, щоб намалювати область. Натисніть Esc, щоб скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动指针或使用箭头键选取区块，然后点按或按下 Return 键。拖移可绘制区域。按下 Esc 键可取消。"
          }
        }
      }
    },
