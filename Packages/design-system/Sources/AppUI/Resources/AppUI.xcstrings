    "hideElement.toast.empty": {
      "comment": "Hide Element's toast, at the bottom right of the page while Hide Element (⇧⌘H) is on: its list when no element is hidden on this site.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Website ist noch nichts ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is hidden on this site yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada oculto en este sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément n’est encore masqué sur ce site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトで非表示にしている要素はまだありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tej witrynie nic jeszcze nie jest ukryte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом сайте пока ничего не скрыто."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому сайті ще нічого не сховано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网站上尚未隐藏任何内容。"
          }
        }
      }
    },
    "hideElement.toast.listKeys": {
      "comment": "Hide Element's toast, at the bottom right of the page while Hide Element (⇧⌘H) is on: a hint under its list. ↑ and ↓ move through the list; Delete (⌫) shows the chosen element again.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ zum Auswählen, ⌫ zum Einblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ to choose, ⌫ to show again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ para seleccionar, ⌫ para volver a mostrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ pour choisir, ⌫ pour afficher de nouveau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓で選択、⌫で再表示"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ — wybierz, ⌫ — pokaż ponownie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ — выбор, ⌫ — показать снова"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ — вибір, ⌫ — показати знову"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ↑ ↓ 选取，按 ⌫ 再次显示"
          }
        }
      }
    },
    "hideElement.toast.reloadNote": {
      "comment": "Hide Element's toast, at the bottom right of the page while Hide Element (⇧⌘H) is on: under its list after an element hidden before this time was shown again. It only comes back once the page loads again, which Done does.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite wird nach „Fertig“ neu geladen, um wieder einzublenden, was du angezeigt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page reloads when you’re done, to bring back what you showed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página se recarga al terminar para recuperar lo que has vuelto a mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page se recharge lorsque vous avez terminé, pour rétablir ce que vous avez affiché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了すると、再表示した要素を戻すためにページが再読み込みされます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy skończysz, strona zostanie wczytana ponownie, aby przywrócić pokazane elementy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы закончите, страница перезагрузится, чтобы вернуть показанные элементы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після завершення сторінку буде перезавантажено, щоб повернути показане."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成后页面会重新加载，以恢复你已再次显示的内容。"
          }
        }
      }
    },
    "hideElement.toast.refused": {
      "comment": "Hide Element's toast, at the bottom right of the page while Hide Element (⇧⌘H) is on: the second line after a click hid an element but Arx couldn't save it, such as on a site with content blocking off.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht dauerhaft ausgeblendet werden. Beim Neuladen der Seite erscheint es wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t keep that hidden. It comes back when the page reloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido mantener oculto. Volverá a aparecer al recargar la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de le garder masqué. Il réapparaît au rechargement de la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示を保持できませんでした。ページを再読み込みすると元に戻ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować ukrycia. Element wróci po ponownym wczytaniu strony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить скрытие. Элемент вернётся после перезагрузки страницы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти приховування. Елемент повернеться після перезавантаження сторінки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保持隐藏状态。页面重新加载后会再次显示。"
          }
        }
      }
    },
