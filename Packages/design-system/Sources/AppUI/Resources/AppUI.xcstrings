    "automation.batchWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Freigabe gilt genau für diese Schritte in dieser Reihenfolge. Arx prüft jeden Schritt weiterhin bei der Ausführung und stoppt beim ersten, der fehlschlägt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One approval covers exactly these steps, in this order. Arx still checks each step when it runs, and stops at the first one that fails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una aprobación cubre exactamente estos pasos, en este orden. Arx sigue comprobando cada paso al ejecutarlo y se detiene en el primero que falla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule approbation couvre exactement ces étapes, dans cet ordre. Arx vérifie quand même chaque étape à son exécution et s’arrête à la première qui échoue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の承認で、これらのステップのみがこの順番で許可されます。Arxは実行時に各ステップを確認し、失敗した最初のステップで停止します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno zatwierdzenie obejmuje dokładnie te kroki, w tej kolejności. Arx nadal sprawdza każdy krok przy jego wykonaniu i zatrzymuje się na pierwszym, który się nie powiedzie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно подтверждение распространяется ровно на эти шаги в этом порядке. Arx по-прежнему проверяет каждый шаг при выполнении и останавливается на первом неудачном."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один дозвіл охоплює саме ці кроки в цьому порядку. Arx усе одно перевіряє кожен крок під час виконання й зупиняється на першому, що не вдався."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次批准仅涵盖这些步骤，并按此顺序执行。Arx 仍会在运行每个步骤时进行检查，并在第一个失败的步骤处停止。"
          }
        }
      }
    },
