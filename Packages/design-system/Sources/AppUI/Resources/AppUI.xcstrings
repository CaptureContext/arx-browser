    "migration.credentials.csvSteps": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere deine Passwörter aus %@ als CSV-Datei und wähle sie dann hier aus. Anmeldungen werden auf diesem Weg nicht übertragen. Lege die Datei anschließend in den Papierkorb: Sie enthält deine Passwörter unverschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your passwords from %@ as a CSV file, then choose it here. Sign-ins don't move this way. Afterwards, move the file to the Bin: it holds your passwords unencrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta tus contraseñas de %@ como archivo CSV y selecciónalo aquí. Los inicios de sesión no se trasladan de este modo. Después, mueve el archivo a la Papelera: contiene tus contraseñas sin cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez vos mots de passe depuis %@ sous forme de fichier CSV, puis choisissez-le ici. Les connexions ne sont pas transférées de cette façon. Ensuite, placez le fichier dans la corbeille : il contient vos mots de passe non chiffrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@からパスワードをCSVファイルとして書き出し、ここで選択してください。この方法では、サインインは移行されません。完了したら、ファイルをゴミ箱に入れてください。ファイルにはパスワードが暗号化されずに含まれています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyeksportuj hasła z %@ jako plik CSV, a następnie wybierz go tutaj. Logowania nie są w ten sposób przenoszone. Potem przenieś plik do kosza: zawiera Twoje hasła w postaci niezaszyfrowanej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте пароли из %@ в файл CSV и выберите его здесь. Данные для входа этим способом не переносятся. После этого переместите файл в Корзину: в нем пароли хранятся в незашифрованном виде."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортуйте свої паролі з %@ як файл CSV, а потім виберіть його тут. Входи таким способом не переносяться. Потім перемістіть файл у Смітник: у ньому ваші паролі без шифрування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的密码从 %@ 导出为 CSV 文件，然后在这里选取它。登录状态无法通过这种方式移动。之后，请将该文件移到废纸篓：它以未加密的形式保存着你的密码。"
          }
        }
      }
    },
