    "appLinks.invalidDefinition": {
      "comment": "App Links (Settings › Links › Air Traffic Control › App Links): a handler is a rule for links that a page hands to another app, such as claude://: which links it catches (by scheme, host and path) and what happens to them, open an app or run the person's script.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Profil kann nur eine Verarbeitung haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each profile can have only one handling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil solo puede tener una gestión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil ne peut avoir qu’un seul traitement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルごとに設定できる扱いは1つだけです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy profil może mieć tylko jedną obsługę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого профиля может быть только один способ обработки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен профіль може мати лише один спосіб обробки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个用户场景只能有一种处理方式。"
          }
        }
      }
    },
    "appLinks.empty": {
      "comment": "App Links (Settings › Links › Air Traffic Control › App Links): a handler is a rule for links that a page hands to another app, such as claude://: which links it catches (by scheme, host and path) and what happens to them, open an app or run the person's script.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Handler. Bei Links für andere Apps fragt der Dialog von Chrome nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No handlers. Links for other apps ask with Chrome's dialog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay gestores. Los enlaces para otras apps preguntan con el diálogo de Chrome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun gestionnaire. Les liens destinés à d’autres apps demandent confirmation avec la fenêtre de Chrome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドラはありません。ほかのApp用のリンクは、Chromeのダイアログで確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak obsług. O łącza dla innych aplikacji pyta okno dialogowe Chrome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет обработчиков. Для ссылок других приложений будет показан запрос Chrome."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає обробників. Для посилань на інші програми показується діалог Chrome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
