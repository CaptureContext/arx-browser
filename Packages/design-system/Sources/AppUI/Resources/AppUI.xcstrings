    "settings.notificationsOpenClosedSitesExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du auf eine Mitteilung einer Website klickst, deren Tab du geschlossen hast, wird die Website erneut geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a notification from a site whose tab you closed opens the site again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al hacer clic en una notificación de un sitio cuya pestaña cerraste, el sitio se vuelve a abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur une notification d’un site dont vous avez fermé l’onglet rouvre ce site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを閉じたサイトの通知をクリックすると、そのサイトがもう一度開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknięcie powiadomienia z witryny, której kartę zamknięto, otwiera tę witrynę ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие на уведомление от сайта, вкладку которого Вы закрыли, снова открывает этот сайт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацання сповіщення від сайту, вкладку якого ви закрили, знову відкриває цей сайт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按来自你已关闭其标签页的网站的通知，会再次打开该网站。"
          }
        }
      }
    },
