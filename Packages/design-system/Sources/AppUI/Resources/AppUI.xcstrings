    "sendFeedback.privateNotice": {
      "comment": "Send Feedback card, under the title: who reads the report.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Bericht geht an den Betreuer von Arx. Teile davon können veröffentlicht werden, wie in der Datenschutzerklärung beschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your report goes to Arx's maintainer. Parts of it may be published, as the privacy policy describes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu informe llega al responsable de Arx. Partes de él pueden publicarse, como describe la política de privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rapport est transmis au mainteneur d’Arx. Certaines parties peuvent être publiées, comme l’explique la politique de confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートはArxのメンテナに送信されます。内容の一部は、プライバシーポリシーに記載のとおり公開されることがあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszenie trafia do opiekuna Arx. Jego części mogą zostać opublikowane, jak opisano w polityce prywatności."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш отчет передается разработчику Arx. Его части могут быть опубликованы, как описано в политике конфиденциальности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш звіт потрапляє до розробника Arx. Його частини можуть бути опубліковані, як описано в політиці приватності."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的报告会发送给 Arx 的维护者。其中部分内容可能会公开，详见隐私政策。"
          }
        }
      }
    },
    "sendFeedback.promptBug": {
