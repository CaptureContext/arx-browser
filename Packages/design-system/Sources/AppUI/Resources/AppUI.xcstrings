    "settings.translationProviderAppleExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten werden auf diesem Mac mit Apples Übersetzung übersetzt; ihr Text verlässt den Mac nicht. Eine Sprache wird beim ersten Bedarf geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages are translated on this Mac with Apple's Translation; their text doesn't leave the Mac. A language is downloaded the first time it's needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas se traducen en este Mac con la Traducción de Apple; su texto no sale del Mac. Un idioma se descarga la primera vez que se necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages sont traduites sur ce Mac avec la Traduction d’Apple ; leur texte ne quitte pas le Mac. Une langue est téléchargée la première fois qu’elle est nécessaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページはAppleの翻訳を使ってこのMac上で翻訳され、テキストがMacの外に出ることはありません。言語は、最初に必要になったときにダウンロードされます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strony są tłumaczone na tym Macu za pomocą Tłumaczenia Apple; ich tekst nie opuszcza Maca. Język jest pobierany przy pierwszym użyciu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы переводятся на этом Mac с помощью приложения «Перевод» от Apple; их текст не покидает Mac. Язык загружается при первом использовании."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінки перекладаються на цьому Mac за допомогою функції «Переклад» від Apple; їхній текст не залишає Mac. Мова викачується під час першої потреби."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面会使用 Apple 的“翻译”在这台 Mac 上进行翻译；其文本不会离开这台 Mac。首次需要某种语言时会下载该语言。"
          }
        }
      }
    },
    "settings.translationProviderGoogleExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Übersetzer erhält den Text jeder Seite, die du übersetzt. Arx sendet ihn ohne Cookies über den Dienst, den auch das Übersetzungsskript von Google verwendet. Dieser ist keine offizielle API und kann jederzeit nicht mehr funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Translate receives the text of every page you translate. Arx sends it without cookies, through the service Google's own translate script uses, which isn't an official API and may stop working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Translate recibe el texto de cada página que traduces. Arx lo envía sin cookies, a través del servicio que usa el propio script de traducción de Google, que no es una API oficial y puede dejar de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Traduction reçoit le texte de chaque page que vous traduisez. Arx l’envoie sans cookies, par le service qu’utilise le script de traduction de Google, qui n’est pas une API officielle et peut cesser de fonctionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google翻訳は、翻訳するすべてのページのテキストを受け取ります。Arxは、Google自身の翻訳スクリプトが使用するサービスを通じて、Cookieなしで送信します。これは公式のAPIではないため、動作しなくなる可能性があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumacz Google otrzymuje tekst każdej tłumaczonej strony. Arx wysyła go bez plików cookie, przez usługę używaną przez skrypt tłumaczenia Google, która nie jest oficjalnym API i może przestać działać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Translate получает текст каждой переведенной страницы. Arx отправляет его без файлов cookie через службу, которую использует собственный скрипт перевода Google; она не является официальным API и может перестать работать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Translate отримує текст кожної сторінки, яку ви перекладаєте. Arx надсилає його без файлів cookie через службу, яку використовує власний скрипт перекладу Google; це не офіційний API, тож вона може перестати працювати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 翻译会接收你翻译的每个页面的文本。Arx 会在不带 Cookie 的情况下，通过 Google 自己的翻译脚本所使用的服务发送，该服务不是官方 API，可能会停止工作。"
          }
        }
      }
    },
