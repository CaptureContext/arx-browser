    "appLinks.footerOpenURL": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Skript kann den Link mit [open-url von fxClaude und fxCodex](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts) an ein Claude- oder Codex-Fenster übergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A script can hand the link to one Claude or Codex window with [fxClaude and fxCodex’s open-url](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un script puede pasar el enlace a una ventana de Claude o Codex con [open-url de fxClaude y fxCodex](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un script peut transmettre le lien à une fenêtre Claude ou Codex avec [open-url de fxClaude et fxCodex](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトからリンクを1つのClaudeまたはCodexウインドウに渡せます。[fxClaudeとfxCodexのopen-url](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts)を参照してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrypt może przekazać łącze jednemu oknu Claude lub Codex za pomocą [open-url z fxClaude i fxCodex](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипт может передать ссылку одному окну Claude или Codex с помощью [fxClaude и fxCodex’s open-url](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипт може передати посилання в одне вікно Claude або Codex за допомогою [fxClaude і fxCodex open-url](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本可以通过 [fxClaude 和 fxCodex 的 open-url](https://manual.arx.capturecontext.dev/profiles/air-traffic-control#scripts) 将链接交给某个 Claude 或 Codex 窗口。"
          }
        }
      }
