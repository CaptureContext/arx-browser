          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuj banery cookie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать баннеры о файлах cookie"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокувати банери cookie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止 Cookie 横幅"
          }
        }
      }
    },
    "settings.blockCookieBannersExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Cookie-Hinweise mit den Cookie-Listen von EasyList und uBlock Origin aus. Wenn eine Website nicht mehr funktioniert, deaktiviere das Blockieren von Inhalten für sie im Website-Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides cookie consent pop-ups with EasyList's and uBlock Origin's cookie lists. If a site stops working, turn content blocking off for it in the site menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las ventanas emergentes de consentimiento de cookies con las listas de cookies de EasyList y uBlock Origin. Si un sitio deja de funcionar, desactiva el bloqueo de contenido para él en el menú del sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les fenêtres de consentement aux cookies grâce aux listes de cookies d’EasyList et d’uBlock Origin. Si un site ne fonctionne plus, désactivez le blocage de contenu pour ce site dans le menu du site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EasyListとuBlock OriginのCookieリストを使って、Cookieの同意ポップアップを非表示にします。サイトが正常に動作しなくなった場合は、サイトメニューでそのサイトのコンテンツブロックをオフにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrywa wyskakujące okna ze zgodą na pliki cookie za pomocą list cookie EasyList i uBlock Origin. Jeśli witryna przestanie działać, wyłącz dla niej blokowanie treści w menu witryny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает окна согласия на использование файлов cookie с помощью списков EasyList и uBlock Origin. Если сайт перестал работать, выключите блокировку контента для него в меню сайта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ховає спливні вікна зі згодою на файли cookie за допомогою списків cookie з EasyList і uBlock Origin. Якщо сайт перестав працювати, вимкніть для нього блокування вмісту в меню сайту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 EasyList 和 uBlock Origin 的 Cookie 列表隐藏 Cookie 同意弹窗。如果某个网站无法正常工作，请在网站菜单中为其关闭内容拦截。"
          }
        }
      }
    },
