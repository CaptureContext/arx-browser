    "deviceChooser.adapterOff": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ist ausgeschaltet. Schalte es im Kontrollzentrum oder in den Systemeinstellungen ein und suche dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off. Turn it on in Control Center or System Settings, then scan again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bluetooth está desactivado. Actívalo en el Centro de Control o en Ajustes del Sistema y vuelve a buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bluetooth est désactivé. Activez-le dans le Centre de contrôle ou les Réglages Système, puis relancez la recherche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothがオフです。コントロールセンターまたはシステム設定でオンにしてから、もう一度スキャンしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth jest wyłączony. Włącz go w Centrum sterowania lub Ustawieniach systemowych, a potem wyszukaj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth выключен. Включите его в Пункте управления или в Системных настройках и повторите поиск."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth вимкнено. Увімкніть його в Центрі керування або Системних параметрах і повторіть пошук."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙已关闭。请在控制中心或“系统设置”中打开它，然后再次扫描。"
          }
        }
      }
    },
