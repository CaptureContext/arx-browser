            "state": "translated",
            "value": "通知からサイトを開く"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwieraj witrynę z jej powiadomienia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать сайт из уведомления"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривати сайт зі сповіщення"
          }
        },
