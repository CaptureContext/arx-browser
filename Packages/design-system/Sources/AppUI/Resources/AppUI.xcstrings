    },
    "settings.closeOnEmptyDeleteExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert auch im Adressfeld. In einer Website-Suche verlässt die erste Betätigung der Löschtaste die Suche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works in the address field too. In a site search, the first Delete leaves the search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También funciona en el campo de dirección. En una búsqueda en un sitio, el primer Suprimir sale de la búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne aussi dans le champ d’adresse. Dans une recherche sur un site, le premier appui sur Supprimer quitte la recherche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスフィールドでも使えます。サイト内検索では、最初にDeleteキーを押すと検索を終了します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa też w polu adresu. W wyszukiwaniu w witrynie pierwsze naciśnięcie Delete kończy wyszukiwanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает и в поле адреса. При поиске по сайту первое нажатие Delete выходит из поиска."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює й у полі адреси. У пошуку на сайті перше натискання Delete виходить із пошуку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在地址栏中同样适用。在网站搜索中，第一次按下 Delete 键会退出搜索。"
          }
        }
      }
    },
