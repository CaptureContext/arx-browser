    "sendFeedback.diagnosticsDetail": {
      "comment": "Send Feedback card: under Include diagnostics, what it adds and what it leaves out.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Absturz- und Hängerberichte sowie Modell und Arbeitsspeicher deines Macs. Keine Seiteninhalte, Adressen oder Verläufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent crash and hang reports, and your Mac's model and memory. No page content, addresses or history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informes recientes de cierres y bloqueos, y el modelo y la memoria de tu Mac. Sin contenido de páginas, direcciones ni historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapports récents de plantage et de blocage, ainsi que le modèle et la mémoire de votre Mac. Aucun contenu de page, adresse ni historique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のクラッシュレポートと応答なしレポート、Macのモデルとメモリ。ページの内容、アドレス、履歴は含まれません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie raporty o awariach i zawieszeniach oraz model i pamięć Twojego Maca. Bez zawartości stron, adresów i historii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недавние отчеты о сбоях и зависаниях, а также модель и объем памяти Вашего Mac. Без содержимого страниц, адресов и истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нещодавні звіти про збої та зависання, модель і памʼять вашого Mac. Без вмісту сторінок, адрес чи історії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的崩溃和卡死报告，以及你的 Mac 型号和内存。不含页面内容、网址或历史记录。"
          }
        }
      }
    },
