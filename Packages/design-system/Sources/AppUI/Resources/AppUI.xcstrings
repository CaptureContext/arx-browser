    "settings.pipExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere eine Website unter „Medien“ in der Bibliothek, während ihr Video läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn one site off from Media in the Library while its video plays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívala para un sitio desde Multimedia en la biblioteca mientras se reproduce su vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez un site dans Médias de la bibliothèque pendant la lecture de sa vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオの再生中に、ライブラリの「メディア」からサイトごとにオフにできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz jedną witrynę w Multimediach w Bibliotece, gdy odtwarza wideo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите режим для одного сайта в разделе «Медиа» библиотеки, пока воспроизводится его видео."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть один сайт у «Медіа» в бібліотеці, поки відтворюється його відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在某个网站播放视频时，可从资源库的“媒体”中为该网站单独关闭。"
          }
        }
      }
    },
