    "reportProblem.cannotSend": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von Arx kann keine Berichte senden. Sichere den Bericht und sende die Datei an das Arx-Team."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Arx can't send reports. Save the report and send the file to the Arx team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Arx no puede enviar informes. Guarda el informe y envía el archivo al equipo de Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d’Arx ne peut pas envoyer de signalements. Enregistrez le signalement et envoyez le fichier à l’équipe d’Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのArxはレポートを送信できません。レポートを保存して、そのファイルをArxチームに送信してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja Arx nie może wysyłać raportów. Zachowaj raport i wyślij plik zespołowi Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия Arx не может отправлять отчеты. Сохраните отчет и отправьте файл команде Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця версія Arx не може надсилати звіти. Збережіть звіт і надішліть файл команді Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Arx 无法发送报告。请存储报告，并将该文件发送给 Arx 团队。"
          }
        }
      }
    },
    "settings.crashReportsNotSent": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
