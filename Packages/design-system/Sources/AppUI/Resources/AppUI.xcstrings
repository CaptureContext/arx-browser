    "settings.hoverPreviewsExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab zeigt ein Bild seiner Seite, ein Ordner listet seine Tabs auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab shows a picture of its page; a folder lists its tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña muestra una imagen de su página; una carpeta muestra sus pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet affiche une image de sa page ; un dossier liste ses onglets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブにはページのイメージが表示され、フォルダにはそのタブが一覧表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta pokazuje obraz swojej strony, a folder wymienia swoje karty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка показывает изображение своей страницы, папка — список своих вкладок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка показує зображення своєї сторінки; папка показує список своїх вкладок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页会显示其页面的图片；文件夹会列出其中的标签页。"
          }
        }
      }
    },
    "settings.closeOnEmptyDelete": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei leerem Feld mit der Löschtaste schließen"
          }
        },
        "en": {
          "stringUnit": {
