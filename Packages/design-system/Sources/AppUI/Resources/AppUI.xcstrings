    "media.automaticPictureHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für diesen Website-Ursprung in diesem Profil. Manuelles PiP bleibt verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only to this site origin in this profile. Manual PiP stays available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica solo al origen de este sitio en este perfil. El PiP manual sigue disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique uniquement à l’origine de ce site dans ce profil. PiP manuel reste disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルの、このサイトのオリジンにのみ適用されます。手動のPiPは引き続き利用できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy tylko źródła tej witryny w tym profilu. Ręczny PiP pozostaje dostępny."
          }
