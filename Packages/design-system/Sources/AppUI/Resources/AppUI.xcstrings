    "migration.credentials.profileFailed": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx konnte die Passwörter und Anmeldungen dieses Profils nicht importieren. Es wurde nichts davon hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx couldn't import this profile's passwords and sign-ins. Nothing from it was added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx no ha podido importar las contraseñas ni los inicios de sesión de este perfil. No se ha añadido nada de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx n’a pas pu importer les mots de passe et les connexions de ce profil. Rien n’a été ajouté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxはこのプロファイルのパスワードとサインインを読み込めませんでした。何も追加されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie mógł zaimportować haseł i logowań tego profilu. Nic z niego nie dodano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не удалось импортировать пароли и данные для входа этого профиля. Из него ничего не добавлено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не вдалося імпортувати паролі та входи цього профілю. Нічого з нього не додано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 无法导入此用户场景的密码和登录状态。未添加其中的任何内容。"
          }
        }
      }
    },
