    "settings.iCloudSync.syncDeletions": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschungen nach 30 Tagen synchronisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync deletions after 30 days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar eliminaciones tras 30 días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser les suppressions après 30 jours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日後に削除を同期"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj usunięcia po 30 dniach"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизировать удаления через 30 дней"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізувати видалення через 30 днів"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天后同步删除操作"
          }
        }
      }
    },
    "settings.iCloudSync.syncDeletionsDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du löschst, bleibt auf deinen anderen Macs erhalten. Wenn dies aktiviert ist, wird es von allen entfernt, sobald es vor 30 Tagen auf einem Mac gelöscht wurde und seitdem keiner es geöffnet oder bearbeitet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something you delete stays on your other Macs. With this on, it goes from all of them once it was deleted on one Mac 30 days ago and none opened or edited it since."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que eliminas se queda en tus otros Mac. Si se activa, desaparece de todos cuando haya pasado 30 días desde que se eliminó en un Mac y ninguno lo haya abierto ni editado desde entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous supprimez reste sur vos autres Mac. Activé, l’élément disparaît de tous une fois qu’il a été supprimé sur un Mac depuis 30 jours et que personne ne l’a ouvert ni modifié depuis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除したものは、ほかのMacに残ります。オンにすると、1台のMacで30日前に削除され、その後どのMacでも開いたり編集したりしていない場合、すべてのMacから削除されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co usuniesz, zostaje na Twoich pozostałych komputerach Mac. Gdy ta opcja jest włączona, znika ze wszystkich, gdy zostało usunięte na jednym Macu 30 dni temu i od tego czasu żaden go nie otwierał ani nie edytował."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаленный Вами объект остается на Ваших других компьютерах Mac. Если включить, он исчезнет со всех, когда его удалили на одном Mac 30 дней назад и с тех пор его никто не открывал и не изменял."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалене вами залишається на інших ваших Mac. Якщо це ввімкнено, воно зникне з усіх, коли минуло 30 днів відтоді, як його видалили на одному Mac, і відтоді ніхто його не відкривав і не редагував."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你删除的内容会保留在其他 Mac 上。打开此选项后，如果某项内容已在一台 Mac 上删除满 30 天，且此后没有任何 Mac 打开或编辑过它，它就会从所有 Mac 上移除。"
          }
        }
      }
    },
    "settings.iCloudSync.archive": {
      "extractionState": "manual",
      "generatesSymbol": false,
