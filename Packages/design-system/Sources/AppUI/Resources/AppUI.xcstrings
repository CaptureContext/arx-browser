    "links.reorderHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege eine Regel oder drücke ⌥⌘↑ oder ⌥⌘↓ darauf, um die Reihenfolge zu ändern. Wenn zwei Regeln auf einen Link zutreffen, gilt die höhere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag, or press ⌥⌘↑ or ⌥⌘↓ on a rule, to change the order. When two rules match a link, the higher one wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una regla, o pulsa ⌥⌘↑ o ⌥⌘↓ sobre ella, para cambiar el orden. Si dos reglas coinciden con un enlace, gana la de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une règle, ou appuyez sur ⌥⌘↑ ou ⌥⌘↓, pour changer l’ordre. Lorsque deux règles correspondent à un lien, la plus haute l’emporte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールをドラッグするか、ルール上で⌥⌘↑または⌥⌘↓を押して、順序を変更します。2つのルールがリンクに一致する場合は、上にあるルールが優先されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij regułę lub naciśnij ⌥⌘↑ albo ⌥⌘↓, aby zmienić kolejność. Gdy do łącza pasują dwie reguły, wygrywa wyższa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите правило или нажмите ⌥⌘↑ либо ⌥⌘↓, чтобы изменить порядок. Если ссылке подходят два правила, действует то, что выше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть правило або натисніть ⌥⌘↑ чи ⌥⌘↓ на ньому, щоб змінити порядок. Якщо посиланню відповідають два правила, переважає вище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移规则，或在规则上按 ⌥⌘↑ 或 ⌥⌘↓ 来更改顺序。当两条规则都匹配某个链接时，排在上方的规则优先。"
          }
        }
      }
    },
