    "settings.soundsExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leise Töne, wenn eine Aufnahme kopiert oder gesichert wird, ein Download abgeschlossen ist oder einer davon nicht funktioniert. Sie folgen der Warnton-Lautstärke deines Macs und bleiben stumm, solange ein Tab Ton wiedergibt oder das Mikrofon verwendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet sounds when a capture is copied or saved, a download finishes, or one of them doesn’t work. They follow your Mac’s alert volume and stay silent while a tab plays sound or the microphone is in use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonidos discretos cuando se copia o se guarda una captura, termina una descarga o alguna de ellas falla. Siguen el volumen de alertas de tu Mac y permanecen en silencio mientras una pestaña reproduce sonido o se usa el micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sons discrets lorsqu’une capture est copiée ou enregistrée, qu’un téléchargement se termine, ou que l’une de ces actions échoue. Ils suivent le volume des alertes de votre Mac et restent silencieux pendant qu’un onglet émet du son ou que le micro est utilisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャをコピーまたは保存したとき、ダウンロードが完了したとき、またはそれらが失敗したときに、小さな音が鳴ります。音量はMacの警告音の音量に従い、タブが音を再生している間やマイクの使用中は鳴りません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciche dźwięki, gdy zrzut zostanie skopiowany lub zachowany, pobieranie się zakończy albo któraś z tych czynności się nie powiedzie. Podlegają głośności alertów Twojego Maca i milczą, gdy karta odtwarza dźwięk lub używany jest mikrofon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихие звуки, когда снимок скопирован или сохранен, загрузка завершена или что-то из этого не удалось. Они зависят от громкости звуковых сигналов Вашего Mac и не воспроизводятся, пока вкладка издает звук или используется микрофон."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихі звуки, коли знімок скопійовано чи збережено, викачування завершено або одна з цих дій не вдалася. Вони відповідають гучності попереджень вашого Mac і мовчать, поки вкладка відтворює звук або використовується мікрофон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在截取内容被拷贝或存储、下载完成，或其中某项操作失败时播放轻柔的声音。声音遵循 Mac 的提示音量，并在标签页播放声音或正在使用麦克风时保持静默。"
          }
        }
      }
    },
