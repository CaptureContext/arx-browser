    "settings.iCloudSync.merge.joiningTitle": {
      "comment": "Settings › Arx › iCloud Sync: asked when turning on sync on a Mac whose profiles, spaces and tabs differ from those already in iCloud.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume und Tabs dieses Macs mit denen aus iCloud zusammenführen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge this Mac’s spaces and tabs with iCloud’s?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Fusionar las secciones y pestañas de este Mac con las de iCloud?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner les sections et onglets de ce Mac avec ceux d’iCloud ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのスペースとタブをiCloudのものと統合しますか？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
