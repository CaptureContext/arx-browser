    "autofill.subtitle": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ gesicherte Adressen und Zahlungskarten. Andere Profile sehen sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Addresses and payment cards saved in %@. Other profiles never see them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcciones y tarjetas de pago guardadas en %@. Los demás perfiles nunca las ven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresses et cartes de paiement enregistrées dans %@. Les autres profils ne les voient jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に保存された住所と支払いカードです。ほかのプロファイルからは表示されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresy i karty płatnicze zachowane w profilu %@. Inne profile nigdy ich nie widzą."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса и платежные карты, сохраненные в профиле %@. Другие профили их не видят."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреси та платіжні картки, збережені в профілі %@. Інші профілі їх не бачать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储在 %@ 中的地址和支付卡。其他用户场景无法看到它们。"
          }
        }
      }
    },
