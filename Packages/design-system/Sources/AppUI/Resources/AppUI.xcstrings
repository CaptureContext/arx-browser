    "routing.patternHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zuordnung passt zu einer Domain, optional mit Port und Pfad, etwa localhost:3000 oder github.com/capturecontext. Es gilt die erste passende Zuordnung, die eingeschaltet ist; „Andernfalls“ übernimmt jeden anderen Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A route matches a domain, with an optional port and path, such as localhost:3000 or github.com/capturecontext. The first matching route that's on wins; Otherwise takes every other link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla coincide con un dominio, con un puerto y una ruta opcionales, como localhost:3000 o github.com/capturecontext. Gana la primera regla coincidente que esté activada; “En los demás casos” recoge todos los demás enlaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle correspond à un domaine, avec un port et un chemin facultatifs, comme localhost:3000 ou github.com/capturecontext. La première règle activée qui correspond l’emporte ; « Sinon » prend tous les autres liens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り分けルールは、localhost:3000やgithub.com/capturecontextのように、ドメインと、任意のポートとパスに一致します。オンになっている最初に一致する振り分けルールが優先され、「それ以外」はそのほかすべてのリンクに適用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasa pasuje do domeny, z opcjonalnym portem i ścieżką, na przykład localhost:3000 lub github.com/capturecontext. Wygrywa pierwsza pasująca włączona trasa; W przeciwnym razie obejmuje wszystkie pozostałe łącza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрут соответствует домену, при необходимости с портом и путем, например localhost:3000 или github.com/capturecontext. Действует первый подходящий включенный маршрут; «Иначе» принимает все остальные ссылки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрут відповідає домену з необовʼязковим портом і шляхом, як-от localhost:3000 або github.com/capturecontext. Перемагає перший увімкнений маршрут, що збігся; «Інакше» бере всі інші посилання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路由匹配一个域名，可带可选的端口和路径，例如 localhost:3000 或 github.com/capturecontext。第一条已打开且匹配的路由生效；“其他情况”接管所有其他链接。"
          }
        }
      }
    },
