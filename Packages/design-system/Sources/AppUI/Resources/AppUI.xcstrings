    "autofill.busy": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx sichert noch. Versuche es gleich erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx is still saving. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx todavía está guardando. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx enregistre encore. Réessayez dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxはまだ保存中です。しばらくしてからもう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx wciąż zachowuje. Spróbuj ponownie za chwilę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx еще сохраняет данные. Повторите попытку через мгновение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx ще зберігає. Спробуйте за мить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 仍在存储。请稍后再试。"
          }
        }
      }
    },
    "autofill.disabled": {
      "comment": "Autofill data editor. “Fill addresses” and “Fill payment cards” are the switches' names in Settings › General › Autofill; use their translated names.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Adressen ausfüllen“ oder „Zahlungskarten ausfüllen“ unter Einstellungen › Allgemein › Automatisches Ausfüllen, um diese Art hinzuzufügen oder zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Fill addresses or Fill payment cards in Settings › General › Autofill to add or change that kind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Rellenar direcciones o Rellenar tarjetas de pago en Ajustes › General › Autorrelleno para añadir o cambiar ese tipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Remplir les adresses » ou « Remplir les cartes de paiement » dans Réglages › Général › Remplissage automatique pour ajouter ou modifier ce type de données."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この種類を追加または変更するには、「設定」＞「一般」＞「自動入力」で「住所を入力」または「支払いカードを入力」をオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz „Wypełniaj adresy” lub „Wypełniaj karty płatnicze” w Ustawieniach › Ogólne › Wypełnianie, aby dodać lub zmienić dane tego rodzaju."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Заполнять адреса» или «Заполнять платежные карты» в «Настройки › Основные › Автозаполнение», чтобы добавлять или изменять данные этого типа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть «Заповнювати адреси» або «Заповнювати платіжні картки» в «Параметри › Загальні › Автозаповнення», щоб додавати чи змінювати такі записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”>“通用”>“自动填充”中打开“填充地址”或“填充付款卡”，以添加或更改该类信息。"
          }
        }
      }
    },
