    "automation.startDownloadDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx sichert sie dort, wo dieses Profil Downloads sichert, mit den üblichen Sicherheitsprüfungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx saves it where this profile saves downloads, with the usual safety checks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx lo guarda donde este perfil guarda las descargas, con las comprobaciones de seguridad habituales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx l’enregistre à l’emplacement où ce profil enregistre les téléchargements, avec les contrôles de sécurité habituels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の安全確認を行い、このプロファイルのダウンロード先に保存します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx zachowuje go tam, gdzie ten profil zachowuje pobrane pliki, z zwykłymi kontrolami bezpieczeństwa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx сохраняет его туда, куда этот профиль сохраняет загрузки, с обычными проверками безопасности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx зберігає його там, де цей профіль зберігає викачане, зі звичайними перевірками безпеки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会将其存储到此用户场景存放下载项的位置，并进行常规的安全检查。"
          }
        }
      }
    },
    "automation.browserAdmin": {
