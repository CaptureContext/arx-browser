    "settings.reportProblemDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet ein GitHub-Issue für das Arx-Team. Du entscheidest, ob eine Diagnosedatei beigefügt wird. Auch im Menü „Hilfe“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a GitHub issue for the Arx team. You choose whether a diagnostics file goes with it. Also in the Help menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una incidencia de GitHub para el equipo de Arx. Tú decides si se adjunta un archivo de diagnóstico. También está en el menú Ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un ticket GitHub pour l’équipe d’Arx. Vous choisissez d’y joindre ou non un fichier de diagnostic. Également dans le menu Aide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxチーム宛てのGitHub Issueを開きます。診断ファイルを添付するかどうかは選択できます。「ヘルプ」メニューにもあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera zgłoszenie GitHub dla zespołu Arx. Sam wybierasz, czy dołączyć do niego plik diagnostyczny. Jest też w menu Pomoc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает обращение на GitHub для команды Arx. Вы сами решаете, прикладывать ли файл диагностики. Также есть в меню «Справка»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває звернення на GitHub для команди Arx. Ви самі вирішуєте, чи додавати файл діагностики. Також доступно в меню «Довідка»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Arx 团队打开一个 GitHub 问题。你可以选择是否随附诊断文件。“帮助”菜单中也有此项。"
          }
        }
      }
    },
