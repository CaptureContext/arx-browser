    "migration.sourceUnchanged": {
      "comment": "Import (Customize): the footer under the source browser and the kinds of data.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx liest den anderen Browser nur. Dort ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx only reads the other browser. Nothing there changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx solo lee el otro navegador. No se modifica nada en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx lit seulement l’autre navigateur. Rien n’y est modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは、もう一方のブラウザを読み取るだけです。そのデータは変更されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx tylko odczytuje dane z drugiej przeglądarki. Nic się tam nie zmienia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx только читает данные другого браузера. Они не изменяются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx лише читає дані іншого браузера. Там нічого не змінюється."
          }
