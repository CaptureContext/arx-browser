    "automation.scopeNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Profilfreigabe deckt alle Räume, Ordner, Tabs und Favoriten ab, auch später erstellte Räume. Der Zugriff auf einen Raum umfasst seine Ordner und Tabs. Favoriten benötigen sonst eigene Tab-Freigaben. Private Fenster werden nie freigegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A profile grant covers all of its spaces, folders, tabs and Favorites, including spaces created later. Space access includes its folders and tabs. Favorites otherwise need their own tab grants. Private windows are never exposed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permiso de perfil cubre todas sus secciones, carpetas, pestañas y favoritos, incluidas las secciones creadas después. El acceso a una sección incluye sus carpetas y pestañas. Los favoritos, por lo demás, necesitan sus propios permisos de pestaña. Las ventanas privadas nunca se exponen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation sur un profil couvre toutes ses sections, tous ses dossiers, onglets et Favoris, y compris les sections créées plus tard. L’accès à une section inclut ses dossiers et ses onglets. Les Favoris nécessitent sinon leurs propres autorisations d’onglets. Les fenêtres privées ne sont jamais exposées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルの許可は、あとから作成されるスペースを含め、そのすべてのスペース、フォルダ、タブ、お気に入りに及びます。スペースへのアクセスには、そのフォルダとタブが含まれます。お気に入りには、それ以外の場合はタブごとの許可が必要です。プライベートウインドウは公開されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgoda na profil obejmuje wszystkie jego strefy, foldery, karty i ulubione, także strefy utworzone później. Dostęp do strefy obejmuje jej foldery i karty. Ulubione wymagają osobnych zgód na karty. Okna prywatne nigdy nie są udostępniane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на профиль охватывает все его разделы, папки, вкладки и избранное, включая разделы, созданные позже. Доступ к разделу включает его папки и вкладки. Для избранного иначе нужны отдельные разрешения на вкладки. Частные окна никогда не раскрываются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл на профіль охоплює всі його розділи, папки, вкладки та улюблені, зокрема розділи, створені пізніше. Доступ до розділу охоплює його папки та вкладки. Улюблені в іншому разі потребують власних дозволів на вкладки. Приватні вікна ніколи не відкриваються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户场景授权涵盖其所有分区、文件夹、标签页和个人收藏，包括之后创建的分区。分区访问权限包含其文件夹和标签页。个人收藏另外需要各自的标签页授权。无痕浏览窗口绝不会被公开。"
          }
        }
      }
    },
