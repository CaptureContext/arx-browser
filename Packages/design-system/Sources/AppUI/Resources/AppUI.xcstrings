            "value": "空のときにDeleteキーで閉じる"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamykaj klawiszem Delete, gdy puste"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрывать по Delete, когда пусто"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закривати клавішею Delete, коли порожньо"
          }
        },
        "zh-Hans": {
          "stringUnit": {
