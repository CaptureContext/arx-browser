    "settings.iCloudSync.group.routingDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuordnung, ihre Regeln und Proxy-Link-Regeln. Bei „Aus“ bleibt es bei den Werten dieses Macs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routing, its rules, and Proxy Link rules. Off keeps this Mac’s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La apertura, sus reglas y las reglas de enlace proxy. Si se desactiva, se conservan las de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ouverture des liens, ses règles et les règles de lien proxy. Désactivé, conserve celles de ce Mac."
          }
        },
        "ja": {
