    "settings.iCloudSync.group.appearanceDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design, App-Symbol, Seitenleiste, Körnung, wie Links geöffnet werden, und Little Arx. Bei „Aus“ bleibt es bei den Werten dieses Macs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme, app icon, sidebar, grain, how links open, and Little Arx. Off keeps this Mac’s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, icono de la app, barra lateral, grano, cómo se abren los enlaces y Little Arx. Si se desactiva, se conserva el de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème, icône de l’app, barre latérale, grain, ouverture des liens et Little Arx. Désactivé, conserve ceux de ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、アプリケーションアイコン、サイドバー、グレイン、リンクの開き方、Little Arx。オフにすると、このMacの設定が保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motyw, ikona aplikacji, pasek boczny, ziarno, sposób otwierania łączy i Little Arx. Po wyłączeniu zostają ustawienia tego Maca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема, значок приложения, боковое меню, зерно, способ открытия ссылок и Little Arx. Если выключено, остаются настройки этого Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема, іконка програми, бічна панель, зернистість, спосіб відкриття посилань і Little Arx. Якщо вимкнено, залишаються параметри цього Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题、App 图标、边栏、颗粒感、链接的打开方式和 Little Arx。关闭则保留这台 Mac 上的设置。"
          }
        }
      }
    },
