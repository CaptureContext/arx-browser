    "automation.devtoolsNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die Konsolenmeldungen und abgeschlossenen Anfragen eines freigegebenen Tabs, sobald der Assistent darum bittet, ohne Header, Cookies oder Bodys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the console messages and finished requests of a granted tab once the assistant asks, without headers, cookies or bodies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los mensajes de la consola y las peticiones terminadas de una pestaña con permiso cuando el asistente lo solicita, sin cabeceras, cookies ni cuerpos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les messages de la console et les requêtes terminées d’un onglet autorisé dès que l’assistant le demande, sans en-têtes, cookies ni corps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントが要求すると、許可されたタブのコンソールメッセージと完了したリクエストを保持します。ヘッダ、Cookie、本文は含まれません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje komunikaty konsoli i zakończone żądania karty objętej zgodą, gdy asystent o to poprosi, bez nagłówków, plików cookie i treści."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет сообщения консоли и завершенные запросы разрешенной вкладки, когда ассистент их запрашивает, без заголовков, файлов cookie и тел запросов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає повідомлення консолі та завершені запити вкладки з наданим доступом, коли асистент просить, без заголовків, файлів cookie чи тіл запитів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在助理提出请求后，保留已授权标签页的控制台消息和已完成的请求，不含标头、Cookie 或正文。"
          }
        }
      }
    },
