    "appearance.description": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt der Seitenleiste und dem Fensterrahmen Textur hinzu. Der Seiteninhalt bleibt klar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds texture to the sidebar and window frame. Page content stays clear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade textura a la barra lateral y al marco de la ventana. El contenido de la página permanece nítido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute de la texture à la barre latérale et au cadre de la fenêtre. Le contenu des pages reste net."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーとウインドウのフレームに質感を加えます。ページの内容は変わりません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje fakturę paskowi bocznemu i ramce okna. Zawartość stron pozostaje czysta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет текстуру боковому меню и рамке окна. Содержимое страницы остается чистым."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає текстуру бічній панелі й рамці вікна. Вміст сторінки лишається чистим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为边栏和窗口边框增添质感。网页内容保持清晰。"
          }
        }
      }
    },
