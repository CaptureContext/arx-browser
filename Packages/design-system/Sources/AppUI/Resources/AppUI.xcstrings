    "siteSettings.devicesCaption": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "USB-, HID-, serielle und Bluetooth-Geräte, die Websites in diesem Profil verwenden dürfen. Wenn du eines entfernst, muss die Website erneut fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB, HID, serial and Bluetooth devices sites in this profile may use. Forget one and the site has to ask again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos USB, HID, serie y Bluetooth que los sitios de este perfil pueden usar. Si olvidas uno, el sitio tendrá que volver a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils USB, HID, série et Bluetooth que les sites de ce profil peuvent utiliser. Si vous en oubliez un, le site doit demander de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルのサイトが使用できるUSB、HID、シリアル、Bluetoothデバイス。削除すると、サイトは再び確認を求める必要があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenia USB, HID, szeregowe i Bluetooth, z których mogą korzystać witryny w tym profilu. Jeśli o jednym zapomnisz, witryna będzie musiała zapytać ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства USB, HID, последовательные устройства и устройства Bluetooth, которые могут использовать сайты в этом профиле. Если забыть устройство, сайт должен будет запросить доступ снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрої USB, HID, послідовні й Bluetooth, які можуть використовувати сайти в цьому профілі. Якщо забути пристрій, сайт мусить запитати знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此用户场景中的网站可能使用的 USB、HID、串行和蓝牙设备。忘记某个设备后，该网站必须重新询问。"
          }
        }
      }
    },
