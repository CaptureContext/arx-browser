    "chat.settingsProvidersDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx führt auf diesem Mac die eigene App jedes Anbieters mit dem Account aus, bei dem du dort angemeldet bist. Alle Profile teilen sich diese Verbindungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx runs each provider's own app on this Mac with the account you signed in to there. Every profile shares these connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx ejecuta en este Mac la app propia de cada proveedor con la cuenta en la que has iniciado sesión allí. Todos los perfiles comparten estas conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx exécute l’app de chaque fournisseur sur ce Mac avec le compte auquel vous vous y êtes connecté. Tous les profils partagent ces connexions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは、各プロバイダ自身のAppを、そこでサインインしたアカウントでこのMac上で実行します。これらの接続はすべてのプロファイルで共有されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx uruchamia własną aplikację każdego dostawcy na tym Macu, z kontem zalogowanym w tej aplikacji. Każdy profil współdzieli te połączenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx запускает собственное приложение каждого поставщика на этом Mac с учетной записью, в которую Вы там вошли. Эти подключения общие для всех профилей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx запускає власну програму кожного провайдера на цьому Mac з обліковим записом, у який ви там увійшли. Усі профілі спільно використовують ці підключення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会在这台 Mac 上运行各服务提供方自己的 App，并使用你在其中登录的账户。所有用户场景共用这些连接。"
          }
        }
      }
    },
    "chat.settingsProviderThrough": {
