    "onboarding.message.crashReports": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx kann dem Arx-Team bei einem Absturz einen kurzen Bericht senden. Das ist ausgeschaltet, solange du es nicht einschaltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx can send the Arx team a short report when it crashes. It's off unless you turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx puede enviar al equipo de Arx un informe breve cuando falla. Está desactivado a menos que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx peut envoyer à l’équipe d’Arx un court rapport en cas de plantage. C’est désactivé tant que vous ne l’activez pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxはクラッシュしたときに、Arxチームへ短いレポートを送信できます。オンにしない限り、オフです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx może wysłać zespołowi Arx krótki raport, gdy ulegnie awarii. Jest wyłączone, dopóki tego nie włączysz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx может отправлять команде Arx краткий отчет при сбое. Функция выключена, пока Вы ее не включите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx може надсилати команді Arx короткий звіт у разі збою. Це вимкнено, доки ви не ввімкнете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 崩溃时可以向 Arx 团队发送一份简短的报告。除非你打开，否则此功能保持关闭。"
          }
        }
      }
    },
    "onboarding.headline.crashReports": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf, Abstürze zu beheben"
          }
        },
