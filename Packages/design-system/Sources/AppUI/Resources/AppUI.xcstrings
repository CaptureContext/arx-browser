    "persistence.recovered": {
      "comment": "Shown at launch when the file holding profiles, spaces, folders and tabs was damaged and an earlier save was used.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx hat deine Räume und Tabs so wiederhergestellt, wie sie zuletzt gesichert wurden. Die beschädigte Datei wird beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx recovered your spaces and tabs as they were last saved. The damaged file will be preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx ha recuperado tus secciones y pestañas tal como se guardaron por última vez. El archivo dañado se conservará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx a récupéré vos sections et onglets tels qu’ils avaient été enregistrés en dernier. Le fichier endommagé sera conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは、スペースとタブを前回保存された状態に復旧しました。破損したファイルは保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx odzyskał Twoje strefy i karty w ostatnio zachowanym stanie. Uszkodzony plik zostanie zachowany."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx восстановил Ваши разделы и вкладки в том виде, в каком они были сохранены в последний раз. Поврежденный файл будет сохранен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx відновив ваші розділи та вкладки в останньому збереженому стані. Пошкоджений файл буде збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 已按上次存储的状态恢复了你的分区和标签页。损坏的文件将被保留。"
          }
        }
      }
    },
