    "settings.handoffExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze die Seite des vordersten Fensters auf deinem iPhone, iPad oder anderen Macs fort, die mit demselben Apple Account angemeldet sind. Private Fenster werden nie angeboten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue the front window’s page on your iPhone, iPad or other Macs signed in to the same Apple Account. Private windows are never offered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa la página de la ventana frontal en tu iPhone, iPad u otros Mac con la sesión iniciada en la misma cuenta de Apple. Nunca se ofrecen las ventanas privadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poursuivez la page de la fenêtre au premier plan sur votre iPhone, votre iPad ou d’autres Mac connectés au même compte Apple. Les fenêtres privées ne sont jamais proposées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じApple Accountでサインインしているデバイスで、最前面のウインドウのページをiPhone、iPad、ほかのMacで続けられます。プライベートウインドウは表示されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj stronę z okna na wierzchu na iPhonie, iPadzie lub innych komputerach Mac zalogowanych na to samo konto Apple. Okna prywatne nigdy nie są oferowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте работу со страницей из переднего окна на iPhone, iPad или других компьютерах Mac, на которых выполнен вход в тот же Аккаунт Apple. Частные окна никогда не предлагаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуйте переглядати сторінку з переднього вікна на iPhone, iPad або інших Mac, на яких виконано вхід в той самий обліковий запис Apple. Приватні вікна ніколи не пропонуються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在登录同一 Apple 账户的 iPhone、iPad 或其他 Mac 上继续最前面窗口的页面。绝不会提供无痕浏览窗口。"
          }
        }
      }
    },
