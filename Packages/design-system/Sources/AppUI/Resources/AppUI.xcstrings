    "automation.signInGrantNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent kann nur fragen. Du bestätigst in Arx, alle Assistenten werden pausiert, während du dich anmeldest, und Arx gibt nie Passwörter oder Codes weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant can only ask. You approve in Arx, every assistant is paused while you sign in, and Arx never shares passwords or codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente solo puede pedirlo. Tú lo apruebas en Arx, todos los asistentes se pausan mientras inicias sesión y Arx nunca comparte contraseñas ni códigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant peut seulement demander. Vous approuvez dans Arx, tous les assistants sont suspendus pendant votre connexion et Arx ne partage jamais les mots de passe ni les codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントはリクエストのみ行えます。承認はArxで行い、サインイン中はすべてのアシスタントが一時停止されます。Arxはパスワードやコードを共有しません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent może tylko prosić. Zatwierdzasz w Arx, każdy asystent jest wstrzymany, gdy się logujesz, a Arx nigdy nie udostępnia haseł ani kodów."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент может только запросить вход. Вы подтверждаете в Arx, все ассистенты приостанавливаются на время входа, а Arx никогда не передает пароли и коды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент може лише просити. Ви підтверджуєте в Arx, усіх асистентів призупинено, поки ви входите, а Arx ніколи не передає паролі чи коди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理只能提出请求。你在 Arx 中批准，你登录期间所有助理都会暂停，Arx 绝不会分享密码或验证码。"
          }
        }
      }
    },
    "persistence.recoveredGrants": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP wurde deaktiviert, weil wiederhergestellte Zugriffsberechtigungen möglicherweise veraltet sind. Aktiviere es in den Einstellungen ausdrücklich wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP was disabled because recovered access grants may be outdated. Re-enable it explicitly in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP se ha desactivado porque los permisos de acceso recuperados podrían estar obsoletos. Vuelve a activarlo de forma explícita en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP a été désactivé, car les accès récupérés peuvent être périmés. Réactivez-le explicitement dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧したアクセス許可が古い可能性があるため、MCPを無効にしました。「設定」で、明示的に再度有効にしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP wyłączono, ponieważ odzyskane przyznane dostępy mogą być nieaktualne. Włącz je ponownie jawnie w Ustawieniach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP выключен, так как восстановленные разрешения на доступ могут быть устаревшими. Включите его снова в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP вимкнено, оскільки відновлені дозволи доступу можуть бути застарілими. Увімкніть його знову явно в параметрах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 已被停用，因为恢复的访问授权可能已过时。请在“设置”中明确地重新启用它。"
          }
        }
      }
    },
