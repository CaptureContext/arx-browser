    "profile.moveExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite wird mit dem Zielprofil erneut geöffnet. Cookies, Passwörter, Anmeldungen, Formularinhalte und Verlauf bleiben im ursprünglichen Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page will reopen using the destination profile. Cookies, passwords, sign-ins, form contents and navigation history stay in the original profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página se volverá a abrir con el perfil de destino. Las cookies, las contraseñas, los inicios de sesión, el contenido de formularios y el historial de navegación se quedan en el perfil original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page se rouvrira avec le profil de destination. Les cookies, les mots de passe, les connexions, le contenu des formulaires et l’historique de navigation restent dans le profil d’origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページは、移動先のプロファイルを使用して開き直されます。Cookie、パスワード、サインイン、フォームの内容、ナビゲーション履歴は、元のプロファイルに残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona zostanie ponownie otwarta w profilu docelowym. Pliki cookie, hasła, logowania, zawartość formularzy i historia nawigacji zostają w profilu oryginalnym."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница откроется заново в профиле назначения. Файлы cookie, пароли, данные для входа, содержимое форм и история переходов останутся в исходном профиле."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінка знову відкриється з використанням профілю призначення. Файли cookie, паролі, входи, вміст форм та історія навігації лишаються у вихідному профілі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该页面将使用目标用户场景重新打开。Cookie、密码、登录状态、表单内容和导航历史记录会保留在原来的用户场景中。"
          }
        }
      }
    },
