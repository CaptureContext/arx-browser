    "settings.iCloudSync.merge.joiningMessage": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Profile und Räume auf diesem Mac stimmen mit denen in iCloud überein. Es wird nichts gesendet, bis du „Zusammenführen und synchronisieren“ wählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some profiles and spaces on this Mac match the ones in iCloud. Nothing is sent until you choose Merge and Sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos perfiles y secciones de este Mac coinciden con los de iCloud. No se envía nada hasta que selecciones Fusionar y sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains profils et sections de ce Mac correspondent à ceux d’iCloud. Rien n’est envoyé tant que vous n’avez pas choisi Fusionner et synchroniser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの一部のプロファイルとスペースが、iCloudにあるものと一致しています。「統合して同期」を選択するまで、何も送信されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre profile i strefy na tym Macu pasują do tych w iCloud. Nic nie zostanie wysłane, dopóki nie wybierzesz Scal i synchronizuj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые профили и разделы на этом Mac совпадают с теми, что в iCloud. Ничего не отправляется, пока Вы не выберете «Объединить и синхронизировать»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі профілі й розділи на цьому Mac збігаються з тими, що в iCloud. Нічого не надсилається, доки ви не виберете «Обʼєднати й синхронізувати»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的某些用户场景和分区与 iCloud 中的相同。在你选择“合并并同步”之前，不会发送任何内容。"
          }
        }
      }
    },
    "settings.iCloudSync.merge.profilesTitle": {
