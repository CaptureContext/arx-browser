    "autofill.cardsFooter": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur die letzten vier Ziffern angezeigt. Die Kartennummer bleibt in diesem Profil, verschlüsselt mit dem Schlüssel von Arx in deinem Schlüsselbund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the last four digits are shown. The card number stays in this profile, encrypted with Arx's key in your Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran los últimos cuatro dígitos. El número de la tarjeta permanece en este perfil, cifrado con la clave de Arx en tu llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les quatre derniers chiffres sont affichés. Le numéro de carte reste dans ce profil, chiffré avec la clé d’Arx dans votre trousseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下4桁のみ表示されます。カード番号はこのプロファイル内に、キーチェーンにあるArxのキーで暗号化して保存されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczne są tylko ostatnie cztery cyfry. Numer karty pozostaje w tym profilu, zaszyfrowany kluczem Arx w Twoim pęku kluczy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны только последние четыре цифры. Номер карты хранится в этом профиле в зашифрованном виде с помощью ключа Arx в Вашей связке ключей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано лише останні чотири цифри. Номер картки лишається в цьому профілі, зашифрований ключем Arx у вашій вʼязці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示最后四位数字。卡号保留在此用户场景中，并使用钥匙串中 Arx 的密钥加密。"
          }
        }
      }
    },
