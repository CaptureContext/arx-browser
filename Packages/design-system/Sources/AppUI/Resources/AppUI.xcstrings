    "onboarding.makeItYours.fromICloud": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Profile und Räume stammen aus iCloud"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profiles and spaces came from iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus perfiles y secciones vienen de iCloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos profils et vos sections proviennent d’iCloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルとスペースはiCloudから読み込まれました"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje profile i strefy pochodzą z iCloud"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши профили и разделы загружены из iCloud"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші профілі та розділи надійшли з iCloud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的用户场景和分区来自 iCloud"
          }
        }
      }
    },
    "onboarding.makeItYours.fromICloudSubtitle": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm, was iCloud nicht synchronisiert: Passwörter, Anmeldungen, Verlauf, geöffnete Tabs und Erweiterungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring what iCloud doesn't sync: passwords, sign-ins, history, open tabs and extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae lo que iCloud no sincroniza: contraseñas, inicios de sesión, historial, pestañas abiertas y extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez ce qu’iCloud ne synchronise pas : mots de passe, connexions, historique, onglets ouverts et extensions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudが同期しないもの（パスワード、サインイン、履歴、開いているタブ、機能拡張）を読み込みます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś to, czego iCloud nie synchronizuje: hasła, logowania, historię, otwarte karty i rozszerzenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите то, что iCloud не синхронизирует: пароли, данные для входа, историю, открытые вкладки и расширения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесіть те, що iCloud не синхронізує: паролі, входи, історію, відкриті вкладки та розширення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入 iCloud 不会同步的内容：密码、登录状态、历史记录、打开的标签页和扩展。"
          }
        }
      }
    },
