    "settings.unloadedSiteIconsExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx fragt die Website ohne Cookies, wenn das Profil kein Symbol hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx asks the site, without cookies, when the profile doesn’t have an icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx se lo pide al sitio, sin cookies, cuando el perfil no tiene un icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx interroge le site, sans cookies, quand le profil n’a pas d’icône."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルにアイコンがない場合、ArxはCookieなしでサイトに問い合わせます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx prosi witrynę o ikonę, bez plików cookie, gdy profil jej nie ma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx запрашивает значок у сайта без файлов cookie, если в профиле его нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx запитує іконку в сайту без файлів cookie, коли її немає в профілі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当用户场景没有图标时，Arx 会在不带 Cookie 的情况下向网站请求。"
          }
        }
      }
    },
    "settings.tabUnloading": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
