          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать видео этой вкладки поверх других окон"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати відео цієї вкладки над іншими вікнами"
          }
        },
