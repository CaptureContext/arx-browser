    "automation.uploadWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite erhält diese Dateien von deinem Mac und kann sie überallhin senden. Arx fragt jedes Mal nach, unabhängig von der Freigabeeinstellung dieses Clients."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page will receive these files from your Mac and can send them anywhere. Arx asks every time, whatever this client's approval setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página recibirá estos archivos de tu Mac y puede enviarlos a cualquier sitio. Arx pregunta siempre, sea cual sea el ajuste de aprobación de este cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page recevra ces fichiers de votre Mac et pourra les envoyer n’importe où. Arx demande à chaque fois, quel que soit le réglage d’approbation de ce client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページはMacからこれらのファイルを受け取り、任意の場所に送信できます。このクライアントの承認設定にかかわらず、Arxは毎回確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona otrzyma te pliki z Twojego Maca i może je wysłać dokądkolwiek. Arx pyta za każdym razem, niezależnie od ustawienia zatwierdzania tego klienta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница получит эти файлы с Вашего Mac и сможет отправить их куда угодно. Arx спрашивает каждый раз, независимо от настройки подтверждения для этого клиента."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінка отримає ці файли з вашого Mac і зможе надіслати їх куди завгодно. Arx питає щоразу, незалежно від параметра підтвердження цього клієнта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页将收到来自你 Mac 的这些文件，并可将它们发送到任何地方。无论此客户端的批准设置如何，Arx 每次都会询问。"
          }
        }
      }
    },
    "automation.uploadCancel": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der von der Seite geöffnete Dateiauswahldialog abgebrochen; es wird keine Datei gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cancels the file chooser the page opened; no file is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cancela el selector de archivos que ha abierto la página; no se envía ningún archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela annule le sélecteur de fichiers ouvert par la page ; aucun fichier n’est envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページが開いたファイル選択をキャンセルします。ファイルは送信されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To anuluje okno wyboru plików otwarte przez stronę; żaden plik nie zostanie wysłany."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это отменяет окно выбора файлов, которое открыла страница; файлы не отправляются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це скасовує вибір файлів, який відкрила сторінка; жоден файл не надсилається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会取消网页打开的文件选择器；不会发送任何文件。"
          }
        }
      }
    },
