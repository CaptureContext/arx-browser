    "settings.iCloudSync.archiveDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Mac archivierte Tabs erscheinen im Tab-Archiv desselben Profils auf deinen anderen Macs. Wenn du einen wiederherstellst, bleibt er auf den anderen erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs archived on one Mac, in the same profile’s Tab Archive on your other Macs. Restoring one keeps it on the others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas archivadas en un Mac aparecen en las pestañas archivadas del mismo perfil en tus otros Mac. Al restaurar una, se conserva en los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets archivés sur un Mac apparaissent dans les onglets archivés du même profil sur vos autres Mac. En restaurer un le conserve sur les autres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あるMacでアーカイブしたタブは、ほかのMacの同じプロファイルのタブアーカイブに表示されます。復元しても、ほかのMacには残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty zarchiwizowane na jednym Macu trafiają do Archiwum kart tego samego profilu na Twoich pozostałych komputerach Mac. Przywrócenie jednej zachowuje ją na pozostałych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки, архивированные на одном Mac, попадают в архив вкладок того же профиля на Ваших других компьютерах Mac. Восстановление одной вкладки сохраняет ее на других."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки, архівовані на одному Mac, потрапляють в архів вкладок того самого профілю на інших ваших Mac. Відновлення вкладки зберігає її на інших."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一台 Mac 上归档的标签页，会出现在你其他 Mac 上同一用户场景的标签页归档中。恢复其中一个后，它会在其他 Mac 上保留。"
          }
        }
      }
    },
