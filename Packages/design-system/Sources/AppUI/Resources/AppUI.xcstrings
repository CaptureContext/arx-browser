    "reportProblem.opened": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx hat deinen Bericht als „%@“ gesichert und im Finder ausgewählt. Ziehe ihn in das Problem, das in einem neuen Tab geöffnet wurde. Er befindet sich in diesem Ordner:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx saved your report as “%@” and selected it in Finder. Drag it into the issue that opened in a new tab. It's in this folder:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx ha guardado tu informe como “%@” y lo ha seleccionado en el Finder. Arrástralo a la incidencia que se ha abierto en una pestaña nueva. Está en esta carpeta:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx a enregistré votre signalement sous « %@ » et l’a sélectionné dans le Finder. Faites-le glisser dans le ticket ouvert dans un nouvel onglet. Il se trouve dans ce dossier :"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxはレポートを「%@」として保存し、Finderで選択状態にしました。新規タブで開いたIssueに、ドラッグして追加してください。ファイルはこのフォルダにあります："
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx zachował Twój raport jako „%@” i zaznaczył go w Finderze. Przeciągnij go do zgłoszenia, które otworzyło się w nowej karcie. Znajduje się w tym folderze:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx сохранил Ваш отчет как «%@» и выбрал его в Finder. Перетащите его в обращение, открывшееся в новой вкладке. Он находится в этой папке:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx зберіг ваш звіт як «%@» і вибрав його у Finder. Перетягніть його в повідомлення, що відкрилося в новій вкладці. Він у цій папці:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 已将你的报告存储为“%@”，并在访达中将其选中。请将它拖移到在新标签页中打开的问题里。它位于此文件夹中："
          }
        }
      }
    },
    "reportProblem.openedWithoutFile": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
