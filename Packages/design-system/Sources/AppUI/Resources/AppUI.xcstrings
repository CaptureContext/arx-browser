    "settings.identity.member.explanation": {
      "comment": "Shown above Get your member number in Settings › Arx, before any sign-in opens. \"it\" is the account.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx bittet Apple nur darum, deinen Account zu bestätigen, ohne deinen Namen oder deine E-Mail-Adresse. Der Server von Arx speichert nur einen Hash davon und den Tag, an dem Arx auf diesem Mac installiert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx asks Apple only to confirm your account, without your name or email. Arx's server keeps only a hash of it, and the day Arx was installed on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx solo pide a Apple que confirme tu cuenta, sin tu nombre ni tu correo. El servidor de Arx solo guarda un hash de ella y el día en que se instaló Arx en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx demande à Apple uniquement de confirmer votre compte, sans votre nom ni votre e-mail. Le serveur d’Arx n’en conserve qu’un hash, ainsi que le jour où Arx a été installé sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ArxはAppleにアカウントの確認だけを依頼し、名前やメールアドレスは求めません。Arxのサーバには、そのハッシュと、このMacにArxがインストールされた日だけが保存されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx prosi Apple tylko o potwierdzenie konta, bez imienia i adresu e-mail. Serwer Arx zachowuje tylko jego skrót oraz dzień zainstalowania Arx na tym Macu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx просит Apple только подтвердить Вашу учетную запись, без имени и адреса электронной почты. Сервер Arx хранит лишь ее хеш и день установки Arx на этот Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx просить Apple лише підтвердити ваш обліковий запис, без імені чи адреси е-пошти. Сервер Arx зберігає лише його хеш і день встановлення Arx на цей Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 只会请 Apple 确认你的账户，不会获取你的姓名或电子邮件。Arx 的服务器只保存该账户的哈希值，以及 Arx 在这台 Mac 上安装的日期。"
          }
        }
      }
    },
