    "chat.failureTurnLimitDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent ist für schnelle Aufgaben gedacht. Versuche eine kleinere Anfrage oder verwende für größere Aufgaben eine vollständige Agent-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant is for quick tasks. Try a smaller request, or use a full agent app for bigger jobs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente es para tareas rápidas. Prueba con una petición más pequeña o usa una app de agente completa para trabajos más grandes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant est conçu pour les tâches rapides. Essayez une demande plus petite, ou utilisez une app d’agent complète pour les tâches plus importantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントは簡単な作業向けです。リクエストを小さくするか、大きな作業にはフル機能のエージェントAppを使用してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent służy do szybkich zadań. Spróbuj mniejszej prośby albo użyj pełnej aplikacji agenta do większych zadań."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент предназначен для быстрых задач. Попробуйте более небольшой запрос или используйте полноценное приложение-агент для крупных задач."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент призначений для швидких завдань. Спробуйте менший запит або скористайтеся повноцінною програмою-агентом для більших завдань."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理适合处理快速任务。请尝试较小的请求，或使用完整的智能体 App 处理较大的任务。"
          }
        }
      }
    },
