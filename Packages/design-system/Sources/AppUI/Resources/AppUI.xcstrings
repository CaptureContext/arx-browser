    "settings.batterySaverExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlangsamt und friert Tabs im Hintergrund ein, damit der Akku länger hält. Der Stromsparmodus aktiviert ihn ebenfalls, außer er ist auf „Nie“ eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slows and freezes background tabs to make the battery last. Low Power Mode turns it on too, unless it’s set to Never."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralentiza y congela las pestañas en segundo plano para que la batería dure más. El modo Bajo consumo también lo activa, salvo que esté en Nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralentit et fige les onglets en arrière-plan pour prolonger l’autonomie. Le mode économie d’énergie l’active aussi, sauf s’il est réglé sur Jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーを長持ちさせるため、バックグラウンドのタブを低速化または停止します。「しない」に設定していない限り、低電力モードでもオンになります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowalnia i zamraża karty w tle, aby bateria działała dłużej. Włącza je też tryb niskiego zużycia energii, chyba że ustawiono Nigdy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замедляет и замораживает фоновые вкладки, чтобы батарея работала дольше. Режим энергосбережения macOS тоже включает его, если не выбрано «Никогда»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уповільнює й заморожує фонові вкладки, щоб батарея працювала довше. Режим економії заряду теж вмикає його, якщо не вибрано «Ніколи»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减慢并冻结后台标签页，以延长电池使用时间。低电量模式也会将其打开，除非设为“永不”。"
          }
        }
      }
    },
