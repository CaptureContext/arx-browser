    "chat.settingsReturnKeyDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umschalt-Zeilenschalter beginnt immer eine neue Zeile und ⌘-Zeilenschalter sendet immer. „Einzeiler senden“ sendet mit dem Zeilenschalter, bis die Nachricht mehrere Zeilen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-Return always starts a new line and ⌘Return always sends. Send one-liners sends with Return until the message has several lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayúsculas-Retorno siempre inicia una línea nueva y ⌘Retorno siempre envía. Enviar mensajes de una línea envía con Retorno hasta que el mensaje tiene varias líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maj-Retour commence toujours une nouvelle ligne et ⌘Retour envoie toujours. « Envoyer les messages d’une ligne » envoie avec Retour tant que le message ne comporte qu’une ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift＋Returnは常に改行し、⌘Returnは常に送信します。「1行のみ送信」では、メッセージが複数行になるまでReturnキーで送信します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-Return zawsze zaczyna nowy wiersz, a ⌘Return zawsze wysyła. „Wysyłaj jednowierszowe” wysyła klawiszem Return, dopóki wiadomość nie ma kilku wierszy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-Return всегда начинает новую строку, а ⌘Return всегда отправляет. «Отправлять однострочные» отправляет по Return, пока в сообщении не появится несколько строк."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-Return завжди починає новий рядок, а ⌘Return завжди надсилає. «Надсилати однорядкові» надсилає за Return, доки повідомлення не матиме кілька рядків."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-Return 始终换行，⌘Return 始终发送。“发送单行消息”会用 Return 发送，直到消息变成多行。"
          }
        }
      }
    },
