          }
        }
      }
    },
    "settings.iCloudSync.stop.confirmTitle": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung für diesen Mac stoppen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop syncing this Mac?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dejar de sincronizar este Mac?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la synchronisation de ce Mac ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの同期を停止しますか？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymać synchronizację tego Maca?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить синхронизацию этого Mac?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Припинити синхронізацію цього Mac?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止同步这台 Mac 吗？"
          }
        }
      }
    },
    "settings.iCloudSync.stop.message": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac behält alle seine Daten und erhält keine Änderungen deiner anderen Macs mehr, und diese behalten ihre. Wenn du die Synchronisierung wieder aktivierst, werden die Daten dieses Macs mit denen aus iCloud zusammengeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac keeps all its data and stops getting your other Macs’ changes, and they keep theirs. Turning sync on again merges this Mac’s data with iCloud’s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac conserva todos sus datos y deja de recibir los cambios de tus otros Mac, que conservan los suyos. Al volver a activar la sincronización, se fusionan los datos de este Mac con los de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac conserve toutes ses données et ne reçoit plus les modifications de vos autres Mac, qui conservent les leurs. Réactiver la synchronisation fusionne les données de ce Mac avec celles d’iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはすべてのデータを保持し、ほかのMacの変更を受け取らなくなります。ほかのMacも自分のデータを保持します。同期を再びオンにすると、このMacのデータがiCloudのデータと統合されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac zachowuje wszystkie swoje dane i przestaje otrzymywać zmiany z Twoich pozostałych Maców, a one zachowują swoje. Ponowne włączenie synchronizacji scala dane tego Maca z danymi z iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac сохранит все свои данные и перестанет получать изменения с Ваших других компьютеров Mac, а они сохранят свои. При повторном включении синхронизации данные этого Mac будут объединены с данными iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac зберігає всі свої дані й більше не отримує змін з інших ваших Mac, а вони зберігають свої. Після повторного ввімкнення синхронізації дані цього Mac обʼєднаються з даними iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 会保留其所有数据，并停止获取你其他 Mac 的更改，其他 Mac 也会保留各自的数据。再次打开同步会将这台 Mac 的数据与 iCloud 的数据合并。"
          }
        }
      }
    },
    "settings.iCloudSync.stop.confirm": {
