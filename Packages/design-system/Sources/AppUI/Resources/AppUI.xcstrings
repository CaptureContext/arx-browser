    "onboarding.iCloud.slow": {
      "comment": "Onboarding, Sync with iCloud page: shown once the first fetch has run about 20 seconds. %@ is the line for the part being fetched, such as “Bringing history…”.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Du kannst fortfahren; die Synchronisierung wird im Hintergrund abgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ You can continue; sync finishes in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Puedes continuar; la sincronización termina en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vous pouvez continuer ; la synchronisation se termine en arrière-plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ このまま続けられます。同期はバックグラウンドで完了します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Możesz kontynuować; synchronizacja zakończy się w tle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Можно продолжить: синхронизация завершится в фоновом режиме."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Можна продовжити; синхронізація завершиться у фоновому режимі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 你可以继续；同步会在后台完成。"
          }
        }
      }
    },
