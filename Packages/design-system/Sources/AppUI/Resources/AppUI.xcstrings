    "history.changedOnDisk": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf wurde außerhalb von Arx geändert. Seine Datei wurde beibehalten. Öffne Arx erneut, um sie neu zu laden, oder lösche den Verlauf dieses Profils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History changed outside Arx. Its file has been preserved. Reopen Arx to reload it, or clear this profile’s history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial ha cambiado fuera de Arx. Se ha conservado su archivo. Vuelve a abrir Arx para cargarlo de nuevo o borra el historial de este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique a été modifié en dehors d’Arx. Son fichier a été conservé. Rouvrez Arx pour le recharger, ou effacez l’historique de ce profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴がArxの外部で変更されました。ファイルは保持されています。Arxを開き直して読み込み直すか、このプロファイルの履歴を消去してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia zmieniła się poza Arx. Jej plik został zachowany. Otwórz Arx ponownie, aby ją wczytać, lub wymaż historię tego profilu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История изменена за пределами Arx. Ее файл сохранен. Заново откройте Arx, чтобы загрузить ее, или очистите историю этого профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історію змінено поза Arx. Її файл збережено. Знову відкрийте Arx, щоб перезавантажити його, або очистьте історію цього профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录在 Arx 之外被更改。其文件已保留。请重新打开 Arx 以重新加载，或清除此用户场景的历史记录。"
          }
        }
      }
    },
    "history.clear": {
      "extractionState": "manual",
      "generatesSymbol": false,
