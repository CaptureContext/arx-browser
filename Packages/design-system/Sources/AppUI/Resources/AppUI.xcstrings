    "migration.clearFooter": {
      "comment": "Import (Customize): the footer under Clear Arx data first.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit einem sauberen Arx: Jedes importierte Profil wird zu einem neuen Arx-Profil. Du siehst vorher, was entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from a clean Arx: each imported profile becomes a fresh Arx profile. You'll see what gets removed first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con un Arx limpio: cada perfil importado se convierte en un perfil de Arx nuevo. Antes verás qué se elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartez d’un Arx vierge : chaque profil importé devient un nouveau profil Arx. Vous verrez d’abord ce qui sera supprimé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンな状態のArxから始めます。読み込む各プロファイルは、新しいArxのプロファイルになります。最初に、削除される内容が表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od czystego Arx: każdy zaimportowany profil staje się nowym profilem Arx. Najpierw zobaczysz, co zostanie usunięte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с чистого Arx: каждый импортированный профиль станет новым профилем Arx. Сначала Вы увидите, что будет удалено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть із чистого Arx: кожен імпортований профіль стає новим профілем Arx. Спершу ви побачите, що буде вилучено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
