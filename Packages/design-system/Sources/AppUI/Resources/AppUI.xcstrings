    "translation.unsupported": {
      "comment": "Translation failed: macOS's translation doesn't support the page's language. %@ is a language's name as macOS gives it in the interface language (“French”, „Französisch“); it is inserted as it is and can't be declined, hence the label and colon.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac kann aus dieser Sprache nicht übersetzen: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
