    "settings.iCloudSync.merge.profilesMessage": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erste in der Profilauswahl bleibt erhalten. Deine anderen Macs bewegen ihre geöffneten Tabs ebenfalls dorthin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first one in the profile switcher stays. Your other Macs move their open tabs to it too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva el primero del selector de perfiles. Tus otros Mac también trasladan a él sus pestañas abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier du sélecteur de profil est conservé. Vos autres Mac y déplacent aussi leurs onglets ouverts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルスイッチャで最初のものが残ります。ほかのMacでも、開いているタブがそのプロファイルに移動します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy na liście w przełączniku profili zostaje. Twoje pozostałe komputery Mac przenoszą do niego również swoje otwarte karty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останется первый в списке переключателя профилей. Ваши другие компьютеры Mac тоже переместят в него свои открытые вкладки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається перший у перемикачі профілів. Інші ваші Mac теж перенесуть до нього свої відкриті вкладки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户场景切换器中的第一个会保留。你其他 Mac 也会将其已打开的标签页移到该用户场景。"
          }
        }
      }
    },
