    "webKitPrompt.unavailableMessage": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite gibt geschütztes Video oder geschützte Musik wieder, was die Chromium-Seiten von Arx nicht können. Um sie in Arx wiederzugeben, aktiviere WebKit-Seiten unter Einstellungen › Erweitert › WebKit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page plays protected video or music, which Arx's Chromium pages can't play. To play it in Arx, turn on WebKit pages in Settings › Advanced › WebKit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página reproduce vídeo o música protegidos, que las páginas de Chromium de Arx no pueden reproducir. Para reproducirlos en Arx, activa las páginas de WebKit en Ajustes › Avanzado › WebKit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page lit une vidéo ou une musique protégée, que les pages Chromium d’Arx ne peuvent pas lire. Pour la lire dans Arx, activez les pages WebKit dans Réglages › Avancés › WebKit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページは、ArxのChromiumページでは再生できない、保護されたビデオまたは音楽を再生します。Arxで再生するには、「設定」＞「詳細」＞「WebKit」でWebKitページをオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strona odtwarza chronione wideo lub muzykę, których nie mogą odtwarzać strony Chromium w Arx. Aby odtworzyć je w Arx, włącz strony WebKit w Ustawieniach › Zaawansowane › WebKit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница воспроизводит защищенное видео или музыку, которые страницы Arx на основе Chromium воспроизвести не могут. Чтобы воспроизвести их в Arx, включите страницы WebKit в «Настройки › Дополнения › WebKit»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця сторінка відтворює захищене відео або музику, які сторінки Arx на Chromium не можуть відтворити. Щоб відтворити їх в Arx, увімкніть сторінки WebKit у розділі «Параметри › Експертні › WebKit»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面播放受保护的视频或音乐，而 Arx 的 Chromium 页面无法播放。若要在 Arx 中播放，请在“设置”>“高级”>“WebKit”中打开 WebKit 页面。"
          }
        }
      }
    },
