    "chat.deleteDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chat und das, was %@ dafür auf diesem Mac gesichert hat, werden entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat and what %@ kept on this Mac for it are removed. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan el chat y lo que %@ ha guardado en este Mac para él. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La discussion et ce que %@ a conservé pour elle sur ce Mac sont supprimés. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットと、%@がこのMacに保持しているそのチャットのデータが削除されます。この操作は取り消せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat i to, co %@ zachował dla niego na tym Macu, zostaną usunięte. Tej czynności nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат и данные, которые %@ сохранил для него на этом Mac, будут удалены. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат і все, що %@ зберіг для нього на цьому Mac, буде вилучено. Цю дію не можна відмінити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天内容以及 %@ 在这台 Mac 上为其保留的内容都会被移除。此操作无法撤销。"
          }
        }
      }
    },
