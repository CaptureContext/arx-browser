            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Schlüsselwort aus der Bang-Liste von Helium (Kagi Search und imput, MIT-Lizenz). Es funktioniert offline mit vorangestelltem !, kann nicht bearbeitet werden, und deine eigenen Kürzel haben Vorrang."
                }
              },
              "other": {
                "stringUnit": {
