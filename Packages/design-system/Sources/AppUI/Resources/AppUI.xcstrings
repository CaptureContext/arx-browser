    "settings.iCloudSync.group.shortcutsDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturkurzbefehle und Aliasse von Befehlen und ob die Löschtaste eine leere Befehlsleiste schließt. Bei „Aus“ bleibt es bei den Werten dieses Macs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands’ shortcuts and aliases, and whether Delete closes an empty command bar. Off keeps this Mac’s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos y alias de los comandos, y si Suprimir cierra una barra de comandos vacía. Si se desactiva, se conservan los de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis et alias des commandes, et le choix de fermer la barre de commandes vide avec Supprimer. Désactivé, conserve ceux de ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドのショートカットとエイリアス、および空のコマンドバーをDeleteキーで閉じるかどうか。オフにすると、このMacの設定が保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty klawiszowe i aliasy poleceń oraz to, czy Delete zamyka pusty pasek poleceń. Po wyłączeniu zostają ustawienia tego Maca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания клавиш и псевдонимы команд, а также закрытие пустой панели команд клавишей Delete. Если выключено, остаются настройки этого Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорочення й псевдоніми команд, а також чи закриває Delete порожню панель команд. Якщо вимкнено, залишаються параметри цього Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令的快捷键和别名，以及按下 Delete 键是否关闭空的命令栏。关闭则保留这台 Mac 上的设置。"
          }
        }
      }
    },
