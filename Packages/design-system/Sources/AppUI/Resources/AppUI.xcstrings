    "autofill.removeNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur aus diesem Profil entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed from this profile only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina de este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est supprimé de ce profil uniquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルからのみ削除されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięte tylko z tego profilu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет удален только из этого профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його буде вилучено лише з цього профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅会从此用户场景中移除。"
          }
        }
      }
    },
    "autofill.unavailable": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen und Karten sind für dieses Profil derzeit nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Addresses and cards aren't available for this profile right now."
