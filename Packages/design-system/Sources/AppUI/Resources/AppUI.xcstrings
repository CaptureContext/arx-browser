    "media.presentInTabPictureSubtitle": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video dieses Tabs über anderen Fenstern schweben lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Float this tab's video above other windows"
          }
        },
        "es": {
