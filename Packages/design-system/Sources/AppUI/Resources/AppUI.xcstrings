    "extensions.unpackedScope": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwicklermodus: Ein entpackter Ordner wird nur in dieses Profil geladen. „Neu laden“ liest ihn nach dem Bearbeiten erneut ein. Beim Ausschalten des Entwicklermodus bleiben geladene Erweiterungen erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer mode: an unpacked folder loads into this profile only. Reload rereads it after you edit it. Turning developer mode off keeps loaded extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de desarrollador: una carpeta descomprimida se carga solo en este perfil. Volver a cargar la lee de nuevo tras editarla. Al desactivar el modo de desarrollador se conservan las extensiones cargadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode développeur : un dossier non empaqueté n’est chargé que dans ce profil. Recharger le relit après modification. Désactiver le mode développeur conserve les extensions chargées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デベロッパモード：パッケージ化されていないフォルダは、このプロファイルにのみ読み込まれます。編集したあとに再読み込みすると、再び読み込まれます。デベロッパモードをオフにしても、読み込んだ機能拡張は残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb dewelopera: rozpakowany folder jest wczytywany tylko do tego profilu. Odświeżenie odczytuje go ponownie po edycji. Wyłączenie trybu dewelopera nie usuwa wczytanych rozszerzeń."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим разработчика: распакованная папка загружается только в этот профиль. Перезагрузка заново считывает ее после изменений. Если выключить режим разработчика, загруженные расширения останутся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим розробника: нерозпакована папка завантажується лише в цей профіль. Перезавантаження перечитує її після редагування. Вимкнення режиму розробника зберігає завантажені розширення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者模式：已解压的文件夹只会加载到此用户场景中。编辑后，“重新加载”会再次读取它。关闭开发者模式后，已加载的扩展会保留。"
          }
        }
      }
    },
    "extensions.directoryMissing": {
