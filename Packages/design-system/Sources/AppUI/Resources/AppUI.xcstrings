    "settings.shortcutsDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weise einem Befehl einen Tastaturkurzbefehl oder einen Alias zu, mit dem du ihn in der Befehlsleiste findest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a command a keyboard shortcut, or an alias that finds it in the command bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna a un comando un atajo de teclado, o un alias que lo encuentre en la barra de comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez à une commande un raccourci clavier, ou un alias qui permet de la trouver dans la barre de commandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドにキーボードショートカット、またはコマンドバーでそのコマンドを見つけるためのエイリアスを設定します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj poleceniu skrót klawiszowy lub alias, który znajduje je na pasku poleceń."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте команде сочетание клавиш или псевдоним, по которому ее можно найти в панели команд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначте команді клавіатурне скорочення або псевдонім, за яким її можна знайти на панелі команд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为命令指定键盘快捷键，或指定可在命令栏中找到它的别名。"
