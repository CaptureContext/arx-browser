    "sendFeedback.failure.unavailable": {
      "comment": "Send Feedback card: the server is down or couldn't file the report.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server von Arx konnte den Bericht gerade nicht annehmen. Versuche es später erneut; dein Bericht bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx's server couldn't take the report right now. Try again later; your report is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de Arx no ha podido recibir el informe ahora. Inténtalo más tarde; tu informe se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur d’Arx n’a pas pu recevoir le rapport pour le moment. Réessayez plus tard ; votre rapport est conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxのサーバが現在レポートを受け付けられません。後でもう一度お試しください。レポートは保存されています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer Arx nie mógł teraz przyjąć zgłoszenia. Spróbuj ponownie później; zgłoszenie zostało zachowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Arx сейчас не может принять отчет. Повторите попытку позже; Ваш отчет сохранен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Arx зараз не може прийняти звіт. Спробуйте пізніше; ваш звіт збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 的服务器暂时无法接收该报告。请稍后再试；你的报告已保留。"
          }
        }
      }
    },
