    "sendFeedback.failure.fileTooLarge": {
      "comment": "Send Feedback card: a file, even made smaller, doesn't fit. %1$@ is the file's name, %2$@ the files' total size with it, %3$@ the limit, such as “4 MB”.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „%1$@“ ergeben die Dateien %2$@ und überschreiten damit das Limit von %3$@. Lass eine weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With “%1$@”, the files come to %2$@, over the limit of %3$@. Leave one out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con “%1$@”, los archivos suman %2$@, por encima del límite de %3$@. Deja uno fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « %1$@ », les fichiers atteignent %2$@, au-delà de la limite de %3$@. Retirez-en un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を含めると、ファイルの合計が%2$@になり、上限の%3$@を超えます。ファイルを1つ減らしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razem z „%1$@” pliki mają %2$@, co przekracza limit %3$@. Pomiń jeden z nich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с файлом «%1$@» общий размер файлов составляет %2$@, что превышает предел в %3$@. Исключите один из файлов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З файлом «%1$@» загальний розмір файлів становить %2$@, що перевищує ліміт %3$@. Не додавайте один із файлів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加上“%1$@”后，文件总大小为 %2$@，超过了 %3$@ 的限制。请去掉一个文件。"
          }
        }
      }
    },
    "sendFeedback.failure.invalidEmail": {
      "comment": "Send Feedback card: shown when the optional email isn't an address.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse scheint nicht zu stimmen. Prüfe sie oder lass das Feld leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email address doesn't look right. Check it, or leave the field empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa dirección de correo no parece correcta. Revísala o deja el campo vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail semble incorrecte. Vérifiez-la ou laissez le champ vide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスが正しくないようです。確認するか、入力欄を空にしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten adres e-mail wygląda niepoprawnie. Sprawdź go lub zostaw pole puste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес электронной почты указан неверно. Проверьте его или оставьте поле пустым."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, адреса е-пошти неправильна. Перевірте її або залиште поле порожнім."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该电子邮件地址似乎不正确。请检查，或将此栏留空。"
          }
        }
      }
    },
    "sendFeedback.failure.offline": {
      "comment": "Send Feedback card: the report didn't go because there's no connection.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx konnte seinen Server nicht erreichen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx couldn't reach its server. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx no ha podido conectar con su servidor. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx n’a pas pu joindre son serveur. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxのサーバに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie mógł połączyć się ze swoim serwerem. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к серверу Arx. Проверьте подключение и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не вдалося звʼязатися зі своїм сервером. Перевірте зʼєднання й спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 无法连接其服务器。请检查网络连接，然后重试。"
          }
        }
      }
    },
    "sendFeedback.failure.refused": {
      "comment": "Send Feedback card: the server refused the form, likely an outdated app.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server von Arx hat den Bericht nicht akzeptiert. Aktualisiere Arx und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx's server didn't accept the report. Update Arx and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de Arx no ha aceptado el informe. Actualiza Arx e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur d’Arx n’a pas accepté le rapport. Mettez à jour Arx et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxのサーバがレポートを受け付けませんでした。Arxをアップデートして、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer Arx nie przyjął zgłoszenia. Zaktualizuj Arx i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Arx не принял отчет. Обновите Arx и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Arx не прийняв звіт. Оновіть Arx і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 的服务器未接受该报告。请更新 Arx，然后重试。"
          }
        }
      }
    },
    "sendFeedback.failure.tooLarge": {
      "comment": "Send Feedback card: the server refused the report's size or a file's type.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht ist zu groß. Lass eine Datei weg und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report is too large. Leave a file out and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe es demasiado grande. Deja un archivo fuera e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport est trop volumineux. Retirez un fichier et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートが大きすぎます。ファイルを減らして、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszenie jest zbyt duże. Pomiń plik i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчет слишком большой. Исключите один из файлов и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звіт завеликий. Не додавайте один із файлів і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告太大。请去掉一个文件，然后重试。"
          }
        }
      }
    },
    "sendFeedback.failure.tooMany": {
      "comment": "Send Feedback card: the server's rate limit refused the report.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast in kurzer Zeit mehrere Berichte gesendet. Versuche es in einer Stunde erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've sent several reports in a short time. Try again in an hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has enviado varios informes en poco tiempo. Inténtalo de nuevo dentro de una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez envoyé plusieurs rapports en peu de temps. Réessayez dans une heure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間に何件ものレポートが送信されました。1時間後にもう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W krótkim czasie wysłano kilka zgłoszeń. Spróbuj ponownie za godzinę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отправили несколько отчетов за короткое время. Повторите попытку через час."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви надіслали кілька звітів за короткий час. Спробуйте ще раз за годину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在短时间内发送了多份报告。请一小时后再试。"
          }
        }
      }
    },
