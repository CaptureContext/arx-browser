    "management.removeSpaceDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Raum, seine Ordner sowie seine fixierten und normalen Tabs löschen? Favoriten des Profils und Website-Daten bleiben erhalten. Seiten mit nicht gesicherten Änderungen können den Vorgang abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this space, its folders, and its pinned and regular tabs? Profile favorites and website data are kept. Pages with unsaved changes can cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta sección, sus carpetas y sus pestañas ancladas y normales? Los favoritos del perfil y los datos de sitios web se conservan. Las páginas con cambios sin guardar pueden cancelar la acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette section, ses dossiers, ainsi que ses onglets épinglés et ordinaires ? Les favoris du profil et les données de sites web sont conservés. Les pages contenant des modifications non enregistrées peuvent annuler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスペースと、そのフォルダ、固定タブ、通常のタブを削除しますか？プロファイルのお気に入りとウェブサイトデータは保持されます。保存されていない変更があるページは、キャンセルできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć tę strefę, jej foldery oraz przypięte i zwykłe karty? Ulubione profilu i dane witryn zostają. Strony z niezachowanymi zmianami mogą anulować."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот раздел, его папки, а также закрепленные и обычные вкладки? Избранное профиля и данные веб-сайтов сохраняются. Страницы с несохраненными изменениями могут отменить удаление."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей розділ, його папки, а також закріплені та звичайні вкладки? Улюблені профілю та дані вебсайтів зберігаються. Сторінки з незбереженими змінами можуть скасувати дію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除此分区及其文件夹、固定的标签页和普通标签页吗？用户场景的个人收藏和网站数据会保留。有未存储更改的页面可以取消。"
          }
        }
      }
    },
