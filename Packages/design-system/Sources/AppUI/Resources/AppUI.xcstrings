    "viewer.localServerUnreachable": {
      "comment": "A localhost or loopback page refused the connection. The argument is the port.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Port %lld dieses Macs läuft nichts. Starte deinen Entwicklungsserver und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is running on port %lld of this Mac. Start your development server, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se está ejecutando nada en el puerto %lld de este Mac. Inicia tu servidor de desarrollo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s’exécute sur le port %lld de ce Mac. Démarrez votre serveur de développement, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのポート%lldでは何も実行されていません。開発サーバを起動してから、再試行してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie działa na porcie %lld tego Maca. Uruchom swój serwer deweloperski, a następnie spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На порту %lld этого Mac ничего не запущено. Запустите сервер разработки и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На порту %lld цього Mac нічого не запущено. Запустіть свій сервер розробки й повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的 %lld 端口上没有任何程序在运行。请启动你的开发服务器，然后重试。"
          }
        }
      }
    },
    "viewer.localCertificateRejected": {
      "comment": "A localhost or loopback page failed certificate validation. Arx never offers to bypass it.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Zertifikat dieses lokalen Servers wird nicht vertraut. Verwende http:// auf localhost oder vertraue deinem Entwicklungszertifikat in der Schlüsselbundverwaltung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local server’s certificate isn’t trusted. Use http:// on localhost, or trust your development certificate in Keychain Access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado de este servidor local no es de confianza. Usa http:// en localhost o confía en tu certificado de desarrollo en Acceso a Llaveros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de ce serveur local n’est pas approuvé. Utilisez http:// sur localhost, ou approuvez votre certificat de développement dans Trousseaux d’accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルサーバの証明書は信頼されていません。localhostではhttp://を使用するか、キーチェーンアクセスで開発用の証明書を信頼してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Certyfikat tego lokalnego serwera nie jest zaufany. Użyj http:// na localhost lub zaufaj swojemu certyfikatowi deweloperskiemu w Dostępie do pęku kluczy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат этого локального сервера не является доверенным. Используйте http:// на localhost или добавьте свой сертификат разработчика в доверенные в приложении «Связка ключей»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертифікат цього локального сервера не є надійним. Використайте http:// на localhost або додайте свій сертифікат розробки до довірених у програмі «Ключар»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此本地服务器的证书不受信任。请在 localhost 上使用 http://，或在“钥匙串访问”中信任你的开发证书。"
          }
        }
      }
    },
    "viewer.localServerWithoutEncryption": {
      "comment": "A localhost or loopback https:// page failed its TLS handshake, usually because the development server speaks plain HTTP.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser lokale Server hat nicht über HTTPS geantwortet. Er liefert wahrscheinlich reines HTTP aus, versuche es daher mit der http://-Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local server didn’t answer over HTTPS. It probably serves plain HTTP, so try the http:// address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor local no ha respondido por HTTPS. Probablemente sirve HTTP sin cifrar, así que prueba con la dirección http://."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur local n’a pas répondu en HTTPS. Il sert probablement du HTTP simple ; essayez l’adresse en http://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルサーバはHTTPSで応答しませんでした。通常のHTTPで提供している可能性があるため、http://のアドレスを試してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten lokalny serwer nie odpowiedział przez HTTPS. Prawdopodobnie udostępnia zwykły HTTP, więc spróbuj adresu http://."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот локальный сервер не ответил по HTTPS. Вероятно, он работает по обычному HTTP, поэтому попробуйте адрес http://."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей локальний сервер не відповів через HTTPS. Імовірно, він працює через звичайний HTTP, тож спробуйте адресу http://."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此本地服务器没有通过 HTTPS 响应。它可能提供的是普通 HTTP，请尝试 http:// 地址。"
          }
        }
      }
    },
