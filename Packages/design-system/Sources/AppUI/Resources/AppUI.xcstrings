    "settings.iCloudSync.group.searchEnginesDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suchmaschine jedes Profils folgt der eigenen Synchronisierung dieses Profils. Bei „Aus“ bleibt es bei den Werten dieses Macs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each profile’s search engine follows that profile’s own sync. Off keeps this Mac’s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El buscador de cada perfil sigue la sincronización de ese perfil. Si se desactiva, se conserva el de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de recherche de chaque profil suit la synchronisation propre à ce profil. Désactivé, conserve celui de ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プロファイルの検索エンジンは、そのプロファイル自身の同期に従います。オフにすると、このMacの設定が保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwarka każdego profilu podlega synchronizacji tego profilu. Po wyłączeniu zostają ustawienia tego Maca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поисковая система каждого профиля следует синхронизации этого профиля. Если выключено, остаются настройки этого Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошукова система кожного профілю синхронізується разом із самим профілем. Якщо вимкнено, залишаються параметри цього Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个用户场景的搜索引擎遵循该用户场景自己的同步设置。关闭则保留这台 Mac 上的设置。"
          }
        }
      }
    },
