    "appLinks.invalid.scheme": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schema ist ein Buchstabe gefolgt von Buchstaben, Ziffern, +, - oder . (RFC 3986), zum Beispiel claude. Lass :// weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A scheme is a letter followed by letters, digits, +, - or . (RFC 3986), such as claude. Leave out ://."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esquema es una letra seguida de letras, dígitos, +, - o . (RFC 3986), como claude. Omite ://."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un schéma est une lettre suivie de lettres, de chiffres, de +, - ou . (RFC 3986), par exemple claude. Omettez ://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキームは、英字に続けて英字、数字、+、-、.を使います（RFC 3986）（例：claude）。://は含めないでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schemat to litera, po której następują litery, cyfry, +, - lub . (RFC 3986), na przykład claude. Pomiń ://."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема — это буква, за которой следуют буквы, цифры, +, - или . (RFC 3986), например claude. Не добавляйте ://."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема — це літера, за якою йдуть літери, цифри, +, - або . (RFC 3986), наприклад claude. Без ://."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案是一个字母，后跟字母、数字、+、- 或 .（RFC 3986），例如 claude。不要包含 ://。"
          }
        }
      }
    },
    "appLinks.invalid.reservedScheme": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "http, https, file und andere Web-Schemata werden in Arx geöffnet und können daher keine App-Links sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "http, https, file and other web schemes open in Arx, so they can’t be app links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "http, https, file y otros esquemas web se abren en Arx, así que no pueden ser enlaces de apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les schémas http, https, file et les autres schémas web s’ouvrent dans Arx ; ils ne peuvent donc pas être des liens d’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http、https、fileなどのウェブ用スキームはArxで開くため、Appリンクにはできません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schematy http, https, file i inne schematy www otwierają się w Arx, więc nie mogą być łączami aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схемы http, https, file и другие веб-схемы открываются в Arx, поэтому не могут быть ссылками приложений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схеми http, https, file та інші вебсхеми відкриваються в Arx, тому не можуть бути посиланнями на програми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "http、https、file 和其他网页方案会在 Arx 中打开，因此不能用作 App 链接。"
          }
        }
      }
    },
    "appLinks.invalid.host": {
