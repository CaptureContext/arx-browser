    "automation.focusedTab": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehl für den fokussierten Tab erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the focused tab shortcut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir el atajo de la pestaña activa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le raccourci de l’onglet actif"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のタブのショートカットを許可"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwalaj na skrót aktywnej karty"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить сокращение «активная вкладка»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити скорочення «активна вкладка»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用“当前标签页”快捷方式"
          }
        }
      }
    },
    "automation.focusedTabNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt den Assistenten „den fokussierten Tab“ sagen, statt einen zu nennen. Arx wählt beim Ausführen des Tools den ausgewählten Tab des fokussierten Fensters, nur wenn deine Freigabe ihn abdeckt, und teilt dem Assistenten mit, welchen Tab es verwendet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the assistant say “the focused tab” instead of naming one. Arx picks the selected tab of the focused window when the tool runs, only if your grant covers it, and tells the assistant which tab it used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el asistente diga “la pestaña activa” en lugar de nombrar una. Arx elige la pestaña seleccionada de la ventana activa cuando se ejecuta la herramienta, solo si tu permiso la cubre, e indica al asistente qué pestaña ha usado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à l’assistant de dire « l’onglet actif » au lieu d’en nommer un. Arx choisit l’onglet sélectionné de la fenêtre active à l’exécution de l’outil, uniquement si votre autorisation le couvre, et indique à l’assistant quel onglet il a utilisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントがタブを指定する代わりに「フォーカス中のタブ」と指定できるようにします。ツールの実行時に、許可の範囲内であれば、Arxがフォーカス中のウインドウで選択されているタブを選び、使用したタブをアシスタントに伝えます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala asystentowi powiedzieć „aktywna karta” zamiast wskazywać konkretną. Arx wybiera zaznaczoną kartę aktywnego okna w chwili uruchomienia narzędzia, tylko jeśli obejmuje ją Twoja zgoda, i informuje asystenta, której karty użył."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет ассистенту сказать «активная вкладка», не называя ее. Arx выбирает выбранную вкладку активного окна при запуске инструмента, только если это входит в Ваше разрешение, и сообщает ассистенту, какую вкладку использовал."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дає асистентові змогу сказати «активна вкладка», не називаючи її. Arx вибирає вибрану вкладку активного вікна в момент виконання інструмента, лише якщо ваш дозвіл це охоплює, і повідомляє асистентові, яку вкладку використано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让助理可以说“当前标签页”，而无需指明具体标签页。工具运行时，Arx 会选取当前窗口中选中的标签页（仅当你的授权涵盖它时），并告知助理用的是哪个标签页。"
          }
        }
      }
    },
    "automation.manageBrowserNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet, navigiert, bewegt, fixiert, benennt um und schließt Tabs und Ordner und öffnet Peek und Little Arx."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens, navigates, moves, pins, renames and closes tabs and folders, and opens Peek and Little Arx."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre, navega, traslada, ancla, renombra y cierra pestañas y carpetas, y abre Peek y Little Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre, navigue, déplace, épingle, renomme et ferme des onglets et des dossiers, et ouvre Peek et Little Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブとフォルダを開く、移動する、固定する、名前を変更する、閉じる操作と、PeekおよびLittle Arxを開く操作を行います。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera, nawiguje, przenosi, przypina, zmienia nazwy i zamyka karty oraz foldery, a także otwiera Peek i Little Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает, переводит по ссылкам, перемещает, закрепляет, переименовывает и закрывает вкладки и папки, а также открывает Peek и Little Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває, переглядає, переміщує, закріплює, перейменовує та закриває вкладки й папки, а також відкриває Peek і Little Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开、导航、移动、固定、重新命名和关闭标签页与文件夹，并打开 Peek 和 Little Arx。"
          }
        }
      }
    },
