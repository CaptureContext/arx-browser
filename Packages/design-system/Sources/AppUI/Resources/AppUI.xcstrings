    "settings.widevineAnswerExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt Websites, die auf Widevine prüfen, mit, dass es vorhanden ist, damit Shops und Kassen funktionieren, die einen Browser ohne es ablehnen. Arx lädt kein Widevine. Gilt beim nächsten Öffnen von Arx."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells sites that check for Widevine that it’s there, so stores and checkouts that refuse a browser without it work. Arx loads no Widevine. Applies the next time Arx opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a los sitios que comprueban Widevine que está presente, para que funcionen las tiendas y los pagos que rechazan un navegador sin él. Arx no carga Widevine. Se aplica la próxima vez que se abra Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique aux sites qui recherchent Widevine qu’il est présent, afin que les boutiques et les paiements qui refusent un navigateur sans lui fonctionnent. Arx ne charge aucun Widevine. S’applique à la prochaine ouverture d’Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Widevineの有無を確認するサイトに、Widevineがあると伝えます。これにより、Widevineのないブラウザを拒否するストアやチェックアウトが動作します。ArxはWidevineを読み込みません。次回Arxを開いたときに適用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuje witryny sprawdzające obecność Widevine, że jest dostępny, dzięki czemu działają sklepy i kasy odrzucające przeglądarkę bez niego. Arx nie ładuje Widevine. Obowiązuje od następnego otwarcia Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает сайтам, которые проверяют наличие Widevine, что он есть, чтобы магазины и страницы оплаты, отказывающие браузеру без него, работали. Arx не загружает Widevine. Применяется при следующем открытии Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомляє сайтам, які перевіряють наявність Widevine, що він є, щоб працювали магазини й оформлення замовлень, які відмовляються працювати з браузером без нього. Arx не завантажує Widevine. Застосовується під час наступного відкриття Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告知检查 Widevine 的网站它存在，让拒绝没有它的浏览器的商店和结账页面可以正常使用。Arx 不会加载任何 Widevine。下次打开 Arx 时生效。"
          }
        }
      }
    },
