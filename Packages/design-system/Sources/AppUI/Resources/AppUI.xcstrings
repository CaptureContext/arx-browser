            "value": "削除するまで"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki ich nie usunę"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока я не удалю их"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доки я не видалю"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直到我删除为止"
          }
        }
      }
    },
    "chat.settingsRetentionDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Chats verschwinden 20 Minuten nach ihrer letzten Nachricht oder wenn Arx beendet wird, zusammen mit dem, was der Anbieter auf diesem Mac behalten hat. Fixierte Chats bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary chats disappear 20 minutes after their last message or when Arx quits, along with what the provider kept on this Mac. Pinned chats stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats temporales desaparecen 20 minutos después de su último mensaje o cuando Arx se cierra, junto con lo que el proveedor haya guardado en este Mac. Los chats anclados se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions temporaires disparaissent 20 minutes après leur dernier message ou quand Arx se ferme, avec ce que le fournisseur a conservé sur ce Mac. Les discussions épinglées restent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なチャットは、最後のメッセージから20分後、またはArxを終了すると、プロバイダがこのMacに保持したデータとともに消えます。固定したチャットは残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czaty tymczasowe znikają 20 minut po ostatniej wiadomości lub po zakończeniu Arx, razem z tym, co dostawca zachował na tym Macu. Przypięte czaty zostają."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временные чаты исчезают через 20 минут после последнего сообщения или при завершении Arx вместе с данными, которые поставщик сохранил на этом Mac. Закрепленные чаты остаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасові чати зникають через 20 хвилин після останнього повідомлення або коли Arx завершує роботу, разом із тим, що провайдер зберіг на цьому Mac. Закріплені чати лишаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时聊天会在最后一条消息 20 分钟后或 Arx 退出时消失，服务提供方在这台 Mac 上保留的相关内容也会一并清除。已固定的聊天会保留。"
          }
        }
      }
    },
