    "automation.settingsWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx wendet dies genau so an, als wäre es in den Einstellungen geändert worden, und die Einstellungen zeigen es sofort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx applies this exactly as if it were changed in Settings, and Settings shows it at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx lo aplica exactamente como si se cambiara en Ajustes, y Ajustes lo muestra al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx applique cela exactement comme si c’était modifié dans les Réglages, et les Réglages l’affichent aussitôt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは「設定」で変更した場合とまったく同じように適用し、「設定」にもすぐに反映されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx stosuje to dokładnie tak, jakby zmieniono to w Ustawieniach, a Ustawienia pokazują to od razu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx применяет это так, как если бы изменение было сделано в настройках, и настройки показывают его сразу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx застосовує це так, наче це змінено в параметрах, і параметри одразу це показують."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会完全按照在“设置”中更改的方式应用此项，并且“设置”会立即显示。"
          }
        }
      }
    },
