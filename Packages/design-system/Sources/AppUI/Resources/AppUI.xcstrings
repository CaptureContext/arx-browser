        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx używa tylko logowania z Twojego planu, nigdy osobno rozliczanego klucza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx использует только вход Вашего плана, но не ключ с отдельной оплатой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx використовує лише вхід вашого плану, а не окремо оплачуваний ключ."
