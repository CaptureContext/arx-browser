        }
      }
    },
    "settings.shareCrashReportsDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Arx oder einer seiner Helfer abstürzt, wird gesendet, wo der Absturz auftrat und welche Versionen beteiligt waren. Nie Webadressen, Seitentitel, Seiteninhalte oder etwas, das dich identifiziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Arx or one of its helpers crashes, send where it crashed and the versions involved. Never web addresses, page titles, page content or anything that identifies you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando Arx o uno de sus procesos auxiliares falla, envía dónde falló y las versiones implicadas. Nunca direcciones web, títulos de páginas, contenido de páginas ni nada que te identifique."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Arx ou l’un de ses processus auxiliaires plante, envoie l’endroit du plantage et les versions concernées. Jamais d’adresses web, de titres de pages, de contenu de pages ni rien qui vous identifie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxまたはそのヘルパがクラッシュしたときに、クラッシュした場所と関連するバージョンを送信します。ウェブアドレス、ページのタイトル、ページの内容、個人を特定できる情報は送信されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy Arx lub jeden z jego procesów pomocniczych ulegnie awarii, wysyła miejsce awarii i zaangażowane wersje. Nigdy adresów www, tytułów stron, treści stron ani niczego, co Cię identyfikuje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда Arx или один из его вспомогательных процессов дает сбой, отправлять место сбоя и задействованные версии. Никогда не отправляются веб-адреса, заголовки страниц, содержимое страниц и все, что позволяет Вас идентифицировать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли Arx або один із його допоміжних процесів аварійно завершується, надсилає, де сталася аварія, і задіяні версії. Ніколи не надсилає вебадреси, заголовки чи вміст сторінок або будь-що, що вас ідентифікує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Arx 或其辅助进程崩溃时，发送崩溃发生的位置和相关版本。绝不会发送网址、页面标题、页面内容或任何可识别你身份的信息。"
          }
        }
      }
    },
