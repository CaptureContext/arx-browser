    "taskManager.endProcessHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet den Prozess des ausgewählten Tabs oder der ausgewählten Erweiterung. Seine Seiten zeigen an, dass sie angehalten wurden, und werden neu geladen, wenn du zu ihnen zurückkehrst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the selected tab's or extension's process. Its pages show that they stopped and reload when you return to them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza el proceso de la pestaña o la extensión seleccionada. Sus páginas indican que se han detenido y se vuelven a cargar cuando vuelves a ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine le processus de l’onglet ou de l’extension sélectionné. Ses pages indiquent qu’elles se sont arrêtées et se rechargent quand vous y revenez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したタブまたは機能拡張のプロセスを終了します。そのページには停止したことが表示され、戻ると再び読み込まれます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy proces zaznaczonej karty lub rozszerzenia. Jego strony pokazują, że zostały zatrzymane, i ładują się ponownie po powrocie do nich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает процесс выбранной вкладки или расширения. Ее страницы показывают, что остановлены, и перезагружаются при возврате к ним."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершує процес вибраної вкладки або розширення. Його сторінки показують, що зупинилися, і перезавантажуються, коли ви до них повертаєтеся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束所选标签页或扩展的进程。其页面会显示已停止，并在你返回时重新加载。"
          }
        }
      }
    },
