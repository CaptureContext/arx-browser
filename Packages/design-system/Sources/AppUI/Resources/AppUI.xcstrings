    "siteSettings.error.invalid": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Website wie example.com und eine Einstellung ein, die diese Berechtigung zulässt."
