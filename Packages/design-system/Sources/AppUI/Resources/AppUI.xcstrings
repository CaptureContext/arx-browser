          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайти, що вирішують самі"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自行选择的网站"
          }
        }
      }
    },
    "settings.unreadBadgeSitesDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was im Menü einer Website gewählt wird, hat Vorrang vor jedem Profil und diesem Standard. Die eigene Wahl eines Tabs hat Vorrang vor der seiner Website."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chosen in each site's menu, they win over every profile and this default. A tab's own choice wins over its site's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido en el menú de cada sitio, prevalece sobre todos los perfiles y sobre este valor por omisión. La elección de una pestaña prevalece sobre la de su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisi dans le menu de chaque site, ce choix l’emporte sur tous les profils et sur cette valeur par défaut. Le choix propre à un onglet l’emporte sur celui de son site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サイトのメニューで設定した内容は、すべてのプロファイルとこのデフォルトより優先されます。タブ自身の設定は、そのサイトの設定より優先されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane w menu każdej witryny, mają pierwszeństwo przed każdym profilem i tym ustawieniem domyślnym. Wybór samej karty ma pierwszeństwo przed wyborem jej witryny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор, сделанный в меню сайта, важнее выбора любого профиля и этого значения по умолчанию. Выбор самой вкладки важнее выбора ее сайта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір, зроблений у меню сайту, має перевагу над кожним профілем і цим типовим значенням. Вибір самої вкладки має перевагу над вибором її сайту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个网站的菜单中选择后，其优先级高于所有用户场景和此默认设置。标签页自己的选择优先于其网站的选择。"
          }
        }
      }
    },
