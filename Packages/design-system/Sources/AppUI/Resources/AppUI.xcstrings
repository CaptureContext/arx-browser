      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Page's frame shows the whole page it took. Drawing an area toward the page's edge scrolls the page, faster closer to the edge, and the area is captured in one image."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
