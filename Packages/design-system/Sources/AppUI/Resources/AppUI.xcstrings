    "settings.webKitSitesOff": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Websites werden in WebKit geöffnet, sobald „Aufgeführte Websites in WebKit öffnen“ unter „Erweitert“ aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These sites open in WebKit once Open listed sites in WebKit is on, in Advanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos sitios se abren en WebKit cuando Abrir en WebKit los sitios de la lista está activado, en Avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sites s’ouvrent dans WebKit une fois Ouvrir les sites listés dans WebKit activé, dans Avancés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのサイトは、「詳細」で「リストしたサイトをWebKitで開く」をオンにするとWebKitで開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te witryny otwierają się w WebKit po włączeniu Otwieraj wymienione witryny w WebKit w Zaawansowanych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сайты открываются в WebKit, когда в разделе «Дополнения» включен параметр «Открывать сайты из списка в WebKit»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці сайти відкриваються в WebKit, щойно ввімкнено «Відкривати сайти зі списку в WebKit» в «Експертні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“高级”中打开“在 WebKit 中打开列出的网站”后，这些网站会在 WebKit 中打开。"
          }
        }
      }
    },
