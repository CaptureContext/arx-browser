    "automation.pageInteractionNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicks, Textersetzung, Optionsauswahl, Tastendrücke und Scrollen. Erfordert auch Seiteninhalt. Handler von Websites können Formulare senden oder Daten ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicks, text replacement, option selection, key presses and scrolling. Needs page content too. Website handlers may submit forms or change data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clics, sustitución de texto, selección de opciones, pulsaciones de teclas y desplazamiento. También necesita el contenido de la página. Los controladores de los sitios web pueden enviar formularios o cambiar datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clics, remplacement de texte, sélection d’options, appuis sur des touches et défilement. Nécessite aussi le contenu de la page. Les gestionnaires du site web peuvent envoyer des formulaires ou modifier des données."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリック、テキストの置き換え、オプションの選択、キー入力、スクロールを行います。ページの内容も必要です。ウェブサイトのハンドラにより、フォームが送信されたりデータが変更されたりする場合があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknięcia, zastępowanie tekstu, wybór opcji, naciskanie klawiszy i przewijanie. Wymaga także zawartości strony. Procedury witryny mogą wysyłać formularze lub zmieniać dane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатия, замена текста, выбор вариантов, нажатия клавиш и прокрутка. Требуется также доступ к содержимому страницы. Обработчики сайта могут отправлять формы или менять данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацання, заміна тексту, вибір варіантів, натискання клавіш і прокручування. Потрібен також вміст сторінки. Обробники вебсайту можуть надсилати форми або змінювати дані."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按、替换文本、选择选项、按键和滚动。还需要网页内容权限。网站处理程序可能会提交表单或更改数据。"
          }
        }
      }
    },
