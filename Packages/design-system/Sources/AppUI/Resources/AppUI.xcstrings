          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили не синхронизируются между компьютерами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі не синхронізуються між компʼютерами."
          }
        },
        "zh-Hans": {
