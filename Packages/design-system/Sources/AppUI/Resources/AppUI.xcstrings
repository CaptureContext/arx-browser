    "downloads.destination": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden in „Downloads“ gesichert. Vorhandene Dateien bleiben erhalten, indem doppelten Dateinamen eine Nummer hinzugefügt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are saved in Downloads. Existing files are preserved by adding a number to duplicate filenames."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se guardan en Descargas. Los archivos existentes se conservan añadiendo un número a los nombres duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont enregistrés dans Téléchargements. Les fichiers existants sont conservés en ajoutant un numéro aux noms de fichiers en double."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは「ダウンロード」に保存されます。既存のファイルは、同じファイル名に番号を付けて保持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki są zachowywane w folderze Pobrane. Istniejące pliki są zachowywane dzięki dodaniu numeru do powtarzających się nazw plików."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы сохраняются в «Загрузки». Существующие файлы не перезаписываются: к повторяющимся именам добавляется номер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли зберігаються у «Викачане». Наявні файли не перезаписуються: до повторюваних назв файлів додається число."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会存储在“下载”文件夹中。已有的文件会保留，重名文件会加上数字。"
          }
        }
      }
    },
