        }
      }
    },
    "media.pictureUnavailableAudio": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Video kann in Bild-in-Bild dargestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a video can be presented in Picture in Picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede mostrar un vídeo en imagen dentro de imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une vidéo peut être présentée en mode Image dans l’image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクチャ・イン・ピクチャで表示できるのはビデオのみです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trybie Obraz w obrazie można pokazać tylko wideo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В режиме «Картинка в картинке» можно показать только видео."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У режимі «Кадр у кадрі» можна показати лише відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有视频可以在画中画中显示。"
          }
        }
      }
    },
    "media.pictureUnavailableSite": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Website lässt die Wiedergabe ihres Videos in Bild-in-Bild nicht zu. „Tab in Bild-in-Bild darstellen“ zeigt stattdessen die gesamte Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This site doesn't let its video play in Picture in Picture. Present Tab in Picture in Picture shows the whole page instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sitio no permite reproducir su vídeo en imagen dentro de imagen. “Mostrar pestaña en imagen dentro de imagen” muestra la página completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce site n’autorise pas la lecture de sa vidéo en mode Image dans l’image. « Présenter l’onglet en mode Image dans l’image » affiche plutôt toute la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトは、ビデオをピクチャ・イン・ピクチャで再生できないようにしています。「タブをピクチャ・イン・ピクチャで表示」を使うと、ページ全体が表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta witryna nie pozwala odtwarzać wideo w trybie Obraz w obrazie. Opcja Pokaż kartę w trybie Obraz w obrazie pokazuje zamiast tego całą stronę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сайт не позволяет воспроизводить свое видео в режиме «Картинка в картинке». Вместо этого команда «Показать вкладку в режиме „Картинка в картинке“» показывает всю страницу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сайт не дозволяє відтворювати своє відео в режимі «Кадр у кадрі». Команда «Показати вкладку в режимі «Кадр у кадрі»» показує натомість цілу сторінку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网站不允许其视频在画中画中播放。“在画中画中显示标签页”会改为显示整个页面。"
          }
        }
      }
    },
