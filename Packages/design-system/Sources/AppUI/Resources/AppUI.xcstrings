    "move.identity": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Bewegen in ein anderes Profil werden neue Seiten mit den Accounts dieses Profils geöffnet. Cookies, Verlauf und Seitenstatus werden nicht übertragen. „Widerrufen“ stellt die Anordnung durch erneutes Öffnen der Seiten wieder her, aber keinen flüchtigen Seitenstatus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving to another profile opens fresh pages using that profile’s accounts. Cookies, history, and page state do not transfer. Undo restores organization by reopening pages; it cannot restore transient page state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al trasladar a otro perfil se abren páginas nuevas con las cuentas de ese perfil. Las cookies, el historial y el estado de las páginas no se transfieren. Deshacer restaura la organización volviendo a abrir las páginas; no puede restaurar el estado transitorio de las páginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passage vers un autre profil ouvre de nouvelles pages avec les comptes de ce profil. Les cookies, l’historique et l’état des pages ne sont pas transférés. Annuler rétablit l’organisation en rouvrant les pages ; l’état temporaire des pages ne peut pas être restauré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のプロファイルに移動すると、そのプロファイルのアカウントを使用して新しいページが開きます。Cookie、履歴、ページの状態は引き継がれません。取り消すと、ページを開き直すことで構成が復元されますが、一時的なページの状態は復元できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeniesienie do innego profilu otwiera nowe strony z kontami tego profilu. Pliki cookie, historia i stan strony nie są przenoszone. Cofnięcie przywraca układ przez ponowne otwarcie stron; nie może przywrócić przejściowego stanu strony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При перемещении в другой профиль открываются новые страницы с учетными записями этого профиля. Файлы cookie, история и состояние страниц не переносятся. Отмена восстанавливает упорядочивание, заново открывая страницы; она не может восстановить временное состояние страниц."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщення в інший профіль відкриває свіжі сторінки з обліковими записами цього профілю. Файли cookie, історія та стан сторінок не переносяться. Відмінення відновлює упорядкування, знову відкриваючи сторінки; воно не може відновити тимчасовий стан сторінок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到其他用户场景会使用该用户场景的账户打开全新的页面。Cookie、历史记录和页面状态不会转移。“撤销”会通过重新打开页面来恢复布局；它无法恢复临时的页面状态。"
          }
        }
      }
    },
    "move.order": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte werden in der Reihenfolge bewegt, in der du sie ausgewählt hast. Ordner enthalten ihren gesamten Inhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items move in the order you selected them. Folders include all their contents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems se trasladan en el orden en que los has seleccionado. Las carpetas incluyen todo su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sont déplacés dans l’ordre de votre sélection. Les dossiers incluent tout leur contenu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目は、選択した順序で移動します。フォルダにはその内容がすべて含まれます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycje są przenoszone w kolejności, w jakiej je zaznaczono. Foldery obejmują całą swoją zawartość."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты перемещаются в порядке выбора. Папки включают все свое содержимое."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елементи переміщуються в порядку, в якому ви їх вибрали. Папки містять увесь свій вміст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目会按你选择的顺序移动。文件夹包含其中的所有内容。"
          }
        }
      }
    },
    "move.search": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Raum oder Ordner suchen"
          }
        },
        "en": {
          "stringUnit": {
