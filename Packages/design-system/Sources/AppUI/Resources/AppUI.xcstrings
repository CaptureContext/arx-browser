    "savedPasswords.subtitle": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in %@ gesichert. Andere Profile können sie weder sehen noch verwenden."
