    "search.empty": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine eigenen Suchkürzel. Die integrierten bangs unten funktionieren auch ohne, zum Beispiel !gh für GitHub."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shortcuts of your own yet. The built-in bangs below work without any, such as !gh for GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes atajos de búsqueda propios. Los bangs integrados de abajo funcionan sin ellos, como !gh para GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun raccourci de recherche personnel pour l’instant. Les bangs intégrés ci-dessous fonctionnent sans, comme !gh pour GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の検索ショートカットはまだありません。下の組み込みのbangは、なくても使えます。たとえば、GitHubなら!ghです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze własnych skrótów wyszukiwania. Wbudowane bangi poniżej działają bez nich, na przykład !gh dla GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Своих поисковых сокращений пока нет. Встроенные bang-команды ниже работают и без них, например !gh для GitHub."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власних пошукових скорочень ще немає. Вбудовані bang-команди нижче працюють і без них, наприклад !gh для GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有你自己的搜索快捷词。下方内置的 bang 无需添加即可使用，例如用 !gh 搜索 GitHub。"
          }
        }
      },
      "comment": "Settings › General › Search shortcuts, in place of the list while the person has added no shortcut of their own. Keep “!gh” as it is: it's what they type."
    },
