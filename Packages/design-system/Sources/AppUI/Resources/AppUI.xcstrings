    "settings.archiveLittleExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sie so lange nicht verwendet wurden, werden Little-Arx-Fenster geschlossen und ins Archiv bewegt. Fenster, in denen Medien wiedergegeben werden, die laden oder in denen du etwas eingegeben hast, bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unused for this long, Little Arx windows close and move to the Archive. Windows playing media, loading or holding something you typed stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se usan durante este tiempo, las ventanas de Little Arx se cierran y pasan a las pestañas archivadas. Las ventanas que reproducen contenido multimedia, que están cargando o que contienen algo que has escrito se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si elles restent inutilisées aussi longtemps, les fenêtres Little Arx se ferment et passent dans l’archive. Les fenêtres qui lisent un média, qui chargent ou qui contiennent un texte saisi restent ouvertes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これだけの時間使用しないと、Little Arxウインドウは閉じてアーカイブに移動します。メディアを再生中、読み込み中、または入力した内容があるウインドウは残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieużywane przez tak długi czas okna Little Arx zamykają się i trafiają do Archiwum. Okna odtwarzające multimedia, wczytujące się lub zawierające coś, co wpisano, zostają."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если окна Little Arx не используются так долго, они закрываются и перемещаются в архив. Окна с воспроизведением медиа, загрузкой или введенным Вами текстом остаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вікна Little Arx не використовуються так довго, вони закриваються й переміщуються до архіву. Вікна, у яких відтворюється медіа, триває завантаження або є введений вами текст, залишаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Arx 窗口闲置这么长时间后会关闭并移到归档。正在播放媒体、正在加载或含有你输入内容的窗口会保留。"
          }
        }
      }
    },
