    "settings.iCloudSync.stop.title": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung für diesen Mac stoppen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop syncing this Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de sincronizar este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la synchronisation de ce Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの同期を停止"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj synchronizację tego Maca"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить синхронизацию этого Mac"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Припинити синхронізацію цього Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止同步这台 Mac"
          }
        }
      }
    },
    "settings.iCloudSync.stop.detail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlässt alle Kategorien. Dieser Mac und deine anderen Macs behalten jeweils ihre Daten. Anders als beim Ausschalten der Synchronisierung wird nichts, was du hier in der Zwischenzeit änderst, später gesendet: Dieser Mac tritt als neuer Mac wieder bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves every category. This Mac and your other Macs each keep their data. Unlike turning sync off, nothing changed here meanwhile is sent later: this Mac rejoins as a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de todas las categorías. Este Mac y tus otros Mac conservan sus datos. A diferencia de desactivar la sincronización, nada de lo que cambie aquí mientras tanto se enviará más tarde: este Mac se vuelve a unir como uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitte toutes les catégories. Ce Mac et vos autres Mac conservent chacun leurs données. Contrairement à la désactivation de la synchronisation, rien de ce qui est modifié ici entre-temps n’est envoyé plus tard : ce Mac se joint de nouveau comme un nouvel appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカテゴリから外れます。このMacとほかのMacは、それぞれのデータを保持します。同期をオフにする場合と異なり、その間にここで変更した内容は後から送信されません。このMacは新しいMacとして再び加わります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opuszcza każdą kategorię. Ten Mac i Twoje pozostałe komputery Mac zachowują swoje dane. W przeciwieństwie do wyłączenia synchronizacji nic zmienionego tutaj w międzyczasie nie zostanie później wysłane: ten Mac dołącza ponownie jako nowy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходит из всех категорий. Этот Mac и Ваши другие компьютеры Mac сохраняют свои данные. В отличие от выключения синхронизации, изменения, сделанные здесь за это время, позже не отправляются: этот Mac присоединится как новый."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виходить з усіх категорій. Цей Mac та інші ваші Mac зберігають свої дані. На відміну від вимкнення синхронізації, зміни, зроблені тут за цей час, не буде надіслано пізніше: цей Mac знову приєднається як новий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出所有类别。这台 Mac 和你其他 Mac 各自保留自己的数据。与关闭同步不同，你在此期间所做的更改以后不会发送：这台 Mac 会作为新的 Mac 重新加入。"
          }
        }
      }
    },
    "settings.iCloudSync.stop.button": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
