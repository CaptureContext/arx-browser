    "settings.iCloudSync.stop.stopped": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac synchronisiert nicht mehr. Wenn du die Synchronisierung aktivierst, werden seine Daten mit denen aus iCloud zusammengeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac stopped syncing. Turning sync on merges its data with iCloud’s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac ha dejado de sincronizar. Al activar la sincronización, se fusionan sus datos con los de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation de ce Mac est arrêtée. La réactiver fusionne ses données avec celles d’iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの同期を停止しました。同期をオンにすると、データがiCloudのデータと統合されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac przestał się synchronizować. Włączenie synchronizacji scala jego dane z danymi z iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac больше не синхронизируется. При включении синхронизации его данные будут объединены с данными iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac припинив синхронізацію. Після ввімкнення синхронізації його дані обʼєднаються з даними iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已停止同步。打开同步会将其数据与 iCloud 的数据合并。"
          }
        }
      }
    },
