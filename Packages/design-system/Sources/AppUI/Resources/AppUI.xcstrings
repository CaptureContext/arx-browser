    "archive.clearDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Tabs und die Archive anderer Profile bleiben unverändert. Dies kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live tabs and the archives of other profiles are unchanged. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas abiertas y las pestañas archivadas de otros perfiles no cambian. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets ouverts et les archives des autres profils ne sont pas modifiés. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているタブと、ほかのプロファイルのアーカイブは変更されません。この操作は取り消せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywne karty i archiwa innych profili pozostaną bez zmian. Tej czynności nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытые вкладки и архивы других профилей не изменятся. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриті вкладки та архіви інших профілів не зміняться. Цю дію не можна відмінити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中的标签页和其他用户场景的归档不会改变。此操作无法撤销。"
          }
        }
      }
    },
