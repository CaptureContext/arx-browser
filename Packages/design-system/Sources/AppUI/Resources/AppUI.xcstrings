        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS завершила эту страницу, обычно чтобы освободить память. Перезагрузите ее, чтобы открыть снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS завершила цю сторінку, зазвичай щоб звільнити памʼять. Перезавантажте, щоб відкрити її знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 结束了此页面，通常是为了释放内存。请重新加载以再次打开。"
          }
        }
      }
    },
    "viewer.rendererEndedByArx": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
