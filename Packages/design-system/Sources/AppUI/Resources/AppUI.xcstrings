    "extensions.directoryUnreadable": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx kann diesen Ordner oder seine Datei manifest.json nicht lesen. Überprüfe die Berechtigungen des Ordners im Finder und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx can't read that folder or its manifest.json. Check the folder's permissions in Finder, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx no puede leer esa carpeta ni su manifest.json. Comprueba los permisos de la carpeta en el Finder e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx ne peut pas lire ce dossier ni son manifest.json. Vérifiez les permissions du dossier dans le Finder, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxはそのフォルダまたはそのmanifest.jsonを読み取れません。Finderでフォルダのアクセス権を確認してから、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie może odczytać tego folderu ani jego pliku manifest.json. Sprawdź uprawnienia folderu w Finderze i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не может прочитать эту папку или ее файл manifest.json. Проверьте права доступа к папке в Finder и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не може прочитати цю папку або її manifest.json. Перевірте дозволи папки у Finder і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 无法读取该文件夹或其 manifest.json。请在访达中检查该文件夹的权限，然后重试。"
          }
        }
      }
    },
    "extensions.invalidManifest": {
