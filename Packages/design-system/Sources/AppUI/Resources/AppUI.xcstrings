    "automation.networkDetailsNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Header und Bodys von Anfragen und Antworten sowie HAR-Export in Tabs, deren Protokolle behalten werden. Cookie- und Zugangsdaten-Header verlassen Arx nie, und Zugangsdatenfelder in Bodys werden ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request and response headers and bodies, and HAR export, in tabs whose logs it keeps. Cookie and credential headers never leave Arx, and credential fields in bodies are hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeceras y cuerpos de peticiones y respuestas, y exportación HAR, en las pestañas cuyos registros conserva. Las cabeceras de cookies y credenciales nunca salen de Arx y los campos de credenciales de los cuerpos se ocultan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En-têtes et corps des requêtes et des réponses, et export HAR, dans les onglets dont il conserve les journaux. Les en-têtes de cookies et d’identifiants ne quittent jamais Arx, et les champs d’identifiants dans les corps sont masqués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログを保持しているタブで、リクエストとレスポンスのヘッダおよび本文、HARの書き出しを行います。CookieおよびCredentialのヘッダはArxの外に出ず、本文内の認証情報フィールドは非表示になります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagłówki i treści żądań i odpowiedzi oraz eksport HAR w kartach, których dzienniki zachowuje. Nagłówki z plikami cookie i poświadczeniami nigdy nie opuszczają Arx, a pola poświadczeń w treściach są ukrywane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки и тела запросов и ответов и экспорт HAR во вкладках, журналы которых сохраняются. Заголовки с файлами cookie и учетными данными никогда не покидают Arx, а поля с учетными данными в телах скрываются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки й тіла запитів і відповідей та експорт HAR у вкладках, журнали яких зберігаються. Заголовки з файлами cookie й обліковими даними ніколи не залишають Arx, а поля облікових даних у тілах приховано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在保留其日志的标签页中，包含请求和响应的标头与正文，以及 HAR 导出。Cookie 和凭据标头绝不会离开 Arx，正文中的凭据栏位会被隐藏。"
          }
        }
      }
    },
    "extensions.allowInPrivate": {
