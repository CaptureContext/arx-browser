    "appLinks.sourceChanged": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite wurde gewechselt, bevor du geantwortet hast, daher wird nichts ausgeführt. Öffne den Link erneut auf der Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page moved on before you answered, so nothing runs. Open the link again from the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página ha cambiado antes de que respondieras, así que no se ejecuta nada. Vuelve a abrir el enlace desde la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page a changé avant votre réponse, rien n’est donc exécuté. Ouvrez de nouveau le lien depuis la page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答する前にページが移動したため、何も実行されません。ページからもう一度リンクを開いてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona zmieniła się, zanim odpowiedziano, więc nic się nie uruchomi. Otwórz łącze ponownie ze strony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница изменилась до Вашего ответа, поэтому ничего не запущено. Откройте ссылку на странице снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінка змінилася, поки ви відповідали, тому нічого не виконується. Відкрийте посилання на сторінці ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你回应之前网页已经跳转，因此不会运行任何内容。请从网页再次打开该链接。"
          }
        }
      }
    },
