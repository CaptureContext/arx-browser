    "automation.mediaWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergeben, Pausieren, Springen, Stummschalten oder das Bewegen eines Videos in oder aus Bild-in-Bild ändert, was du siehst und hörst, als hättest du „Medien“ in der Bibliothek verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing, pausing, seeking, muting or moving a video into or out of Picture in Picture changes what you see and hear, as if you had used Media in the Library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir, pausar, desplazarse por el vídeo, silenciarlo o pasarlo a imagen dentro de imagen (o sacarlo) cambia lo que ves y oyes, como si hubieras usado Multimedia en la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire, mettre en pause, se déplacer dans une vidéo, couper le son ou passer une vidéo en Image dans l’image ou l’en sortir change ce que vous voyez et entendez, comme si vous aviez utilisé Médias dans la bibliothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生、一時停止、シーク、消音、またはビデオのピクチャ・イン・ピクチャへの移動・解除を行うと、ライブラリの「メディア」を使った場合と同様に、見え方や聞こえ方が変わります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie, wstrzymywanie, przewijanie, wyciszanie albo przenoszenie wideo do trybu Obraz w obrazie lub z niego zmienia to, co widzisz i słyszysz, tak samo jak działania w Multimediach w Bibliotece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение, пауза, перемотка, выключение звука и перевод видео в режим «Картинка в картинке» и обратно меняют то, что Вы видите и слышите, как если бы Вы использовали «Медиа» в Библиотеке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення, пауза, перемотування, вимкнення звуку та переведення відео в режим «Кадр у кадрі» чи з нього змінює те, що ви бачите й чуєте, так само, наче ви скористалися розділом «Медіа» в бібліотеці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放、暂停、跳转、静音，或将视频移入或移出画中画，会改变你看到和听到的内容，就像你在资源库中使用“媒体”一样。"
          }
        }
      }
    },
