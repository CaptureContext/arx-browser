    "appearance.backgroundDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt die Seitenleiste und den Fensterrahmen. Profile und Räume können eigene Farben wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors the sidebar and window frame. Profiles and spaces can choose their own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorea la barra lateral y el marco de la ventana. Los perfiles y las secciones pueden elegir los suyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore la barre latérale et le cadre de la fenêtre. Les profils et les sections peuvent choisir les leurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーとウインドウのフレームに色を付けます。プロファイルとスペースで個別に選択することもできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koloruje pasek boczny i ramkę okna. Profile i strefy mogą wybrać własne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрашивает боковое меню и рамку окна. Профили и разделы могут выбрать свои цвета."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фарбує бічну панель і рамку вікна. Профілі та розділи можуть вибрати власні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为边栏和窗口边框着色。用户场景和分区可以选择各自的颜色。"
          }
        }
      }
    },
