    "viewer.unresponsiveDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst warten oder sie neu laden. Beim Neuladen wird beendet, was die Seite gerade getan hat, und andere Seiten, die sich einen Prozess mit ihr teilen, werden ebenfalls neu geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can wait for it, or reload it. Reloading ends what the page was doing, and other pages it shares a process with reload too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes esperar o volver a cargarla. Al volver a cargarla se interrumpe lo que hacía la página, y también se vuelven a cargar otras páginas con las que comparte proceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez attendre, ou la recharger. Recharger met fin à ce que faisait la page, et les autres pages qui partagent un processus avec elle se rechargent aussi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待つか、再読み込みしてください。再読み込みすると、ページの処理が中断され、プロセスを共有しているほかのページも再読み込みされます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz poczekać lub odświeżyć stronę. Odświeżenie kończy to, co strona robiła, i odświeża też inne strony, z którymi współdzieli proces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно подождать или перезагрузить ее. Перезагрузка прерывает то, что делала страница, и другие страницы с общим процессом тоже перезагружаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна зачекати або перезавантажити її. Перезавантаження перериває те, що робила сторінка, і інші сторінки, які мають із нею спільний процес, теж перезавантажуються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以等待，也可以重新加载。重新加载会结束页面正在进行的操作，与其共用进程的其他页面也会重新加载。"
          }
        }
      }
    },
