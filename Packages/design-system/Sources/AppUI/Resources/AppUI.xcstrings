    "settings.updatesChannelDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta erhält neue Versionen zuerst und auch jede stabile. Wenn du zu „Stabil“ zurückwechselst, bleibt diese Version, bis eine neuere stabile erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta gets new versions first, and every stable one too. Switching back to Stable keeps this version until a newer stable one comes out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta recibe las versiones nuevas primero, y también todas las estables. Si vuelves a Estable, se mantiene esta versión hasta que salga una estable más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bêta reçoit les nouvelles versions en premier, ainsi que toutes les versions stables. Revenir à Stable conserve cette version jusqu’à la sortie d’une version stable plus récente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベータでは、新しいバージョンがいち早く提供され、安定版のバージョンもすべて提供されます。「安定版」に戻した場合は、より新しい安定版が公開されるまで、このバージョンのままです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta dostaje nowe wersje jako pierwsza, a także każdą stabilną. Powrót do Stabilnej zachowuje tę wersję, dopóki nie pojawi się nowsza stabilna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бета получает новые версии первой, а также все стабильные. При возврате к стабильному каналу остается эта версия, пока не выйдет более новая стабильная."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бета отримує нові версії першою, а також кожну стабільну. Повернення до стабільного каналу залишає цю версію, доки не вийде новіша стабільна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试版会最先获得新版本，也包括每个稳定版。切换回稳定版后，会保留当前版本，直到发布更新的稳定版。"
          }
        }
      }
    },
