    "developer.appleScriptJavaScript": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JavaScript aus AppleScript erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow JavaScript from AppleScript"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir JavaScript desde AppleScript"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser JavaScript depuis AppleScript"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScriptからのJavaScriptを許可"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwalaj na JavaScript z AppleScript"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить JavaScript из AppleScript"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити JavaScript з AppleScript"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许来自 AppleScript 的 JavaScript"
          }
        }
      }
    },
    "developer.appleScriptJavaScriptExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skripte können mit execute JavaScript in deinen Tabs ausführen. Private Fenster erlauben dies nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts can run JavaScript in your tabs with execute. Private windows never allow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los scripts pueden ejecutar JavaScript en tus pestañas con execute. Las ventanas privadas nunca lo permiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scripts peuvent exécuter du JavaScript dans vos onglets avec execute. Les fenêtres privées ne l’autorisent jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトはexecuteでタブ内のJavaScriptを実行できます。プライベートウインドウでは許可されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrypty mogą uruchamiać JavaScript w Twoich kartach za pomocą execute. Okna prywatne nigdy na to nie pozwalają."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипты могут запускать JavaScript во вкладках с помощью execute. В частных окнах это не разрешается никогда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипти можуть виконувати JavaScript у ваших вкладках за допомогою execute. Приватні вікна ніколи цього не дозволяють."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本可以使用 execute 在你的标签页中运行 JavaScript。无痕浏览窗口绝不允许。"
          }
        }
      }
    },
    "settings.notificationsOpenClosedSites": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Website über ihre Mitteilung öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the site from its notification"
          }
        },
        "es": {
