    "onboarding.tour.sample.peek.body1": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link wird über der aktuellen Seite geöffnet. Esc legt ihn weg, und er kann als Tab bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link opens over the page you're on. Esc puts it away, and it can stay as a tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace se abre sobre la página en la que estás. Esc lo guarda y puede quedarse como pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien s’ouvre au-dessus de la page où vous êtes. Échap le range, et il peut rester comme onglet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは、今見ているページの上で開きます。Escキーでしまえますが、タブとして残すこともできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącze otwiera się nad stroną, na której jesteś. Esc go chowa, a może on zostać jako karta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка открывается поверх текущей страницы. Esc убирает ее, а еще она может остаться вкладкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання відкривається поверх сторінки, на якій ви перебуваєте. Esc прибирає його, а ще воно може лишитися вкладкою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接会在你当前的页面上方打开。按 Esc 键可将其收起，它也可以保留为标签页。"
          }
        }
      }
    },
    "onboarding.tour.sample.peek.body2": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neben der Seite wird daraus Split View: zwei Tabs, ein Fenster, jeweils mit eigenem Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beside the page, it becomes Split View: two tabs, one window, each with its own history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto a la página se convierte en Split View: dos pestañas, una ventana, cada una con su propio historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À côté de la page, il devient Split View : deux onglets, une fenêtre, chacun avec son propre historique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの横に置くと、Split Viewになります。1つのウインドウに2つのタブがあり、それぞれ独自の履歴を持ちます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obok strony staje się Split View: dwie karty, jedno okno, każda z własną historią."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядом со страницей она становится Split View: две вкладки, одно окно, у каждой своя история."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поруч зі сторінкою це стає Split View: дві вкладки, одне вікно, в кожної своя історія."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放在页面旁边时，它会变成分屏浏览：两个标签页，一个窗口，各有各的历史记录。"
          }
        }
      }
    },
