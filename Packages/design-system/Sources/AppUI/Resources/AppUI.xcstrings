            "value": "Mantiene el vídeo de esta pestaña flotando sobre otras ventanas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire flotter la vidéo de cet onglet au-dessus des autres fenêtres"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブのビデオをほかのウインドウの上に浮かせて表示します"
          }
        },
        "pl": {
