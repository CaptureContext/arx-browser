    "settings.updatesDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx sucht auf GitHub nach neuen Versionen und installiert nur neuere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx checks GitHub for new versions and only ever installs newer ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx busca versiones nuevas en GitHub y solo instala versiones más recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx recherche de nouvelles versions sur GitHub et n’installe jamais que des versions plus récentes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ArxはGitHubで新しいバージョンを確認し、より新しいバージョンのみをインストールします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx sprawdza w GitHub, czy są nowe wersje, i instaluje wyłącznie nowsze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx проверяет наличие новых версий на GitHub и устанавливает только более новые."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx перевіряє GitHub на нові версії та інсталює лише новіші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 会在 GitHub 上检查新版本，并且只会安装更新的版本。"
          }
        }
      }
    },
