          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент пока не может использовать вкладки этого профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент ще не може користуватися вкладками цього профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
