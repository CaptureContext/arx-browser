    "settings.webKitPagesExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Spotify, Disney+ und andere Dienste, die ihre Videos und Musik schützen, werden wie in Safari in WebKit mit FairPlay wiedergegeben. Eine Website umfasst ihre https-Seiten und Subdomains. WebKit-Seiten unterstützen keine Erweiterungen, kein automatisches Ausfüllen von Passwörtern, keine Chrome-Website-Einstellungen, keine Übersetzung, keine Mitteilungen und keine Passkeys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Spotify, Disney+ and other services that protect their video and music play in WebKit, as in Safari, with FairPlay. A site matches its https pages and its subdomains. WebKit pages don’t have extensions, password autofill, Chrome site settings, translation, notifications or passkeys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Spotify, Disney+ y otros servicios que protegen su vídeo y su música se reproducen en WebKit, como en Safari, con FairPlay. Un sitio abarca sus páginas https y sus subdominios. Las páginas de WebKit no tienen extensiones, autorrelleno de contraseñas, ajustes del sitio de Chrome, traducción, notificaciones ni llaves de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Spotify, Disney+ et d’autres services qui protègent leurs vidéos et leur musique sont lus dans WebKit, comme dans Safari, avec FairPlay. Un site correspond à ses pages https et à ses sous-domaines. Les pages WebKit n’ont ni extensions, ni remplissage automatique des mots de passe, ni réglages de sites de Chrome, ni traduction, ni notifications, ni clés d’accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix、Spotify、Disney+など、ビデオや音楽を保護しているサービスは、Safariと同様に、FairPlayを使ってWebKitで再生されます。サイトは、そのhttpsのページとサブドメインに一致します。WebKitページでは、機能拡張、パスワードの自動入力、Chromeのサイトの設定、翻訳、通知、パスキーは使用できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Spotify, Disney+ i inne usługi chroniące swoje wideo i muzykę odtwarzają je w WebKit, jak w Safari, z FairPlay. Witryna obejmuje swoje strony https i subdomeny. Strony WebKit nie mają rozszerzeń, wypełniania haseł, ustawień witryn Chrome, tłumaczenia, powiadomień ani kluczy dostępu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Spotify, Disney+ и другие сервисы, защищающие свое видео и музыку, воспроизводятся в WebKit с FairPlay, как в Safari. Сайт охватывает свои страницы https и поддомены. На страницах WebKit нет расширений, автозаполнения паролей, настроек сайта Chrome, перевода, уведомлений и ключей входа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Spotify, Disney+ та інші служби, що захищають своє відео й музику, відтворюються в WebKit, як у Safari, з FairPlay. Сайт охоплює свої сторінки https і піддомени. Сторінки WebKit не мають розширень, автозаповнення паролів, параметрів вебсайтів Chrome, перекладу, сповіщень чи ключів допуску."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix、Spotify、Disney+ 以及其他保护其视频和音乐的服务，会像在 Safari 中一样，使用 FairPlay 在 WebKit 中播放。网站会匹配其 https 页面及其子域名。WebKit 页面没有扩展、密码自动填充、Chrome 网站设置、翻译、通知或通行密钥。"
          }
        }
      }
    },
