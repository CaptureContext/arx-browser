    "settings.backForwardCache": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für „Zurück“ und „Vorwärts“ behaltene Seiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages kept for Back and Forward"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas guardadas para Atrás y Adelante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages conservées pour Page précédente et Page suivante"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「戻る」と「進む」用に保持するページ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strony zachowane dla Wróć i Do przodu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы для «Назад» и «Вперед»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінки для «Назад» і «Вперед»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为“返回”和“向前”保留的页面"
          }
        }
      }
    },
    "settings.backForwardCacheExplanation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zurück“ und „Vorwärts“ zeigen diese Seiten sofort, dorthin gescrollt, wo du warst. Mehr Seiten benötigen mehr Arbeitsspeicher. Gilt beim nächsten Öffnen von Arx."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back and Forward show these pages at once, scrolled where you were. More pages use more memory. Applies the next time Arx opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrás y Adelante muestran estas páginas al instante, desplazadas hasta donde estabas. Cuantas más páginas, más memoria se usa. Se aplica la próxima vez que se abra Arx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page précédente et Page suivante affichent ces pages immédiatement, au point où vous vous trouviez. Plus il y a de pages, plus la mémoire utilisée augmente. S’applique à la prochaine ouverture d’Arx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「戻る」と「進む」で、これらのページをスクロール位置もそのままにすぐ表示します。ページ数が多いほどメモリを使用します。次回Arxを開いたときに適用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wróć i Do przodu od razu pokazują te strony, przewinięte tam, gdzie były. Więcej stron zajmuje więcej pamięci. Obowiązuje od następnego otwarcia Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки «Назад» и «Вперед» сразу показывают эти страницы с прежней прокруткой. Чем больше страниц, тем больше памяти. Применяется при следующем открытии Arx."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Назад» і «Вперед» одразу показують ці сторінки, прокручені до місця, де ви були. Більше сторінок — більше памʼяті. Застосовується під час наступного відкриття Arx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“返回”和“向前”会立即显示这些页面，并停留在你之前滚动到的位置。页面越多，占用的内存越多。下次打开 Arx 时生效。"
          }
        }
      }
    },
    "settings.backForwardCacheNextLaunch": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende Arx und öffne es erneut, um die neue Anzahl zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit and reopen Arx to use the new number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
