    "export.archiveSummary": {
      "comment": "Export finished alert, after exporting an archive. %@ is a list joined in the language's list format, such as “2 profiles, 3 spaces, 4 folders and 10 tabs” (export.count.*, each its own plural).",
      "extractionState": "manual",
