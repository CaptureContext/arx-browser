    "settings.linkStatusDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Zeiger auf einen Link bewegst, wird seine Adresse in der unteren Ecke der Seite angezeigt. Halte ⌘, ⇧ oder ⌥ gedrückt, um zu sehen, was ein Klick mit diesen Tasten bewirkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovering a link shows its address at the page's bottom corner. Hold ⌘, ⇧ or ⌥ to see what a click with those keys will do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pasar el puntero sobre un enlace, se muestra su dirección en la esquina inferior de la página. Mantén pulsado ⌘, ⇧ o ⌥ para ver qué hará un clic con esas teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survoler un lien affiche son adresse dans le coin inférieur de la page. Maintenez ⌘, ⇧ ou ⌥ pour voir ce que fera un clic avec ces touches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクにポインタを重ねると、ページの下隅にそのアドレスが表示されます。⌘、⇧、⌥を押すと、それらのキーを押しながらクリックしたときの動作を確認できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najechanie na łącze pokazuje jego adres w dolnym rogu strony. Przytrzymaj ⌘, ⇧ lub ⌥, aby zobaczyć, co zrobi kliknięcie z tymi klawiszami."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При наведении на ссылку ее адрес отображается в нижнем углу страницы. Удерживайте ⌘, ⇧ или ⌥, чтобы увидеть, что произойдет при нажатии с этими клавишами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви наводите курсор на посилання, його адреса показується в нижньому куті сторінки. Утримуйте ⌘, ⇧ або ⌥, щоб побачити, що станеться після клацання з цими клавішами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针悬停在链接上时，会在页面底部角落显示其地址。按住 ⌘、⇧ 或 ⌥ 可查看使用这些按键点按会执行什么操作。"
          }
        }
      }
    },
