    "routing.invalidDefinition": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Regelnamen, einen gültigen Host und optional ein HTTP(S)-Schema, einen Port oder ein codiertes Pfadpräfix ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a rule name, a valid host, and optional HTTP(S) scheme, port, or encoded path prefix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre de regla, un host válido y, opcionalmente, un esquema HTTP(S), un puerto o un prefijo de ruta codificada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom de règle, un hôte valide, et éventuellement un schéma HTTP(S), un port ou un préfixe de chemin encodé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルール名と有効なホストを入力してください。HTTP(S)のスキーム、ポート、エンコードされたパスの先頭部分は任意です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz nazwę reguły, prawidłowy host oraz opcjonalnie schemat HTTP(S), port lub zakodowany prefiks ścieżki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите название правила, допустимый хост и, при необходимости, схему HTTP(S), порт или закодированный префикс пути."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть назву правила, дійсний хост і, за потреби, схему HTTP(S), порт або закодований префікс шляху."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入规则名称、有效的主机，以及可选的 HTTP(S) 协议、端口或已编码的路径前缀。"
          }
        }
      },
      "extractionState": "manual",
      "generatesSymbol": false
    },
