    "archive.restoreProfileDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seiten werden in %@ mit den Accounts und Cookies des Zielprofils geöffnet. Der Seitenzustand und der Navigationsverlauf werden nicht wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages will open in %@ using the destination profile’s accounts and cookies. Page state and navigation history are not restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas se abrirán en %@ con las cuentas y las cookies del perfil de destino. El estado de la página y el historial de navegación no se restauran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages s’ouvriront dans %@ avec les comptes et les cookies du profil de destination. L’état des pages et l’historique de navigation ne sont pas restaurés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページは%@で、復元先プロファイルのアカウントとCookieを使って開きます。ページの状態とナビゲーション履歴は復元されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strony otworzą się w profilu %@ z użyciem kont i plików cookie profilu docelowego. Stan strony i historia nawigacji nie zostaną przywrócone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы откроются в профиле %@ с учетными записями и файлами cookie этого профиля. Состояние страниц и история переходов не восстанавливаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінки відкриються в профілі %@ з обліковими записами та файлами cookie цільового профілю. Стан сторінок та історія переходів не відновлюються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页将在 %@ 中打开，并使用目标用户场景的账户和 Cookie。网页状态和导航历史记录不会恢复。"
          }
        }
      }
    },
