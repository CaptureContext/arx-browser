    "onboarding.iCloud.notNowNote": {
      "comment": "Onboarding, after choosing Not now for iCloud sync. The path names the Settings tab as titled (settings.category.sync).",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist ausgeschaltet. Du kannst sie jederzeit unter Einstellungen › Synchronisierung einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is off. You can turn it on any time in Settings › Sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está desactivada. Puedes activarla cuando quieras en Ajustes › Sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est désactivée. Vous pouvez l’activer à tout moment dans Réglages › Synchronisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期はオフです。「設定」＞「同期」でいつでもオンにできます。"
          }
        },
        "pl": {
          "stringUnit": {
