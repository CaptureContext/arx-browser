    "history.clearMessage": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne den gesicherten Verlauf dieses Profils. Geöffnete Tabs, Cookies und gesicherte Seiten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this profile’s saved browsing history. Open tabs, cookies, and saved pages remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el historial de navegación guardado de este perfil. Las pestañas abiertas, las cookies y las páginas guardadas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez l’historique de navigation enregistré de ce profil. Les onglets ouverts, les cookies et les pages enregistrées restent disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルに保存されているブラウズ履歴を削除します。開いているタブ、Cookie、保存したページは引き続き利用できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń zapisaną historię przeglądania tego profilu. Otwarte karty, pliki cookie i zachowane strony pozostaną dostępne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить сохраненную историю просмотров этого профиля. Открытые вкладки, файлы cookie и сохраненные страницы останутся доступны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити збережену історію перегляду цього профілю. Відкриті вкладки, файли cookie та збережені сторінки залишаться доступними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此用户场景已存储的浏览历史记录。打开的标签页、Cookie 和已存储的页面仍然可用。"
          }
        }
      }
    },
    "history.description": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten, die du besuchst, erscheinen in der Suche der Befehlsleiste. Private Fenster und Vorschauen werden nicht gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages you visit appear in command-bar search. Private windows and previews aren’t saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas que visitas aparecen en la búsqueda de la barra de comandos. Las ventanas privadas y las previsualizaciones no se guardan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages que vous visitez apparaissent dans la recherche de la barre de commandes. Les fenêtres privées et les aperçus ne sont pas enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスしたページはコマンドバーの検索に表示されます。プライベートウインドウとプレビューは保存されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odwiedzane strony pojawiają się w wyszukiwaniu na pasku poleceń. Okna prywatne i podglądy nie są zachowywane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посещенные страницы отображаются в результатах поиска в панели команд. Частные окна и предпросмотры не сохраняются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінки, які ви відвідуєте, зʼявляються в пошуку панелі команд. Приватні вікна та попередні перегляди не зберігаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你访问过的页面会出现在命令栏搜索中。无痕浏览窗口和预览不会被存储。"
          }
        }
      }
    },
    "history.removeFailed": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Verlauf des entfernten Profils konnte nicht gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The removed profile’s local history could not be deleted."
