    "onboarding.connectAgent.note": {
      "comment": "Onboarding, Connect your agent page: the note under the providers. “It” is the agent the person connects.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird in jedem Profil zum Assistenten: Gib eine Frage in der Befehlsleiste ein und drücke den Tabulator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It becomes the assistant in every profile: type a question in the command bar and press Tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se convierte en el asistente de todos los perfiles: escribe una pregunta en la barra de comandos y pulsa Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il devient l’assistant de tous les profils : saisissez une question dans la barre de commandes et appuyez sur Tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続したエージェントは、すべてのプロファイルでアシスタントになります。コマンドバーに質問を入力して、Tabキーを押します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staje się asystentem w każdym profilu: wpisz pytanie na pasku poleceń i naciśnij Tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он становится ассистентом во всех профилях: введите вопрос в панели команд и нажмите Tab."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він стає асистентом у кожному профілі: введіть запитання в панелі команд і натисніть Tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会成为每个用户场景中的助理：在命令栏中输入问题，然后按下 Tab 键。"
          }
        }
      }
    },
