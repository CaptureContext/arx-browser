    "settings.iCloudSync.caption": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält deine Profile, Räume und Einstellungen über deinen eigenen iCloud-Account auf deinen Macs gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your profiles, spaces and preferences the same on your Macs through your own iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tus perfiles, secciones y preferencias iguales en tus Mac mediante tu propia cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient vos profils, sections et préférences identiques sur vos Mac grâce à votre propre compte iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのiCloudアカウントを通じて、Mac間でプロファイル、スペース、環境設定を同じ状態に保ちます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje Twoje profile, strefy i preferencje takie same na Twoich komputerach Mac przez Twoje własne konto iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизирует Ваши профили, разделы и настройки на всех Ваших компьютерах Mac через Вашу учетную запись iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізує ваші профілі, розділи й параметри на ваших Mac через ваш обліковий запис iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你自己的 iCloud 账户，让你各台 Mac 上的用户场景、分区和偏好设置保持一致。"
          }
        }
      }
    },
    "settings.iCloudSync.footer": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Website-Daten, Passwörter, Tab-Archiv und geöffnete Tabs bleiben auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Website data, passwords, Tab Archive and open tabs stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de sitios web, las contraseñas, las pestañas archivadas y las pestañas abiertas se quedan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de sites web, les mots de passe, les onglets archivés et les onglets ouverts restent sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブサイトのデータ、パスワード、タブアーカイブ、開いているタブは、このMacにのみ保存されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane witryn, hasła, Archiwum kart i otwarte karty zostają na tym Macu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные веб-сайтов, пароли, архив вкладок и открытые вкладки остаются на этом Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані вебсайтів, паролі, архів вкладок і відкриті вкладки залишаються на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站数据、密码、标签页归档和已打开的标签页会保留在这台 Mac 上。"
          }
        }
      }
    },
    "settings.iCloudSync.developmentWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Entwicklung. Das Löschen blendet etwas derzeit nur auf diesem Mac aus, der Rest der iCloud-Synchronisierung wird aber noch entwickelt. Aktiviere dieses Feature-Flag daher für niemanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In development. Deleting something now hides it on this Mac only, but the rest of iCloud Sync is still being built, so don’t turn this feature flag on for anyone yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En desarrollo. Eliminar algo ahora solo lo oculta en este Mac, pero el resto de la sincronización con iCloud aún se está creando, así que no actives este indicador de función para nadie todavía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En développement. Supprimer un élément le masque pour l’instant sur ce Mac uniquement, mais le reste de la synchronisation iCloud est encore en construction : n’activez pas cet indicateur de fonctionnalité pour d’autres personnes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発中です。現在は、削除したものはこのMacでのみ非表示になりますが、iCloud同期のそのほかの部分はまだ構築中のため、このフィーチャーフラグはまだ誰に対してもオンにしないでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trakcie tworzenia. Usunięcie czegoś ukrywa to teraz tylko na tym Macu, ale reszta synchronizacji iCloud wciąż powstaje, więc nie włączaj tej flagi funkcji nikomu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разработке. Удаление сейчас скрывает объект только на этом Mac, а остальная часть синхронизации iCloud еще создается, поэтому пока никому не включайте этот флаг функции."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У розробці. Видалення зараз лише ховає елемент на цьому Mac, але решта синхронізації iCloud ще створюється, тож поки що не вмикайте цей прапорець функції для інших."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发中。现在删除某项内容只会在这台 Mac 上将其隐藏，但 iCloud 同步的其余部分仍在构建中，因此请勿为任何人打开此功能标志。"
          }
        }
      }
    },
