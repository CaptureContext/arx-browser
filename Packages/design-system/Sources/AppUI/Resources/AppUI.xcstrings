    "profile.createDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Profilen sind deine Räume wirklich voneinander getrennt, mit eigenem Verlauf, eigenen gesicherten Passwörtern, Erweiterungen und anderen Browserdaten. Schluss mit dem ständigen Wechseln zwischen Arbeits- und privaten Accounts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles make your Spaces truly separate, with their own history, saved passwords, extensions and other browsing data. No more flipping between work and personal accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles separan de verdad tus secciones, con su propio historial, contraseñas guardadas, extensiones y otros datos de navegación. Se acabó alternar entre cuentas de trabajo y personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils séparent vraiment vos sections, avec leur propre historique, leurs mots de passe enregistrés, leurs extensions et leurs autres données de navigation. Fini les allers-retours entre comptes professionnels et personnels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルを使うと、スペースを完全に分けることができ、それぞれが独自の履歴、保存されたパスワード、機能拡張、そのほかの閲覧履歴データを持ちます。仕事用と個人用のアカウントを切り替える手間はもうありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile sprawiają, że Twoje strefy są naprawdę oddzielne, z własną historią, zachowanymi hasłami, rozszerzeniami i innymi danymi przeglądania. Koniec z przełączaniem się między kontami służbowymi i prywatnymi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили делают Ваши разделы по-настоящему раздельными: у каждого своя история, сохраненные пароли, расширения и другие данные о работе в браузере. Больше не нужно переключаться между рабочей и личной учетными записями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі роблять ваші розділи справді окремими: з власною історією, збереженими паролями, розширеннями й іншими даними вебперегляду. Більше не потрібно перемикатися між робочими та особистими обліковими записами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户场景让你的分区真正彼此独立，各自拥有历史记录、已存储的密码、扩展和其他浏览数据。不必再在工作和个人账户之间来回切换。"
          }
        }
      }
    },
    "profile.createNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile werden nicht zwischen Computern synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
