    "sendFeedback.failure.unsupportedFile": {
      "comment": "Send Feedback card: a file of a type the report doesn't take. %@ is the file's name.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ kann nicht angehängt werden. Hänge Bilder, Videos, Text oder PDF-Dateien an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” can't be attached. Attach pictures, videos, text or PDF files."
          }
        },
        "es": {
          "stringUnit": {
