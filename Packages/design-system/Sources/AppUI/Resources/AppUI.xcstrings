    "migration.clearFailed": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx konnte seine Daten nicht löschen, daher wurde nichts importiert. Versuche es erneut oder deaktiviere „Zuerst Arx-Daten löschen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx couldn't clear its data, so nothing was imported. Try again, or turn off Clear Arx Data First."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx no ha podido borrar sus datos, así que no se ha importado nada. Inténtalo de nuevo o desactiva “Borrar datos de Arx antes”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx n’a pas pu effacer ses données, donc rien n’a été importé. Réessayez, ou désactivez « Effacer d’abord les données d’Arx »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxのデータを消去できなかったため、何も読み込まれませんでした。もう一度お試しいただくか、「最初にArxのデータを消去」をオフにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx nie mógł wyczyścić swoich danych, więc nic nie zaimportowano. Spróbuj ponownie lub wyłącz opcję Najpierw wyczyść dane Arx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не удалось очистить свои данные, поэтому ничего не импортировано. Повторите попытку или выключите параметр «Сначала очистить данные Arx»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx не вдалося очистити свої дані, тому нічого не імпортовано. Спробуйте ще раз або вимкніть «Спершу очистити дані Arx»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 无法清除其数据，因此未导入任何内容。请重试，或关闭“先清除 Arx 数据”。"
          }
        }
      }
    },
