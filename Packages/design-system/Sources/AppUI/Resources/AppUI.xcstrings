    "automation.scriptWarning": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Skript läuft als du auf dieser Website: Es kann die Seite lesen und ändern und Anfragen mit deiner Sitzung senden. Es kann weder Cookies, Passwörter, Kartennummern noch gesicherte Zugangsdaten lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script runs as you on this site: it can read and change the page and send requests with your session. It can't read cookies, passwords, card numbers or saved credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El script se ejecuta como tú en este sitio: puede leer y cambiar la página y enviar peticiones con tu sesión. No puede leer cookies, contraseñas, números de tarjeta ni credenciales guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script s’exécute en tant que vous sur ce site : il peut lire et modifier la page et envoyer des requêtes avec votre session. Il ne peut pas lire les cookies, les mots de passe, les numéros de carte ni les identifiants enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトはこのサイトでご自身として実行されます。ページの読み取りと変更、セッションを使ったリクエストの送信ができます。Cookie、パスワード、カード番号、保存済みの認証情報は読み取れません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrypt działa jako Ty w tej witrynie: może odczytywać i zmieniać stronę oraz wysyłać żądania z Twoją sesją. Nie może odczytać plików cookie, haseł, numerów kart ani zachowanych poświadczeń."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипт запускается на этом сайте от Вашего имени: он может читать и менять страницу и отправлять запросы в рамках Вашего сеанса. Он не может читать файлы cookie, пароли, номера карт и сохраненные учетные данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипт виконується від вашого імені на цьому сайті: він може читати й змінювати сторінку та надсилати запити з вашим сеансом. Він не може читати файли cookie, паролі, номери карток чи збережені облікові дані."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本会以你的身份在此网站上运行：它可以读取和更改网页，并使用你的会话发送请求。它无法读取 Cookie、密码、卡号或已存储的凭据。"
          }
        }
      }
    },
