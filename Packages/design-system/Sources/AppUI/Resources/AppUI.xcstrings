    "outsideAgents.permissions.change": {
      "comment": "Outside agents (onboarding and Settings): what a connected agent asks before doing. The subject, the agent, is implied.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt vor dem Klicken, Tippen oder Bewegen von Tabs nach, außer du erlaubst es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks before clicking, typing or moving tabs, unless you allow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta antes de hacer clic, escribir o trasladar pestañas, a menos que lo permitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande avant de cliquer, de saisir ou de déplacer des onglets, sauf autorisation de votre part."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可しない限り、クリック、入力、タブの移動の前に確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyta przed klikaniem, pisaniem lub przenoszeniem kart, chyba że na to pozwolisz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивает перед нажатием, вводом или перемещением вкладок, если Вы не разрешили это."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує перед клацанням, введенням або переміщенням вкладок, якщо ви не дозволите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按、输入或移动标签页之前会询问你，除非你允许。"
          }
        }
      }
    },
    "outsideAgents.permissions.destructive": {
      "comment": "Outside agents (onboarding and Settings): what a connected agent always asks before. The subject, the agent, is implied.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt vor dem Schließen oder Löschen nach. Uploads fragen immer nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks before closing or deleting. Uploads always ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta antes de cerrar o eliminar. Subir archivos siempre se pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande avant de fermer ou de supprimer. Demande toujours avant d’importer un fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる操作や削除の前に確認します。アップロードは常に確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyta przed zamykaniem lub usuwaniem. Przesyłanie plików zawsze wymaga pytania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивает перед закрытием или удалением. Загрузка файлов всегда требует подтверждения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує перед закриттям або видаленням. Вивантаження завжди запитує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭或删除之前会询问你。上传文件始终会询问。"
          }
        }
      }
    },
    "outsideAgents.permissions.read": {
      "comment": "Outside agents (onboarding and Settings): what a connected agent may read. The subject, the agent, is implied.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest ohne Rückfrage, was du geteilt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads what you've shared without asking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee lo que has compartido sin preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit sans demander ce que vous avez partagé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有した内容は、確認なしで読み取ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyta to, co udostępnisz, bez pytania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает то, к чему Вы дали доступ, без запроса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
