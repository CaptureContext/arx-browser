    "search.instructions": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende !Schlüsselwort Suchbegriff oder tippe ein Schlüsselwort und drücke den Tabulator. Vorlagen benötigen genau ein {query} als vollständigen Abfragewert oder Pfadsegment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use !keyword query, or type a keyword and press Tab. Templates need one {query} as a complete query value or path segment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa !palabra consulta o escribe una palabra clave y pulsa Tab. Las plantillas necesitan un {query} como valor de consulta completo o segmento de ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez !motclé requête, ou saisissez un mot-clé et appuyez sur Tab. Les modèles requièrent un seul {query} comme valeur de requête complète ou segment de chemin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「!キーワード 検索語」と入力するか、キーワードを入力してTabキーを押します。テンプレートには、検索語全体またはパスの区間として、{query}を1つ含める必要があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj !słowo zapytanie lub wpisz słowo kluczowe i naciśnij Tab. Szablony wymagają jednego {query} jako pełnej wartości zapytania lub segmentu ścieżki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите !ключевое_слово запрос или введите ключевое слово и нажмите Tab. В шаблоне должен быть один {query} как полное значение запроса или сегмент пути."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте !ключове_слово запит або введіть ключове слово й натисніть Tab. Шаблони потребують одного {query} як повного значення запиту або сегмента шляху."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 !关键词 查询内容，或输入关键词后按下 Tab 键。模板需要有一个 {query}，作为完整的查询值或路径段。"
          }
        }
      }
    },
    "search.invalidShortcut": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe URL-Vorlage, Name und Schlüsselwort. Schlüsselwörter müssen eindeutig sein; verwende Buchstaben, Ziffern, Bindestriche oder Unterstriche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the URL template, name and keyword. Keywords must be unique; use letters, numbers, dashes or underscores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la plantilla de URL, el nombre y la palabra clave. Las palabras clave deben ser únicas; usa letras, números, guiones o guiones bajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le modèle d’URL, le nom et le mot-clé. Les mots-clés doivent être uniques ; utilisez des lettres, des chiffres, des tirets ou des tirets bas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URLテンプレート、名前、キーワードを確認してください。キーワードは一意である必要があります。英字、数字、ダッシュ、アンダースコアを使用してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź szablon URL, nazwę i słowo kluczowe. Słowa kluczowe muszą być unikalne; używaj liter, cyfr, myślników lub podkreślników."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте шаблон URL, название и ключевое слово. Ключевые слова должны быть уникальными; используйте буквы, цифры, дефисы или подчеркивания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте шаблон URL, назву та ключове слово. Ключові слова мають бути унікальними; використовуйте літери, цифри, дефіси або підкреслення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 URL 模板、名称和关键词。关键词必须唯一；请使用字母、数字、短横线或下划线。"
          }
        }
      }
    },
