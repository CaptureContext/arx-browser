    "appLinks.applicationMissing": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ befindet sich nicht mehr am gewählten Ort und Arx konnte nicht herausfinden, wohin es verschoben wurde. Wähle die App in Air Traffic Control erneut aus oder öffne den Link mit der Standard-App des Systems."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t where it was chosen, and Arx couldn’t find where it went. Choose it again in Air Traffic Control, or open the link with the System Default app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya no está donde se seleccionó y Arx no ha podido encontrar adónde ha ido. Vuelve a seleccionarla en Air Traffic Control o abre el enlace con la app por omisión del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne se trouve plus à l’emplacement choisi et Arx n’a pas pu le retrouver. Choisissez-le de nouveau dans Air Traffic Control, ou ouvrez le lien avec l’app par défaut du système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は選択した場所にありません。移動先も見つかりませんでした。Air Traffic Controlでもう一度選択するか、システムのデフォルトのAppでリンクを開いてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacji %@ nie ma w miejscu, w którym ją wybrano, a Arx nie mógł znaleźć, dokąd trafiła. Wybierz ją ponownie w Air Traffic Control albo otwórz łącze w aplikacji domyślnej systemu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» не найдено там, где его выбрали, и Arx не удалось понять, куда оно делось. Выберите его снова в Air Traffic Control или откройте ссылку в приложении по умолчанию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми %@ немає там, де її було вибрано, і Arx не вдалося знайти, куди вона поділася. Виберіть її знову в Air Traffic Control або відкрийте посилання в програмі, вибраній у системі типово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不在选取时的位置，Arx 也找不到它被移到了哪里。请在 Air Traffic Control 中重新选取，或使用系统默认 App 打开此链接。"
          }
        }
      }
    },
