    "links.templateHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende explizite Hosts, bei Bedarf mit www. {host} ist der Quell-Host. {subdomain} beginnt den Host des Ziels mit der Subdomain des Links, etwa vm. für vm.tiktok.com, und lässt die Regel auf Subdomains ihrer Hosts zutreffen. {path} behält den codierten Pfad bei, {query} enthält ? und {fragment} enthält #. Es werden nur HTTP(S) und Standard-Ports unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use explicit hosts, including www when needed. {host} is the source host. {subdomain} starts the destination's host with the link's subdomain, such as vm. for vm.tiktok.com, and lets the rule match its hosts' subdomains. {path} preserves the encoded path, {query} includes ? and {fragment} includes #. Only HTTP(S) and standard ports are supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa hosts explícitos, incluido www cuando haga falta. {host} es el host de origen. {subdomain} hace que el host de destino empiece por el subdominio del enlace, como vm. en vm.tiktok.com, y permite que la regla coincida con los subdominios de sus hosts. {path} conserva la ruta codificada, {query} incluye ? y {fragment} incluye #. Solo se admiten HTTP(S) y puertos estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des hôtes explicites, avec www si nécessaire. {host} est l’hôte source. {subdomain} place le sous-domaine du lien au début de l’hôte de destination, comme vm. pour vm.tiktok.com, et permet à la règle de correspondre aux sous-domaines de ses hôtes. {path} conserve le chemin encodé, {query} inclut le ? et {fragment} inclut le #. Seuls HTTP(S) et les ports standard sont pris en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要に応じてwwwを含め、ホストを明示してください。{host}はソースホストです。{subdomain}は、転送先のホストの先頭にリンクのサブドメイン（vm.tiktok.comのvm.など）を付け、ルールがそのホストのサブドメインにも一致するようにします。{path}はエンコードされたパスを保持し、{query}は?を、{fragment}は#を含みます。HTTP(S)と標準ポートのみサポートされています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj jawnych hostów, w tym www, gdy trzeba. {host} to host źródłowy. {subdomain} zaczyna host docelowy od subdomeny łącza, na przykład vm. dla vm.tiktok.com, i sprawia, że reguła pasuje do subdomen swoich hostów. {path} zachowuje zakodowaną ścieżkę, {query} zawiera ? a {fragment} zawiera #. Obsługiwane są tylko HTTP(S) i standardowe porty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указывайте хосты явно, включая www, если нужно. {host} — исходный хост. {subdomain} начинает хост назначения с поддомена ссылки, например vm. для vm.tiktok.com, и позволяет правилу подходить к поддоменам его хостов. {path} сохраняет закодированный путь, {query} включает ?, а {fragment} включает #. Поддерживаются только HTTP(S) и стандартные порты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте явні хости, зокрема www, коли потрібно. {host} — вихідний хост. {subdomain} починає хост призначення з піддомену посилання, як-от vm. для vm.tiktok.com, і дозволяє правилу відповідати піддоменам його хостів. {path} зберігає закодований шлях, {query} містить ?, а {fragment} містить #. Підтримуються лише HTTP(S) і стандартні порти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用明确的主机，需要时包括 www。{host} 是来源主机。{subdomain} 会让目标主机以该链接的子域名开头，例如 tiktok.com 链接 vm.tiktok.com 中的 vm.，并让规则匹配其主机的子域名。{path} 保留已编码的路径，{query} 包含 ?，{fragment} 包含 #。仅支持 HTTP(S) 和标准端口。"
          }
        }
      }
    },
    "links.testHelp": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt vor dem Sichern, was diese Regel und „Bereinigten Link kopieren“ aus einem Link machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows what this rule and Copy Clean Link make of a link, before you save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra qué hacen esta regla y Copiar enlace limpio con un enlace, antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le résultat de cette règle et de « Copier le lien propre » sur un lien, avant d’enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存する前に、このルールと「クリーンリンクをコピー」でリンクがどうなるかを表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje, co z łącza robi ta reguła i Kopiuj czyste łącze, zanim zachowasz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, что получится из ссылки по этому правилу и по команде «Скопировать чистую ссылку», до сохранения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує, що з посилання роблять це правило та «Скопіювати чисте посилання», перш ніж ви збережете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你存储之前，显示此规则和“拷贝纯净链接”会如何处理某个链接。"
          }
        }
      }
    },
