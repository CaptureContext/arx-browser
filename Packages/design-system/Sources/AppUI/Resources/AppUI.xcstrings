    "profileMove.tabDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite wird im Profil „%@“ neu geladen. Ihre Anmeldungen werden nicht übernommen, daher musst du dich eventuell erneut anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page reloads in the %@ profile. Its sign-ins don’t carry over, so you may need to sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página se vuelve a cargar en el perfil %@. Sus inicios de sesión no se trasladan, así que puede que tengas que iniciar sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page se recharge dans le profil %@. Ses connexions ne sont pas conservées, vous devrez donc peut-être vous reconnecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページは「%@」プロファイルで再読み込みされます。サインインは引き継がれないため、もう一度サインインが必要になる場合があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona zostanie ponownie wczytana w profilu %@. Jej logowania nie zostaną przeniesione, więc może być konieczne ponowne zalogowanie się."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница перезагрузится в профиле «%@». Данные для входа не переносятся, поэтому может потребоваться войти снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінка перезавантажиться в профілі «%@». Її входи не переносяться, тож, можливо, доведеться увійти знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该页面将在 %@ 用户场景中重新加载。其登录状态不会带过去，因此你可能需要重新登录。"
          }
        }
      }
    },
