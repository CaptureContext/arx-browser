    "automation.description": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde einen vertrauenswürdigen Assistenten auf diesem Mac mit ausgewähltem Browserkontext. Neue Clients haben keinen Zugriff, bis du ihn erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a trusted assistant on this Mac to selected browser context. New clients have no access until you grant it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta un asistente de confianza de este Mac con parte del contexto del navegador. Los clientes nuevos no tienen acceso hasta que se lo concedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un assistant de confiance de ce Mac à une sélection de contexte du navigateur. Les nouveaux clients n’ont aucun accès tant que vous ne l’accordez pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac上の信頼できるアシスタントを、選択したブラウザのコンテキストに接続します。新しいクライアントは、許可するまでアクセスできません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz zaufanego asystenta na tym Macu z wybranym kontekstem przeglądarki. Nowi klienci nie mają dostępu, dopóki go nie przyznasz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите доверенного ассистента на этом Mac к выбранному контексту браузера. У новых клиентов нет доступа, пока Вы его не предоставите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть надійного асистента на цьому Mac до вибраного контексту браузера. Нові клієнти не мають доступу, доки ви його не надасте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这台 Mac 上你信任的助理连接到所选的浏览器上下文。新客户端在你授权之前没有任何访问权限。"
          }
        }
      }
    },
