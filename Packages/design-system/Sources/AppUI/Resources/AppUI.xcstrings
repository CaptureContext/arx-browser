        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowanie czyszczenia oczekuje. Zakończ Arx i otwórz go ponownie, aby spróbować jeszcze raz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка к очистке ожидает выполнения. Завершите и снова откройте Arx, чтобы повторить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготовка очищення очікує. Завершіть роботу Arx і знову відкрийте його, щоб повторити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除准备正在等待中。请退出并重新打开 Arx 以重试。"
