    "chat.failureUnsupportedSignInDetail": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx verwendet nur die eigene Anmeldung deines Tarifs, nie einen gesondert abgerechneten Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
