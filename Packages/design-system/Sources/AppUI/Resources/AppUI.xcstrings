    "downloads.blocked": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Sicherheitsgründen blockiert. Brich diesen Download ab und verwende eine vertrauenswürdige Quelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked for safety. Cancel this download and use a trusted source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueada por seguridad. Cancela esta descarga y usa una fuente de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué par sécurité. Annulez ce téléchargement et utilisez une source de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全のためブロックされました。このダウンロードをキャンセルして、信頼できる入手元を使用してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowano ze względów bezpieczeństwa. Anuluj to pobieranie i użyj zaufanego źródła."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировано в целях безопасности. Отмените эту загрузку и используйте надежный источник."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблоковано з міркувань безпеки. Скасуйте це викачування й скористайтеся надійним джерелом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出于安全考虑已被阻止。请取消此下载，并使用可信的来源。"
          }
        }
      }
    },
