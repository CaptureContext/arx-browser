    "sendFeedback.vulnerabilityHint": {
      "comment": "Send Feedback card: tooltip of the Vulnerability kind in the row of kinds, on one short line, what happens to such a report.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dringend markiert und bis zur Behebung privat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked urgent and kept private until fixed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se marca como urgente y sigue siendo privado hasta que se corrige"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marqué comme urgent et privé jusqu’à sa correction"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緊急として扱われ、修正されるまで非公開"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczone jako pilne i prywatne do czasu naprawy"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечается как срочное и остается конфиденциальным до исправления"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначається як термінове й залишається конфіденційним до виправлення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记为紧急，修复前保持私密"
          }
        }
      }
    },
    "sendFeedback.vulnerabilityNote": {
      "comment": "Send Feedback card: shown under the text field when the kind is Vulnerability.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen zu Sicherheitslücken werden als dringend markiert und bleiben privat, bis sie behoben sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vulnerability reports are marked urgent and stay private until they're fixed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes de vulnerabilidades se marcan como urgentes y siguen siendo privados hasta que se corrigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports de vulnérabilité sont marqués comme urgents et restent privés jusqu’à leur correction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脆弱性のレポートは緊急として扱われ、修正されるまで非公開になります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszenia luk w zabezpieczeniach są oznaczane jako pilne i pozostają prywatne do czasu ich naprawy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения об уязвимостях помечаются как срочные и остаются конфиденциальными, пока не будут исправлены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звіти про вразливості позначаються як термінові й залишаються конфіденційними, доки їх не буде виправлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漏洞报告会标记为紧急，并在修复之前保持私密。"
          }
        }
      }
    },
