    "developer.securityDataCaption": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx fragt den Komponentendienst von Google alle fünf Stunden danach ab. Die Abfrage nennt nur die Komponenten und ihre Versionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx checks Google's component service for these every five hours. The check names only the components and their versions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx consulta el servicio de componentes de Google cada cinco horas. La consulta solo indica los componentes y sus versiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx interroge le service de composants de Google toutes les cinq heures pour les obtenir. La vérification ne mentionne que les composants et leurs versions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxは、Googleのコンポーネントサービスで5時間ごとにこれらを確認します。確認では、コンポーネント名とバージョンのみが送信されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx co pięć godzin sprawdza je w usłudze komponentów Google. Sprawdzenie podaje tylko komponenty i ich wersje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx проверяет службу компонентов Google на их наличие каждые пять часов. В проверке указываются только компоненты и их версии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx перевіряє службу компонентів Google на наявність цього кожні п’ять годин. Перевірка називає лише компоненти та їхні версії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arx 每五小时向 Google 的组件服务检查一次这些内容。检查时只会提供组件名称及其版本。"
          }
        }
      }
    },
