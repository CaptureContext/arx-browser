          }
        }
      }
    },
    "automation.signIn.lockNote": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Browserzugriff der Assistenten bleibt pausiert, bis du die Sperre beendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant browser access remains paused until you end the lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de los asistentes al navegador sigue en pausa hasta que termines el bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès des assistants au navigateur reste suspendu jusqu’à ce que vous mettiez fin au verrouillage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを終了するまで、アシスタントのブラウザへのアクセスは一時停止されたままです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp asystentów do przeglądarki pozostaje wstrzymany, dopóki nie zakończysz blokady."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ ассистентов к браузеру остается приостановленным, пока Вы не снимете блокировку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ асистентів до браузера лишається призупиненим, доки ви не завершите блокування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你结束锁定之前，助理对浏览器的访问会一直保持暂停。"
          }
        }
      }
    },
    "automation.signIn.resume": {
