    "settings.iCloudSync.device.keeps": {
      "comment": "Settings › Arx › iCloud Sync › Preferences: a Mac that doesn't sync some groups of settings. %1$@ is the Mac's line (its name and when it was last seen, settings.iCloudSync.device.seen), %2$@ a list of settings groups (settings.iCloudSync.group.*) joined in the language's list format.",
      "extractionState": "manual",
