    "settings.globalShortcutTaken": {
      "comment": "Settings › Arx, under the global Little Arx shortcut switch: macOS refused the shortcut because another app registered it first (DEV-1332).",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App verwendet diesen Tastaturkurzbefehl. Arx übernimmt ihn, sobald diese App beendet wird, oder du wählst unter „Tastaturkurzbefehle“ eine andere Belegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is using this shortcut. Arx takes it as soon as that app quits, or you can choose another binding in Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app está usando este atajo. Arx lo tomará en cuanto esa app se cierre, o puedes elegir otra combinación en Atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app utilise ce raccourci. Arx le prendra dès que cette app se fermera, ou vous pouvez choisir une autre combinaison dans Raccourcis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがこのショートカットを使用しています。そのアプリが終了するとArxが使用を開始します。「ショートカット」で別のキーを選ぶこともできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna aplikacja używa tego skrótu. Arx przejmie go, gdy tylko tamta aplikacja się zakończy, lub możesz wybrać inny skrót w Skróty klawiszowe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое приложение использует это сочетание. Arx займёт его, как только то приложение завершится, или Вы можете выбрать другое сочетание в разделе «Сочетания клавиш»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інша програма використовує це скорочення. Arx займе його, щойно ту програму буде завершено, або ви можете вибрати інше скорочення в розділі «Клавіатурні скорочення»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 正在使用此快捷键。该 App 退出后，Arx 会立即接管，你也可以在“快捷键”中选择其他组合。"
          }
        }
      }
    },
    "settings.conflictDelayed": {
