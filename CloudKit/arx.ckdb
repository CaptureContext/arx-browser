DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE archiveDeletion (
        "___createTime"                                  TIMESTAMP,
        "___createdBy"                                   REFERENCE,
        "___etag"                                        STRING,
        "___modTime"                                     TIMESTAMP,
        "___modifiedBy"                                  REFERENCE,
        "___recordID"                                    REFERENCE,
        deletedAt                                        ENCRYPTED DOUBLE,
        deviceID                                         ENCRYPTED STRING,
        id                                               ENCRYPTED STRING,
        itemID                                           ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deletedAt ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deviceID  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_itemID    ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE archiveDevice (
        "___createTime"                                 TIMESTAMP,
        "___createdBy"                                  REFERENCE,
        "___etag"                                       STRING,
        "___modTime"                                    TIMESTAMP,
        "___modifiedBy"                                 REFERENCE,
        "___recordID"                                   REFERENCE,
        id                                              ENCRYPTED STRING,
        lastSeen                                        ENCRYPTED DOUBLE,
        sqlitedata_icloud_userModificationTime          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_lastSeen ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE archiveEntry (
        "___createTime"                                           TIMESTAMP,
        "___createdBy"                                            REFERENCE,
        "___etag"                                                 STRING,
        "___modTime"                                              TIMESTAMP,
        "___modifiedBy"                                           REFERENCE,
        "___recordID"                                             REFERENCE,
        automationClientID                                        ENCRYPTED STRING,
        closedAt                                                  ENCRYPTED DOUBLE,
        customTitle                                               ENCRYPTED STRING,
        groupID                                                   ENCRYPTED STRING,
        id                                                        ENCRYPTED STRING,
        originalIndex                                             ENCRYPTED INT64,
        position                                                  ENCRYPTED STRING,
        profileID                                                 ENCRYPTED STRING,
        spaceID                                                   ENCRYPTED STRING,
        spaceName                                                 ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime                    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_automationClientID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_closedAt           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_customTitle        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_groupID            ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id                 ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_originalIndex      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_position           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_profileID          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_spaceID            ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_spaceName          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_tabID              ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_title              ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_url                ENCRYPTED INT64,
        tabID                                                     ENCRYPTED STRING,
        title                                                     ENCRYPTED STRING,
        url                                                       ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE deletion (
        "___createTime"                                       TIMESTAMP,
        "___createdBy"                                        REFERENCE,
        "___etag"                                             STRING,
        "___modTime"                                          TIMESTAMP,
        "___modifiedBy"                                       REFERENCE,
        "___recordID"                                         REFERENCE,
