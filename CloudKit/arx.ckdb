        position                                           ENCRYPTED STRING,
        profileID                                          ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_customTitle ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_icon        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_iconURL     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_position    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_profileID   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_title       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_url         ENCRYPTED INT64,
