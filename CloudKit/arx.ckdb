        deviceID                                              ENCRYPTED STRING,
        id                                                    ENCRYPTED STRING,
        itemID                                                ENCRYPTED STRING,
        itemTable                                             ENCRYPTED STRING,
        keepsElsewhere                                        ENCRYPTED INT64,
