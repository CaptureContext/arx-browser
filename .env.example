# Apple Developer Team ID. Leave empty for unsigned CI builds.
DEVELOPMENT_TEAM=

# Optional Services ID for the member number's Sign in with Apple, through Apple's web sign-in:
# dev.capturecontext.arx.auth, grouped with the App ID dev.capturecontext.arx, whose return URL is
# https://api.arxbrowser.net/v1/apple/callback. Not a secret. Leave empty to build without Apple sign-in.
ARX_APPLE_SERVICES_ID=

# Optional SHA-1 of an existing Apple Development identity for this team.
# Otherwise, choose the valid team certificate with the latest expiry.
ARX_SIGNING_IDENTITY=

# Optional SHA-1 fingerprint of the Developer ID Application identity for make dmg.
# Otherwise, the team's Developer ID Application certificate in the keychain is used.
ARX_RELEASE_IDENTITY=
# Optional notarytool keychain profile for make dmg, used instead of the API key below.
ARX_NOTARY_KEYCHAIN_PROFILE=

# Optional paths to provisioning profiles, used instead of the Match profiles that
# make signing-setup and make release-signing-setup install into
# ~/Library/Developer/Xcode/UserData/Provisioning Profiles/. Keep profiles out of the repo.
ARX_DEVELOPMENT_PROFILE=
ARX_DEVELOPER_ID_PROFILE=

# Fastlane certificate and profile restore, and make dmg notarization. Local builds need only an
# installed identity and profile. The signing_profiles lane (writes) also takes a devices file kept
# outside the repo: mise exec -- fastlane mac signing_profiles devices:~/.config/arx/devices.txt
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=
APP_STORE_CONNECT_API_KEY_KEY_CONTENT=
APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64=false
MATCH_GIT_URL=
MATCH_GIT_BRANCH=main
MATCH_PASSWORD=
