    "NSCameraUsageDescription" : {
      "comment" : "macOS asks whether Arx may use the camera.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, die du erlaubst, können in Arx deine Kamera verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites you allow can use your camera in Arx."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios web que permitas pueden usar tu cámara en Arx."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites web que vous autorisez peuvent utiliser votre caméra dans Arx."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可したウェブサイトは、Arxでカメラを使用できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryny, na które pozwolisz, mogą używać Twojej kamery w Arx."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веб-сайты, которым Вы разрешите, смогут использовать камеру в Arx."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вебсайти, яким ви дозволите, можуть використовувати вашу камеру в Arx."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你允许的网站可以在 Arx 中使用你的摄像头。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "macOS asks whether Arx may find devices on the local network.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx findet Chromecasts und andere Geräte in deinem lokalen Netzwerk, auf die gestreamt werden kann, und Websites, die du erlaubst, können Geräte darin erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx finds Chromecasts and other devices to cast to on your local network, and websites you allow can reach devices on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx encuentra Chromecasts y otros dispositivos a los que enviar contenido en tu red local, y los sitios web que permitas pueden acceder a los dispositivos de esa red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx détecte les Chromecast et autres appareils de diffusion sur votre réseau local, et les sites web que vous autorisez peuvent accéder aux appareils de ce réseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arxは、ローカルネットワーク上のChromecastやキャスト先のデバイスを検出します。許可したウェブサイトも、ローカルネットワーク上のデバイスにアクセスできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx znajduje w Twojej sieci lokalnej Chromecasty i inne urządzenia do przesyłania, a witryny, na które pozwolisz, mogą docierać do urządzeń w tej sieci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx находит устройства Chromecast и другие устройства для трансляции в Вашей локальной сети, а веб-сайты, которым Вы разрешите, смогут обращаться к устройствам в ней."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx знаходить Chromecast та інші пристрої для трансляції у вашій локальній мережі, а вебсайти, яким ви дозволите, можуть звертатися до пристроїв у ній."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx 会在你的本地网络上查找 Chromecast 和其他可投放的设备，你允许的网站也可以访问其中的设备。"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "macOS asks whether Arx may use Location Services.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, die du erlaubst, können in Arx deinen Standort verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites you allow can use your location in Arx."
