{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "macOS asks whether Arx may control another app (Automation).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx übergibt App-Links, etwa Anmelderückrufe, an die App, die du für dieses Profil ausgewählt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx hands app links, such as sign-in callbacks, to the app you chose for this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx entrega los enlaces de apps, como las respuestas de inicio de sesión, a la app que has elegido para este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx transmet les liens d’app, tels que les rappels de connexion, à l’app que vous avez choisie pour ce profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arxは、サインインのコールバックなどのAppのリンクを、このプロファイルに選択したAppに渡します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx przekazuje łącza do aplikacji, takie jak wywołania zwrotne logowania, aplikacji wybranej dla tego profilu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx передает ссылки приложений, например обратные вызовы для входа, приложению, которое Вы выбрали для этого профиля."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx передає посилання на програми, як-от зворотні виклики входу, програмі, яку ви вибрали для цього профілю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arx 会将 App 链接（如登录回调）交给你为此用户场景选取的 App。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "macOS asks whether Arx may capture system audio.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, die du erlaubst, können in Arx Audio aufnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites you allow can capture audio in Arx."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios web que permitas pueden capturar audio en Arx."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites web que vous autorisez peuvent capturer l’audio dans Arx."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可したウェブサイトは、Arxでオーディオをキャプチャできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryny, na które pozwolisz, mogą przechwytywać dźwięk w Arx."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веб-сайты, которым Вы разрешите, смогут записывать звук в Arx."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вебсайти, яким ви дозволите, можуть записувати звук в Arx."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你允许的网站可以在 Arx 中捕获音频。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "macOS asks whether Arx may use Bluetooth.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, die du erlaubst, können in Arx Bluetooth verwenden, zum Beispiel um dich mit einem Passkey auf deinem iPhone anzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites you allow can use Bluetooth in Arx, for example to sign in with a passkey on your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios web que permitas pueden usar Bluetooth en Arx, por ejemplo, para iniciar sesión con una llave de acceso en tu móvil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites web que vous autorisez peuvent utiliser le Bluetooth dans Arx, par exemple pour se connecter avec une clé d’accès sur votre téléphone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可したウェブサイトは、ArxでBluetoothを使用できます。たとえば、iPhoneのパスキーでサインインできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryny, na które pozwolisz, mogą używać Bluetooth w Arx, na przykład do logowania kluczem dostępu na telefonie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веб-сайты, которым Вы разрешите, смогут использовать Bluetooth в Arx, например для входа с помощью ключа входа на Вашем телефоне."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вебсайти, яким ви дозволите, можуть використовувати Bluetooth в Arx, наприклад для входу за допомогою ключа допуску на вашому телефоні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你允许的网站可以在 Arx 中使用蓝牙，例如使用手机上的通行密钥登录。"
          }
        }
      }
    },
