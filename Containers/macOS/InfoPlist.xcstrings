        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веб-сайты, которым Вы разрешите, смогут использовать Вашу геопозицию в Arx."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вебсайти, яким ви дозволите, можуть використовувати ваше місцезнаходження в Arx."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
